{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Inscriptions{% endblock %}
{% block page_title %}Gestion des Inscriptions{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('assets/css/inscriptions-admin.css') }}">

<div class="inscriptions-page">
    <div class="inscriptions-hero">
        <div class="hero-content">
            <span class="hero-badge">EcoAdventure • Administration</span>
            <h2>Liste des inscriptions aux packs</h2>
            <p>
                Consultez les inscriptions enregistrées, recherchez instantanément un utilisateur,
                un pack ou un statut, et visualisez les informations essentielles dans une interface moderne.
            </p>
        </div>

        <div class="hero-stat">
            <span>Total</span>
            <strong>{{ totalInscriptions }}</strong>
            <small>inscriptions enregistrées</small>
        </div>
    </div>

    <div class="flash-wrap-insc">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success custom-alert-insc">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger custom-alert-insc">{{ message }}</div>
        {% endfor %}
    </div>

    <div class="inscriptions-toolbar">
        <div class="toolbar-head">
            <div>
                <h3>Recherche intelligente</h3>
                <p>La recherche se lance automatiquement pendant la saisie, sans bouton.</p>
            </div>

            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-back-insc">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>

        <form method="get"
              action="{{ path('app_admin_inscriptions') }}"
              id="inscriptionSearchForm">
            <div class="search-live-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       name="search"
                       id="liveSearchInput"
                       class="form-control"
                       placeholder="Rechercher par nom, email, pack ou statut..."
                       value="{{ search|default('') }}"
                       autocomplete="off">
            </div>
        </form>
    </div>

    <div class="inscriptions-table-card">
        {% if inscriptions|length > 0 %}
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Pack</th>
                            <th>Date d’inscription</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for inscription in inscriptions %}
                            {% set userName = inscription.userApp ? inscription.userApp.prenom ~ ' ' ~ inscription.userApp.nom : (inscription.nomUser ?: 'Utilisateur inconnu') %}
                            {% set userEmail = inscription.userApp ? inscription.userApp.email : null %}
                            <tr>
                                <td>
                                    <div class="cell-title">
                                        {{ userName|trim }}
                                    </div>
                                    {% if userEmail %}
                                        <small class="text-muted">{{ userEmail }}</small>
                                    {% endif %}
                                </td>

                                <td>
                                    <div class="cell-pack">
                                        {{ inscription.nomPack ?: (inscription.pack ? inscription.pack.nom : 'Pack non défini') }}
                                    </div>
                                </td>

                                <td>
                                    {{ inscription.dateInscription ? inscription.dateInscription|date('d/m/Y H:i') : '-' }}
                                </td>

                                <td>
                                    <span class="amount-chip">
                                        {{ inscription.montantTotal }} DT
                                    </span>
                                </td>

                                <td>
                                    {% set statut = inscription.statutInscr ? inscription.statutInscr.value : 'Inconnu' %}

                                    {% if statut|lower in ['confirmée', 'confirmee', 'validée', 'validee', 'active'] %}
                                        <span class="status-badge status-success">{{ statut }}</span>
                                    {% elseif statut|lower in ['en attente', 'pending'] %}
                                        <span class="status-badge status-warning">{{ statut }}</span>
                                    {% else %}
                                        <span class="status-badge status-dark">{{ statut }}</span>
                                    {% endif %}
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-delete-inscription"
                                            data-inscription-id="{{ inscription.idInscription }}"
                                            data-inscription-user="{{ userName|trim }}"
                                            data-inscription-pack="{{ inscription.nomPack ?: (inscription.pack ? inscription.pack.nom : 'Pack non défini') }}"
                                            data-inscription-token="{{ csrf_token('delete_inscription_' ~ inscription.idInscription) }}">
                                        <i class="bi bi-trash me-1"></i> Supprimer
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty-state-insc">
                <i class="bi bi-journal-x"></i>
                <h4>Aucune inscription trouvée</h4>
                <p>Aucun résultat ne correspond à la recherche actuelle.</p>
            </div>
        {% endif %}
    </div>
</div>

<div id="deleteInscriptionModal" class="delete-modal-overlay">
    <div class="delete-modal-stage">
        <div class="delete-card-animation" id="deleteAnimatedCard">
            <div class="delete-card-face delete-card-front">
                <div class="card-chip"></div>
                <div class="card-brand">EcoAdventure</div>
                <div class="card-wave"></div>
                <div class="card-title">Suppression sécurisée</div>
                <div class="card-subtitle">Validation en cours...</div>
            </div>
            <div class="delete-card-face delete-card-back">
                <div class="card-strip"></div>
                <div class="card-note">Admin Control</div>
            </div>
        </div>

        <div class="delete-confirm-box" id="deleteConfirmBox">
            <h3>Confirmer la suppression</h3>
            <p id="deleteConfirmText">
                Êtes-vous sûr de vouloir supprimer cette inscription ?
            </p>

            <form id="deleteInscriptionForm" method="post" action="">
                <input type="hidden" name="_token" id="deleteInscriptionToken">
                <div class="delete-confirm-actions">
                    <button type="submit" class="btn btn-confirm-yes">
                        Oui, supprimer
                    </button>
                    <button type="button" class="btn btn-confirm-no" id="cancelDeleteBtn">
                        Non
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const input = document.getElementById('liveSearchInput');
        const form = document.getElementById('inscriptionSearchForm');
        let timer = null;

        if (input && form) {
            input.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () {
                    form.submit();
                }, 350);
            });
        }
    })();

    (function () {
        const modal = document.getElementById('deleteInscriptionModal');
        const animatedCard = document.getElementById('deleteAnimatedCard');
        const confirmBox = document.getElementById('deleteConfirmBox');
        const confirmText = document.getElementById('deleteConfirmText');
        const deleteForm = document.getElementById('deleteInscriptionForm');
        const deleteToken = document.getElementById('deleteInscriptionToken');
        const cancelBtn = document.getElementById('cancelDeleteBtn');
        const deleteButtons = document.querySelectorAll('.btn-delete-inscription');

        function openDeleteModal(id, user, pack, token) {
            deleteForm.action = '/admin/inscriptions/' + id + '/delete';
            deleteToken.value = token;
            confirmText.textContent = 'Êtes-vous sûr de vouloir supprimer l’inscription de "' + user + '" pour le pack "' + pack + '" ?';

            modal.classList.add('active');
            animatedCard.classList.remove('stop-motion');
            confirmBox.classList.remove('show-confirm');

            void animatedCard.offsetWidth;

            setTimeout(() => {
                animatedCard.classList.add('stop-motion');
                confirmBox.classList.add('show-confirm');
            }, 1900);
        }

        function closeDeleteModal() {
            modal.classList.remove('active');
            confirmBox.classList.remove('show-confirm');
            animatedCard.classList.remove('stop-motion');
        }

        deleteButtons.forEach((btn) => {
            btn.addEventListener('click', function () {
                openDeleteModal(
                    this.dataset.inscriptionId,
                    this.dataset.inscriptionUser,
                    this.dataset.inscriptionPack,
                    this.dataset.inscriptionToken
                );
            });
        });

        if (cancelBtn) {
            cancelBtn.addEventListener('click', closeDeleteModal);
        }

        if (modal) {
            modal.addEventListener('click', function (e) {
                if (e.target === modal) {
                    closeDeleteModal();
                }
            });
        }
    })();
</script>
{% endblock %}
