{% extends 'admin/base_admin.html.twig' %}

{% block title %}Statistiques Événements{% endblock %}
{% block page_title %}Statistiques des Événements{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 fw-bold">Tableau de bord financier & statistique</h3>
        <a href="{{ path('app_admin_statistiques_export_excel') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel (Chiffre d'affaires)
        </a>
    </div>
    <!-- Cartes récapitulatives -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-calendar-event fs-3"></i>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Total Événements</h6>
                    <h3 class="fw-bold mb-0">{{ totalEvents }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Taux de Remplissage</h6>
                    <h3 class="fw-bold mb-0">{{ fillRate }}%</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-star fs-3"></i>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Catégorie Populaire</h6>
                    <h3 class="fw-bold mb-0" style="font-size: 1.2rem;">{{ mostPopularType }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-cash-stack fs-3"></i>
                    </div>
                    <h6 class="text-muted fw-bold mb-1">Revenu Estimé</h6>
                    <h3 class="fw-bold mb-0">{{ estimatedRevenue|number_format(2, ',', ' ') }} DT</h3>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Petites Stats Réservations -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-primary">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3">
                        <i class="bi bi-journal-check fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Total Réservations</small>
                        <h5 class="mb-0 fw-bold">{{ totalReservations }}</h5>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-success">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Confirmées</small>
                        <h5 class="mb-0 fw-bold">{{ resStats['confirmées'] }}</h5>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-danger">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-3">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">Annulées</small>
                        <h5 class="mb-0 fw-bold">{{ resStats['annulées'] }}</h5>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-warning">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-bold">En Attente</small>
                        <h5 class="mb-0 fw-bold">{{ resStats['en_attente'] }}</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Événements par mois -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Événements par Mois</h5>
                </div>
                <div class="card-body p-4">
                    <div id="eventsByMonthChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>

        <!-- Répartition par type -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Répartition par Type</h5>
                </div>
                <div class="card-body p-4">
                    <div id="eventsByTypeChart" style="height: 300px;"></div>
                </div>
            </div>
        </div>

        <!-- Réservations Confirmées vs Annulées -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Statut des Réservations</h5>
                </div>
                <div class="card-body p-4">
                    <div id="resStatusChart" style="height: 250px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    {{ gc_draw(monthChart, 'eventsByMonthChart') }}
    {{ gc_draw(typeChart, 'eventsByTypeChart') }}
    {{ gc_draw(resChart, 'resStatusChart') }}
</script>

<style>
    .card { transition: transform 0.2s ease-in-out; }
    .card:hover { transform: translateY(-5px); }
</style>
{% endblock %}
