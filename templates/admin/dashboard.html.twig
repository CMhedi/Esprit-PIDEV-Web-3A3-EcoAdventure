{% extends 'admin/base_admin.html.twig' %}

{% block title %}EcoAdventure | Pro AI Dashboard{% endblock %}

{% block body %}
<div class="dashboard-container animate-fade-in">
    <!-- Header with Glassmorphism -->
    <div class="glass-header d-flex justify-content-between align-items-center mb-4 p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold mb-0 text-gradient">Eco-Intelligence Center</h2>
            <p class="text-muted small mb-0"><i class="bi bi-cpu-fill me-2"></i>Analyse prédictive en temps réel | {{ "now"|date("d F Y, H:i") }}</p>
        </div>
        <div class="d-flex gap-3">
            <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm transition-300" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>Exporter PDF
            </button>
            <div class="status-indicator">
                <span class="pulse-dot"></span>
                <span class="text-success fw-bold small">IA ACTIVE</span>
            </div>
        </div>
    </div>

    <!-- Top KPI Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="pro-stat-card card-blue">
                <div class="icon-box"><i class="bi bi-people"></i></div>
                <div class="stat-content">
                    <p class="label">Utilisateurs</p>
                    <h3 class="value">{{ stats.users }}</h3>
                    <span class="trend up"><i class="bi bi-graph-up-arrow"></i> +12%</span>
                </div>
                <div class="card-bg-icon"><i class="bi bi-people"></i></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pro-stat-card card-green">
                <div class="icon-box"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-content">
                    <p class="label">Événements</p>
                    <h3 class="value">{{ stats.events }}</h3>
                    <span class="trend"><i class="bi bi-check-circle"></i> Actifs</span>
                </div>
                <div class="card-bg-icon"><i class="bi bi-calendar-event"></i></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pro-stat-card card-purple">
                <div class="icon-box"><i class="bi bi-emoji-smile"></i></div>
                <div class="stat-content">
                    <p class="label">Satisfaction (IA)</p>
                    <h3 class="value">{{ ai.sentiment }}%</h3>
                    <span class="badge rounded-pill bg-white bg-opacity-25">{{ ai.sentimentLabel }}</span>
                </div>
                <div class="card-bg-icon"><i class="bi bi-heart"></i></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pro-stat-card card-orange">
                <div class="icon-box"><i class="bi bi-lightning"></i></div>
                <div class="stat-content">
                    <p class="label">Prédiction Flux</p>
                    <h3 class="value">+{{ ai.forecast|reduce((a, b) => a + b) }}</h3>
                    <span class="trend">Prochaines 4 sem.</span>
                </div>
                <div class="card-bg-icon"><i class="bi bi-speedometer2"></i></div>
            </div>
        </div>
    </div>

    <!-- Main AI Section -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="glass-card main-ai-card overflow-hidden h-100">
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-activity me-2 text-primary"></i>Prévisions de Croissance (ML Model)</h5>
                        <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Algorithme Gemini-Pro</div>
                    </div>
                    <div style="height: 300px;">
                        <canvas id="forecastChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-card ai-insights-card h-100 p-4">
                <h5 class="fw-bold mb-4 text-gradient-2">AI Insights</h5>
                
                <div class="insight-item mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <div class="insight-icon bg-info-subtle text-info"><i class="bi bi-eye"></i></div>
                        <h6 class="mb-0 fw-bold small text-uppercase tracking-wider">Tendance Détectée</h6>
                    </div>
                    <p class="text-muted small italic">"{{ ai.prediction }}"</p>
                </div>

                <div class="insight-item mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <div class="insight-icon bg-warning-subtle text-warning"><i class="bi bi-lightbulb"></i></div>
                        <h6 class="mb-0 fw-bold small text-uppercase tracking-wider">Plan d'Action</h6>
                    </div>
                    <p class="text-muted small">{{ ai.advice }}</p>
                </div>

                <div class="sentiment-meter mt-auto">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-bold">Score Sentiment</span>
                        <span class="small fw-bold text-primary">{{ ai.sentiment }}%</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 8px; background: rgba(0,0,0,0.05);">
                        <div class="progress-bar bg-gradient-primary rounded-pill" role="progressbar" style="width: {{ ai.sentiment }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Events & Types -->
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="glass-card p-4 h-100">
                <h5 class="fw-bold mb-4">Types de Réclamations</h5>
                <div style="height: 250px;">
                    <canvas id="reclamationDoughnut"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="glass-card overflow-hidden h-100">
                <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Opérations Récentes</h5>
                    <a href="{{ path('app_event_admin_new') }}" class="btn btn-primary btn-sm rounded-pill px-3">Nouveau Projet</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase tracking-wider">
                                <th class="ps-4">Événement</th>
                                <th>Date</th>
                                <th>Flux</th>
                                <th>Statut</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in recentEvents %}
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-box me-3">{{ event.title|slice(0, 1) }}</div>
                                        <div>
                                            <div class="fw-bold">{{ event.title }}</div>
                                            <div class="text-muted mini">{{ event.location }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">{{ event.date|date('d M') }}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 4px;">
                                            <div class="progress-bar bg-primary" style="width: {{ (event.participants / 50 * 100)|round }}%"></div>
                                        </div>
                                        <span class="small">{{ event.participants }}</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-status {{ event.status|lower }}">{{ event.status }}</span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-icon"><i class="bi bi-three-dots-vertical"></i></button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #4361ee;
        --primary-light: #4895ef;
        --secondary: #3f37c9;
        --success: #4cc9f0;
        --glass: rgba(255, 255, 255, 0.7);
        --glass-border: rgba(255, 255, 255, 0.3);
    }

    body {
        background-color: #f0f2f5;
        font-family: 'Outfit', sans-serif;
    }

    .text-gradient {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .text-gradient-2 {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .glass-header {
        background: var(--glass);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
    }

    .glass-card {
        background: var(--glass);
        backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        transition: transform 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-5px);
    }

    /* Pro Stat Cards */
    .pro-stat-card {
        position: relative;
        padding: 1.5rem;
        border-radius: 24px;
        overflow: hidden;
        color: white;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .pro-stat-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    .card-blue { background: linear-gradient(135deg, #4361ee, #4895ef); }
    .card-green { background: linear-gradient(135deg, #2ec4b6, #cbf3f0); color: #011627; }
    .card-purple { background: linear-gradient(135deg, #7209b7, #b5179e); }
    .card-orange { background: linear-gradient(135deg, #ff9f1c, #ffbf69); color: #011627; }

    .pro-stat-card .icon-box {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(5px);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .pro-stat-card .value {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.2rem;
    }

    .pro-stat-card .label {
        opacity: 0.8;
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 0;
    }

    .pro-stat-card .trend {
        font-size: 0.75rem;
        font-weight: 600;
    }

    .card-bg-icon {
        position: absolute;
        right: -10px;
        bottom: -10px;
        font-size: 5rem;
        opacity: 0.1;
        transform: rotate(-15deg);
    }

    /* Utilities */
    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #4cc9f0;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
        animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.5); opacity: 0.5; }
        100% { transform: scale(1); opacity: 1; }
    }

    .mini { font-size: 0.7rem; }
    
    /* Table & Badges */
    .avatar-box {
        width: 38px;
        height: 38px;
        background: var(--primary-light);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .badge-status {
        padding: 5px 12px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    .badge-status.active { background: #e7f9f3; color: #2ec4b6; }
    .badge-status.inactive { background: #fff1f2; color: #ff5d8f; }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Forecast Chart (ML Prediction)
    const forecastCtx = document.getElementById('forecastChart');
    if (forecastCtx) {
        const forecastData = {{ ai.forecast|json_encode|raw }};
        const weeks = ['Semaine 1', 'Semaine 2', 'Semaine 3', 'Semaine 4'];
        
        new Chart(forecastCtx, {
            type: 'line',
            data: {
                labels: weeks,
                datasets: [{
                    label: 'Prévision Inscriptions',
                    data: forecastData,
                    borderColor: '#4361ee',
                    backgroundColor: 'rgba(67, 97, 238, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#4361ee',
                    pointBorderColor: '#fff',
                    pointRadius: 6,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { display: false },
                        ticks: { color: '#999' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#999' }
                    }
                }
            }
        });
    }

    // 2. Reclamation Doughnut
    const doughnutCtx = document.getElementById('reclamationDoughnut');
    if (doughnutCtx) {
        const stats = {{ reclamationStats|json_encode|raw }};
        const labels = [...new Set(stats.map(s => s.type))];
        const values = labels.map(l => stats.filter(s => s.type === l).reduce((acc, c) => acc + parseInt(c.total), 0));

        new Chart(doughnutCtx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: ['#4361ee', '#4cc9f0', '#7209b7', '#ff9f1c', '#2ec4b6'],
                    borderWidth: 0,
                    borderRadius: 5,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { 
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 20 }
                    }
                },
                cutout: '75%'
            }
        });
    }
});
</script>
{% endblock %}