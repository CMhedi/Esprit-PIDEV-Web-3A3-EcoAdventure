<!DOCTYPE html>
<html lang="{% block html_lang %}fr{% endblock %}">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dashboard Admin{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('img/Hero.png') }}">
    <link href="{{ asset('vendor/bootstrap/bootstrap.min.css') }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/ecoadventure.css') }}?v=20260423">
    {% block css %}{% endblock %}
</head>
<body class="admin-body {% block body_class %}{% endblock %}">

<div class="admin-wrapper">
    {% block admin_sidebar %}
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <h4 class="fw-bold mb-0">Eco<span>Adventure</span></h4>
        </div>

        <ul class="sidebar-menu list-unstyled">
            <li><a href="{{ path('app_admin_dashboard') }}" class="{{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}"><i class="bi bi-grid"></i> Tableau de bord</a></li>
            <li>
                <a href="{{ app.user ? path('app_user_app_show', {'id_user': app.user.id_user}) : '#' }}" class="{{ app.request.get('_route') == 'app_user_app_show' ? 'active' : '' }} {{ app.user ? '' : 'disabled' }}">
                    <i class="bi bi-person-circle"></i> Mon profil
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_reclamation_index') }}" class="{{ app.request.get('_route') starts with 'app_reclamation' or app.request.get('_route') == 'app_admin_reclamation_index' ? 'active' : '' }}">
                    <i class="bi bi-exclamation-octagon"></i> Reclamations
                </a>
            </li>
            <li><a href="{{ path('app_admin_activites') }}" class="{{ app.request.get('_route') starts with 'app_admin_activites' ? 'active' : '' }}"><i class="bi bi-tree"></i> Activites</a></li>
            <li><a href="{{ path('app_admin_reservations') }}" class="{{ app.request.get('_route') == 'app_admin_reservations' ? 'active' : '' }}"><i class="bi bi-journal-check"></i> Reservations activites</a></li>
            <li><a href="{{ path('app_admin_planning') }}" class="{{ app.request.get('_route') starts with 'app_admin_planning' ? 'active' : '' }}"><i class="bi bi-journal-check"></i> Planning</a></li>
            <li><a href="{{ path('app_event_admin_index') }}" class="{{ app.request.get('_route') starts with 'app_event_admin' and app.request.get('_route') != 'app_event_admin_reservations' ? 'active' : '' }}"><i class="bi bi-calendar-event"></i> Evenements</a></li>
            <li><a href="{{ path('app_event_admin_reservations') }}" class="{{ app.request.get('_route') == 'app_event_admin_reservations' ? 'active' : '' }}"><i class="bi bi-ticket-detailed"></i> Reservations evenements</a></li>
            <li><a href="{{ path('admin_messagerie_index') }}" class="{{ app.request.get('_route') starts with 'admin_messagerie' ? 'active' : '' }}"><i class="bi bi-chat-dots"></i> Messagerie</a></li>
            <li>
                <a href="{{ path('app_user_app_index') }}" class="{{ app.request.get('_route') == 'app_user_app_index' ? 'active' : '' }}">
                    <i class="bi bi-people"></i> Utilisateurs
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_packs') }}" class="{{ app.request.get('_route') starts with 'app_admin_pack' or app.request.get('_route') == 'app_admin_packs' ? 'active' : '' }}">
                    <i class="bi bi-box-seam"></i> Packs
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_inscriptions') }}" class="{{ app.request.get('_route') starts with 'app_admin_inscription' or app.request.get('_route') == 'app_admin_inscriptions' ? 'active' : '' }}">
                    <i class="bi bi-journal-check"></i> Inscriptions
                </a>
            </li>
            <li>
                <a href="{{ path('admin_ai_dashboard') }}" class="{{ app.request.get('_route') starts with 'admin_ai' ? 'active' : '' }}">
                    <i class="bi bi-robot"></i> AI Agent Activite-Res
                </a>
            </li>
            <li>
                <a href="{{ path('app_logout') }}" class="text-danger fw-bold">
                    <i class="bi bi-box-arrow-right"></i> Deconnexion
                </a>
            </li>
        </ul>
    </aside>
    {% endblock %}

    <main class="admin-content">
        {% block admin_topbar %}
        <div class="admin-topbar d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">{% block page_title %}Dashboard{% endblock %}</h2>
                <small class="text-muted">Gestion de l'agence sportive</small>
            </div>
            <div class="admin-user">
                {% if app.user and app.user.role.value == 'ADMIN' %}
                    <a href="{{ path('app_home') }}" class="btn btn-outline-success btn-sm rounded-pill me-2">
                        <i class="bi bi-globe2 me-1"></i> Aller au Front
                    </a>
                {% endif %}
                <span class="badge text-bg-light px-3 py-2 rounded-pill">Admin</span>
            </div>
        </div>
        {% endblock %}

        <div class="row">
            <div class="col-12">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>

        {% block body %}{% endblock %}
    </main>
</div>

<div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="adminConfirmTitle">Confirmation</h5>
                    <small class="text-muted" id="adminConfirmLabel">Verifiez bien avant de continuer.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="mb-2" id="adminConfirmMessage">Voulez-vous continuer ?</p>
                <div class="small text-muted" id="adminConfirmNote"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="adminConfirmSubmit">Confirmer</button>
            </div>
        </div>
    </div>
</div>

<style>
    #adminConfirmModal .modal-content {
        border-radius: 20px;
    }

    #adminConfirmModal .modal-title {
        color: #10233f;
    }

    #adminConfirmModal .btn-danger {
        border-radius: 999px;
        padding-inline: 1.25rem;
    }

    #adminConfirmModal .btn-outline-secondary {
        border-radius: 999px;
        padding-inline: 1.25rem;
    }
</style>

<script src="{{ asset('vendor/bootstrap/bootstrap.bundle.min.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modalElement = document.getElementById('adminConfirmModal');
        if (!modalElement || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);
        const titleEl = document.getElementById('adminConfirmTitle');
        const labelEl = document.getElementById('adminConfirmLabel');
        const messageEl = document.getElementById('adminConfirmMessage');
        const noteEl = document.getElementById('adminConfirmNote');
        const submitBtn = document.getElementById('adminConfirmSubmit');
        let pendingForm = null;

        const getConfirmCopy = (form) => {
            const submitButton = form.querySelector('button[type="submit"], input[type="submit"]');
            const actionLabel = form.dataset.confirmTitle || submitButton?.title || submitButton?.textContent?.trim() || 'Confirmation';
            const rawOnsubmit = form.getAttribute('onsubmit') || '';
            const confirmMatch = rawOnsubmit.match(/confirm\('(.+?)'\)/);
            const fallbackMessage = confirmMatch ? confirmMatch[1] : 'Voulez-vous continuer cette action ?';

            return {
                title: actionLabel,
                label: form.dataset.confirmLabel || 'Action sensible',
                message: form.dataset.confirmMessage || fallbackMessage,
                note: form.dataset.confirmNote || 'Cette action peut etre irreversible.',
                confirmText: form.dataset.confirmButton || 'Confirmer',
            };
        };

        const forms = Array.from(document.querySelectorAll('form[onsubmit*="confirm"], form[data-confirm-form]'));
        forms.forEach((form) => {
            form.removeAttribute('onsubmit');
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                pendingForm = form;

                const copy = getConfirmCopy(form);
                titleEl.textContent = copy.title;
                labelEl.textContent = copy.label;
                messageEl.textContent = copy.message;
                noteEl.textContent = copy.note;
                submitBtn.textContent = copy.confirmText;

                modal.show();
            });
        });

        submitBtn.addEventListener('click', () => {
            if (!pendingForm) {
                modal.hide();
                return;
            }

            const formToSubmit = pendingForm;
            pendingForm = null;
            modal.hide();
            HTMLFormElement.prototype.submit.call(formToSubmit);
        });

        modalElement.addEventListener('hidden.bs.modal', () => {
            pendingForm = null;
        });
    });
</script>
{% block js %}{% endblock %}
{% block javascripts %}{% endblock %}
</body>
</html>
