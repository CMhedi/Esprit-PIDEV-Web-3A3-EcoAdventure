<!DOCTYPE html>
<html lang="{% block html_lang %}fr{% endblock %}">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dashboard Admin{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/ecoadventure.css') }}">
    {#<link rel="stylesheet" href="{{ asset('css/ecoadventure.css') }}">#}
</head>
<body class="admin-body {% block body_class %}{% endblock %}">

<div class="admin-wrapper">
    {% block admin_sidebar %}
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <h4 class="fw-bold mb-0">Eco<span>Adventure</span></h4>
        </div>

        <ul class="sidebar-menu list-unstyled">
            <li><a href="{{ path('app_admin_dashboard') }}" class="{{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}"><i class="bi bi-grid"></i> Tableau de bord</a></li>
            <li>
                <a href="{{ app.user ? path('app_user_app_show', {'id_user': app.user.id_user}) : '#' }}" class="{{ app.request.get('_route') == 'app_user_app_show' ? 'active' : '' }} {{ app.user ? '' : 'disabled' }}">
                    <i class="bi bi-person-circle"></i> Mon Profil
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_reclamation_index') }}" class="{{ app.request.get('_route') starts with 'app_reclamation' or app.request.get('_route') == 'app_admin_reclamation_index' ? 'active' : '' }}">
                    <i class="bi bi-exclamation-octagon"></i> Réclamations
                </a>
            </li>
            <li><a href="{{ path('app_admin_activites') }}" class="{{ app.request.get('_route') starts with 'app_admin_activites' ? 'active' : '' }}"><i class="bi bi-tree"></i> Activités</a></li>
            <li><a href="{{ path('app_admin_reservations') }}" class="{{ app.request.get('_route') == 'app_admin_reservations' ? 'active' : '' }}"><i class="bi bi-journal-check"></i> Réservations Activités</a></li>
            <li><a href="{{ path('app_admin_planning') }}" class="{{ app.request.get('_route') starts with 'app_admin_planning' ? 'active' : '' }}"><i class="bi bi-journal-check"></i> Planning</a></li>
            <li><a href="{{ path('app_event_admin_index') }}" class="{{ app.request.get('_route') starts with 'app_event_admin' and app.request.get('_route') != 'app_event_admin_reservations' ? 'active' : '' }}"><i class="bi bi-calendar-event"></i> Événements</a></li>
            <li><a href="{{ path('app_event_admin_reservations') }}" class="{{ app.request.get('_route') == 'app_event_admin_reservations' ? 'active' : '' }}"><i class="bi bi-ticket-detailed"></i> Réservations Événements</a></li>
            <li><a href="{{ path('app_admin_statistiques_event') }}" class="{{ app.request.get('_route') == 'app_admin_statistiques_event' ? 'active' : '' }}"><i class="bi bi-bar-chart"></i> Statistiques Event</a></li>
            <li><a href="{{ path('admin_messagerie_index') }}" class="{{ app.request.get('_route') starts with 'admin_messagerie' ? 'active' : '' }}"><i class="bi bi-chat-dots"></i> Messagerie</a></li>
            <li>
                <a href="{{ path('app_user_app_index') }}" class="{{ app.request.get('_route') == 'app_user_app_index' ? 'active' : '' }}">
                    <i class="bi bi-people"></i> Utilisateurs
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_packs') }}" class="{{ app.request.get('_route') starts with 'app_admin_pack' or app.request.get('_route') == 'app_admin_packs' ? 'active' : '' }}">
                    <i class="bi bi-box-seam"></i> Packs
                </a>
            </li>
            <li>
                <a href="{{ path('app_admin_inscriptions') }}" class="{{ app.request.get('_route') starts with 'app_admin_inscription' or app.request.get('_route') == 'app_admin_inscriptions' ? 'active' : '' }}">
                    <i class="bi bi-journal-check"></i> Inscriptions
                </a>
            </li>
            
            <li>
                <a href="{{ path('app_logout') }}" class="text-danger fw-bold">
                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                </a>
            </li>
        </ul>
    </aside>
    {% endblock %}

    <main class="admin-content">
        {% block admin_topbar %}
        <div class="admin-topbar d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">{% block page_title %}Dashboard{% endblock %}</h2>
                <small class="text-muted">Gestion de l'agence sportive</small>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <!-- Notification Center (Show only on Reservations page) -->
                {% if app.request.get('_route') == 'app_event_admin_reservations' %}
                <div class="dropdown" id="notificationCenter">
                    <button class="btn btn-light position-relative rounded-pill p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="notifBtn">
                        <i class="bi bi-bell fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge">
                            0
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-0 overflow-hidden" style="width: 320px;" id="notifList">
                        <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                            <h6 class="mb-0 fw-bold">Notifications</h6>
                            <button class="btn btn-sm btn-link text-decoration-none p-0" id="markAllRead">Tout marquer comme lu</button>
                        </li>
                        <div id="notifContainer" style="max-height: 400px; overflow-y: auto;">
                            <!-- Notifications injectées par JS -->
                            <li class="p-4 text-center text-muted small">Aucune notification</li>
                        </div>
                    </ul>
                </div>
                {% endif %}

                <div class="admin-user">
                    <span class="badge text-bg-light px-3 py-2 rounded-pill">Admin</span>
                </div>
            </div>
        </div>

        <!-- Notification Toasts Container -->
        <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 9999"></div>
        {% endblock %}

        <div class="row">
            <div class="col-12">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>

        {% block body %}{% endblock %}
    </main>
</div>

<div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="adminConfirmTitle">Confirmation</h5>
                    <small class="text-muted" id="adminConfirmLabel">Verifiez bien avant de continuer.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="mb-2" id="adminConfirmMessage">Voulez-vous continuer ?</p>
                <div class="small text-muted" id="adminConfirmNote"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="adminConfirmSubmit">Confirmer</button>
            </div>
        </div>
    </div>
</div>

<style>
    #adminConfirmModal .modal-content {
        border-radius: 20px;
    }

    #adminConfirmModal .modal-title {
        color: #10233f;
    }

    #adminConfirmModal .btn-danger {
        border-radius: 999px;
        padding-inline: 1.25rem;
    }

    #adminConfirmModal .btn-outline-secondary {
        border-radius: 999px;
        padding-inline: 1.25rem;
    }

    /* Notifications Styling */
    .notification-item {
        transition: background-color 0.2s ease;
        cursor: pointer;
    }
    .notification-item:hover {
        background-color: #f8f9fa;
    }
    #notifBadge {
        font-size: 0.65rem;
        padding: 0.35em 0.5em;
    }
    .toast {
        min-width: 300px;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const notifBadge = document.getElementById('notifBadge');
        const notifContainer = document.getElementById('notifContainer');
        const markAllRead = document.getElementById('markAllRead');
        const toastContainer = document.getElementById('toastContainer');

        // Only initialize JS if notification elements exist (i.e. we are on the Reservations page)
        if (notifBadge && notifContainer) {
            let knownNotifIds = new Set();
            let isFirstLoad = true;

            const showToast = (notif) => {
                const toastId = `toast-${notif.id}`;
                const toastHtml = `
                    <div id="${toastId}" class="toast border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="toast-header border-0 rounded-top-4 bg-danger text-white">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong class="me-auto">${notif.title}</strong>
                            <small class="text-white-50">À l'instant</small>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body p-3">
                            ${notif.message}
                            <div class="mt-2 pt-2 border-top">
                                <a href="{{ path('app_event_admin_reservations') }}" class="btn btn-sm btn-outline-danger rounded-pill">Voir les réservations</a>
                            </div>
                        </div>
                    </div>
                `;
                toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = document.getElementById(toastId);
                const toast = new bootstrap.Toast(toastElement, { autohide: true, delay: 10000 });
                toast.show();
            };

            const fetchNotifications = async () => {
                try {
                    const response = await fetch('{{ path('app_admin_notifications_unread') }}');
                    const data = await response.json();
                    const notifications = data.notifications;
                    const unreadCount = data.unreadCount;
                    
                    // Update badge
                    if (unreadCount > 0) {
                        notifBadge.textContent = unreadCount;
                        notifBadge.classList.remove('d-none');
                    } else {
                        notifBadge.classList.add('d-none');
                    }

                    // Render list
                    if (notifications.length === 0) {
                        notifContainer.innerHTML = '<li class="p-4 text-center text-muted small">Aucune notification</li>';
                    } else {
                        notifContainer.innerHTML = notifications.map(n => `
                            <li class="p-3 border-bottom notification-item ${n.isRead ? 'opacity-50 bg-light' : ''}" data-id="${n.id}">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-circle">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold small d-flex justify-content-between">
                                            ${n.title}
                                            ${!n.isRead ? '<span class="badge bg-primary rounded-pill" style="font-size: 0.5rem;">New</span>' : ''}
                                        </div>
                                        <div class="text-muted small mb-1">${n.message}</div>
                                        <div class="text-end" style="font-size: 0.7rem;">${n.createdAt}</div>
                                    </div>
                                </div>
                            </li>
                        `).join('');
                    }

                    // Show Toasts only for new UNREAD notifications
                    notifications.forEach(n => {
                        if (!n.isRead && !knownNotifIds.has(n.id)) {
                            knownNotifIds.add(n.id);
                            if (!isFirstLoad) {
                                showToast(n);
                            }
                        } else if (n.isRead) {
                            knownNotifIds.add(n.id);
                        }
                    });

                    isFirstLoad = false;
                } catch (error) {
                    console.error('Error fetching notifications:', error);
                }
            };

            // Mark all as read
            if (markAllRead) {
                markAllRead.addEventListener('click', async (e) => {
                    e.preventDefault();
                    try {
                        await fetch('{{ path('app_admin_notifications_read_all') }}', { method: 'POST' });
                        fetchNotifications();
                    } catch (error) {
                        console.error('Error marking all read:', error);
                    }
                });
            }

            // Polling every 10 seconds
            setInterval(fetchNotifications, 10000);
            fetchNotifications();
        }

        // Admin confirmation modal logic (pre-existing)
        const modalElement = document.getElementById('adminConfirmModal');
        if (!modalElement || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);
        const titleEl = document.getElementById('adminConfirmTitle');
        const labelEl = document.getElementById('adminConfirmLabel');
        const messageEl = document.getElementById('adminConfirmMessage');
        const noteEl = document.getElementById('adminConfirmNote');
        const submitBtn = document.getElementById('adminConfirmSubmit');
        let pendingForm = null;

        const getConfirmCopy = (form) => {
            const submitButton = form.querySelector('button[type="submit"], input[type="submit"]');
            const actionLabel = form.dataset.confirmTitle || submitButton?.title || submitButton?.textContent?.trim() || 'Confirmation';
            const rawOnsubmit = form.getAttribute('onsubmit') || '';
            const confirmMatch = rawOnsubmit.match(/confirm\('(.+?)'\)/);
            const fallbackMessage = confirmMatch ? confirmMatch[1] : 'Voulez-vous continuer cette action ?';

            return {
                title: actionLabel,
                label: form.dataset.confirmLabel || 'Action sensible',
                message: form.dataset.confirmMessage || fallbackMessage,
                note: form.dataset.confirmNote || 'Cette action peut etre irreversible.',
                confirmText: form.dataset.confirmButton || 'Confirmer',
            };
        };

        const forms = Array.from(document.querySelectorAll('form[onsubmit*="confirm"], form[data-confirm-form]'));
        forms.forEach((form) => {
            form.removeAttribute('onsubmit');
            form.addEventListener('submit', (event) => {
                event.preventDefault();
                pendingForm = form;

                const copy = getConfirmCopy(form);
                titleEl.textContent = copy.title;
                labelEl.textContent = copy.label;
                messageEl.textContent = copy.message;
                noteEl.textContent = copy.note;
                submitBtn.textContent = copy.confirmText;

                modal.show();
            });
        });

        submitBtn.addEventListener('click', () => {
            if (!pendingForm) {
                modal.hide();
                return;
            }

            const formToSubmit = pendingForm;
            pendingForm = null;
            modal.hide();
            HTMLFormElement.prototype.submit.call(formToSubmit);
        });

        modalElement.addEventListener('hidden.bs.modal', () => {
            pendingForm = null;
        });
    });
</script>
{% block js %}{% endblock %}
{% block javascripts %}{% endblock %}
</body>
</html>
