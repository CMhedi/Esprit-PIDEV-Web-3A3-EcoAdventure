{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion Réservations{% endblock %}
{% block page_title %}Réservations Activités{% endblock %}

{% block body %}
<div class="admin-card">
    <h4 class="fw-bold mb-4">Liste des Réservations</h4>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Activité</th>
                    <th>Utilisateur</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Personnes</th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservations %}
                    <tr>
                        <td>{{ reservation.activite.nom }}</td>
                        <td>{{ reservation.userApp.nom }}</td>
                        <td>{{ reservation.dateRes|date('Y-m-d H:i') }}</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                {{ reservation.statutRes.value }}
                            </span>
                        </td>
                        <td>{{ reservation.nbPersonnes }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}