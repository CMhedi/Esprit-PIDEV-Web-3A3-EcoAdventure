
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Churn Dashboard{% endblock %}

{% block page_title %}
📊 Prédiction de Churn
{% endblock %}

{% block body %}

<!-- ===== STATS CARDS ===== -->
<div class="row mb-5 g-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border-top: 5px solid #3498db;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-people-fill me-1" style="color: #3498db;"></i>
                            Total Utilisateurs
                        </small>
                        <h2 class="mb-0 fw-bold" style="color: #3498db;">{{ stats.total_users }}</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.1; color: #3498db;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border-top: 5px solid #e74c3c;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-exclamation-circle-fill me-1" style="color: #e74c3c;"></i>
                            Risque Élevé
                        </small>
                        <h2 class="mb-0 fw-bold" style="color: #e74c3c;">{{ stats.high_risk }}</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.1; color: #e74c3c;">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border-top: 5px solid #f39c12;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-exclamation-circle me-1" style="color: #f39c12;"></i>
                            Risque Moyen
                        </small>
                        <h2 class="mb-0 fw-bold" style="color: #f39c12;">{{ stats.medium_risk }}</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.1; color: #f39c12;">
                        <i class="bi bi-dash-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border-top: 5px solid #27ae60;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <small class="text-muted d-block mb-1">
                            <i class="bi bi-check-circle-fill me-1" style="color: #27ae60;"></i>
                            Faible Risque
                        </small>
                        <h2 class="mb-0 fw-bold" style="color: #27ae60;">{{ stats.low_risk }}</h2>
                    </div>
                    <div style="font-size: 2.5rem; opacity: 0.1; color: #27ae60;">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== ACTION BAR ===== -->
<div class="card shadow-sm border-0 rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <button id="predictBtn" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm" 
                style="background: linear-gradient(135deg, #3498db 0%, #2980b9 100%); border: none; transition: all 0.3s ease;">
            <i class="bi bi-arrow-clockwise me-2"></i> Recalculer les prédictions
        </button>
        
        <div class="d-flex gap-2">
            <small class="text-muted fw-bold d-flex align-items-center">
                <i class="bi bi-info-circle me-1"></i>
                Mis à jour: <span id="lastUpdate" class="ms-1" style="color: #27ae60;">juste à l'instant</span>
            </small>
        </div>
    </div>
</div>

<!-- ===== CHART ===== -->
<div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
    <h5 class="mb-4 fw-bold" style="color: #2c3e50;">
        <i class="bi bi-pie-chart-fill me-2" style="color: #3498db;"></i>
        Distribution des Risques
    </h5>
    <canvas id="churnChart" style="max-height: 300px;"></canvas>
</div>

<!-- ===== FILTRES ET RECHERCHE ===== -->
<div class="card shadow-sm border-0 rounded-4 p-4 mb-4">
    <h5 class="mb-3 fw-bold" style="color: #2c3e50;">
        <i class="bi bi-funnel me-2"></i>
        Recherche & Filtres
    </h5>

    <div class="row g-3">
        <!-- Recherche -->
        <div class="col-md-4">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-white border-end-0" style="border: 2px solid #ecf0f1;">
                    <i class="bi bi-search" style="color: #3498db;"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0" 
                       placeholder="Rechercher par email..." 
                       style="border: 2px solid #ecf0f1; padding: 0.75rem;">
            </div>
        </div>

        <!-- Filtre Risque -->
        <div class="col-md-3">
            <select id="riskFilter" class="form-select form-select-lg" style="border: 2px solid #ecf0f1; padding: 0.75rem;">
                <option value="">Tous les risques</option>
                <option value="high">🔴 Risque Élevé</option>
                <option value="medium">🟠 Risque Moyen</option>
                <option value="low">🟢 Faible Risque</option>
            </select>
        </div>

        <!-- Tri -->
        <div class="col-md-3">
            <select id="sortSelect" class="form-select form-select-lg" style="border: 2px solid #ecf0f1; padding: 0.75rem;">
                <option value="risk-desc">Risque décroissant</option>
                <option value="risk-asc">Risque croissant</option>
                <option value="prob-desc">Probabilité ↓</option>
                <option value="prob-asc">Probabilité ↑</option>
                <option value="date-desc">Plus récent</option>
                <option value="date-asc">Plus ancien</option>
            </select>
        </div>

        <!-- Bouton Reset -->
        <div class="col-md-2 d-flex">
            <button id="resetBtn" class="btn btn-outline-secondary w-100 rounded-3 fw-bold" 
                    style="border: 2px solid #ecf0f1;">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
            </button>
        </div>
    </div>
</div>

<!-- ===== TABLE UTILISATEURS ===== -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header p-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-bottom: 2px solid #ecf0f1;">
        <h5 class="mb-0 fw-bold" style="color: #2c3e50;">
            <i class="bi bi-table me-2" style="color: #3498db;"></i>
            Utilisateurs à Risque
            <span id="resultCount" class="badge bg-info ms-2">{{ users|length }}</span>
        </h5>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background: #f8f9fa; border-bottom: 2px solid #ecf0f1;">
                <tr>
                    <th style="color: #7f8c8d; font-weight: 600; padding: 1rem;">
                        <i class="bi bi-hash me-1"></i> ID
                    </th>
                    <th style="color: #7f8c8d; font-weight: 600; padding: 1rem;">
                        <i class="bi bi-envelope me-1"></i> Email
                    </th>
                    <th style="color: #7f8c8d; font-weight: 600; padding: 1rem;">
                        <i class="bi bi-percent me-1"></i> Probabilité
                    </th>
                    <th style="color: #7f8c8d; font-weight: 600; padding: 1rem;">
                        <i class="bi bi-shield-exclamation me-1"></i> Statut Risque
                    </th>
                    <th style="color: #7f8c8d; font-weight: 600; padding: 1rem;">
                        <i class="bi bi-calendar-event me-1"></i> Dernière Prédiction
                    </th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                {% for user in users %}
                    <tr class="user-row" data-risk="{{ user.churnRisk }}" data-prob="{{ user.churnProbability }}" 
                        data-email="{{ user.email|lower }}" data-date="{{ user.lastPredictionAt ? user.lastPredictionAt|date('Y-m-d H:i') : '' }}"
                        style="transition: all 0.2s ease;">
                        <td>
                            <strong style="color: #2c3e50;">{{ user.id }}</strong>
                        </td>
                        <td>
                            <div>
                                <strong style="color: #2c3e50;">{{ user.email }}</strong>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 50px; height: 8px; background: #ecf0f1; border-radius: 10px; overflow: hidden;">
                                    {% set prob = (user.churnProbability * 100)|round(1) %}
                                    {% if prob > 70 %}
                                        {% set color = '#e74c3c' %}
                                    {% elseif prob > 40 %}
                                        {% set color = '#f39c12' %}
                                    {% else %}
                                        {% set color = '#27ae60' %}
                                    {% endif %}
                                    <div style="width: {{ prob }}%; height: 100%; background: {{ color }}; transition: width 0.3s ease;"></div>
                                </div>
                                <strong style="color: #2c3e50; min-width: 50px;">{{ prob }}%</strong>
                            </div>
                        </td>
                        <td>
                            {% if user.churnRisk == 'high' %}
                                <span class="badge bg-danger rounded-3 px-3 py-2" style="font-weight: 600; font-size: 0.85rem;">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i> Élevé
                                </span>
                            {% elseif user.churnRisk == 'medium' %}
                                <span class="badge bg-warning text-dark rounded-3 px-3 py-2" style="font-weight: 600; font-size: 0.85rem;">
                                    <i class="bi bi-exclamation-circle me-1"></i> Moyen
                                </span>
                            {% else %}
                                <span class="badge bg-success rounded-3 px-3 py-2" style="font-weight: 600; font-size: 0.85rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i> Faible
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <small style="color: #7f8c8d;">
                                <i class="bi bi-clock me-1"></i>
                                {{ user.lastPredictionAt ? user.lastPredictionAt|date('d/m/Y H:i') : '—' }}
                            </small>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Message vide -->
    <div id="emptyState" class="d-none text-center py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; color: #bdc3c7;"></i>
        <p class="text-muted mt-3 fw-bold">Aucun utilisateur ne correspond aux critères</p>
    </div>
</div>

{% endblock %}

{% block js %}

<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
console.log('🚀 Dashboard JS loaded');

// ===== CHART SETUP =====
const ctx = document.getElementById('churnChart');

if (ctx) {
    const churnChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['🔴 Risque Élevé', '🟠 Risque Moyen', '🟢 Faible Risque'],
            datasets: [{
                data: [
                    {{ stats.high_risk }},
                    {{ stats.medium_risk }},
                    {{ stats.low_risk }}
                ],
                backgroundColor: ['#e74c3c', '#f39c12', '#27ae60'],
                borderColor: '#fff',
                borderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        padding: 20,
                        font: { size: 12, weight: 600 }
                    }
                }
            }
        }
    });
}

// ===== DOM ELEMENTS =====
const searchInput = document.getElementById('searchInput');
const riskFilter = document.getElementById('riskFilter');
const sortSelect = document.getElementById('sortSelect');
const resetBtn = document.getElementById('resetBtn');
const resultCount = document.getElementById('resultCount');
const emptyState = document.getElementById('emptyState');
const usersTableBody = document.getElementById('usersTableBody');
const predictBtn = document.getElementById('predictBtn');

// ===== VÉRIFIER QUE LES ÉLÉMENTS EXISTENT =====
if (!searchInput || !riskFilter || !sortSelect) {
    console.error('❌ Les éléments de filtrage ne sont pas trouvés !');
}

// ===== STOCKER TOUTES LES LIGNES =====
const allRows = Array.from(document.querySelectorAll('.user-row'));
console.log(`📊 ${allRows.length} utilisateurs trouvés`);

// ===== FONCTION DE FILTRAGE ET TRI =====
function filterAndSort() {
    try {
        const searchTerm = (searchInput?.value || '').toLowerCase().trim();
        const riskValue = riskFilter?.value || '';
        const sortValue = sortSelect?.value || 'risk-desc';

        console.log(`🔍 Filtrage: search="${searchTerm}", risk="${riskValue}", sort="${sortValue}"`);

        // Copier les lignes
        let rows = [...allRows];

        // ===== FILTRER =====
        rows = rows.filter(row => {
            const email = row.getAttribute('data-email') || '';
            const risk = row.getAttribute('data-risk') || '';

            const matchSearch = !searchTerm || email.includes(searchTerm);
            const matchRisk = !riskValue || risk === riskValue;

            return matchSearch && matchRisk;
        });

        console.log(`✅ ${rows.length} résultats après filtrage`);

        // ===== TRIER =====
        rows.sort((a, b) => {
            try {
                const probA = parseFloat(a.getAttribute('data-prob')) || 0;
                const probB = parseFloat(b.getAttribute('data-prob')) || 0;

                const riskOrder = { high: 3, medium: 2, low: 1 };
                const riskA = riskOrder[a.getAttribute('data-risk')] || 0;
                const riskB = riskOrder[b.getAttribute('data-risk')] || 0;

                switch (sortValue) {
                    case 'risk-desc':
                        return riskB - riskA;
                    case 'risk-asc':
                        return riskA - riskB;
                    case 'prob-desc':
                        return probB - probA;
                    case 'prob-asc':
                        return probA - probB;
                    case 'date-desc': {
                        const dateA = new Date(a.getAttribute('data-date') || 0);
                        const dateB = new Date(b.getAttribute('data-date') || 0);
                        return dateB - dateA;
                    }
                    case 'date-asc': {
                        const dateA = new Date(a.getAttribute('data-date') || 0);
                        const dateB = new Date(b.getAttribute('data-date') || 0);
                        return dateA - dateB;
                    }
                    default:
                        return 0;
                }
            } catch (e) {
                console.error('Erreur tri:', e);
                return 0;
            }
        });

        // ===== AFFICHER RÉSULTATS =====
        if (usersTableBody) {
            usersTableBody.innerHTML = '';

            if (rows.length === 0) {
                if (emptyState) emptyState.classList.remove('d-none');
            } else {
                if (emptyState) emptyState.classList.add('d-none');
                rows.forEach(row => {
                    const clonedRow = row.cloneNode(true);
                    usersTableBody.appendChild(clonedRow);
                });
            }
        }

        // ===== METTRE À JOUR LE COMPTEUR =====
        if (resultCount) {
            resultCount.textContent = rows.length;
        }

    } catch (error) {
        console.error('❌ Erreur dans filterAndSort:', error);
    }
}

// ===== EVENT LISTENERS =====
if (searchInput) {
    searchInput.addEventListener('keyup', filterAndSort);
    console.log('✅ Listener ajouté: searchInput');
}

if (riskFilter) {
    riskFilter.addEventListener('change', filterAndSort);
    console.log('✅ Listener ajouté: riskFilter');
}

if (sortSelect) {
    sortSelect.addEventListener('change', filterAndSort);
    console.log('✅ Listener ajouté: sortSelect');
}

if (resetBtn) {
    resetBtn.addEventListener('click', () => {
        console.log('🔄 Réinitialisation des filtres');
        if (searchInput) searchInput.value = '';
        if (riskFilter) riskFilter.value = '';
        if (sortSelect) sortSelect.value = 'risk-desc';
        filterAndSort();
    });
    console.log('✅ Listener ajouté: resetBtn');
}

// ===== RECALCULER PRÉDICTIONS =====
if (predictBtn) {
    predictBtn.addEventListener('click', function() {
        console.log('📊 Recalcul des prédictions...');
        
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Calcul en cours...';
        this.disabled = true;

        fetch('/admin/api/churn/predict-all', { 
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
            .then(res => {
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return res.json();
            })
            .then(data => {
                console.log('✅ Prédictions mises à jour:', data);
                if (document.getElementById('lastUpdate')) {
                    document.getElementById('lastUpdate').textContent = 'à l\'instant';
                }
                setTimeout(() => location.reload(), 1500);
            })
            .catch(err => {
                console.error('❌ Erreur:', err);
                alert('❌ Erreur lors du calcul !');
                this.innerHTML = '<i class="bi bi-arrow-clockwise me-2"></i> Recalculer les prédictions';
                this.disabled = false;
            });
    });
    console.log('✅ Listener ajouté: predictBtn');
}

// ===== HOVER EFFECTS =====
document.querySelectorAll('.user-row').forEach(row => {
    row.addEventListener('mouseenter', function() {
        this.style.backgroundColor = '#f8faf9';
    });
    row.addEventListener('mouseleave', function() {
        this.style.backgroundColor = 'transparent';
    });
});

// ===== ANIMATION BOUTON =====
if (predictBtn) {
    predictBtn.addEventListener('mouseenter', function() {
        this.style.boxShadow = '0 6px 20px rgba(52, 152, 219, 0.3)';
        this.style.transform = 'translateY(-2px)';
    });

    predictBtn.addEventListener('mouseleave', function() {
        this.style.boxShadow = '';
        this.style.transform = '';
    });
}

console.log('✅ Dashboard JS initialisé');
</script>

<style>
    /* Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .user-row {
        animation: fadeIn 0.3s ease;
    }

    /* Focus inputs */
    .form-control:focus,
    .form-select:focus {
        border-color: #3498db !important;
        box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25) !important;
    }

    /* Smooth transitions */
    .table-responsive {
        transition: all 0.3s ease;
    }

    .btn {
        transition: all 0.3s ease !important;
    }
</style>

{% endblock %}