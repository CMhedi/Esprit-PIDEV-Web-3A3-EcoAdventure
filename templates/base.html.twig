<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}EcoAdventure{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('assets/css/ecoadventure.css') }}">

    {% block css %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top custom-navbar">
    <div class="container">
        <a class="navbar-brand fw-bold brand-text" href="{{ path('app_home') }}">
            <i class="bi bi-tree-fill me-2"></i>Eco<span>Adventure</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_events') }}">Evenements</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_activitefront') }}">Activite</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_packs') }}">Packs</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Coachs</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
            </ul>

<div class="d-flex align-items-center gap-3">
    <div class="position-relative me-2">
        <a href="{{ app.user ? path('app_messagerie_open') : path('app_login') }}" class="btn btn-link text-success fs-4 p-0 border-0 text-decoration-none" title="Ouvrir la messagerie">
            <i class="bi bi-chat-text-fill"></i>
            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
        </a>
    </div>

    {% if app.user %}
        <div class="dropdown">
            <a class="btn btn-light rounded-pill dropdown-toggle d-flex align-items-center gap-2 border shadow-sm" 
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-5 text-success"></i>
                <span class="fw-semibold">{{ app.user.prenom }}</span>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li>
                    <a class="dropdown-item py-2" href="{{ path('app_profile_index') }}">
                        <i class="bi bi-person me-2"></i>Mon Profil
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-2"></i>Deconnexion
                    </a>
                </li>
            </ul>
        </div>
    {% else %}
        <a href="{{ path('app_login') }}" class="btn btn-outline-success rounded-pill px-4 fw-semibold">
            Connexion
        </a>
        <a href="{{ path('app_register') }}" class="btn btn-eco rounded-pill px-4 fw-semibold text-white">
            S'inscrire
        </a>
    {% endif %}
</div>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

<footer class="footer-eco text-white mt-5">
    <div class="footer-overlay py-5">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-lg-4">
                    <h4 class="fw-bold">EcoAdventure</h4>
                    <p>
                        Votre agence d'activites et d'evenements sportifs en pleine nature.
                    </p>
                </div>
                <div class="col-lg-4">
                    <h5>Liens utiles</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_events') }}">Evenements</a></li>
                        <li><a href="{{ path('app_packs') }}">Packs</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>Suivez-nous</h5>
                    <div class="d-flex gap-3 fs-4">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block js %}{% endblock %}
</body>
</html>