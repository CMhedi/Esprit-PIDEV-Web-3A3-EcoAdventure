 url=https://github.com/Sabrix33/ecotrack
{% extends 'base.html.twig' %}

{% block title %}Calcul IMC & Nutrition API - EcoTrack{% endblock %}

{% block content %}
<div class="admin-body">
    <div class="admin-wrapper">
        {% include 'components/sidebar.html.twig' %}

        <div class="admin-content">
            <!-- HEADER -->
            <div class="admin-topbar mb-4">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="mb-0">
                            <i class="bi bi-calculator me-2" style="color: var(--energy-orange);"></i>
                            Calcul IMC & Nutrition API
                        </h2>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- ===== COLONNE 1: CALCUL IMC ===== -->
                <div class="col-lg-6">
                    <div class="admin-card">
                        <h5 class="mb-4">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Calculer votre IMC
                        </h5>

                        <form id="imcForm">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Poids (kg)</label>
                                <input type="number" class="form-control" id="weightInput" placeholder="75" step="0.1" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Taille (cm)</label>
                                <input type="number" class="form-control" id="heightInput" placeholder="175" step="0.1" required>
                            </div>

                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold">Âge</label>
                                    <input type="number" class="form-control" id="ageInput" placeholder="30" required>
                                </div>

                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold">Genre</label>
                                    <select class="form-select" id="genderInput" required>
                                        <option value="M">Homme</option>
                                        <option value="F">Femme</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Niveau Activité</label>
                                <select class="form-select" id="activityInput" required>
                                    <option value="1.2">Sédentaire</option>
                                    <option value="1.375">Peu actif</option>
                                    <option value="1.55" selected>Modérément actif</option>
                                    <option value="1.725">Très actif</option>
                                    <option value="1.9">Extrêmement actif</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-eco w-100 py-2">
                                <i class="bi bi-calculator me-2"></i> Calculer IMC
                            </button>
                        </form>

                        <!-- RÉSULTATS IMC -->
                        <div id="imcResult" class="d-none mt-4">
                            <div class="alert" id="imcAlert" role="alert">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <h4 id="imcValue" class="mb-1">--</h4>
                                        <p id="imcCategory" class="mb-0 fw-bold"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="card border-light">
                                <div class="card-body">
                                    <p id="imcRemark" class="text-muted small mb-3"></p>

                                    <hr>

                                    <div class="row text-center">
                                        <div class="col-6">
                                            <small class="text-muted d-block">Poids Idéal</small>
                                            <strong id="idealWeightMin">--</strong> - <strong id="idealWeightMax">--</strong> <span class="small">kg</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">BMR</small>
                                            <strong id="bmrValue">--</strong> <span class="small">kcal/jour</span>
                                        </div>
                                    </div>

                                    <hr>

                                    <div>
                                        <small class="text-muted d-block mb-2">TDEE (Dépense Énergétique)</small>
                                        <strong id="tdeeValue" class="d-block">--</strong> <span class="small text-muted">kcal/jour</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RECOMMANDATIONS IMC -->
                    <div id="imcRecommendations" class="d-none mt-4">
                        <div class="admin-card">
                            <h5 class="mb-3">
                                <i class="bi bi-lightbulb me-2"></i>
                                Recommandations Personnalisées
                            </h5>

                            <div id="recommendationsContent"></div>
                        </div>
                    </div>
                </div>

                <!-- ===== COLONNE 2: RECHERCHE ALIMENTS API ===== -->
                <div class="col-lg-6">
                    <div class="admin-card">
                        <h5 class="mb-4">
                            <i class="bi bi-search me-2"></i>
                            Rechercher Nutrition Aliment
                        </h5>

                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="ingredientSearch" placeholder="Entrez un aliment (ex: pomme, poulet...)">
                            <button class="btn btn-eco" type="button" id="searchBtn">
                                <i class="bi bi-search"></i> Chercher
                            </button>
                        </div>

                        <!-- RÉSULTATS RECHERCHE -->
                        <div id="searchLoading" class="d-none text-center">
                            <div class="spinner-border spinner-border-sm text-eco" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                        </div>

                        <div id="searchResults" class="d-none">
                            <!-- Résultats ici -->
                        </div>

                        <!-- COMPARAISON ALIMENTS -->
                        <div class="mt-4 pt-4 border-top">
                            <h6 class="mb-3">
                                <i class="bi bi-shuffle me-2"></i>
                                Comparer 2 Aliments
                            </h6>

                            <div class="mb-2">
                                <input type="text" class="form-control form-control-sm mb-2" id="ingredient1" placeholder="Aliment 1 (ex: poulet)">
                                <input type="text" class="form-control form-control-sm" id="ingredient2" placeholder="Aliment 2 (ex: tofu)">
                            </div>

                            <button class="btn btn-outline-eco w-100 btn-sm" id="compareBtn">
                                <i class="bi bi-shuffle me-1"></i> Comparer
                            </button>

                            <div id="comparisonResult" class="d-none mt-3"></div>
                        </div>
                    </div>

                    <!-- RECOMMANDATIONS JOURNALIÈRES -->
                    <div id="dailyRecommendations" class="d-none admin-card mt-4">
                        <h5 class="mb-3">
                            <i class="bi bi-calendar-check me-2"></i>
                            Recommandations Journalières
                        </h5>

                        <div id="dailyRecContent"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
// ===== CALCUL IMC =====
document.getElementById('imcForm').addEventListener('submit', function(e) {
    e.preventDefault();
    calculateIMC();
});

function calculateIMC() {
    const weight = parseFloat(document.getElementById('weightInput').value);
    const height = parseFloat(document.getElementById('heightInput').value);
    const age = parseInt(document.getElementById('ageInput').value);
    const gender = document.getElementById('genderInput').value;
    const activity = parseFloat(document.getElementById('activityInput').value);

    fetch('{{ path("nutrition_imc_dashboard") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            weight: weight,
            height: height,
            age: age,
            gender: gender,
            activity_level: activity
        })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            displayIMCResults(data);
            displayRecommendations(data.recommendations);
            displayDailyRecommendations(data);
        } else {
            alert('❌ Erreur: ' + data.error);
        }
    })
    .catch(e => alert('Erreur: ' + e.message));
}

function displayIMCResults(data) {
    const imc = data.imc;
    const analysis = data.analysis;
    const ideal = data.ideal_weight;
    const bmr = data.bmr;
    const tdee = data.tdee;

    // IMC Value
    document.getElementById('imcValue').textContent = imc;
    document.getElementById('imcCategory').textContent = analysis.category;
    document.getElementById('imcRemark').textContent = analysis.remark;

    // Alert Color
    const alert = document.getElementById('imcAlert');
    let alertClass = 'alert-success';
    if (analysis.severity === 'warning') alertClass = 'alert-warning';
    else if (analysis.severity === 'danger') alertClass = 'alert-danger';
    else if (analysis.severity === 'critical') alertClass = 'alert-dark border border-danger';

    alert.className = 'alert ' + alertClass;

    // Ideal Weight
    document.getElementById('idealWeightMin').textContent = ideal.min;
    document.getElementById('idealWeightMax').textContent = ideal.max;

    // BMR & TDEE
    document.getElementById('bmrValue').textContent = bmr;
    document.getElementById('tdeeValue').textContent = tdee;

    document.getElementById('imcResult').classList.remove('d-none');
}

function displayRecommendations(recommendations) {
    let html = '';

    if (recommendations.nutrition && recommendations.nutrition.length > 0) {
        html += '<h6 class="mb-2">🥗 Nutrition</h6>';
        html += '<ul class="small">';
        recommendations.nutrition.forEach(r => {
            html += `<li>${r}</li>`;
        });
        html += '</ul>';
    }

    if (recommendations.exercise && recommendations.exercise.length > 0) {
        html += '<h6 class="mb-2 mt-3">💪 Exercice</h6>';
        html += '<ul class="small">';
        recommendations.exercise.forEach(r => {
            html += `<li>${r}</li>`;
        });
        html += '</ul>';
    }

    if (recommendations.lifestyle && recommendations.lifestyle.length > 0) {
        html += '<h6 class="mb-2 mt-3">😴 Style de Vie</h6>';
        html += '<ul class="small">';
        recommendations.lifestyle.forEach(r => {
            html += `<li>${r}</li>`;
        });
        html += '</ul>';
    }

    document.getElementById('recommendationsContent').innerHTML = html;
    document.getElementById('imcRecommendations').classList.remove('d-none');
}

function displayDailyRecommendations(data) {
    const rec = data.recommendations;
    
    let html = `
        <div class="row text-center">
            <div class="col-6 mb-3">
                <div class="p-2 bg-light rounded">
                    <small class="text-muted d-block">Calories</small>
                    <strong class="d-block" style="font-size: 1.3rem;">${data.tdee}</strong>
                    <span class="small text-muted">kcal/jour</span>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="p-2 bg-light rounded">
                    <small class="text-muted d-block">Protéines</small>
                    <strong class="d-block" style="font-size: 1.3rem;">${rec.protein || 0}</strong>
                    <span class="small text-muted">g/jour</span>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="p-2 bg-light rounded">
                    <small class="text-muted d-block">Glucides</small>
                    <strong class="d-block" style="font-size: 1.3rem;">${rec.carbs || 0}</strong>
                    <span class="small text-muted">g/jour</span>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="p-2 bg-light rounded">
                    <small class="text-muted d-block">Graisses</small>
                    <strong class="d-block" style="font-size: 1.3rem;">${rec.fat || 0}</strong>
                    <span class="small text-muted">g/jour</span>
                </div>
            </div>
        </div>
    `;

    document.getElementById('dailyRecContent').innerHTML = html;
    document.getElementById('dailyRecommendations').classList.remove('d-none');
}

// ===== RECHERCHE ALIMENTS =====
document.getElementById('searchBtn').addEventListener('click', searchIngredient);

function searchIngredient() {
    const query = document.getElementById('ingredientSearch').value;

    if (!query || query.length < 2) {
        alert('Entrez au moins 2 caractères');
        return;
    }

    document.getElementById('searchLoading').classList.remove('d-none');
    document.getElementById('searchResults').classList.add('d-none');

    fetch(`{{ path("nutrition_search") }}?q=${encodeURIComponent(query)}`)
        .then(r => r.json())
        .then(data => {
            displaySearchResults(data.results || []);
        })
        .catch(e => {
            alert('Erreur: ' + e.message);
        })
        .finally(() => {
            document.getElementById('searchLoading').classList.add('d-none');
        });
}

function displaySearchResults(results) {
    let html = '';

    if (results.length === 0) {
        html = '<p class="text-muted text-center">Aucun résultat trouvé</p>';
    } else {
        results.forEach(result => {
            html += `
                <div class="card mb-2 border-light">
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">${result.name || result.original}</h6>
                                <small class="text-muted">${result.aisle || 'Aliment'}</small>
                            </div>
                            <button class="btn btn-sm btn-eco" onclick="getNutrition('${result.name || result.original}')">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        });
    }

    document.getElementById('searchResults').innerHTML = html;
    document.getElementById('searchResults').classList.remove('d-none');
}

function getNutrition(ingredient) {
    fetch(`{{ path("nutrition_api_get") }}?ingredient=${encodeURIComponent(ingredient)}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const nut = data.nutrition;
                alert(`✅ ${data.ingredient}\n\nCalories: ${nut.calories} kcal\nProtéines: ${nut.protein}g\nGraisses: ${nut.fat}g\nGlucides: ${nut.carbs}g`);
            }
        })
        .catch(e => alert('Erreur: ' + e.message));
}

// ===== COMPARAISON ALIMENTS =====
document.getElementById('compareBtn').addEventListener('click', compareIngredients);

function compareIngredients() {
    const ing1 = document.getElementById('ingredient1').value;
    const ing2 = document.getElementById('ingredient2').value;

    if (!ing1 || !ing2) {
        alert('Entrez 2 aliments à comparer');
        return;
    }

    fetch(`{{ path("nutrition_compare") }}?ingredient1=${encodeURIComponent(ing1)}&ingredient2=${encodeURIComponent(ing2)}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                displayComparison(data.comparison);
            }
        })
        .catch(e => alert('Erreur: ' + e.message));
}

function displayComparison(comp) {
    const ing1 = comp.ingredient1;
    const ing2 = comp.ingredient2;
    const healthier = comp.comparison.healthier === 'ingredient1' ? ing1.name : ing2.name;

    let html = `
        <div class="table-responsive">
            <table class="table table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Nutriment</th>
                        <th>${ing1.name}</th>
                        <th>${ing2.name}</th>
                        <th>Différence</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Calories</strong></td>
                        <td>${ing1.nutrition.calories} kcal</td>
                        <td>${ing2.nutrition.calories} kcal</td>
                        <td>${(comp.comparison.calories_diff).toFixed(1)} ${comp.comparison.calories_diff > 0 ? '↑' : '↓'}</td>
                    </tr>
                    <tr>
                        <td><strong>Protéines</strong></td>
                        <td>${ing1.nutrition.protein}g</td>
                        <td>${ing2.nutrition.protein}g</td>
                        <td>${(comp.comparison.protein_diff).toFixed(1)}g ${comp.comparison.protein_diff > 0 ? '✅' : ''}</td>
                    </tr>
                    <tr>
                        <td><strong>Graisses</strong></td>
                        <td>${ing1.nutrition.fat}g</td>
                        <td>${ing2.nutrition.fat}g</td>
                        <td>${(comp.comparison.fat_diff).toFixed(1)}g</td>
                    </tr>
                    <tr>
                        <td><strong>Glucides</strong></td>
                        <td>${ing1.nutrition.carbs}g</td>
                        <td>${ing2.nutrition.carbs}g</td>
                        <td>${(comp.comparison.carbs_diff).toFixed(1)}g</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="alert alert-success mt-2">
            <strong>✅ Plus sain: ${healthier}</strong>
        </div>
    `;

    document.getElementById('comparisonResult').innerHTML = html;
    document.getElementById('comparisonResult').classList.remove('d-none');
}
</script>

{% endblock %}