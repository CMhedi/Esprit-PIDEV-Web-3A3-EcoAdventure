{# templates/profile/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Profil - EcoAdventure{% endblock %}

{% block css %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

        :root {
            --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --glass-bg: rgba(255, 255, 255, 0.75);
            --glass-border: rgba(255, 255, 255, 0.5);
            --text-dark: #1e293b;
            --accent-blue: #3a7bd5;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            margin: 0;
            color: var(--text-dark);
        }

        .profile-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: rgba(0,0,0,0.2);
        }

        .profile-container {
            width: 100%;
            max-width: 900px;
            background: var(--glass-bg);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--glass-border);
            border-radius: 40px;
            box-shadow: 0 40px 80px rgba(0,0,0,0.3);
            overflow: hidden;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .header-cover {
            height: 180px;
            background: var(--primary-gradient);
            position: relative;
        }

        .avatar-box {
            position: absolute;
            bottom: -70px;
            left: 50px;
            z-index: 5;
        }

        .avatar-img {
            width: 160px; height: 160px;
            border-radius: 35px;
            border: 6px solid white;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            object-fit: cover;
            background: white;
            transition: 0.4s;
        }

        .avatar-img:hover { transform: rotate(3deg) scale(1.05); }

        .profile-body {
            padding: 90px 50px 50px 50px;
        }

        .name-area { margin-bottom: 30px; }
        .user-full-name { font-weight: 800; font-size: 2.8rem; margin: 0; letter-spacing: -1px; color: #0f172a; }
        
        .badge-premium {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 20px; background: white; border-radius: 15px;
            font-weight: 700; color: var(--accent-blue); font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-top: 10px;
        }

        /* Widgets Grid */
        .widgets-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; margin-bottom: 40px;
        }

        .widget-card {
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid var(--glass-border);
            padding: 25px; border-radius: 28px; transition: 0.3s;
            text-align: center;
        }

        .widget-card:hover { background: white; transform: translateY(-8px); box-shadow: 0 20px 30px rgba(0,0,0,0.05); }

        .widget-icon {
            font-size: 1.8rem; margin-bottom: 15px; display: inline-block;
            background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .widget-val { display: block; font-size: 1.6rem; font-weight: 800; color: #1e293b; }
        .widget-lab { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }

        /* Content Sections */
        .info-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; }

        .section-title { font-weight: 700; font-size: 1.2rem; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; }
        .section-title i { color: var(--accent-blue); }

        .detail-row {
            background: rgba(255, 255, 255, 0.4);
            padding: 18px 25px; border-radius: 20px; margin-bottom: 15px;
            display: flex; justify-content: space-between; align-items: center;
            border: 1px solid transparent; transition: 0.3s;
        }
        .detail-row:hover { border-color: var(--accent-blue); background: white; }

        .detail-label { font-weight: 600; color: #64748b; font-size: 0.9rem; }
        .detail-value { font-weight: 700; color: #1e293b; }

        /* Action Buttons */
        .actions-footer {
            margin-top: 40px; padding-top: 30px; border-top: 1px solid rgba(0,0,0,0.05);
            display: flex; gap: 20px;
        }

        .btn-premium {
            padding: 15px 35px; border-radius: 20px; font-weight: 700;
            display: flex; align-items: center; gap: 10px; transition: 0.3s; text-decoration: none;
        }

        .btn-edit { background: var(--primary-gradient); color: white; border: none; box-shadow: 0 10px 20px rgba(58, 123, 213, 0.2); }
        .btn-edit:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(58, 123, 213, 0.4); color: white; }

        .btn-danger-soft { background: #fee2e2; color: #ef4444; border: none; }
        .btn-danger-soft:hover { background: #ef4444; color: white; transform: translateY(-3px); }

        @media (max-width: 900px) {
            .widgets-grid { grid-template-columns: 1fr; }
            .info-layout { grid-template-columns: 1fr; }
            .avatar-box { left: 50%; transform: translateX(-50%); }
            .user-full-name { font-size: 2rem; text-align: center; }
            .name-area { text-align: center; margin-top: 10px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="profile-wrapper">
    <div class="profile-container">
        <div class="header-cover">
            <div class="avatar-box">
                <img src="{{ user.imageUrl ? asset('uploads/' ~ user.imageUrl) : asset('image/profil.png') }}" class="avatar-img" alt="Profile Image">
            </div>
        </div>

        <div class="profile-body">
            <div class="name-area">
                <h1 class="user-full-name">{{ user.prenom|capitalize }} {{ user.nom|upper }}</h1>
                <div class="badge-premium">
                    <i class="fas fa-shield-check"></i>
                    {{ user.role.value|replace({'ROLE_': ''})|upper }}
                </div>
            </div>

            <div class="widgets-grid">
                <div class="widget-card">
                    <i class="fas fa-calendar-alt widget-icon"></i>
                    <span class="widget-val">
                        {% set total_res = (user.reservationActivites|length) + (user.reservationEvenements|length) + (user.reservationSeances|length) %}
                        {{ total_res }}
                    </span>
                    <span class="widget-lab">Réservations</span>
                </div>
                <div class="widget-card">
                    <i class="fas fa-medal widget-icon"></i>
                    <span class="widget-val">{{ user.date_creation ? user.date_creation|date('Y') : '2024' }}</span>
                    <span class="widget-lab">Membre depuis</span>
                </div>
                <div class="widget-card">
                    <i class="fas fa-heart widget-icon"></i>
                    <span class="widget-val">{{ user.reclamations|length }}</span>
                    <span class="widget-lab">Réclamations</span>
                </div>
            </div>

            <div class="info-layout">
                <div class="main-info">
                    <h4 class="section-title"><i class="fas fa-user-circle"></i> Détails personnels</h4>
                    
                    <div class="detail-row">
                        <span class="detail-label">Adresse Email</span>
                        <span class="detail-value">{{ user.email }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Numéro de Téléphone</span>
                        <span class="detail-value">{{ user.telephone ?: 'Non renseigné' }}</span>
                    </div>

                    {% if user.role.value == 'COACH' %}
                        <h4 class="section-title mt-5"><i class="fas fa-briefcase"></i> Profil Professionnel</h4>
                        <div class="detail-row">
                            <span class="detail-label">Spécialité</span>
                            <span class="detail-value text-primary">{{ user.specialite.value ?: 'Multi-disciplinaire' }}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Expérience</span>
                            <span class="detail-value">{{ user.experience ?: '0' }} ans</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Statut</span>
                            <span class="badge {{ user.disponibilite and user.disponibilite.value == 'DISPONIBLE' ? 'bg-success' : 'bg-secondary' }} rounded-pill p-2 px-3">
                                {{ user.disponibilite.value ?: 'N/A' }}
                            </span>
                        </div>
                    {% endif %}
                </div>

                <div class="side-info">
                    <h4 class="section-title"><i class="fas fa-info-circle"></i> À propos</h4>
                    <div class="widget-card text-start" style="background: rgba(255,255,255,0.2); padding: 20px;">
                        <p class="text-muted x-small mb-0" style="font-size: 0.85rem; line-height: 1.6;">
                            {{ user.bioCertifs ?: "Cet utilisateur n'a pas encore rédigé sa biographie. Rejoignez l'aventure EcoAdventure !" }}
                        </p>
                    </div>
                </div>
            </div>

            <div class="actions-footer">
                <a href="{{ path('app_user_app_edit', {'id_user': user.id_user}) }}" class="btn-premium btn-edit">
                    <i class="fas fa-user-edit"></i> Modifier Profil
                </a>
                <a href="{{ path('app_logout') }}" class="btn-premium btn-danger-soft">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}