{# templates/profile/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Profil - EcoAdventure{% endblock %}
{% set profileAvatar = user.imageUrl
    ? ((user.imageUrl matches '/gravatar\\.com\\/avatar\\//i' and user.imageUrl matches '/[?&]d=404/i')
        ? asset('image/profil.png')
        : (user.imageUrl starts with 'http'
            ? user.imageUrl
            : asset('uploads/' ~ user.imageUrl)))
    : asset('image/profil.png') %}

{% block css %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

        :root {
            --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --glass-bg: rgba(255, 255, 255, 0.75);
            --glass-border: rgba(255, 255, 255, 0.5);
            --text-dark: #1e293b;
            --accent-blue: #3a7bd5;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            margin: 0;
            color: var(--text-dark);
        }

        .profile-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: rgba(0,0,0,0.2);
        }

        .profile-container {
            width: 100%;
            max-width: 900px;
            background: var(--glass-bg);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--glass-border);
            border-radius: 40px;
            box-shadow: 0 40px 80px rgba(0,0,0,0.3);
            overflow: hidden;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .header-cover {
            height: 180px;
            background: var(--primary-gradient);
            position: relative;
        }

        .avatar-box {
            position: absolute;
            bottom: -70px;
            left: 50px;
            z-index: 5;
        }

        .avatar-img {
            width: 160px; height: 160px;
            border-radius: 35px;
            border: 6px solid white;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            object-fit: cover;
            background: white;
            transition: 0.4s;
        }

        .avatar-img:hover { transform: rotate(3deg) scale(1.05); }

        .profile-body {
            padding: 90px 50px 50px 50px;
        }

        .name-area { margin-bottom: 30px; }
        .user-full-name { font-weight: 800; font-size: 2.8rem; margin: 0; letter-spacing: -1px; color: #0f172a; }
        
        .badge-premium {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 20px; background: white; border-radius: 15px;
            font-weight: 700; color: var(--accent-blue); font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-top: 10px;
        }

        /* Widgets Grid */
        .widgets-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; margin-bottom: 40px;
        }

        .widget-card {
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid var(--glass-border);
            padding: 25px; border-radius: 28px; transition: 0.3s;
            text-align: center;
        }

        .widget-card:hover { background: white; transform: translateY(-8px); box-shadow: 0 20px 30px rgba(0,0,0,0.05); }

        .widget-icon {
            font-size: 1.8rem; margin-bottom: 15px; display: inline-block;
            background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .widget-val { display: block; font-size: 1.6rem; font-weight: 800; color: #1e293b; }
        .widget-lab { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }

        /* Content Sections */
        .info-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; }

        .section-title { font-weight: 700; font-size: 1.2rem; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; }
        .section-title i { color: var(--accent-blue); }

        .detail-row {
            background: rgba(255, 255, 255, 0.4);
            padding: 18px 25px; border-radius: 20px; margin-bottom: 15px;
            display: flex; justify-content: space-between; align-items: center;
            border: 1px solid transparent; transition: 0.3s;
        }
        .detail-row:hover { border-color: var(--accent-blue); background: white; }

        .detail-label { font-weight: 600; color: #64748b; font-size: 0.9rem; }
        .detail-value { font-weight: 700; color: #1e293b; }

        /* Action Buttons */
        .actions-footer {
            margin-top: 40px; padding-top: 30px; border-top: 1px solid rgba(0,0,0,0.05);
            display: flex; gap: 20px;
        }

        .btn-premium {
            padding: 15px 35px; border-radius: 20px; font-weight: 700;
            display: flex; align-items: center; gap: 10px; transition: 0.3s; text-decoration: none;
        }

        .btn-edit { background: var(--primary-gradient); color: white; border: none; box-shadow: 0 10px 20px rgba(58, 123, 213, 0.2); }
        .btn-edit:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(58, 123, 213, 0.4); color: white; }

        .btn-danger-soft { background: #fee2e2; color: #ef4444; border: none; }
        .btn-danger-soft:hover { background: #ef4444; color: white; transform: translateY(-3px); }

        /* Modal Styles */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(10px);
            display: none; align-items: center; justify-content: center; z-index: 1000;
        }
        .modal-content {
            background: white; width: 100%; max-width: 500px; border-radius: 35px;
            padding: 40px; position: relative; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            animation: modalPop 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalPop { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
        
        .modal-step { display: flex; gap: 20px; margin-bottom: 25px; align-items: flex-start; }
        .step-num { 
            width: 32px; height: 32px; background: var(--accent-blue); color: white; 
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 800; flex-shrink: 0;
        }
        .step-text h5 { margin: 0 0 5px 0; font-weight: 700; color: #1e293b; }
        .step-text p { margin: 0; font-size: 0.9rem; color: #64748b; }

        .benefit-tag {
            background: #f0fdf4; color: #15803d; padding: 10px 15px; border-radius: 12px;
            font-size: 0.85rem; font-weight: 600; margin-bottom: 30px; display: flex; align-items: center; gap: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="profile-wrapper">
    <!-- ... same profile container ... -->
    <div class="profile-container">
        <!-- ... header cover ... -->
        <div class="header-cover">
            <div class="avatar-box">
                <img src="{{ user.imageUrl ? asset('uploads/' ~ user.imageUrl) : asset('image/profil.png') }}" class="avatar-img" alt="Profile Image">
            </div>
        </div>

        <div class="profile-body">
            <!-- ... name area ... -->
            <div class="name-area">
                <h1 class="user-full-name">{{ user.prenom|capitalize }} {{ user.nom|upper }}</h1>
                <div class="badge-premium">
                    <i class="fas fa-shield-check"></i>
                    {{ user.role.value|replace({'ROLE_': ''})|upper }}
                </div>
            </div>

            <div class="widgets-grid">
                <div class="widget-card">
                    <i class="fas fa-calendar-alt widget-icon"></i>
                    <span class="widget-val">
                        {% set total_res = (user.reservationActivites|length) + (user.reservationEvenements|length) + (user.reservationSeances|length) %}
                        {{ total_res }}
                    </span>
                    <span class="widget-lab">Réservations</span>
                </div>
                <div class="widget-card">
                    <i class="fas fa-medal widget-icon"></i>
                    <span class="widget-val">{{ user.date_creation ? user.date_creation|date('Y') : '2024' }}</span>
                    <span class="widget-lab">Membre depuis</span>
                </div>
                <div class="widget-card">
                    <i class="fas fa-heart widget-icon"></i>
                    <span class="widget-val">{{ user.reclamations|length }}</span>
                    <span class="widget-lab">Réclamations</span>
                </div>
            </div>

            <div class="info-layout">
                <div class="main-info">
                    <h4 class="section-title"><i class="fas fa-user-circle"></i> Détails personnels</h4>
                    
                    <div class="detail-row">
                        <span class="detail-label">Adresse Email</span>
                        <span class="detail-value">{{ user.email }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Numéro de Téléphone</span>
                        <span class="detail-value">{{ user.telephone ?: 'Non renseigné' }}</span>
                    </div>
                </div>

                <div class="side-info">
                    <h4 class="section-title"><i class="fas fa-info-circle"></i> À propos</h4>
                    <div class="widget-card text-start" style="background: rgba(255,255,255,0.2); padding: 20px;">
                        <p class="text-muted x-small mb-0" style="font-size: 0.85rem; line-height: 1.6;">
                            {{ user.bioCertifs ?: "Cet utilisateur n'a pas encore rédigé sa biographie. Rejoignez l'aventure EcoAdventure !" }}
                        </p>
                    </div>
                </div>
            </div>

            <div class="actions-footer">
                <a href="{{ path('app_user_app_edit', {'id_user': user.id_user}) }}" class="btn-premium btn-edit">
                    <i class="fas fa-user-edit"></i> Modifier Profil
                </a>

                {% if user.telegramId %}
                    <div class="btn-premium" style="background: rgba(0, 200, 83, 0.1); color: #00c853; border: 1px solid #00c853;">
                        <i class="fab fa-telegram"></i> 2FA Actif
                    </div>
                {% else %}
                    <a href="{{ path('app_profile_index', {setup2fa: 1}) }}" class="btn-premium" style="background: #24A1DE; color: white; border: none; text-decoration: none;">
                        <i class="fab fa-telegram"></i> Activer 2FA Telegram
                    </a>
                {% endif %}

                <a href="{{ path('app_logout') }}" class="btn-premium btn-danger-soft">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2FA -->
<div id="2faModal" class="modal-overlay">
    <div class="modal-content">
        <h2 style="margin-top: 0; font-weight: 800;">Double Authentification</h2>
        <div class="benefit-tag">
            <i class="fas fa-shield-alt"></i>
            Protégez votre compte contre les accès non autorisés.
        </div>

        <div class="modal-step">
            <div class="step-num">1</div>
            <div class="step-text">
                <h5>Installer Telegram</h5>
                <p>Assurez-vous d'avoir l'application Telegram sur votre téléphone.</p>
            </div>
        </div>

        <div class="modal-step">
            <div class="step-num">2</div>
            <div class="step-text">
                <h5>Scannez ou Cliquez</h5>
                <p>Scannez ce QR Code avec votre téléphone ou cliquez sur le bouton.</p>
                <div style="margin-top: 15px; text-align: center; background: #f8fafc; padding: 15px; border-radius: 20px; border: 1px dashed #cbd5e1;">
                    <img id="qrCodeImg" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ ("https://t.me/eco_adventure_2fa_bot?start=" ~ user.telegramToken)|url_encode }}" alt="QR Code Telegram">
                </div>
            </div>
        </div>

        <div class="modal-step">
            <div class="step-num">3</div>
            <div class="step-text">
                <h5>Cliquer sur START</h5>
                <p>Une fois sur Telegram, appuyez sur <b>DÉMARRER</b> pour lier votre compte automatiquement.</p>
            </div>
        </div>

        <div style="display: flex; gap: 15px; margin-top: 30px;">
            <a href="{{ path('app_telegram_link') }}" class="btn-premium" style="background: #24A1DE; color: white; flex: 1; justify-content: center; text-decoration: none;">
                Ouvrir Telegram <i class="fas fa-external-link-alt"></i>
            </a>
            <button onclick="document.getElementById('2faModal').style.display='none'" class="btn-premium btn-danger-soft" style="flex: 0.5; justify-content: center;">
                Fermer
            </button>
        </div>
    </div>
</div>

<script>
    // Auto-open modal if redirected from token generation
    {% if showModal %}
        document.getElementById('2faModal').style.display = 'flex';
    {% endif %}

    // Close modal when clicking outside
    window.onclick = function(event) {
        let modal = document.getElementById('2faModal');
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>
{% endblock %}
