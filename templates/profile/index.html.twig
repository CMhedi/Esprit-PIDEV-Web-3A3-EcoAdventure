{# templates/profile/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Profil - EcoAdventure{% endblock %}

{% block css %}
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.4);
            --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --accent-color: #00d2ff;
        }

        .profile-page-container {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            font-family: 'Inter', sans-serif;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            width: 100%;
            max-width: 850px;
            overflow: hidden;
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .profile-header {
            background: var(--primary-gradient);
            height: 120px;
            position: relative;
        }

        .avatar-container {
            position: absolute;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
        }

        .avatar-main {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 5px solid white;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            object-fit: cover;
            background-color: white;
            transition: transform 0.3s ease;
        }

        .avatar-main:hover {
            transform: scale(1.05);
        }

        .profile-content {
            padding: 80px 40px 40px 40px;
            text-align: center;
        }

        .user-name {
            font-size: 2.2rem;
            font-weight: 800;
            color: #1a1a1a;
            margin-bottom: 5px;
            letter-spacing: -0.5px;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 16px;
            background: rgba(58, 123, 213, 0.1);
            color: #3a7bd5;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 30px;
            border: 1px solid rgba(58, 123, 213, 0.2);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-item {
            background: rgba(255, 255, 255, 0.5);
            padding: 20px;
            border-radius: 20px;
            border: 1px solid var(--glass-border);
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            background: white;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        .stat-value {
            display: block;
            font-size: 1.5rem;
            font-weight: 700;
            color: #333;
        }

        .stat-label {
            font-size: 0.8rem;
            color: #666;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            font-size: 1.2rem;
            margin-bottom: 8px;
            display: block;
            color: var(--accent-color);
        }

        /* Info Sections */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            text-align: left;
            margin-bottom: 40px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.4);
            padding: 20px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .info-icon-box {
            width: 45px;
            height: 45px;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #3a7bd5;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .info-label {
            display: block;
            font-size: 0.75rem;
            font-weight: 700;
            color: #888;
            margin-bottom: 2px;
            text-transform: uppercase;
        }

        .info-value {
            display: block;
            font-size: 0.95rem;
            font-weight: 600;
            color: #333;
            word-break: break-all;
        }

        /* Referral Code Box */
        .referral-box {
            grid-column: span 2;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            padding: 20px;
            border-radius: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px dashed #ccc;
        }

        .code-display {
            font-family: 'Monaco', 'Consolas', monospace;
            font-size: 1.2rem;
            font-weight: 700;
            color: #3a7bd5;
            background: white;
            padding: 5px 15px;
            border-radius: 8px;
            border: 1px solid #eee;
        }

        .copy-btn {
            background: none;
            border: none;
            color: #3a7bd5;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s;
        }

        .copy-btn:hover {
            color: #2a5298;
        }

        /* Coach Section */
        .coach-details {
            margin-top: 30px;
            padding: 25px;
            background: rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            text-align: left;
            border-left: 5px solid var(--accent-color);
        }

        .coach-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Actions */
        .profile-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }

        .btn-custom {
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-edit {
            background: var(--primary-gradient);
            color: white;
            border: none;
            box-shadow: 0 4px 15px rgba(58, 123, 213, 0.3);
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(58, 123, 213, 0.4);
            color: white;
        }

        .btn-logout {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.2);
        }

        .btn-logout:hover {
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
        }

        @media (max-width: 768px) {
            .stats-grid, .info-grid {
                grid-template-columns: 1fr;
            }
            .referral-box {
                grid-column: span 1;
            }
            .profile-content {
                padding: 80px 20px 30px 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="profile-page-container">
    <div class="glass-card">
        <div class="profile-header">
            <div class="avatar-container">
                <img src="{{ user.imageUrl ? asset('uploads/' ~ user.imageUrl) : asset('image/profil.png') }}" class="avatar-main" alt="Avatar">
            </div>
        </div>

        <div class="profile-content">
            <h1 class="user-name">{{ user.prenom|capitalize }} {{ user.nom|upper }}</h1>
            <div class="role-badge">
                <i class="bi bi-patch-check-fill me-2"></i>
                {{ user.role.value|replace({'ROLE_': ''})|upper }}
            </div>

            {# Quick Stats #}
            <div class="stats-grid">
                <div class="stat-item">
                    <i class="bi bi-calendar-check stat-icon"></i>
                    <span class="stat-value">
                        {% set total_res = (user.reservationActivites|length) + (user.reservationEvenements|length) + (user.reservationSeances|length) %}
                        {{ total_res }}
                    </span>
                    <span class="stat-label">Réservations</span>
                </div>
                <div class="stat-item">
                    <i class="bi bi-star stat-icon" style="color: #4caf50;"></i>
                    <span class="stat-value">{{ user.date_creation ? user.date_creation|date('Y') : '2024' }}</span>
                    <span class="stat-label">Depuis</span>
                </div>
            </div>

            {# Information Grid #}
            <div class="info-grid">
                <div class="info-card">
                    <div class="info-icon-box">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <span class="info-label">Email</span>
                        <span class="info-value">{{ user.email }}</span>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-icon-box">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <span class="info-label">Téléphone</span>
                        <span class="info-value">{{ user.telephone ?? 'Non renseigné' }}</span>
                    </div>
                </div>
            </div>

            {# Coach Specific Section #}
            {% if user.role.value == 'COACH' %}
                <div class="coach-details">
                    <h3 class="coach-title">
                        <i class="bi bi-briefcase-fill text-primary"></i> 
                        Informations Professionnelles
                    </h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <span class="info-label">Spécialité</span>
                            <span class="info-value text-primary">{{ user.specialite.value ?? 'Général' }}</span>
                        </div>
                        <div class="col-md-4">
                            <span class="info-label">Expérience</span>
                            <span class="info-value">{{ user.experience ?? '0' }} ans</span>
                        </div>
                        <div class="col-md-4">
                            <span class="info-label">Disponibilité</span>
                            <span class="badge {{ user.disponibilite and user.disponibilite.value == 'DISPONIBLE' ? 'bg-success' : 'bg-secondary' }} rounded-pill">
                                {{ user.disponibilite.value ?? 'N/A' }}
                            </span>
                        </div>
                        {% if user.bioCertifs %}
                        <div class="col-12 mt-3">
                            <span class="info-label">Biographie & Certificats</span>
                            <p class="mb-0 text-muted small mt-1" style="line-height: 1.6;">
                                {{ user.bioCertifs }}
                            </p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Actions #}
            <div class="profile-actions">
                <a href="{{ path('app_user_app_edit', {'id_user': user.id_user}) }}" class="btn btn-custom btn-edit">
                    <i class="bi bi-pencil-square"></i> Modifier Profil
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-custom btn-logout">
                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function copyCode() {
        const code = document.getElementById('refCode').innerText;
        navigator.clipboard.writeText(code).then(() => {
            const icon = document.getElementById('copyIcon');
            icon.classList.replace('bi-clipboard', 'bi-check-lg');
            icon.style.color = '#4caf50';
            
            setTimeout(() => {
                icon.classList.replace('bi-check-lg', 'bi-clipboard');
                icon.style.color = '';
            }, 2000);
        });
    }
</script>
{% endblock %}