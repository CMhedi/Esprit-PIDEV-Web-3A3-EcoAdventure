{% extends 'base.html.twig' %}

{% block body %}
<style>
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }

    .glass-wrapper {
        background: rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 40px;
        margin-top: 50px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
    }

    .main-title { 
        color: white !important; 
        font-weight: 700; 
        font-size: 2.8rem; 
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .table-glass {
        background: white !important;
        border-radius: 10px !important;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .table-glass th {
        background: #fff !important;
        color: #1b4f72 !important;
        font-weight: 800 !important;
        border-bottom: 2px solid #eee !important;
        padding: 15px !important;
        text-transform: uppercase;
        font-size: 0.8rem;
    }

    .table-glass td {
        padding: 15px !important;
        background: #fff !important;
        vertical-align: middle;
        color: #333;
    }

    .btn-nouvelle {
        background-color: #007bff !important;
        border-radius: 50px !important;
        padding: 12px 30px !important;
        font-weight: 600 !important;
        color: white !important;
        border: none !important;
        transition: 0.3s;
    }
    .btn-nouvelle:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,123,255,0.4); }
    
    .action-btn { border-radius: 50px !important; padding: 5px 15px !important; font-weight: 600; font-size: 0.85rem; }
    
    .admin-row:hover {
        background-color: #f8f9fa !important;
        cursor: pointer;
    }
</style>

<div class="container pb-5">
    <div class="glass-wrapper shadow-lg">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="main-title">EcoAdventure </h1>
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_reclamation_new') }}" class="btn btn-nouvelle shadow">
                    <i class="fas fa-plus-circle me-2"></i>Nouvelle Plainte
                </a>
            {% endif %}
        </div>

        <div class="table-responsive rounded-3">
            <table class="table table-glass mb-0">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Réponse</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for reclamation in reclamations %}
                    <tr {% if is_granted('ROLE_ADMIN') %} 
                            class="admin-row"
                            ondblclick="openReponseModal('{{ reclamation.id_reclamation }}', '{{ reclamation.reponse|e('js') }}')" 
                            title="Double-cliquez pour répondre"
                        {% endif %}>
                        <td class="fw-bold">{{ reclamation.type }}</td>
                        <td class="text-muted small">
                            {{ reclamation.date_creation ? reclamation.date_creation|date('d/m/Y H:i') : '---' }}
                        </td>
                        <td>
                            <span class="badge {% if reclamation.statut.value == 'TRAITEE' %}bg-success{% elseif reclamation.statut.value == 'REJETEE' %}bg-danger{% else %}bg-warning text-dark{% endif %} px-3 py-2 rounded-pill">
                                {{ reclamation.statut.value }}
                            </span>
                        </td>
                        <td class="text-muted small italic">
                            {{ reclamation.reponse ?: 'Pas encore de réponse' }}
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_reclamation_show', {'id_reclamation': reclamation.id_reclamation}) }}" class="btn btn-sm btn-outline-info action-btn">
                                    <i class="fas fa-eye me-1"></i> details
                                </a>
                                
                                {% if not is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_reclamation_edit', {'id_reclamation': reclamation.id_reclamation}) }}" class="btn btn-sm btn-warning text-dark action-btn">
                                        <i class="fas fa-edit me-1"></i> Modifier
                                    </a>
                                {% endif %}

                                <form method="post" action="{{ path('app_reclamation_delete', {'id_reclamation': reclamation.id_reclamation}) }}" onsubmit="return confirm('Etes-vous sûr ?');" style="display:inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id_reclamation) }}">
                                    <button class="btn btn-sm btn-danger action-btn">
                                        <i class="fas fa-trash-alt me-1"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Aucune réclamation trouvée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="reponseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-reply me-2"></i>Répondre</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reponseForm" method="POST">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Votre Réponse</label>
                        <textarea name="reponse" id="reponseText" class="form-control" rows="4" required placeholder="Tapez votre réponse ici..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Changer le Statut</label>
                        <select name="statut" id="statutSelect" class="form-select">
                            <option value="TRAITEE">Traitée (Acceptée)</option>
                            <option value="REJETEE">Rejetée</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openReponseModal(id, currentReponse) {
    const modalElement = document.getElementById('reponseModal');
    const modal = new bootstrap.Modal(modalElement);
    const form = document.getElementById('reponseForm');
    form.action = "/reclamation/admin-reply/" + id;
    const cleanReponse = (currentReponse === "Pas encore de réponse") ? "" : currentReponse;
    document.getElementById('reponseText').value = cleanReponse;
    modal.show();
}
</script>
{% endblock %}