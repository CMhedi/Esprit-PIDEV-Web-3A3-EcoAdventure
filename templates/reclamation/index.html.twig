{# templates/reclamation/index.html.twig #}

{% set adminMode = admin_mode|default(false) %}
{% extends adminMode ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block body %}
<style>
    {% if not adminMode %}
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }
    {% endif %}

    .glass-container {
        background: white !important;
        border-radius: 35px;
        border: 1px solid #f1f5f9;
        padding: 40px;
        margin-top: 40px;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.05);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .title-group h1 {
        color: #2d5a27 !important; /* Vert ghameq bech iban */
        font-weight: 800;
        font-size: 2.5rem;
        margin: 0;
        letter-spacing: -1px;
    }

    .title-group p {
        color: #64748b !important; /* Gris wadhah */
        margin: 0;
        font-size: 1.1rem;
    }

    .btn-add {
        background: linear-gradient(135deg, #2d5a27 0%, #4a7c44 100%);
        color: white !important;
        border: none;
        padding: 12px 25px;
        border-radius: 15px;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(45, 90, 39, 0.2);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-box {
        position: relative;
        max-width: 450px;
        margin-bottom: 30px;
    }

    .search-box input {
        background: #f8fafc !important;
        border: 2px solid #f1f5f9 !important;
        border-radius: 18px !important;
        padding: 15px 15px 15px 55px !important;
        color: #1e293b !important;
        font-size: 1.05rem;
        transition: 0.3s;
    }

    .search-box input::placeholder { color: #94a3b8; }
    .search-box input:focus {
        background: white !important;
        border-color: #2d5a27 !important;
        box-shadow: 0 10px 25px rgba(45, 90, 39, 0.08) !important;
    }

    .search-box i {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #2d5a27;
        font-size: 1.2rem;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .custom-table thead th {
        color: #1e293b !important; /* Headers wadhin */
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 20px;
        border: none;
        letter-spacing: 1px;
    }

    .reclamation-row {
        background: white;
        transition: 0.3s;
        border-radius: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.02);
        border: 1px solid #f1f5f9;
    }

    .reclamation-row.row-answered {
        background: #f0fdf4 !important; /* Vert tres clair bech iban mriguel */
        border-left: 8px solid #2d5a27;
    }

    .reclamation-row:hover {
        transform: scale(1.005) translateY(-3px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    }

    .reclamation-row td {
        padding: 22px;
        vertical-align: middle;
        border: none;
    }

    .reclamation-row td:first-child { border-top-left-radius: 20px; border-bottom-left-radius: 20px; }
    .reclamation-row td:last-child { border-top-right-radius: 20px; border-bottom-right-radius: 20px; }

    /* Badges */
    .status-badge {
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.8rem;
        display: inline-block;
        text-transform: uppercase;
        min-width: 120px;
        text-align: center;
    }
    .status-traitée, .status-traitee { background: #dcfce7 !important; color: #166534 !important; }
    .status-en_attente, .status-en-attente { background: #fef9c3 !important; color: #854d0e !important; }
    .status-rejetée, .status-rejetee { background: #fee2e2 !important; color: #991b1b !important; }

    .priority-badge {
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: white;
    }
    .priority-haute { background: #ef4444 !important; }
    .priority-moyenne { background: #f59e0b !important; }
    .priority-basse { background: #10b981 !important; }

    .action-group { display: flex; gap: 8px; justify-content: center; }
    
    .action-btn-custom {
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.3s;
        border: none;
    }

    .btn-view { background: #2d5a27; color: white !important; }
    .btn-view:hover { background: #1a3617; transform: translateY(-2px); }

    .btn-delete { background: #fee2e2; color: #991b1b !important; }
    .btn-delete:hover { background: #ef4444; color: white !important; }

    .type-icon {
        width: 48px;
        height: 48px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-right: 18px;
    }
</style>

<div class="container pb-5">
    <div class="glass-container">
        <div class="dashboard-header">
            <div class="title-group">
                <h1>Mes Réclamations</h1>
                <p>Suivez l'état de vos demandes en temps réel</p>
            </div>
            {% if not adminMode %}
                <a href="{{ path('app_reclamation_new') }}" class="btn-add">
                    <i class="bi bi-plus-circle-fill"></i> Nouvelle Plainte
                </a>
            {% endif %}
        </div>

        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="rechercheReclamation" placeholder="Rechercher par type, date ou statut...">
        </div>            

        <div class="table-responsive">
            <table class="custom-table" id="tableReclamation">
                <thead>
                    <tr>
                        <th>Type de Plainte</th>
                        <th>Date de création</th>
                        <th>État</th>
                        <th>Priorité</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for reclamation in reclamations %}
                    <tr class="reclamation-row {% if reclamation.reponse %}row-answered{% endif %}" {% if adminMode %}ondblclick="openReponseModal('{{ reclamation.id_reclamation }}', '{{ reclamation.reponse|e('js') }}')"{% endif %}>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="type-icon">
                                    {% if 'Paiement' in reclamation.type %}
                                        <i class="bi bi-credit-card-fill" style="color: #6366f1;"></i>
                                    {% elseif 'Technique' in reclamation.type %}
                                        <i class="bi bi-tools" style="color: #0ea5e9;"></i>
                                    {% elseif 'Séance' in reclamation.type %}
                                        <i class="bi bi-person-walking" style="color: #10b981;"></i>
                                    {% else %}
                                        <i class="bi bi-exclamation-triangle-fill" style="color: #f59e0b;"></i>
                                    {% endif %}
                                </div>
                                <span class="fw-bold text-dark">{{ reclamation.type }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="text-dark fw-bold">{{ reclamation.date_creation ? reclamation.date_creation|date('d M Y') : '---' }}</div>
                            <small class="text-muted">{{ reclamation.date_creation ? reclamation.date_creation|date('H:i') : '' }}</small>
                        </td>
                        <td>
                            <span class="status-badge status-{{ reclamation.statut.value|lower }}">
                                {{ reclamation.statut.value }}
                            </span>
                        </td>
                        <td>
                            <span class="priority-badge priority-{{ reclamation.priorite|lower }}">
                                {{ reclamation.priorite }}
                            </span>
                        </td>
                        <td>
                            <div class="action-group">
                                <a href="{{ path('app_reclamation_show', {'id_reclamation': reclamation.id_reclamation}) }}" class="action-btn-custom btn-view">
                                    <i class="bi bi-eye"></i> <span>Détails</span>
                                </a>

                                <form method="post" action="{{ path('app_reclamation_delete', {'id_reclamation': reclamation.id_reclamation}) }}" onsubmit="return confirm('Supprimer cette réclamation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id_reclamation) }}">
                                    <button class="action-btn-custom btn-delete">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-folder-x display-1 mb-3"></i>
                                <p class="fs-5">Aucune réclamation trouvée.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# --- MODAL REPONSE (ADMIN ONLY) --- #}
{% if adminMode %}
<div class="modal fade" id="reponseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-reply-fill me-2"></i>Action Administrateur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reponseForm" method="POST">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Réponse</label>
                        <textarea name="reponse" id="reponseText" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Changer statut</label>
                        <select name="statut" id="statutSelect" class="form-select">
                            <option value="TRAITEE">Accepter</option>
                            <option value="REJETEE">Rejeter</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Valider</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<script>
    const searchInput = document.getElementById('rechercheReclamation');
    if(searchInput) {
        searchInput.addEventListener('keyup', function() {
            let value = this.value.toLowerCase();
            let rows = document.querySelectorAll('#tableReclamation tbody tr');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
            });
        });
    }

    function openReponseModal(id, currentReponse) {
        {% if not adminMode %} return; {% endif %}
        const modalElement = document.getElementById('reponseModal');
        if(!modalElement) return;
        const modal = new bootstrap.Modal(modalElement);
        const form = document.getElementById('reponseForm');
        form.action = "/reclamation/admin-reply/" + id;
        document.getElementById('reponseText').value = (currentReponse === "Pas encore de réponse") ? "" : currentReponse;
        modal.show();
    }
</script>
{% endblock %}
