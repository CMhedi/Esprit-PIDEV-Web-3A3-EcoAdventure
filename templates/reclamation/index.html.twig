{# templates/reclamation/index.html.twig #}

{% set adminMode = admin_mode|default(false) %}
{% extends adminMode ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block body %}
<style>
    {% if not adminMode %}
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }
    {% endif %}

    .glass-container {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 40px;
        margin-top: 40px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .title-group h1 {
        color: white;
        font-weight: 800;
        font-size: 2.5rem;
        margin: 0;
        letter-spacing: -1px;
    }

    .title-group p {
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        font-size: 1.1rem;
    }

    .btn-add {
        background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
        color: white !important;
        border: none;
        padding: 12px 25px;
        border-radius: 15px;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(58, 123, 213, 0.3);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-add:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 25px rgba(58, 123, 213, 0.5);
    }

    .search-box {
        position: relative;
        max-width: 450px;
        margin-bottom: 30px;
    }

    .search-box input {
        background: rgba(255, 255, 255, 0.15) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 18px !important;
        padding: 15px 15px 15px 55px !important;
        color: white !important;
        backdrop-filter: blur(10px);
        font-size: 1.05rem;
        transition: 0.3s;
    }

    .search-box input::placeholder { color: rgba(255, 255, 255, 0.6); }
    .search-box input:focus {
        background: rgba(255, 255, 255, 0.25) !important;
        border-color: white !important;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.1) !important;
    }

    .search-box i {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: white;
        font-size: 1.2rem;
        opacity: 0.8;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .custom-table thead th {
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 10px 20px;
        border: none;
    }

    .reclamation-row {
        background: rgba(255, 255, 255, 0.95);
        transition: 0.3s;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .reclamation-row.row-answered {
        background: #bbf7d0 !important; /* Vert bien plus foncé et visible */
        border-left: 8px solid #15803d;
        box-shadow: 0 4px 15px rgba(21, 128, 61, 0.2);
    }

    .reclamation-row:hover {
        transform: scale(1.01) translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        background: #ffffff;
    }

    .reclamation-row td {
        padding: 20px;
        vertical-align: middle;
        border: none;
    }

    .reclamation-row td:first-child { border-top-left-radius: 15px; border-bottom-left-radius: 15px; }
    .reclamation-row td:last-child { border-top-right-radius: 15px; border-bottom-right-radius: 15px; }

    /* Badges */
    .status-badge {
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.8rem;
        display: inline-block;
        text-transform: uppercase;
        min-width: 120px;
        text-align: center;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);
    }
    .status-traitée, .status-traitee { background: #dcfce7 !important; color: #166534 !important; }
    .status-en_attente, .status-en-attente { background: #fef9c3 !important; color: #854d0e !important; }
    .status-rejetée, .status-rejetee { background: #fee2e2 !important; color: #991b1b !important; }

    .priority-badge {
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        display: inline-block;
    }
    .priority-haute { background: #ef4444 !important; color: white !important; }
    .priority-moyenne { background: #f59e0b !important; color: white !important; }
    .priority-basse { background: #10b981 !important; color: white !important; }

    .action-group { display: flex; gap: 8px; justify-content: center; }
    
    .action-btn-custom {
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .btn-view { background: #eff6ff; color: #1e40af; }
    .btn-view:hover { background: #1e40af; color: white; transform: translateY(-2px); }

    .btn-edit { background: #fffbeb; color: #92400e; }
    .btn-edit:hover { background: #92400e; color: white; transform: translateY(-2px); }

    .btn-delete { background: #fef2f2; color: #991b1b; }
    .btn-delete:hover { background: #991b1b; color: white; transform: translateY(-2px); }

    .type-icon {
        width: 48px;
        height: 48px;
        background: #f1f5f9;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-right: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
</style>

<div class="container pb-5">
    <div class="glass-container">
        <div class="dashboard-header">
            <div class="title-group">
                <h1>Mes Réclamations</h1>
                <p>Suivez l'état de vos demandes en temps réel</p>
            </div>
            {% if not adminMode %}
                <a href="{{ path('app_reclamation_new') }}" class="btn-add">
                    <i class="bi bi-plus-circle-fill"></i> Nouvelle Plainte
                </a>
            {% endif %}
        </div>

        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="rechercheReclamation" placeholder="Rechercher par type, date ou statut...">
        </div>            

        <div class="table-responsive">
            <table class="custom-table" id="tableReclamation">
                <thead>
                    <tr>
                        <th>Type de Plainte</th>
                        <th>Date de création</th>
                        <th>État</th>
                        <th>Priorité</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for reclamation in reclamations %}
                    <tr class="reclamation-row {% if reclamation.reponse %}row-answered{% endif %}" {% if adminMode %}ondblclick="openReponseModal('{{ reclamation.id_reclamation }}', '{{ reclamation.reponse|e('js') }}')"{% endif %}>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="type-icon">
                                    {% if 'Paiement' in reclamation.type %}
                                        <i class="bi bi-credit-card-fill" style="color: #6366f1;"></i>
                                    {% elseif 'Technique' in reclamation.type %}
                                        <i class="bi bi-tools" style="color: #0ea5e9;"></i>
                                    {% elseif 'Séance' in reclamation.type %}
                                        <i class="bi bi-person-walking" style="color: #10b981;"></i>
                                    {% else %}
                                        <i class="bi bi-exclamation-triangle-fill" style="color: #f59e0b;"></i>
                                    {% endif %}
                                </div>
                                <span class="fw-bold text-dark">{{ reclamation.type }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="text-dark fw-500">{{ reclamation.date_creation ? reclamation.date_creation|date('d M Y') : '---' }}</div>
                            <small class="text-muted">{{ reclamation.date_creation ? reclamation.date_creation|date('H:i') : '' }}</small>
                        </td>
                        <td>
                            <span class="status-badge status-{{ reclamation.statut.value|lower }}">
                                {{ reclamation.statut.value }}
                            </span>
                        </td>
                        <td>
                            <span class="priority-badge priority-{{ reclamation.priorite|lower }}">
                                {{ reclamation.priorite }}
                            </span>
                        </td>
                        <td>
                            <div class="action-group">
                                <a href="{{ path('app_reclamation_show', {'id_reclamation': reclamation.id_reclamation}) }}" class="action-btn-custom btn-view">
                                    <i class="bi bi-eye"></i> <span>Détails</span>
                                </a>
                                
                                {% if not adminMode %}
                                    <a href="{{ path('app_reclamation_edit', {'id_reclamation': reclamation.id_reclamation}) }}" class="action-btn-custom btn-edit">
                                        <i class="bi bi-pencil-square"></i> <span>Modifier</span>
                                    </a>
                                {% endif %}

                                <form method="post" action="{{ path('app_reclamation_delete', {'id_reclamation': reclamation.id_reclamation}) }}" onsubmit="return confirm('Etes-vous sûr de vouloir supprimer cette réclamation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id_reclamation) }}">
                                    <button class="action-btn-custom btn-delete">
                                        <i class="bi bi-trash3"></i> <span>Supprimer</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-white opacity-75">
                                <i class="bi bi-folder-x display-1 mb-3"></i>
                                <p class="fs-5">Aucune réclamation trouvée.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# --- MODAL REPONSE (ADMIN ONLY) --- #}
{% if adminMode %}
<div class="modal fade" id="reponseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fas fa-reply me-2"></i>Action Administrateur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reponseForm" method="POST">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Réponse</label>
                        <textarea name="reponse" id="reponseText" class="form-control" rows="4" placeholder="Votre message ici..."></textarea>
                        <small class="text-primary">Si vous écrivez une réponse, le statut passera à <strong>TRAITEE</strong> automatique.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">Ou changer direct</label>
                        <select name="statut" id="statutSelect" class="form-select">
                            <option value="TRAITEE">Accepter (TRAITEE)</option>
                            <option value="REJETEE">Rejeter (REJETEE)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">Valider</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<script>
// --- Recherche Logic ---
const searchInput = document.getElementById('rechercheReclamation');
if(searchInput) {
    searchInput.addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        let rows = document.querySelectorAll('#tableReclamation tbody tr');
        rows.forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
        });
    });
}

// --- Modal Logic ---
function openReponseModal(id, currentReponse) {
    {% if not adminMode %}
    return;
    {% endif %}
    const modalElement = document.getElementById('reponseModal');
    if(!modalElement) return;
    const modal = new bootstrap.Modal(modalElement);
    const form = document.getElementById('reponseForm');
    
    // Thabet f'el route mte3ek mta3 el reply
    form.action = "/reclamation/admin-reply/" + id;
    
    const cleanReponse = (currentReponse === "Pas encore de réponse") ? "" : currentReponse;
    document.getElementById('reponseText').value = cleanReponse;
    
    modal.show();
}
</script>
{% endblock %}
