{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
<style>
    /* Modern Premium Design */
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
        font-family: 'Outfit', sans-serif;
    }

    .form-container {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(25px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 50px;
        margin-top: 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
        position: relative;
        /* overflow: hidden; */ /* Remove this to let the assistant float outside */
    }

    .form-container::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    .form-header h2 {
        color: white;
        font-weight: 800;
        font-size: 2.8rem;
        margin-bottom: 10px;
        letter-spacing: -1.5px;
        text-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .inner-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 30px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 1px solid white;
    }

    .custom-label {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.95rem;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-control-custom {
        width: 100% !important;
        border: 2px solid #f1f5f9 !important;
        background: #ffffff !important;
        border-radius: 18px !important;
        padding: 16px 20px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 1rem;
        color: #0f172a;
    }

    /* Uniquement pour le textarea */
    textarea.form-control-custom {
        min-height: 250px !important;
        border-radius: 24px !important;
        padding: 25px !important;
        font-size: 1.1rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02) !important;
    }

    .form-control-custom:focus {
        border-color: #6366f1 !important;
        background: white !important;
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.1) !important;
        transform: translateY(-2px);
    }

    /* Pro Voice Dictation Section */
    .voice-control-wrapper {
        display: flex;
        align-items: center;
        background: #f1f5f9;
        padding: 8px 16px;
        border-radius: 25px;
        gap: 15px;
        transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid #e2e8f0;
        cursor: pointer;
        user-select: none;
        position: relative;
        overflow: hidden;
    }

    .voice-control-wrapper:hover {
        background: #e2e8f0;
        border-color: #cbd5e1;
        transform: translateY(-2px);
    }

    .voice-control-wrapper.recording {
        background: #fff1f2;
        border-color: #ef4444;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.2);
    }

    .voice-btn-container {
        position: relative;
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: -10px;
    }

    .voice-btn {
        background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        color: white !important;
        border: none;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        font-size: 1.5rem;
        z-index: 5;
        position: relative;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
    }

    .voice-btn i {
        color: white !important;
    }

    .voice-control-wrapper.recording .voice-btn {
        background: #ef4444;
        animation: pulseRecord 1.2s infinite;
        transform: scale(1.1);
    }

    @keyframes pulseRecord {
        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(239, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .voice-label {
        font-size: 0.95rem;
        font-weight: 800;
        color: #1e293b;
        padding-right: 10px;
    }

    .recording-status {
        display: none;
        align-items: center;
        gap: 12px;
        color: #ef4444;
        font-size: 0.95rem;
        font-weight: 800;
        padding-right: 15px;
    }

    .voice-control-wrapper.recording .recording-status {
        display: flex;
    }
    
    .voice-control-wrapper.recording .voice-label {
        display: none;
    }

    /* Modern Wave Animation */
    .wave-bars {
        display: flex;
        align-items: center;
        gap: 3px;
        height: 20px;
    }

    .wave-bar {
        width: 3px;
        height: 4px;
        background: #ef4444;
        border-radius: 10px;
        animation: wave-grow 1s ease-in-out infinite;
    }

    .wave-bar:nth-child(2) { animation-delay: 0.1s; }
    .wave-bar:nth-child(3) { animation-delay: 0.2s; }
    .wave-bar:nth-child(4) { animation-delay: 0.3s; }
    .wave-bar:nth-child(5) { animation-delay: 0.4s; }

    @keyframes wave-grow {
        0%, 100% { height: 4px; }
        50% { height: 18px; }
    }

    /* AI Button Premium */
    .ai-magic-btn {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white !important;
        border: none;
        padding: 12px 28px;
        border-radius: 20px;
        font-weight: 800;
        letter-spacing: 0.5px;
        transition: 0.4s;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 10px 25px rgba(168, 85, 247, 0.3);
        position: relative;
        overflow: hidden;
    }

    .ai-magic-btn::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 60%);
        animation: rotateGlow 4s linear infinite;
    }

    @keyframes rotateGlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .ai-magic-btn:hover:not(:disabled) {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 20px 40px rgba(168, 85, 247, 0.4);
    }

    .ai-magic-btn i {
        font-size: 1.2rem;
        color: #ffd700;
        animation: sparkle 2s infinite;
    }

    @keyframes sparkle {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(1.2); }
    }

    /* Badges & Results */
    .analysis-badge {
        padding: 8px 16px;
        border-radius: 14px;
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #475569;
        transition: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .badge-sentiment-COLERE { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }
    .badge-sentiment-POSITIF { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
    .badge-urgency-HAUTE { 
        background: #fff1f2; color: #be123c; border-color: #fecdd3;
        box-shadow: 0 0 15px rgba(190, 18, 60, 0.2);
    }

    .preview-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 0;
        margin-top: 35px;
        position: relative;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid rgba(99, 102, 241, 0.2);
    }

    .preview-header {
        background: #f8fafc;
        padding: 15px 25px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .preview-header-info {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        color: #1e293b;
        font-size: 0.9rem;
    }

    .preview-actions {
        display: flex;
        gap: 10px;
    }

    .action-btn-mini {
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        border: 1px solid #e2e8f0;
        background: white;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn-mini:hover {
        background: #f1f5f9;
        transform: translateY(-2px);
    }

    .action-btn-apply {
        background: #6366f1 !important;
        color: white !important;
        border-color: #6366f1 !important;
    }

    .preview-body {
        padding: 30px;
        font-family: 'Inter', serif;
        line-height: 1.8;
        color: #334155;
        font-size: 1rem;
        min-height: 150px;
        position: relative;
    }

    .email-meta {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px dashed #e2e8f0;
    }

    .typewriter-cursor {
        display: inline-block;
        width: 2px;
        height: 1em;
        background: #6366f1;
        margin-left: 2px;
        animation: blink 0.8s infinite;
        vertical-align: middle;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .btn-submit {
        background: #0f172a;
        color: white !important;
        border: none;
        padding: 20px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 1.1rem;
        transition: 0.4s;
        margin-top: 20px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    /* Clear Button */
    .btn-clear {
        position: absolute;
        right: 20px;
        top: 20px;
        background: rgba(241, 245, 249, 0.8);
        border: 1px solid #e2e8f0;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        cursor: pointer;
        transition: 0.3s;
        z-index: 10;
    }

    .btn-clear:hover {
        background: #fee2e2;
        color: #ef4444;
        border-color: #fecaca;
        transform: scale(1.1);
    }

    .btn-submit:hover {
        background: #1e293b;
        transform: translateY(-4px);
        box-shadow: 0 20px 30px rgba(15, 23, 42, 0.2);
    }

    .ai-overlay {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(47, 53, 66, 0.9);
        color: white;
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(5px);
        opacity: 0;
        transform: translateY(10px);
        transition: 0.3s;
        pointer-events: none;
        z-index: 10;
    }

    .ai-overlay.active {
        opacity: 1;
        transform: translateY(0);
    }

    .ai-glow {
        animation: aiGlow 2s infinite;
        border-color: #6366f1 !important;
    }

    @keyframes aiGlow {
        0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); }
        50% { box-shadow: 0 0 20px 5px rgba(99, 102, 241, 0.2); }
        100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); }
    }

    /* Floating Labels for Inputs */
    .input-group-custom {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        z-index: 10;
        pointer-events: none;
    }

    /* Assistant Bot */
    .assistant-bot {
        position: absolute;
        right: -60px;
        top: -40px;
        width: 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: float 4s ease-in-out infinite;
        z-index: 100;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-15px); }
    }

    .bot-avatar {
        width: 80px;
        height: 80px;
        background: #6366f1;
        border-radius: 50%;
        box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid white;
        position: relative;
        animation: botPulse 3s ease-in-out infinite;
    }

    .bot-avatar::after {
        content: '🤖';
        font-size: 2.5rem;
    }

    @keyframes botPulse {
        0%, 100% { transform: scale(1); box-shadow: 0 15px 35px rgba(99, 102, 241, 0.4); }
        50% { transform: scale(1.05); box-shadow: 0 20px 45px rgba(99, 102, 241, 0.5); }
    }

    .bot-bubble {
        background: white;
        padding: 12px 18px;
        border-radius: 20px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
        margin-top: 15px;
        border: 1px solid #e2e8f0;
        text-align: center;
        position: relative;
        width: 180px;
    }

    .bot-bubble::before {
        content: '';
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 10px solid transparent;
        border-right: 10px solid transparent;
        border-bottom: 10px solid white;
    }

    @media (max-width: 1200px) {
        .assistant-bot {
            position: relative;
            right: 0;
            top: 0;
            width: 100%;
            flex-direction: row;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }
        .bot-bubble { margin-top: 0; width: auto; }
        .bot-bubble::before {
            top: 50%;
            left: -10px;
            transform: translateY(-50%);
            border-bottom: 10px solid transparent;
            border-top: 10px solid transparent;
            border-right: 10px solid white;
        }
    }
</style>

<div class="container pb-5">
    <div class="form-container">
        <!-- Assistant Bot -->
        <div class="assistant-bot">
            <div class="bot-avatar">
                <i class="fas fa-robot"></i>
                <div class="bot-status-dot"></div>
            </div>
            <div class="bot-bubble" id="bot-message">
                Mar7ba! A7kili chnoua el mochkla w ena n3awnek.
            </div>
        </div>

        <div class="form-header">
            <h2>Nouvelle Plainte <span id="ai-status-emoji"></span></h2>
            <p>Notre équipe est là pour vous aider. Décrivez votre problème ci-dessous.</p>
        </div>

        <div class="inner-card">
            {{ form_start(form) }}
                
                <div class="mb-4">
                    <label class="custom-label">
                        <i class="bi bi-tag-fill"></i> Quel est le type de votre problème ?
                    </label>
                    <div class="input-group-custom">
                        <i class="fas fa-list-ul field-icon"></i>
                        {{ form_widget(form.type, {'attr': {'class': 'form-control-custom form-select', 'id': 'reclamation_type'}}) }}
                    </div>
                    <div id="ai-category-hint" class="small text-primary mt-1" style="display:none">
                        <i class="fas fa-magic me-1"></i> Catégorie détectée par l'IA
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="custom-label mb-0">
                            <i class="bi bi-chat-left-text-fill"></i> Détails de votre réclamation
                        </label>
                        
                        <div class="d-flex gap-3">
                            <div class="voice-control-wrapper" id="voice-trigger">
                                <div class="voice-btn-container">
                                    <button type="button" class="voice-btn" id="btn-voice-dictation">
                                        <i class="fas fa-microphone"></i>
                                    </button>
                                </div>
                                <span class="voice-label">Dicter en Darija</span>
                                <div class="recording-status">
                                    <div class="wave-bars">
                                        <div class="wave-bar"></div>
                                        <div class="wave-bar"></div>
                                        <div class="wave-bar"></div>
                                        <div class="wave-bar"></div>
                                        <div class="wave-bar"></div>
                                    </div>
                                    <span>Écoute en cours...</span>
                                </div>
                            </div>

                            <button type="button" class="ai-magic-btn" id="btn-improve-text">
                                <i class="fas fa-wand-magic-sparkles"></i> Améliorer
                            </button>
                        </div>
                    </div>
                    
                    <div class="input-group-custom">
                        <button type="button" class="btn-clear" id="btn-clear-text" title="Effacer le texte">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        {{ form_widget(form.contenu, {'attr': {
                            'class': 'form-control-custom', 
                            'id': 'reclamation_contenu', 
                            'rows': '6',
                            'placeholder': 'Expliquez-nous dhoabt chnoua sarr... (Darija tounsi ok!)'
                        }}) }}
                        
                        {# AI Loading Overlay #}
                        <div id="ai-loading" class="ai-overlay">
                            <div class="spinner-border spinner-border-sm text-light" role="status"></div>
                            <span>L'IA analyse votre texte...</span>
                        </div>
                    </div>
                    <div class="text-danger small">{{ form_errors(form.contenu) }}</div>

                    {# AI Analysis Results #}
                    <div class="d-flex flex-wrap gap-2">
                        <div id="badge-sentiment" class="analysis-badge">
                            <i class="fas fa-smile"></i> <span>Sentiment</span>
                        </div>
                        <div id="badge-urgency" class="analysis-badge">
                            <i class="fas fa-bolt"></i> <span>Urgence</span>
                        </div>
                    </div>

                    {# Live Preview Card (Email Style) #}
                    <div id="ai-preview" class="preview-card" style="display:none">
                        <div class="preview-header">
                            <div class="preview-header-info">
                                <i class="fas fa-envelope-open-text text-primary"></i>
                                <span>Brouillon de la Réclamation</span>
                            </div>
                            <div class="preview-actions">
                                <button type="button" class="action-btn-mini" id="btn-copy-preview">
                                    <i class="fas fa-copy"></i> Copier
                                </button>
                                <button type="button" class="action-btn-mini action-btn-apply" id="btn-apply-preview">
                                    <i class="fas fa-check-circle"></i> Appliquer
                                </button>
                            </div>
                        </div>
                        <div class="preview-body">
                            <div class="email-meta">
                                <div><strong>De:</strong> {{ app.user.email|default('Client EcoAdventure') }}</div>
                                <div><strong>Objet:</strong> Réclamation formelle - <span id="preview-subject-type">...</span></div>
                            </div>
                            <div id="preview-text"></div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane me-2"></i> Envoyer ma réclamation
                </button>

            {{ form_end(form) }}

            <div class="text-center mt-4 pt-3 border-top">
                <a href="{{ path('app_reclamation_index') }}" class="text-decoration-none text-muted fw-bold small">
                    <i class="fas fa-arrow-left me-1"></i> Annuler et retourner à la liste
                </a>
            </div>
        </div>
    </div>
</div>

{# Javascript pour l'Intelligence Artificielle #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const aiBtn = document.getElementById('btn-improve-text');
    const voiceBtn = document.getElementById('btn-voice-dictation');
    const textarea = document.getElementById('reclamation_contenu');
    const overlay = document.getElementById('ai-loading');
    const typeSelect = document.getElementById('reclamation_type');
    
    // UI Elements for AI results
    const badgeSentiment = document.getElementById('badge-sentiment');
    const badgeUrgency = document.getElementById('badge-urgency');
    const previewCard = document.getElementById('ai-preview');
    const previewText = document.getElementById('preview-text');
    const categoryHint = document.getElementById('ai-category-hint');
    const statusEmoji = document.getElementById('ai-status-emoji');

    // Assistant Bot Messages
    const botMessage = document.getElementById('bot-message');
    function updateBot(msg, isAi = false) {
        botMessage.style.opacity = 0;
        setTimeout(() => {
            botMessage.innerText = msg;
            botMessage.style.opacity = 1;
            if(isAi) botMessage.style.borderColor = "#6366f1";
            else botMessage.style.borderColor = "#e2e8f0";
        }, 300);
    }

    // 1. Voice Dictation Feature
    const voiceTrigger = document.getElementById('voice-trigger');
    
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const recognition = new SpeechRecognition();
        
        recognition.lang = 'ar-TN'; 
        recognition.continuous = true;
        recognition.interimResults = true;

        let isRecording = false;

        voiceTrigger.addEventListener('click', () => {
            if (isRecording) {
                recognition.stop();
            } else {
                try {
                    recognition.start();
                } catch (e) {
                    console.error("Recognition already started", e);
                }
            }
        });

        recognition.onstart = () => {
            isRecording = true;
            voiceTrigger.classList.add('recording');
            textarea.placeholder = "Djawebni, a7ki chnoua sarr...";
            updateBot("Ena nasma3 fik, tfadhel a7ki...");
            statusEmoji.innerText = '🎙️';
        };

        recognition.onend = () => {
            isRecording = false;
            voiceTrigger.classList.remove('recording');
            textarea.placeholder = "Expliquez-nous dhoabt chnoua sarr...";
            updateBot("Sma3tek! Tawa clicki 3la 'Améliorer' bech nriglek el texte.");
        };

        recognition.onresult = (event) => {
            let interimTranscript = '';
            let finalTranscript = '';

            for (let i = event.resultIndex; i < event.results.length; ++i) {
                if (event.results[i].isFinal) {
                    finalTranscript += event.results[i][0].transcript;
                } else {
                    interimTranscript += event.results[i][0].transcript;
                }
            }

            if (finalTranscript) {
                // On ajoute le texte final
                const currentVal = textarea.value.trim();
                textarea.value = (currentVal ? currentVal + " " : "") + finalTranscript;
                textarea.dispatchEvent(new Event('input'));
            }
            
            // On peut afficher l'interim dans le placeholder ou un petit badge si on veut
            if (interimTranscript) {
                textarea.placeholder = "... " + interimTranscript;
            }
        };

        recognition.onerror = (event) => {
            console.error("Speech Recognition Error", event.error);
            isRecording = false;
            voiceTrigger.classList.remove('recording');
            if (event.error === 'not-allowed') {
                alert("L'accès au microphone a été refusé. Veuillez l'autoriser pour utiliser la dictée.");
            }
        };
    } else {
        voiceTrigger.style.display = 'none';
    }

    // Clear text feature
    const clearBtn = document.getElementById('btn-clear-text');
    if(clearBtn && textarea) {
        clearBtn.addEventListener('click', () => {
            if (confirm("Effacer tout le contenu ?")) {
                textarea.value = '';
                textarea.focus();
                previewCard.style.display = 'none';
            }
        });
    }

    // 2. AI Enhancement Feature
    if(aiBtn && textarea) {
        aiBtn.addEventListener('click', async function() {
            const originalText = textarea.value.trim();
            
            if(originalText === '') {
                textarea.placeholder = "Écrivez d'abord quelque chose (même en Darija)...";
                textarea.focus();
                return;
            }
            
            aiBtn.disabled = true;
            aiBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Analyse...';
            textarea.classList.add('ai-glow');
            overlay.classList.add('active');
            
            try {
                const response = await fetch('/api/reclamation/enhance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: originalText })
                });
                
                const data = await response.json();

                if (response.ok && data.enhancedText) {
                    if (data.isFallback) {
                        updateBot("Sma7ni, l'IA t3abet tawa (Quota), jarreb tawa chwaya ekhor wala baddal el Clé API!");
                    }
                    else if (data.enhancedText.trim() === originalText.trim()) {
                        updateBot("Sma7ni, l'IA ma najmetch t-riguel el texte hedha tawa, jarreb baddal l'ktiba chwaya.");
                    } else {
                        previewCard.style.display = 'block';
                        document.getElementById('preview-subject-type').innerText = data.category || 'Support';
                        typeWriter(data.enhancedText, 'preview-text');
                    }

                    updateBadge(badgeSentiment, 'sentiment', data.sentiment);
                    updateBadge(badgeUrgency, 'urgency', data.urgency);

                    if (data.category) {
                        for (let option of typeSelect.options) {
                            if (option.value.includes(data.category) || data.category.includes(option.value)) {
                                typeSelect.value = option.value;
                                categoryHint.style.display = 'block';
                                break;
                            }
                        }
                    }

                    if (data.enhancedText !== originalText) {
                        if (data.sentiment === 'COLERE') {
                            statusEmoji.innerText = '😟';
                            updateBot("7assit b'ghochek, rani rigueltlek el plainte bech toussel fissa3.");
                        }
                        else if (data.sentiment === 'POSITIF') {
                            statusEmoji.innerText = '😊';
                            updateBot("Ya3tik el sa7a! El texte tawa walla tayara.");
                        }
                        else {
                            statusEmoji.innerText = '📝';
                            updateBot("Saye, rani kammalt l'analyse. Thabbet f'el aperçu!");
                        }
                    }

                    document.querySelector('#ai-loading span').innerText = data.shortDescription || "Analyse terminée !";
                    finishAiProcess();
                }
 else {
                    const errorMsg = data.error || "Erreur inconnue";
                    const errorDetails = data.details || "";
                    console.error("AI Error Details:", errorMsg, errorDetails);
                    
                    document.querySelector('#ai-loading span').innerText = "Erreur IA: " + errorMsg;
                    document.querySelector('#ai-loading span').style.color = "#ff4757";
                    
                    finishAiProcess();
                    alert("Erreur IA: " + errorMsg + "\n" + errorDetails);
                }

            } catch (error) {
                console.error("AI Error:", error);
                runSimulation(originalText);
            }
        });

        function updateBadge(el, type, value) {
            el.className = 'analysis-badge show';
            el.classList.add(`badge-${type}-${value}`);
            const icon = el.querySelector('i');
            const span = el.querySelector('span');
            if (type === 'sentiment') {
                span.innerText = `Ton : ${value}`;
                icon.className = value === 'COLERE' ? 'fas fa-angry' : (value === 'POSITIF' ? 'fas fa-laugh-beam' : 'fas fa-meh');
            } else {
                span.innerText = `Urgence : ${value}`;
                icon.className = 'fas fa-bolt';
            }
        }

        function runSimulation(originalText) {
            setTimeout(() => {
                // Au lieu de mettre un texte bidon, on informe l'utilisateur
                document.querySelector('#ai-loading span').innerText = "Erreur de connexion à l'IA.";
                document.querySelector('#ai-loading span').style.color = "#ff4757";
                
                // On peut quand même faire une petite correction locale simple (majuscule)
                const simpleFix = originalText.charAt(0).toUpperCase() + originalText.slice(1);
                textarea.value = simpleFix;
                
                finishAiProcess();
                
                setTimeout(() => {
                    overlay.classList.remove('active');
                    alert("Désolé, l'IA est temporairement indisponible. Veuillez vérifier votre clé API ou votre connexion.");
                }, 1000);
            }, 1500);
        }


        // Typewriter Effect
        function typeWriter(text, elementId) {
            const element = document.getElementById(elementId);
            element.innerHTML = '';
            let i = 0;
            const speed = 15; // ms

            function type() {
                if (i < text.length) {
                    element.innerHTML = text.substring(0, i + 1) + '<span class="typewriter-cursor"></span>';
                    i++;
                    setTimeout(type, speed);
                } else {
                    element.innerHTML = text; // Remove cursor at end
                }
            }
            type();
        }

        // Apply Preview logic
        document.getElementById('btn-apply-preview').addEventListener('click', () => {
            textarea.value = document.getElementById('preview-text').innerText;
            textarea.dispatchEvent(new Event('input'));
            updateBot("Mabrouk! El texte tawa walla mriguel.");
            // Scroll to textarea
            textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

        // Copy logic
        document.getElementById('btn-copy-preview').addEventListener('click', () => {
            const text = document.getElementById('preview-text').innerText;
            navigator.clipboard.writeText(text);
            const btn = document.getElementById('btn-copy-preview');
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> Copié !';
            setTimeout(() => btn.innerHTML = originalContent, 2000);
        });

        function finishAiProcess() {
            setTimeout(() => {
                overlay.classList.remove('active');
                textarea.classList.remove('ai-glow');
                aiBtn.disabled = false;
                aiBtn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Améliorer';
            }, 1000);
        }
    }
});
</script>
{% endblock %}
