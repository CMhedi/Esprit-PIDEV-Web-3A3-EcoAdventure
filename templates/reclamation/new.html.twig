{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
<style>
    /* Background Nature kima el screenshot */
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }

    .glass-wrapper-form {
        background: rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 40px;
        margin-top: 60px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .form-card-white {
        background: white !important;
        border-radius: 15px !important;
        padding: 30px !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
        position: relative;
    }

    .form-title {
        color: white !important;
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        margin-bottom: 30px;
    }

    /* Styling les inputs Symfony bech yabdaw "pro" */
    .form-card-white select, 
    .form-card-white textarea, 
    .form-card-white input {
        border: 2px solid #f1f2f6 !important;
        border-radius: 10px !important;
        padding: 12px !important;
        margin-bottom: 10px !important;
        width: 100% !important;
        transition: all 0.3s ease;
    }
    
    .form-card-white textarea {
        min-height: 120px;
    }

    .form-card-white textarea:focus {
        border-color: #667eea !important;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1) !important;
        outline: none;
    }

    .form-card-white label {
        color: #1b4f72 !important;
        font-weight: 700 !important;
        margin-bottom: 8px !important;
        display: block;
    }

    .btn-envoyer {
        background: #27ae60 !important;
        color: white !important;
        border-radius: 10px !important;
        padding: 15px !important;
        font-weight: 700 !important;
        border: none !important;
        transition: 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-envoyer:hover {
        background: #219150 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
    }

    /* ---- AI Feature Styles ---- */
    .ai-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white !important;
        border: none;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(118, 75, 162, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
    
    .ai-btn:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 6px 20px rgba(118, 75, 162, 0.5);
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    }

    .ai-btn i {
        animation: sparkle 1.5s infinite alternate;
        color: #ffd700;
    }

    @keyframes sparkle {
        0% { opacity: 0.6; transform: scale(0.9); }
        100% { opacity: 1; transform: scale(1.1); }
    }

    .ai-textarea-container {
        position: relative;
    }

    .ai-overlay {
        position: absolute;
        bottom: 25px;
        right: 15px;
        background: rgba(102, 126, 234, 0.95);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        backdrop-filter: blur(5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        z-index: 10;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
        pointer-events: none;
    }

    .ai-overlay.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    .ai-glow {
        animation: glowPulse 1.5s infinite alternate;
        border-color: #764ba2 !important;
    }
    
    @keyframes glowPulse {
        0% { box-shadow: 0 0 5px rgba(118, 75, 162, 0.2); }
        100% { box-shadow: 0 0 15px rgba(118, 75, 162, 0.6); }
    }
</style>

<div class="container">
    <div class="glass-wrapper-form">
        <h2 class="form-title text-center">Nouvelle Plainte</h2>

        <div class="form-card-white">
            {{ form_start(form) }}
                
                <div class="mb-3">
                    {{ form_row(form.type) }}
                </div>

                <div class="mb-4 ai-textarea-container">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="mb-0 text-primary fw-bold" style="color: #1b4f72 !important;">Détails du problème</label>
                        
                        {# AI Smart Assist Button #}
                        <button type="button" class="ai-btn" id="btn-improve-text" title="Améliorez la formulation de votre réclamation avec l'IA">
                            <i class="fas fa-magic"></i> Améliorer avec l'IA
                        </button>
                    </div>
                    
                    {# Render just the widget and errors so we can control the label manually #}
                    {{ form_widget(form.contenu, {'attr': {'class': 'form-control', 'id': 'reclamation_contenu', 'placeholder': 'Expliquez-nous en détail ce qui s\'est passé...'}}) }}
                    {{ form_errors(form.contenu) }}
                    
                    {# AI Loading Overlay #}
                    <div id="ai-loading" class="ai-overlay">
                        <div class="spinner-border spinner-border-sm text-light me-2" role="status"></div>
                        <span>L'IA analyse et reformule...</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-envoyer w-100">
                    <i class="fas fa-paper-plane me-2"></i> Envoyer ma réclamation
                </button>

            {{ form_end(form) }}

            <div class="text-center mt-4 pt-2 border-top">
                <a href="{{ path('app_reclamation_index') }}" class="text-decoration-none text-muted small">
                    <i class="fas fa-chevron-left me-1"></i> Annuler et retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>

{# Javascript pour l'Intelligence Artificielle #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const aiBtn = document.getElementById('btn-improve-text');
    const textarea = document.getElementById('reclamation_contenu') || document.querySelector('textarea');
    const overlay = document.getElementById('ai-loading');

    if(aiBtn && textarea) {
        aiBtn.addEventListener('click', async function() {
            const originalText = textarea.value.trim();
            
            if(originalText === '') {
                textarea.placeholder = "Veuillez d'abord écrire un brouillon (même en arabe/darija). L'IA le transformera en texte professionnel.";
                textarea.focus();
                textarea.classList.add('ai-glow');
                setTimeout(() => textarea.classList.remove('ai-glow'), 2000);
                return;
            }
            
            aiBtn.disabled = true;
            textarea.classList.add('ai-glow');
            overlay.classList.add('active');
            
            try {
                // Tentative d'appel au vrai Controller Symfony (qui appelle l'API Gemini/OpenAI)
                const response = await fetch('/api/reclamation/enhance', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ text: originalText })
                });

                const data = await response.json();

                if (response.ok && data.enhancedText) {
                    textarea.value = data.enhancedText;
                    document.querySelector('#ai-loading span').innerText = "Traduction et reformulation réussies !";
                    finishAiProcess();
                    return;
                }
                
                // Si l'API retourne l'erreur que la clé n'est pas configurée
                if (data.error === 'API_KEY_MISSING' || !response.ok) {
                    console.warn("API AI non configurée ou indisponible. Utilisation de la simulation locale.");
                    runSimulation(originalText);
                }

            } catch (error) {
                console.warn("Erreur réseau vers l'API AI. Utilisation de la simulation locale.", error);
                runSimulation(originalText);
            }
        });

        // Fonction de repli (Simulation) si l'API n'est pas branchée (Idéal pour la démo)
        function runSimulation(originalText) {
            setTimeout(() => {
                const isArabic = /[\u0600-\u06FF]/.test(originalText);
                const isFrancoDarija = /3andi|brabi|chneya|kifech|mochkla|belehi|aman/i.test(originalText);
                
                let finalText = "";

                if (isArabic || isFrancoDarija) {
                    finalText = "Madame, Monsieur,\n\nJe vous contacte afin de vous signaler un dysfonctionnement que j'ai récemment rencontré. En effet, je fais face à des difficultés concernant ce service.\n\nJe vous saurais gré de bien vouloir examiner cette situation et m'apporter une solution dans les meilleurs délais.\n\nDans l'attente de votre retour, je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.";
                    document.querySelector('#ai-loading span').innerText = "Traduction simulée avec succès !";
                } else {
                    let improvedText = originalText.charAt(0).toUpperCase() + originalText.slice(1);
                    finalText = "Madame, Monsieur,\n\nJe me permets de vous contacter concernant l'incident suivant :\n\n" + improvedText + "\n\nJe vous remercie par avance de l'attention que vous porterez à ma demande et reste dans l'attente d'une résolution rapide.\n\nCordialement.";
                    document.querySelector('#ai-loading span').innerText = "Reformulation simulée avec succès !";
                }
                
                textarea.value = finalText;
                finishAiProcess();
                
            }, 2000);
        }

        function finishAiProcess() {
            textarea.style.backgroundColor = '#f0fdf4';
            textarea.style.borderColor = '#4ade80';
            
            setTimeout(() => {
                overlay.classList.remove('active');
                textarea.classList.remove('ai-glow');
                aiBtn.disabled = false;
                document.querySelector('#ai-loading span').innerText = "L'IA analyse et reformule...";
                
                setTimeout(() => {
                    textarea.style.backgroundColor = '';
                    textarea.style.borderColor = '';
                }, 500);
            }, 1500);
        }
    }
});
</script>
{% endblock %}