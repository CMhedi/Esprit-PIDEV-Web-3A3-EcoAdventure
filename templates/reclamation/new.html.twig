{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
<style>
    /* Background Nature kima el screenshot */
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }

    .form-container {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 40px;
        margin-top: 60px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 35px;
    }

    .form-header h2 {
        color: white;
        font-weight: 800;
        font-size: 2.2rem;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .form-header p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1rem;
    }

    .inner-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .custom-label {
        font-weight: 700;
        color: #2f3542;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .input-group-custom {
        position: relative;
        margin-bottom: 25px;
    }

    .input-group-custom i.field-icon {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #3a7bd5;
        font-size: 1.1rem;
        z-index: 5;
    }

    .form-control-custom {
        width: 100%;
        padding: 15px 20px 15px 55px !important;
        border-radius: 15px !important;
        border: 2px solid #f1f2f6 !important;
        background: #f8f9fa !important;
        transition: 0.3s;
        font-size: 1rem;
    }

    .form-control-custom:focus {
        border-color: #3a7bd5 !important;
        background: white !important;
        box-shadow: 0 0 0 4px rgba(58, 123, 213, 0.1) !important;
        outline: none;
    }

    textarea.form-control-custom {
        padding-top: 15px !important;
        min-height: 150px;
    }

    /* AI Magic Button */
    .ai-magic-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white !important;
        border: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.85rem;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(118, 75, 162, 0.3);
    }

    .ai-magic-btn:hover:not(:disabled) {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 25px rgba(118, 75, 162, 0.5);
    }

    .ai-magic-btn i {
        color: #ffd700;
        animation: pulseMagic 2s infinite;
    }

    @keyframes pulseMagic {
        0% { transform: scale(1); filter: drop-shadow(0 0 2px gold); }
        50% { transform: scale(1.2); filter: drop-shadow(0 0 8px gold); }
        100% { transform: scale(1); filter: drop-shadow(0 0 2px gold); }
    }

    .btn-submit {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white !important;
        border: none;
        padding: 18px;
        border-radius: 15px;
        font-weight: 800;
        width: 100%;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(46, 204, 113, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(46, 204, 113, 0.4);
    }

    .ai-overlay {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(47, 53, 66, 0.9);
        color: white;
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(5px);
        opacity: 0;
        transform: translateY(10px);
        transition: 0.3s;
        pointer-events: none;
        z-index: 10;
    }

    .ai-overlay.active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<div class="container pb-5">
    <div class="form-container">
        <div class="form-header">
            <h2>Nouvelle Plainte</h2>
            <p>Notre équipe est là pour vous aider. Décrivez votre problème ci-dessous.</p>
        </div>

        <div class="inner-card">
            {{ form_start(form) }}
                
                <div class="mb-4">
                    <label class="custom-label">
                        <i class="bi bi-tag-fill"></i> Quel est le type de votre problème ?
                    </label>
                    <div class="input-group-custom">
                        <i class="fas fa-list-ul field-icon"></i>
                        {{ form_widget(form.type, {'attr': {'class': 'form-control-custom form-select'}}) }}
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="custom-label mb-0">
                            <i class="bi bi-chat-left-text-fill"></i> Détails de votre réclamation
                        </label>
                        
                        <button type="button" class="ai-magic-btn" id="btn-improve-text">
                            <i class="fas fa-magic"></i> Améliorer avec l'IA
                        </button>
                    </div>
                    
                    <div class="input-group-custom">
                        {{ form_widget(form.contenu, {'attr': {
                            'class': 'form-control-custom', 
                            'id': 'reclamation_contenu', 
                            'placeholder': 'Décrivez votre situation en quelques mots...'
                        }}) }}
                        
                        {# AI Loading Overlay #}
                        <div id="ai-loading" class="ai-overlay">
                            <div class="spinner-border spinner-border-sm text-light" role="status"></div>
                            <span>L'IA analyse votre texte...</span>
                        </div>
                    </div>
                    <div class="text-danger small">{{ form_errors(form.contenu) }}</div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-paper-plane me-2"></i> Envoyer ma réclamation
                </button>

            {{ form_end(form) }}

            <div class="text-center mt-4 pt-3 border-top">
                <a href="{{ path('app_reclamation_index') }}" class="text-decoration-none text-muted fw-bold small">
                    <i class="fas fa-arrow-left me-1"></i> Annuler et retourner à la liste
                </a>
            </div>
        </div>
    </div>
</div>

{# Javascript pour l'Intelligence Artificielle #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const aiBtn = document.getElementById('btn-improve-text');
    const textarea = document.getElementById('reclamation_contenu') || document.querySelector('textarea');
    const overlay = document.getElementById('ai-loading');

    if(aiBtn && textarea) {
        aiBtn.addEventListener('click', async function() {
            const originalText = textarea.value.trim();
            
            if(originalText === '') {
                textarea.placeholder = "Veuillez d'abord écrire un brouillon (même en arabe/darija). L'IA le transformera en texte professionnel.";
                textarea.focus();
                textarea.classList.add('ai-glow');
                setTimeout(() => textarea.classList.remove('ai-glow'), 2000);
                return;
            }
            
            aiBtn.disabled = true;
            textarea.classList.add('ai-glow');
            overlay.classList.add('active');
            
            try {
                // Tentative d'appel au vrai Controller Symfony (qui appelle l'API Gemini/OpenAI)
                const response = await fetch('/api/reclamation/enhance', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ text: originalText })
                });

                const data = await response.json();

                if (response.ok && data.enhancedText) {
                    textarea.value = data.enhancedText;
                    document.querySelector('#ai-loading span').innerText = "Traduction et reformulation réussies !";
                    finishAiProcess();
                    return;
                }
                
                // Si l'API retourne l'erreur que la clé n'est pas configurée
                if (data.error === 'API_KEY_MISSING' || !response.ok) {
                    console.warn("API AI non configurée ou indisponible. Utilisation de la simulation locale.");
                    runSimulation(originalText);
                }

            } catch (error) {
                console.warn("Erreur réseau vers l'API AI. Utilisation de la simulation locale.", error);
                runSimulation(originalText);
            }
        });

        // Fonction de repli (Simulation) si l'API n'est pas branchée (Idéal pour la démo)
        function runSimulation(originalText) {
            setTimeout(() => {
                const isArabic = /[\u0600-\u06FF]/.test(originalText);
                const isFrancoDarija = /3andi|brabi|chneya|kifech|mochkla|belehi|aman/i.test(originalText);
                
                let finalText = "";

                if (isArabic || isFrancoDarija) {
                    finalText = "Madame, Monsieur,\n\nJe vous contacte afin de vous signaler un dysfonctionnement que j'ai récemment rencontré. En effet, je fais face à des difficultés concernant ce service.\n\nJe vous saurais gré de bien vouloir examiner cette situation et m'apporter une solution dans les meilleurs délais.\n\nDans l'attente de votre retour, je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.";
                    document.querySelector('#ai-loading span').innerText = "Traduction simulée avec succès !";
                } else {
                    let improvedText = originalText.charAt(0).toUpperCase() + originalText.slice(1);
                    finalText = "Madame, Monsieur,\n\nJe me permets de vous contacter concernant l'incident suivant :\n\n" + improvedText + "\n\nJe vous remercie par avance de l'attention que vous porterez à ma demande et reste dans l'attente d'une résolution rapide.\n\nCordialement.";
                    document.querySelector('#ai-loading span').innerText = "Reformulation simulée avec succès !";
                }
                
                textarea.value = finalText;
                finishAiProcess();
                
            }, 2000);
        }

        function finishAiProcess() {
            textarea.style.backgroundColor = '#f0fdf4';
            textarea.style.borderColor = '#4ade80';
            
            setTimeout(() => {
                overlay.classList.remove('active');
                textarea.classList.remove('ai-glow');
                aiBtn.disabled = false;
                document.querySelector('#ai-loading span').innerText = "L'IA analyse et reformule...";
                
                setTimeout(() => {
                    textarea.style.backgroundColor = '';
                    textarea.style.borderColor = '';
                }, 500);
            }, 1500);
        }
    }
});
</script>
{% endblock %}