{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
<style>
    /* Background Nature kima el screenshot */
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }

    .glass-wrapper-form {
        background: rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(15px) !important;
        -webkit-backdrop-filter: blur(15px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 40px;
        margin-top: 60px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .form-card-white {
        background: white !important;
        border-radius: 15px !important;
        padding: 30px !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
    }

    .form-title {
        color: white !important;
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        margin-bottom: 30px;
    }

    /* Styling les inputs Symfony bech yabdaw "pro" */
    .form-card-white select, 
    .form-card-white textarea, 
    .form-card-white input {
        border: 2px solid #f1f2f6 !important;
        border-radius: 10px !important;
        padding: 12px !important;
        margin-bottom: 10px !important;
        width: 100% !important;
    }

    .form-card-white label {
        color: #1b4f72 !important;
        font-weight: 700 !important;
        margin-bottom: 8px !important;
        display: block;
    }

    .btn-envoyer {
        background: #27ae60 !important;
        color: white !important;
        border-radius: 10px !important;
        padding: 15px !important;
        font-weight: 700 !important;
        border: none !important;
        transition: 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-envoyer:hover {
        background: #219150 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(39, 174, 96, 0.4);
    }
</style>

<div class="container">
    <div class="glass-wrapper-form">
        <h2 class="form-title text-center">Nouvelle Plainte</h2>

        <div class="form-card-white">
            {{ form_start(form) }}
                
                <div class="mb-3">
                    {# Symfony wa7dou bech i-talla3 el label w el select #}
                    {{ form_row(form.type) }}
                </div>

                <div class="mb-4">
                    {{ form_row(form.contenu) }}
                </div>

                {# Ma n'zidoch statut wala user houni khater yetzadou auto f'el Controller #}

                <button type="submit" class="btn btn-envoyer w-100">
                    <i class="fas fa-paper-plane me-2"></i> Envoyer ma réclamation
                </button>

            {{ form_end(form) }}

            <div class="text-center mt-4 pt-2 border-top">
                <a href="{{ path('app_reclamation_index') }}" class="text-decoration-none text-muted small">
                    <i class="fas fa-chevron-left me-1"></i> Annuler et retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}