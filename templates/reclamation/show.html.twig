{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Détails Réclamation - EcoAdventure{% endblock %}

{% block body %}
<style>
    {% if not is_granted('ROLE_ADMIN') %}
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }
    {% endif %}

    .glass-container {
        background: rgba(255, 255, 255, 0.1) !important;
        backdrop-filter: blur(20px) !important;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 40px;
        margin-top: 40px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.2);
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }

    .detail-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .info-label {
        font-weight: 800;
        color: rgba(0, 0, 0, 0.4);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2f3542;
        margin-bottom: 25px;
    }

    .message-box {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 20px;
        border-left: 5px solid #3a7bd5;
        font-size: 1rem;
        line-height: 1.6;
        color: #2f3542;
        margin-bottom: 25px;
    }

    .response-box {
        background: #eef2f7;
        border-radius: 15px;
        padding: 20px;
        border: 1px dashed #3a7bd5;
        font-style: italic;
    }

    .status-pill {
        padding: 8px 20px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .btn-back {
        background: #f1f2f6;
        color: #2f3542;
        padding: 10px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.2s;
    }
</style>

<div class="container pb-5">
    <div class="glass-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-white fw-800 mb-0">Détails de la Plainte</h1>
            <span class="status-pill {% if reclamation.statut.value == 'TRAITEE' %}bg-success text-white{% elseif reclamation.statut.value == 'REJETEE' %}bg-danger text-white{% else %}bg-warning text-dark{% endif %} shadow-sm">
                {{ reclamation.statut.value }}
            </span>
        </div>

        <div class="detail-card">
            <div class="row">
                <div class="col-md-6">
                    <div class="info-label">Type de problème</div>
                    <div class="info-value">{{ reclamation.type }}</div>
                </div>
                <div class="col-md-6">
                    <div class="info-label">Date de soumission</div>
                    <div class="info-value">{{ reclamation.date_creation|date('d M Y à H:i') }}</div>
                </div>
            </div>

            <div class="mb-4">
                <div class="info-label">Description de votre problème</div>
                <div class="message-box">
                    {{ reclamation.contenu|nl2br }}
                </div>
            </div>

            <div class="mb-4">
                <div class="info-label">Réponse de l'équipe EcoAdventure</div>
                <div class="response-box {% if not reclamation.reponse %}text-muted{% else %}text-dark{% endif %}">
                    {% if reclamation.reponse %}
                        <i class="fas fa-reply me-2 text-primary"></i> {{ reclamation.reponse }}
                    {% else %}
                        <i class="fas fa-hourglass-half me-2"></i> En attente d'un retour de nos administrateurs...
                    {% endif %}
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a href="{{ path('app_reclamation_index') }}" class="btn-back">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                </a>
                
                <div class="d-flex gap-2">
                    {% if not is_granted('ROLE_ADMIN') and reclamation.statut.value == 'EN_ATTENTE' %}
                        <a href="{{ path('app_reclamation_edit', {'id_reclamation': reclamation.id_reclamation}) }}" class="btn btn-warning text-dark fw-bold rounded-pill px-4">
                            <i class="fas fa-edit me-1"></i> Modifier
                        </a>
                    {% endif %}
                    {{ include('reclamation/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}