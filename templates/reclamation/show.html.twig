{# templates/reclamation/show.html.twig #}

{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Détails Réclamation - EcoAdventure{% endblock %}
{% block page_title %}{% endblock %}

{% block body %}
<style>
    {% if not is_granted('ROLE_ADMIN') %}
    body {
        background: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=2070') no-repeat center center fixed !important;
        background-size: cover !important;
    }
    {% endif %}

    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

    .details-wrapper {
        font-family: 'Outfit', sans-serif !important;
        padding: 40px 20px;
        animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    .glass-card-details {
        background: white !important;
        border-radius: 40px;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        max-width: 850px;
        margin: 0 auto;
        padding: 50px;
        position: relative;
    }

    .title-details-pro {
        color: #2d5a27 !important; /* Vert ghameq bech iban */
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 40px;
        letter-spacing: -1px;
    }

    .status-badge-details {
        position: absolute;
        top: 50px;
        right: 50px;
        padding: 10px 20px;
        border-radius: 15px;
        font-weight: 800;
        font-size: 0.85rem;
        background: #2d5a27;
        color: white;
        text-transform: uppercase;
    }

    .info-section {
        background: #f8fafc;
        border-radius: 25px;
        padding: 35px;
        margin-bottom: 30px;
        border: 1px solid #edf2f7;
    }

    .label-pro {
        font-weight: 800;
        font-size: 0.8rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
        display: block;
    }

    .value-pro {
        font-weight: 700;
        font-size: 1.15rem;
        color: #1e293b;
    }

    .desc-box {
        background: #f1f5f9;
        padding: 25px;
        border-radius: 20px;
        color: #334155;
        font-weight: 500;
        line-height: 1.6;
        border-left: 5px solid #cbd5e1;
    }

    .response-box {
        background: #f0fdf4;
        padding: 25px;
        border-radius: 20px;
        color: #166534;
        font-weight: 600;
        border: 2px dashed #bbf7d0;
        margin-top: 15px;
    }

    .btn-return {
        background: #f1f5f9;
        color: #475569 !important;
        padding: 15px 30px;
        border-radius: 18px;
        font-weight: 800;
        text-decoration: none;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-return:hover { background: #e2e8f0; color: #1e293b !important; }

</style>

<div class="details-wrapper">
    <div class="glass-card-details">
        <div class="status-badge-details">
            {{ reclamation.statut.value }}
        </div>

        <h1 class="title-details-pro">Détails de la Plainte</h1>

        <div class="info-section">
            <div class="row">
                <div class="col-md-6 mb-4">
                    <span class="label-pro">Type de problème</span>
                    <div class="value-pro">{{ reclamation.type }}</div>
                </div>
                <div class="col-md-6 mb-4">
                    <span class="label-pro">Date de soumission</span>
                    <div class="value-pro">{{ reclamation.date_creation ? reclamation.date_creation|date('d M Y à H:i') : '---' }}</div>
                </div>
            </div>

            <div class="mb-4">
                <span class="label-pro">Description de votre problème</span>
                <div class="desc-box">
                    {{ reclamation.contenu }}
                </div>
            </div>

            {% if reclamation.reponse %}
            <div>
                <span class="label-pro">Réponse de l'équipe EcoAdventure</span>
                <div class="response-box">
                    <i class="bi bi-chat-left-quote-fill me-2"></i>
                    {{ reclamation.reponse }}
                </div>
            </div>
            {% endif %}
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_reclamation_index') }}" class="btn-return">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>

            {% if not is_granted('ROLE_ADMIN') %}
                {{ include('reclamation/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}