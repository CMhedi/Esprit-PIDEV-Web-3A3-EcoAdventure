<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Vérification 2FA - EcoAdventure</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #00c853;
            --primary-glow: rgba(0, 200, 83, 0.3);
            --bg: #0f172a;
            --card: #1e293b;
            --text: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Outfit', sans-serif;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Background animated circles */
        .bg-circles {
            position: absolute;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: -1;
        }
        .circle {
            position: absolute;
            background: var(--primary);
            filter: blur(80px);
            border-radius: 50%;
            opacity: 0.1;
            animation: move 20s infinite alternate;
        }
        @keyframes move {
            from { transform: translate(0, 0); }
            to { transform: translate(100px, 100px); }
        }

        .auth-card {
            background: var(--card);
            padding: 40px;
            border-radius: 32px;
            width: 100%;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
        }

        .icon-box {
            width: 80px;
            height: 80px;
            background: rgba(0, 200, 83, 0.1);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            color: var(--primary);
            font-size: 32px;
            box-shadow: 0 0 20px var(--primary-glow);
        }

        h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        p {
            color: var(--text-muted);
            font-size: 16px;
            line-height: 1.6;
        }

        .status-container {
            margin: 40px 0;
        }

        .pulse {
            width: 64px;
            height: 64px;
            background: var(--primary);
            border-radius: 50%;
            margin: 0 auto 20px;
            animation: pulse-animation 2s infinite;
        }

        @keyframes pulse-animation {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 var(--primary-glow); }
            70% { transform: scale(1); box-shadow: 0 0 0 20px rgba(0, 200, 83, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 200, 83, 0); }
        }

        #status-text {
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-logout {
            margin-top: 24px;
            display: inline-block;
            color: #ef4444;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            opacity: 0.8;
            transition: opacity 0.2s;
        }

        .btn-logout:hover {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div class="bg-circles">
        <div class="circle" style="width: 400px; height: 400px; top: -100px; left: -100px;"></div>
        <div class="circle" style="width: 300px; height: 300px; bottom: -50px; right: -50px; animation-delay: -5s;"></div>
    </div>

    <div class="auth-card">
        <div class="icon-box">
            <i class="fas fa-fingerprint"></i>
        </div>
        <h1>Vérification</h1>
        <p>Approuvez la connexion via votre compte Telegram.</p>

        <div class="status-container">
            <div class="pulse"></div>
            <div id="status-text">En attente de validation...</div>
        </div>

        <a href="{{ path('app_logout') }}" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i> Annuler la connexion
        </a>
    </div>

    <script>
        const statusUrl = '{{ path('app_2fa_status', {token: token}) }}';

        function checkStatus() {
            fetch(statusUrl)
                .then(r => r.json())
                .then(data => {
                    if (data.status === 'approved') {
                        document.getElementById('status-text').innerText = '✅ Accès Autorisé !';
                        document.getElementById('status-text').style.color = 'var(--primary)';
                        setTimeout(() => { window.location.href = '{{ path('app_home') }}'; }, 1000);
                    } else if (data.status === 'rejected') {
                        document.getElementById('status-text').innerText = '❌ Connexion Refusée';
                        document.getElementById('status-text').style.color = '#ef4444';
                        setTimeout(() => { window.location.href = '{{ path('app_logout') }}'; }, 2000);
                    } else {
                        setTimeout(checkStatus, 2000);
                    }
                });
        }
        checkStatus();
    </script>
</body>
</html>
