{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Connexion - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 450px;
        }
    </style>
</head>
<body>
<div class="login-card">
    <form method="post">
        <h2 class="text-center mb-4">Connexion</h2>
        
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="mb-3">
            <label for="inputEmail">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
        </div>

        <div class="mb-3">
            <label for="inputPassword">Mot de passe</label>
            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
            <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary w-100 py-2" type="submit" style="border-radius: 50px; background: #00d2ff; border: none; font-weight: bold;">
            Se connecter
        </button>
        <div class="text-center mt-4">
    <p class="text-muted small">Vous n'avez pas de compte ? 
        <a href="{{ path('app_register') }}" class="fw-bold text-primary text-decoration-none">S'inscrire ici</a>
    </p>
</div>
    </form>
</div>
</body>
</html>