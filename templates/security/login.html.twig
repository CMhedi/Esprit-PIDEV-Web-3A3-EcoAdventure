{# templates/security/login.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Connexion - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 450px;
        }
        /* Style l'el error message bech i-ji rouge w wada7 */
        .alert-error-custom {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="login-card">
    <form method="post" novalidate>
        <h2 class="text-center mb-4 fw-bold" style="color: #2c3e50;">Connexion</h2>
        
        {# 1. Houni el message bi rouge ken famma ghalta #}
        {% if error %}
            <div class="alert-error-custom">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <div class="mb-3">
            <label for="inputEmail" class="small fw-bold mb-1">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control rounded-pill" autocomplete="email" autofocus>
        </div>

        <div class="mb-3">
            <label for="inputPassword" class="small fw-bold mb-1">Mot de passe</label>
            <input type="password" name="password" id="inputPassword" class="form-control rounded-pill" autocomplete="current-password">
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
            <label class="form-check-label small text-muted" for="remember_me">Se souvenir de moi</label>
        </div>

        <button class="btn btn-primary w-100 py-2 mt-2 shadow-sm" type="submit" style="border-radius: 50px; background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%); border: none; font-weight: bold;">
            Se connecter
        </button>
        
        <hr class="my-4">
        
        <div class="text-center">
            <button type="button" id="start-face-login" class="btn btn-outline-info w-100 py-2 shadow-sm mb-3" style="border-radius: 50px; font-weight: bold;">
                <i class="fas fa-camera"></i> Se connecter avec Face ID
            </button>
        </div>

        <div id="face-login-container" style="display: none; position: relative; margin-top: 20px; text-align: center;">
            <p id="face-login-status" class="text-muted small fw-bold mb-2">Chargement de la caméra...</p>
            <video id="webcam" autoplay muted playsinline style="width: 100%; max-width: 400px; border-radius: 10px; border: 2px solid #00d2ff;"></video>
            <!-- Canvas is used by face-api to draw overlays, it should be placed over the video -->
            <canvas id="overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 10px;"></canvas>
            
            <button type="button" id="cancel-face-login" class="btn btn-sm btn-danger mt-3 rounded-pill">
                Annuler
            </button>
        </div>

        <div class="text-center mt-4">
            <p class="text-muted small">Vous n'avez pas de compte ? 
                <a href="{{ path('app_register') }}" class="fw-bold text-primary text-decoration-none">S'inscrire ici</a>
            </p>
            <div class="mb-3">
                <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
            </div>
        </div>
    </form>
</div>

<!-- Add Face-API.js from CDN -->
<script defer src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const startBtn = document.getElementById('start-face-login');
        const cancelBtn = document.getElementById('cancel-face-login');
        const faceContainer = document.getElementById('face-login-container');
        const emailInput = document.getElementById('inputEmail');
        const video = document.getElementById('webcam');
        const statusText = document.getElementById('face-login-status');
        let stream = null;
        let faceMatcher = null;
        let detectionInterval = null;

        async function loadModels() {
            statusText.innerText = "Chargement des modèles d'IA...";
            // We use the local models downloaded to public/models
            await faceapi.nets.ssdMobilenetv1.loadFromUri('/models');
            await faceapi.nets.faceLandmark68Net.loadFromUri('/models');
            await faceapi.nets.faceRecognitionNet.loadFromUri('/models');
            statusText.innerText = "Modèles chargés. Veuillez entrer votre email en haut si ce n'est pas fait.";
        }

        async function initFaceLogin() {
            const email = emailInput.value.trim();
            // On peut maintenant continuer sans email pour les admins déjà enregistrés
            
            faceContainer.style.display = 'block';
            startBtn.style.display = 'none';

            try {
                await loadModels();
                
                statusText.innerText = "Recherche des profils biométriques...";
                
                // 1. Fetch reference data
                const response = await fetch('/api/user/face-image', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });

                const data = await response.json();
                
                if (!response.ok) {
                    throw new Error(data.error || "Erreur lors de la récupération des données.");
                }

                let labeledDescriptors = [];

                if (email) {
                    // Cas 1: Email fourni, on cherche ce compte précis
                    if (data.descriptor) {
                        // Utilisation du descripteur JSON stocké
                        labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(email, [new Float32Array(data.descriptor)]));
                    } else if (data.imageUrl) {
                        // Fallback: Utilisation de l'image si pas de descripteur
                        statusText.innerText = "Analyse de votre photo de profil...";
                        const refImage = await faceapi.fetchImage(data.imageUrl);
                        const refDetection = await faceapi.detectSingleFace(refImage).withFaceLandmarks().withFaceDescriptor();
                        if (refDetection) {
                            labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(email, [refDetection.descriptor]));
                        } else {
                            throw new Error("Impossible de détecter un visage sur votre photo.");
                        }
                    } else {
                        throw new Error("Aucune donnée biométrique pour ce compte.");
                    }
                } else {
                    // Cas 2: Pas d'email, on cherche parmi tous les admins enregistrés
                    if (data.admins && data.admins.length > 0) {
                        data.admins.forEach(admin => {
                            labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(admin.email, [new Float32Array(admin.descriptor)]));
                        });
                        statusText.innerText = "Prêt pour identification automatique.";
                    } else {
                        throw new Error("Veuillez saisir votre email (aucun admin biométrique trouvé).");
                    }
                }

                faceMatcher = new faceapi.FaceMatcher(labeledDescriptors, 0.5);

                statusText.innerText = "Accès à la caméra...";
                stream = await navigator.mediaDevices.getUserMedia({ video: {} });
                video.srcObject = stream;

                video.onloadedmetadata = () => {
                    statusText.innerText = email ? `Veuillez regarder la caméra, ${email}.` : "Identification automatique en cours...";
                    detectFaceLoop();
                };

            } catch (err) {
                console.error(err);
                statusText.innerText = "Erreur: " + err.message;
                statusText.style.color = 'red';
                setTimeout(stopFaceLogin, 4000);
            }
        }

        async function detectFaceLoop() {
            const canvas = document.getElementById('overlay');
            const displaySize = { width: video.clientWidth, height: video.clientHeight };
            faceapi.matchDimensions(canvas, displaySize);

            detectionInterval = setInterval(async () => {
                if (video.paused || video.ended) return;

                const detection = await faceapi.detectSingleFace(video).withFaceLandmarks().withFaceDescriptor();
                
                if (detection) {
                    const resizedDetection = faceapi.resizeResults(detection, displaySize);
                    const context = canvas.getContext('2d');
                    context.clearRect(0, 0, canvas.width, canvas.height);
                    
                    const match = faceMatcher.findBestMatch(detection.descriptor);
                    
                    const box = resizedDetection.detection.box;
                    const drawBox = new faceapi.draw.DrawBox(box, { label: match.label === 'unknown' ? 'Inconnu' : match.label });
                    drawBox.draw(canvas);

                    if (match.label !== 'unknown') {
                        statusText.innerText = `Reconnu : ${match.label} ! Connexion...`;
                        statusText.style.color = "green";
                        clearInterval(detectionInterval);
                        
                        try {
                            const loginRes = await fetch('/login/face', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ email: match.label })
                            });
                            
                            const loginData = await loginRes.json();
                            if (loginData.success) {
                                window.location.href = loginData.redirect;
                            } else {
                                throw new Error("Erreur de session.");
                            }
                        } catch (e) {
                            statusText.innerText = "Erreur de connexion.";
                        }
                        
                        stopFaceLogin(false);
                    }
                }
            }, 1000);
        }

        function stopFaceLogin(hideContainer = true) {
            if (detectionInterval) clearInterval(detectionInterval);
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            if (hideContainer) {
                faceContainer.style.display = 'none';
                startBtn.style.display = 'block';
                statusText.style.color = '';
                const canvas = document.getElementById('overlay');
                const context = canvas.getContext('2d');
                context.clearRect(0, 0, canvas.width, canvas.height);
            }
        }

        startBtn.addEventListener('click', initFaceLogin);
        cancelBtn.addEventListener('click', stopFaceLogin);
    });
</script>

<!-- FontAwesome for the camera icon -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</body>
</html>