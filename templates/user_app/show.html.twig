{# templates/user_app/show.html.twig #}
{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Détails Utilisateur - EcoAdventure{% endblock %}
{% block page_title %}{% endblock %}
{% block topbar_search %}{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

    .show-main-container {
        font-family: 'Outfit', sans-serif !important;
        padding: 40px 20px;
        animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .premium-show-card {
        background: white !important;
        border-radius: 45px;
        box-shadow: 0 50px 120px rgba(0, 0, 0, 0.06);
        border: 1px solid #f1f5f9;
        max-width: 850px;
        margin: 0 auto;
        overflow: hidden;
    }

    .show-header-pro {
        background: linear-gradient(135deg, #2d5a27 0%, #4a7c44 100%);
        padding: 60px 40px;
        text-align: center;
        position: relative;
    }

    .avatar-circle-pro {
        width: 120px; height: 120px;
        background: white;
        border-radius: 40px;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px auto;
        font-size: 3.5rem; font-weight: 900; color: #2d5a27;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        border: 4px solid rgba(255,255,255,0.3);
    }

    .show-name-pro {
        color: white;
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 10px;
        letter-spacing: -1px;
    }

    .role-tag-pro {
        background: rgba(255,255,255,0.2);
        color: white;
        padding: 8px 25px;
        border-radius: 99px;
        font-weight: 800;
        font-size: 0.85rem;
        backdrop-filter: blur(10px);
        text-transform: uppercase;
        display: inline-block;
    }

    .show-body-pro {
        padding: 50px;
    }

    .info-section-eco {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
        background: #f8fafc;
        padding: 40px;
        border-radius: 35px;
        border: 1px solid #edf2f7;
    }

    .info-box-pro {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-label-pro {
        font-weight: 800; font-size: 0.8rem; color: #94a3b8;
        text-transform: uppercase; letter-spacing: 1.5px;
    }

    .info-val-pro {
        font-weight: 700; font-size: 1.1rem; color: #1e293b;
        display: flex; align-items: center; gap: 12px;
    }

    .info-val-pro i {
        color: #2d5a27;
        font-size: 1.3rem;
    }

    .show-footer-pro {
        padding: 30px 50px;
        background: #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-eco-pro {
        padding: 15px 35px;
        border-radius: 20px;
        font-weight: 800;
        text-decoration: none;
        display: flex; align-items: center; gap: 12px;
        transition: 0.3s;
        border: none;
    }

    .btn-eco-secondary { background: white; color: #64748b !important; border: 1px solid #e2e8f0; }
    .btn-eco-secondary:hover { background: #e2e8f0; color: #1e293b !important; }

    .btn-eco-primary { background: #f39237; color: white !important; box-shadow: 0 10px 25px rgba(243, 146, 55, 0.25); }
    .btn-eco-primary:hover { transform: translateY(-4px); box-shadow: 0 15px 35px rgba(243, 146, 55, 0.4); }

</style>

<div class="show-main-container">
    <div class="premium-show-card">
        <div class="show-header-pro">
            <div class="avatar-circle-pro">
                {{ user_app.prenom|first|upper }}{{ user_app.nom|first|upper }}
            </div>
            <h1 class="show-name-pro">{{ user_app.prenom }} {{ user_app.nom }}</h1>
            <div class="role-tag-pro">
                <i class="bi bi-shield-check me-2"></i> {{ user_app.role.value|default('Membre') }}
            </div>
        </div>

        <div class="show-body-pro">
            <div class="info-section-eco">
                <div class="info-box-pro">
                    <span class="info-label-pro">Email Professionnel</span>
                    <div class="info-val-pro"><i class="bi bi-envelope-heart"></i> {{ user_app.email }}</div>
                </div>
                <div class="info-box-pro">
                    <span class="info-label-pro">Téléphone</span>
                    <div class="info-val-pro"><i class="bi bi-phone-vibrate"></i> {{ user_app.telephone|default('---') }}</div>
                </div>
                <div class="info-box-pro">
                    <span class="info-label-pro">Âge Actuel</span>
                    <div class="info-val-pro"><i class="bi bi-calendar3"></i> {{ user_app.age|default('--') }} ans</div>
                </div>
                <div class="info-box-pro">
                    <span class="info-label-pro">Spécialité</span>
                    <div class="info-val-pro"><i class="bi bi-award"></i> {{ user_app.specialite.value|default('Non définie') }}</div>
                </div>
            </div>
        </div>

        <div class="show-footer-pro">
            <a href="{{ path('app_user_app_index') }}" class="btn-eco-pro btn-eco-secondary">
                <i class="bi bi-arrow-left-short fs-4"></i> Retour à la liste
            </a>

            <a href="{{ path('app_user_app_edit', {'id_user': user_app.id_user}) }}" class="btn-eco-pro btn-eco-primary">
                <i class="bi bi-pencil-square"></i> Modifier Profil
            </a>
        </div>
    </div>
</div>
{% endblock %}