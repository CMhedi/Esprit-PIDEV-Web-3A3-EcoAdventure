{# templates/user_app/show.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user_app.nom }}{% endblock %}

{% block body %}
<style>
    /* Design cinematic kima el profil */
    .profil-bg {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1350&q=80');
        background-size: cover;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .glass-profile {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 30px;
        color: white;
        padding: 40px;
        max-width: 800px;
        width: 100%;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }
</style>

<div class="profil-bg">
    <div class="glass-profile">
        <div class="text-center mb-5">
            <div class="bg-white text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: bold;">
                {{ user_app.nom|first|upper }}
            </div>
            <h1 class="display-5 fw-bold">{{ user_app.nom }} {{ user_app.prenom }}</h1>
            <span class="badge bg-info text-dark text-uppercase px-3 py-2 rounded-pill">
                {{ user_app.role ? user_app.role.value : 'Membre' }}
            </span>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <p class="mb-1 text-white-50 small">EMAIL</p>
                <p class="h5 fw-light">{{ user_app.email }}</p>
            </div>
            <div class="col-md-6">
                <p class="mb-1 text-white-50 small">TÉLÉPHONE</p>
                <p class="h5 fw-light">{{ user_app.telephone ?: '---' }}</p>
            </div>
            <div class="col-md-4">
                <p class="mb-1 text-white-50 small">ÂGE</p>
                <p class="h5 fw-light">{{ user_app.age ?: '---' }} ans</p>
            </div>
            <div class="col-md-4">
                <p class="mb-1 text-white-50 small">SPÉCIALITÉ</p>
                <p class="h5 fw-light">{{ user_app.specialite ? user_app.specialite.value : '---' }}</p>
            </div>
            <div class="col-md-4">
                <p class="mb-1 text-white-50 small">EXPÉRIENCE</p>
                <p class="h5 fw-light text-warning">{{ user_app.experience ?: '0' }} ans</p>
            </div>
            <div class="col-12 mt-4">
                <p class="mb-1 text-white-50 small">BIO & CERTIFICATS</p>
                <div class="p-3 rounded" style="background: rgba(255,255,255,0.05);">
                    {{ user_app.bioCertifs ?: 'Aucune information supplémentaire.' }}
                </div>
            </div>
        </div>

        <div class="mt-5 d-flex gap-3 justify-content-center">
            <a href="{{ path('app_user_app_index') }}" class="btn btn-outline-light px-4 rounded-pill">Retour</a>
            <a href="{{ path('app_user_app_edit', {'id_user': user_app.id_user}) }}" class="btn btn-warning px-4 rounded-pill text-dark fw-bold">Modifier</a>
        </div>
    </div>
</div>
{% endblock %}