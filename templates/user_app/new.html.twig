{# templates/user_app/new.html.twig #}
{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Ajouter Utilisateur - EcoAdventure{% endblock %}
{% block page_title %}{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

    :root {
        --eco-green: #2d5a27 !important;
        --eco-orange: #f39237 !important;
        --eco-red: #ef4444;
    }

    .new-user-wrapper {
        font-family: 'Outfit', sans-serif !important;
        padding: 40px 20px;
        animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .premium-new-card {
        background: white !important;
        border-radius: 40px;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        max-width: 850px;
        margin: 0 auto;
        padding: 50px;
    }

    .form-header-new {
        text-align: center;
        margin-bottom: 40px;
    }

    .form-header-new i {
        font-size: 3rem;
        color: var(--eco-green);
        background: #f0fdf4;
        width: 80px; height: 80px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 25px;
        margin: 0 auto 15px auto;
        box-shadow: 0 10px 20px rgba(45, 90, 39, 0.1);
    }

    .form-header-new h1 { font-weight: 800; color: #1e293b; letter-spacing: -1px; }
    .form-header-new p { color: #64748b; font-weight: 600; }

    .section-label-new {
        font-weight: 800; font-size: 0.85rem; color: var(--eco-green);
        text-transform: uppercase; letter-spacing: 1.5px;
        margin: 30px 0 20px 0; display: flex; align-items: center; gap: 15px;
    }
    .section-label-new::after { content: ""; flex: 1; height: 1px; background: #f1f5f9; }

    .input-group-eco { margin-bottom: 25px; position: relative; }
    .input-group-eco label {
        font-weight: 800; font-size: 0.8rem; color: #64748b;
        margin-bottom: 8px; display: block; padding-left: 5px;
    }

    .input-wrapper-eco { position: relative; }
    .input-wrapper-eco i {
        position: absolute; left: 20px; top: 50%; transform: translateY(-50%);
        color: var(--eco-green); font-size: 1.2rem;
        transition: 0.3s;
    }

    .input-wrapper-eco input, .input-wrapper-eco select, .input-wrapper-eco textarea {
        width: 100%;
        padding: 14px 20px 14px 55px !important;
        border-radius: 18px !important;
        border: 2px solid #f1f5f9 !important;
        background: #f8fafc !important;
        font-weight: 700 !important;
        transition: 0.3s !important;
    }

    .input-wrapper-eco input:focus, .input-wrapper-eco select:focus, .input-wrapper-eco textarea:focus {
        border-color: var(--eco-green) !important;
        background: white !important;
        box-shadow: 0 10px 25px rgba(45, 90, 39, 0.08) !important;
        outline: none;
    }

    /* Validation Styles */
    .input-error { border-color: var(--eco-red) !important; background: #fff5f5 !important; }
    .error-text { color: var(--eco-red); font-size: 0.75rem; font-weight: 800; margin-top: 5px; display: none; }

    .btn-submit-eco {
        background: linear-gradient(135deg, var(--eco-green) 0%, #4a7c44 100%) !important;
        color: white !important;
        width: 100%;
        padding: 16px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        box-shadow: 0 15px 35px rgba(45, 90, 39, 0.2);
        margin-top: 30px;
        transition: 0.3s;
    }

    .btn-submit-eco:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 45px rgba(45, 90, 39, 0.35);
    }

    #coach-section {
        display: none;
        animation: slideDown 0.4s ease forwards;
    }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    .btn-cancel-eco {
        display: block;
        text-align: center;
        padding: 16px;
        color: #64748b !important;
        font-weight: 700;
        border-radius: 20px;
        background: #f1f5f9;
        text-decoration: none;
        margin-top: 15px;
        transition: 0.3s;
        border: 1px solid transparent;
    }
    .btn-cancel-eco:hover {
        background: #e2e8f0;
        color: #1e293b !important;
        transform: translateY(-2px);
    }

</style>

<div class="new-user-wrapper">
    <div class="premium-new-card">
        <div class="form-header-new">
            <i class="bi bi-person-plus-fill"></i>
            <h1>Nouveau Membre</h1>
            <p>Ajoutez un nouvel utilisateur à la plateforme EcoAdventure</p>
        </div>

        {{ form_start(form, {'attr': {'id': 'user-form', 'novalidate': 'novalidate'}}) }}
            
            <div class="section-label-new">Informations Personnelles</div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Prénom</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-person-tag"></i>
                            {{ form_widget(form.prenom, {'attr': {'class': 'validate-empty', 'placeholder': 'Ex: Ahmed'}}) }}
                        </div>
                        <span class="error-text">Le prénom est requis.</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Nom</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-person-lines-fill"></i>
                            {{ form_widget(form.nom, {'attr': {'class': 'validate-empty', 'placeholder': 'Ex: Lahmer'}}) }}
                        </div>
                        <span class="error-text">Le nom est requis.</span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Âge</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-calendar-check"></i>
                            {{ form_widget(form.age, {'attr': {'id': 'user-age', 'placeholder': 'Ex: 25', 'type': 'number', 'min': '18', 'max': '40'}}) }}
                        </div>
                        <span class="error-text">Âge invalide (18-40).</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Numéro de Téléphone</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-phone"></i>
                            {{ form_widget(form.telephone, {'attr': {'id': 'user-phone', 'placeholder': '22 123 456'}}) }}
                        </div>
                        <span class="error-text">Numéro invalide (8 chiffres).</span>
                    </div>
                </div>
            </div>

            <div class="section-label-new">Accès & Sécurité</div>

            <div class="row">
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Adresse Email</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-envelope-at"></i>
                            {{ form_widget(form.email, {'attr': {'id': 'user-email'}}) }}
                        </div>
                        <span class="error-text">Email invalide.</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-eco">
                        <label>Rôle Système</label>
                        <div class="input-wrapper-eco">
                            <i class="bi bi-shield-lock"></i>
                            {{ form_widget(form.role, {'attr': {'id': 'role-selector'}}) }}
                        </div>
                        <span class="error-text"></span>
                    </div>
                </div>
            </div>

            <div class="input-group-eco">
                <label>Mot de passe initial</label>
                <div class="input-wrapper-eco">
                    <i class="bi bi-key-fill"></i>
                    {{ form_widget(form.plainPassword, {'attr': {'id': 'user-pass', 'placeholder': 'Entrez un mot de passe sécurisé'}}) }}
                </div>
                <span class="error-text">Le mot de passe est requis (min 8 car).</span>
            </div>

            <div id="coach-section">
                <div class="section-label-new">Profil Professionnel (Coach)</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group-eco">
                            <label>Spécialité</label>
                            <div class="input-wrapper-eco">
                                <i class="bi bi-award"></i>
                                {{ form_widget(form.specialite) }}
                            </div>
                            <span class="error-text"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-eco">
                            <label>Expérience (Années)</label>
                            <div class="input-wrapper-eco">
                                <i class="bi bi-briefcase"></i>
                                {{ form_widget(form.experience) }}
                            </div>
                            <span class="error-text"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group-eco">
                            <label>Disponibilité</label>
                            <div class="input-wrapper-eco">
                                <i class="bi bi-clock-history"></i>
                                {{ form_widget(form.disponibilite) }}
                            </div>
                            <span class="error-text"></span>
                        </div>
                    </div>
                </div>
                <div class="input-group-eco">
                    <label>Bio & Certifications</label>
                    <div class="input-wrapper-eco">
                        <i class="bi bi-file-earmark-text" style="top: 25px;"></i>
                        {{ form_widget(form.bioCertifs, {'attr': {'rows': '3', 'placeholder': 'Détails sur le coach...'}}) }}
                    </div>
                    <span class="error-text"></span>
                </div>
            </div>

            <button type="submit" id="submit-btn" class="btn-submit-eco">
                <i class="bi bi-check-circle-fill me-2"></i> Créer le compte utilisateur
            </button>

            <a href="{{ path('app_user_app_index') }}" class="btn-cancel-eco">
                Annuler et retour
            </a>

            {% do form.imageFile.setRendered %}
        {{ form_end(form) }}
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const roleSelector = document.querySelector('select[name*="role"]');
        const coachSection = document.getElementById('coach-section');
        const form = document.getElementById('user-form');

        if (!roleSelector) {
            console.error("Role selector not found!");
            return;
        }

        // --- Logic Dynamic Coach Section ---
        const toggleCoachSection = () => {
            const selectedRole = roleSelector.value ? roleSelector.value.toUpperCase() : '';
            if (selectedRole === 'COACH') {
                coachSection.style.display = 'block';
            } else {
                coachSection.style.display = 'none';
            }
        };

        roleSelector.addEventListener('change', toggleCoachSection);
        toggleCoachSection(); // Init

        // --- Contrôle de Saisie (Validation) ---
        const showError = (input, show, message = null) => {
            const group = input.closest('.input-group-eco');
            if (!group) return;
            const errorSpan = group.querySelector('.error-text');
            if (show) {
                input.classList.add('input-error');
                if (errorSpan) {
                    errorSpan.style.display = 'block';
                    if (message) errorSpan.innerText = message;
                }
            } else {
                input.classList.remove('input-error');
                if (errorSpan) {
                    errorSpan.style.display = 'none';
                }
            }
        };

        const validateField = (input) => {
            const val = input.value.trim();
            const id = input.id || input.name;
            const isVisible = input.offsetParent !== null;

            if (!isVisible) return true;

            // Define which fields are mandatory
            const isMandatory = input.classList.contains('validate-empty') || 
                               id.includes('email') || 
                               id.includes('telephone') || 
                               id.includes('age') || 
                               id.includes('plainPassword') ||
                               (id.includes('experience') && coachSection.style.display === 'block');

            if (isMandatory && !val) {
                showError(input, true, "Ce champ est obligatoire.");
                return false;
            }

            // Name/Surname: No numbers
            if (id.includes('nom') || id.includes('prenom')) {
                if (/[0-9]/.test(val)) {
                    showError(input, true, "Le nom/prénom ne doit pas contenir de chiffres.");
                    return false;
                }
                if (val.length < 2) {
                    showError(input, true, "Minimum 2 caractères.");
                    return false;
                }
            }

            // Email
            if (input.type === 'email' || id.includes('email')) {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(val)) {
                    showError(input, true, "Format email invalide.");
                    return false;
                }
            }

            // Phone: 8 digits starting with 2, 4, 5, 9 (Tunisia)
            if (id.includes('telephone')) {
                if (!/^[2459]\d{7}$/.test(val)) {
                    showError(input, true, "Numéro invalide (8 chiffres commençant par 2, 4, 5 ou 9).");
                    return false;
                }
            }

            // Age: 18-40
            if (id.includes('age')) {
                const ageVal = parseInt(val);
                if (isNaN(ageVal) || ageVal < 18 || ageVal > 40) {
                    showError(input, true, "L'âge doit être compris entre 18 et 40.");
                    return false;
                }
            }

            // Password: min 8
            if (id.includes('pass') || id.includes('plainPassword')) {
                if (val.length < 8) {
                    showError(input, true, "Le mot de passe doit faire au moins 8 caractères.");
                    return false;
                }
                if (!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/.test(val)) {
                    showError(input, true, "Il faut une majuscule, une minuscule et un chiffre.");
                    return false;
                }
            }

            // Experience (only if coach section is visible)
            if (id.includes('experience') && coachSection.style.display === 'block') {
                const expVal = parseInt(val);
                if (isNaN(expVal) || expVal < 0 || expVal > 50) {
                    showError(input, true, "Expérience invalide (0-50).");
                    return false;
                }
            }

            showError(input, false);
            return true;
        };

        form.addEventListener('submit', (e) => {
            let hasError = false;
            const inputs = form.querySelectorAll('input:not([type="hidden"]), select, textarea');
            
            inputs.forEach(input => {
                if (input.offsetParent !== null) { // Only validate visible fields
                    input.dataset.touched = 'true'; // Mark as touched on submit attempt
                    if (!validateField(input)) {
                        hasError = true;
                    }
                }
            });

            if (hasError) {
                e.preventDefault();
                const firstError = document.querySelector('.input-error');
                if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        // Real-time validation
        form.querySelectorAll('input, select, textarea').forEach(input => {
            input.addEventListener('blur', () => {
                input.dataset.touched = 'true';
                validateField(input);
            });
            input.addEventListener('input', () => {
                if (input.dataset.touched === 'true') {
                    validateField(input);
                }
            });
        });
    });
</script>
{% endblock %}