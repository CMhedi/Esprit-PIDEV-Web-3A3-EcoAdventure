<form method="post" action="{{ path('app_user_app_delete', {'id_user': user_app.id_user}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user_app.id_user) }}">
    <button class="btn">Delete</button>
</form>
