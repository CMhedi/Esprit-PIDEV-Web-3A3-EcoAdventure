{# templates/user_app/edit.html.twig #}

{# 1. Dima el extends d'après el ROLE #}
{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Modifier Profil - EcoAdventure{% endblock %}
{% block page_title %}Modifier l'utilisateur{% endblock %}

{% block body %}
<style>
    /* Wrapper dynamique */
    .edit-profile-wrapper {
        {% if not is_granted('ROLE_ADMIN') %}
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed !important;
            background-size: cover !important;
            min-height: 80vh; 
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 20px;
        {% else %}
            padding: 30px;
            background-color: #f4f7f6;
        {% endif %}
    }

    /* Card style dynamique */
    .edit-glass-card {
        background: {{ is_granted('ROLE_ADMIN') ? '#ffffff' : 'rgba(255, 255, 255, 0.9)' }};
        backdrop-filter: {{ is_granted('ROLE_ADMIN') ? 'none' : 'blur(10px)' }};
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,{{ is_granted('ROLE_ADMIN') ? '0.05' : '0.2' }});
        width: 100%;
        max-width: 650px;
        margin: auto;
    }

    .form-label-custom {
        font-size: 0.85rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .btn-update {
        background: #1e3a8a;
        color: white;
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: bold;
        transition: 0.3s;
        border: none;
        width: 50%;
    }
    .btn-update:hover { background: #3b82f6; color: white; }
</style>

<div class="edit-profile-wrapper">
    <div class="edit-glass-card">
        <h2 class="text-center fw-bold mb-4" style="color: #2c3e50;">
            <i class="bi bi-person-gear me-2 text-primary"></i>Modifier Profil
        </h2>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom">Nom</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control rounded-pill'}}) }}
                    <div class="text-danger small">{{ form_errors(form.nom) }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label-custom">Prénom</label>
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control rounded-pill'}}) }}
                    <div class="text-danger small">{{ form_errors(form.prenom) }}</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">E-mail</label>
                {{ form_widget(form.email, {'attr': {'class': 'form-control rounded-pill'}}) }}
                <div class="text-danger small">{{ form_errors(form.email) }}</div>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Mot de passe <span class="text-muted fw-normal">(Laisser vide pour garder l'actuel)</span></label>
                {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control rounded-pill', 'placeholder': '••••••••'}}) }}
                <div class="text-danger small">{{ form_errors(form.plainPassword) }}</div>
            </div>

            {# On utilise l'objet "user_app" passé au template ou "app.user" #}
            {% set currentUser = user %}
            {% if currentUser.role.value == 'COACH' %}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom">Spécialité</label>
                        {{ form_widget(form.specialite, {'attr': {'class': 'form-select rounded-pill'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom">Disponibilité</label>
                        {{ form_widget(form.disponibilite, {'attr': {'class': 'form-select rounded-pill'}}) }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom">Bio & Certificats</label>
                    {{ form_widget(form.bioCertifs, {'attr': {'class': 'form-control', 'rows': 3, 'style': 'border-radius: 15px;'}}) }}
                </div>
            {% else %}
                <div class="d-none">
                    {{ form_widget(form.specialite) }}
                    {{ form_widget(form.disponibilite) }}
                    {{ form_widget(form.bioCertifs) }}
                </div>
            {% endif %}

            <div style="display:none;">{{ form_rest(form) }}</div>

            <div class="mt-4 d-flex gap-3">
                <button type="submit" class="btn btn-update">
                    <i class="bi bi-check-lg me-2"></i>Mettre à jour
                </button>
                <a href="{{ is_granted('ROLE_ADMIN') ? path('app_user_app_index') : path('app_user_app_show', {'id_user': currentUser.id_user}) }}" class="btn btn-outline-secondary rounded-pill w-50 d-flex align-items-center justify-content-center fw-bold">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}