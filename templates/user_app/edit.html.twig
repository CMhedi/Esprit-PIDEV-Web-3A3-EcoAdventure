{# templates/user_app/edit.html.twig #}
{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Modifier Profil - EcoAdventure{% endblock %}

{% block css %}
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.4);
            --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --accent-color: #00d2ff;
        }

        .edit-profile-container {
            {% if not is_granted('ROLE_ADMIN') %}
                background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
                background-size: cover;
                min-height: calc(100vh - 70px);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 50px 20px;
            {% else %}
                padding: 30px;
                background-color: #f8fafc;
            {% endif %}
            font-family: 'Inter', sans-serif;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            width: 100%;
            max-width: 750px;
            padding: 40px;
            animation: fadeIn 0.8s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-section-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: #3a7bd5;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-section-title::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(58, 123, 213, 0.2);
        }

        .custom-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 8px;
            display: block;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #3a7bd5;
            font-size: 1.1rem;
            z-index: 5;
        }

        .form-control-custom {
            width: 100%;
            padding: 12px 15px 12px 45px;
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 15px;
            font-size: 0.95rem;
            transition: all 0.3s;
        }

        .form-control-custom:focus {
            background: white;
            border-color: #00d2ff;
            box-shadow: 0 0 0 4px rgba(0, 210, 255, 0.1);
            outline: none;
        }

        .btn-update {
            background: var(--primary-gradient);
            color: white;
            border: none;
            padding: 14px 35px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 6px 20px rgba(58, 123, 213, 0.3);
            transition: all 0.3s;
            width: 100%;
        }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(58, 123, 213, 0.4);
            color: white;
        }

        .btn-cancel {
            background: rgba(0,0,0,0.05);
            color: #666;
            border: 1px solid rgba(0,0,0,0.1);
            padding: 14px 35px;
            border-radius: 50px;
            font-weight: 700;
            transition: all 0.3s;
            width: 100%;
            text-align: center;
            text-decoration: none;
        }

        .btn-cancel:hover {
            background: rgba(0,0,0,0.1);
            color: #333;
        }

        .coach-badge {
            background: #ff7e5f;
            color: white;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 800;
            vertical-align: middle;
            margin-left: 10px;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.8rem;
            margin-top: 5px;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
<div class="edit-profile-container">
    <div class="glass-card">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-1" style="color: #1a1a1a;">
                <i class="bi bi-person-gear me-2" style="color: #3a7bd5;"></i>Modifier Profil
            </h2>
            <p class="text-muted small">Mettez à jour vos informations personnelles et professionnelles</p>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Informations Personnelles #}
            <h5 class="form-section-title">
                <i class="bi bi-person"></i> Informations Personnelles
            </h5>
            <div class="row">
                <div class="col-md-6">
                    <label class="custom-label">Prénom</label>
                    <div class="input-group-custom">
                        <i class="bi bi-person-badge input-icon"></i>
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control-custom', 'placeholder': 'Votre prénom', 'required': 'required'}}) }}
                        <div class="error-message">{{ form_errors(form.prenom) }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Nom</label>
                    <div class="input-group-custom">
                        <i class="bi bi-person-badge-fill input-icon"></i>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control-custom', 'placeholder': 'Votre nom', 'required': 'required'}}) }}
                        <div class="error-message">{{ form_errors(form.nom) }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Âge</label>
                    <div class="input-group-custom">
                        <i class="bi bi-calendar3 input-icon"></i>
                        {{ form_widget(form.age, {'attr': {'class': 'form-control-custom', 'placeholder': 'Votre âge'}}) }}
                        <div class="error-message">{{ form_errors(form.age) }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Téléphone</label>
                    <div class="input-group-custom">
                        <i class="bi bi-telephone input-icon"></i>
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control-custom', 'placeholder': 'Votre téléphone'}}) }}
                        <div class="error-message">{{ form_errors(form.telephone) }}</div>
                    </div>
                </div>
            </div>

            {# Section 2: Contact & Sécurité #}
            <h5 class="form-section-title mt-2">
                <i class="bi bi-shield-lock"></i> Contact & Sécurité
            </h5>
            <div class="row">
                <div class="col-md-6">
                    <label class="custom-label">Adresse Email</label>
                    <div class="input-group-custom">
                        <i class="bi bi-envelope input-icon"></i>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control-custom', 'placeholder': 'votre@email.com', 'required': 'required'}}) }}
                        <div class="error-message">{{ form_errors(form.email) }}</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="custom-label">Mot de passe <small class="text-muted">(Laisser vide si inchangé)</small></label>
                    <div class="input-group-custom">
                        <i class="bi bi-key input-icon"></i>
                        {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control-custom', 'type': 'password', 'placeholder': '••••••••'}}) }}
                        <div class="error-message">{{ form_errors(form.plainPassword) }}</div>
                    </div>
                </div>
            </div>

            {# Section 3: Professional Details (For Coaches) #}
            {% if user.role.value == 'COACH' %}
                <h5 class="form-section-title mt-2">
                    <i class="bi bi-briefcase"></i> Profil Professionnel <span class="coach-badge">COACH</span>
                </h5>
                <div class="row">
                    <div class="col-md-6">
                        <label class="custom-label">Spécialité</label>
                        <div class="input-group-custom">
                            <i class="bi bi-award input-icon"></i>
                            {{ form_widget(form.specialite, {'attr': {'class': 'form-control-custom form-select'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="custom-label">Disponibilité</label>
                        <div class="input-group-custom">
                            <i class="bi bi-clock-history input-icon"></i>
                            {{ form_widget(form.disponibilite, {'attr': {'class': 'form-control-custom form-select'}}) }}
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="custom-label">Bio & Certificats</label>
                        <div class="input-group-custom">
                            {{ form_widget(form.bioCertifs, {'attr': {'class': 'form-control-custom', 'style': 'padding-left: 20px;', 'rows': 4, 'placeholder': 'Décrivez votre parcours...'}}) }}
                        </div>
                    </div>
                </div>
            {% else %}
                {# Hide coach fields but keep them in form if needed #}
                {% if form.specialite is defined %}
                    <div class="d-none">
                        {{ form_row(form.specialite) }}
                        {{ form_row(form.disponibilite) }}
                        {{ form_row(form.bioCertifs) }}
                    </div>
                {% endif %}
            {% endif %}

            <div style="display:none;">{{ form_rest(form) }}</div>

            <div class="row g-3 mt-4">
                <div class="col-sm-6">
                    <button type="submit" class="btn btn-update">
                        <i class="bi bi-save me-2"></i>Mettre à jour
                    </button>
                </div>
                <div class="col-sm-6">
                    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_user_app_index') : path('app_profile_index') }}" class="btn btn-cancel">
                        Annuler
                    </a>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}