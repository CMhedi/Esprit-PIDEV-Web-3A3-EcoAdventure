{# templates/user_app/edit.html.twig #}
{% extends is_granted('ROLE_ADMIN') ? 'admin/base_admin.html.twig' : 'base.html.twig' %}

{% block title %}Modifier Membre - EcoAdventure{% endblock %}
{% block page_title %}{% endblock %}

{% block body %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

        :root {
            --eco-green: #2d5a27 !important;
            --eco-orange: #f39237 !important;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        .main-edit-wrapper {
            font-family: 'Outfit', sans-serif !important;
            padding: 40px !important;
            background-color: #f1f5f9; /* Background soft bech el card todher */
            min-height: 100vh;
        }

        .pro-card-layout {
            background: white !important;
            border-radius: 35px !important;
            box-shadow: 0 50px 100px rgba(0,0,0,0.08) !important;
            max-width: 1100px !important;
            margin: 0 auto !important;
            display: flex !important;
            overflow: hidden !important;
            border: 1px solid #e2e8f0 !important;
        }

        /* Side Info Panel */
        .side-info-panel {
            width: 350px;
            background: linear-gradient(180deg, var(--eco-green) 0%, #1a3617 100%);
            padding: 50px 40px;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .avatar-holder-pro {
            width: 140px; height: 140px;
            background: white;
            border-radius: 45px;
            display: flex; align-items: center; justify-content: center;
            font-size: 3.5rem; font-weight: 800; color: var(--eco-green);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            margin-bottom: 30px;
        }

        .side-info-panel h3 { font-weight: 800; font-size: 1.6rem; margin-bottom: 10px; }
        .side-info-panel .role-badge { background: rgba(255,255,255,0.15); padding: 6px 15px; border-radius: 12px; font-weight: 700; font-size: 0.75rem; letter-spacing: 1px; }

        /* Form Main Panel */
        .form-main-panel { flex: 1; padding: 60px 70px; }

        .section-label-pro {
            font-weight: 900; font-size: 0.85rem; color: var(--eco-green);
            text-transform: uppercase; letter-spacing: 2px;
            margin-bottom: 30px; display: flex; align-items: center; gap: 15px;
        }
        .section-label-pro::after { content: ""; flex: 1; height: 2px; background: #f1f5f9; }

        .input-box-pro { margin-bottom: 35px; }
        .input-box-pro label {
            font-weight: 700; font-size: 0.85rem; color: var(--text-muted);
            margin-bottom: 12px; display: block; padding-left: 5px;
        }

        .input-wrapper-pro { position: relative; }
        .input-wrapper-pro i {
            position: absolute; left: 20px; top: 50%; transform: translateY(-50%);
            color: var(--eco-green); font-size: 1.2rem;
        }

        .form-input-pro {
            width: 100% !important; padding: 18px 25px 18px 60px !important;
            border-radius: 20px !important; border: 2px solid #f1f5f9 !important;
            background: #f8fafc !important; font-weight: 700 !important;
            font-size: 1.05rem !important; transition: 0.3s !important;
            color: var(--text-dark) !important;
        }

        .form-input-pro:focus {
            background: white !important; border-color: var(--eco-green) !important; outline: none !important;
            box-shadow: 0 10px 25px rgba(45, 90, 39, 0.08) !important;
        }

        .bg-disabled { background-color: #f1f5f9 !important; cursor: not-allowed !important; opacity: 0.7; }

        .btn-update-pro {
            background: var(--eco-green) !important; color: white !important;
            padding: 22px 40px !important; border-radius: 22px !important;
            font-weight: 800 !important; width: 100% !important; border: none !important;
            box-shadow: 0 15px 35px rgba(45, 90, 39, 0.2) !important;
            font-size: 1.15rem !important; cursor: pointer; transition: 0.3s !important;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .btn-update-pro:hover { transform: translateY(-4px); box-shadow: 0 20px 45px rgba(45, 90, 39, 0.4); }

        .btn-cancel-pro {
            display: block; text-align: center; padding: 18px; color: var(--text-muted) !important;
            font-weight: 700 !important; border-radius: 22px !important;
            background: #f1f5f9 !important; text-decoration: none !important;
            margin-top: 15px; transition: 0.3s !important;
        }
        .btn-cancel-pro:hover { background: #e2e8f0; color: var(--text-dark) !important; }

        .special-accent { color: var(--eco-orange) !important; }

        /* Validation Styles */
        .input-error { border-color: var(--eco-red) !important; background: #fff5f5 !important; }
        .error-text { color: var(--eco-red); font-size: 0.75rem; font-weight: 800; margin-top: 5px; display: none; }
    </style>

<div class="main-edit-wrapper">
    <div class="pro-card-layout">
        <!-- 1. Left Side Info -->
        <div class="side-info-panel">
            <div class="avatar-holder-pro">
                {{ user.nom|first|upper }}{{ user.prenom|first|upper }}
            </div>
            <h3>{{ user.nom }} {{ user.prenom }}</h3>
            <span class="role-badge">{{ user.role.value }}</span>
            
            <div class="mt-auto small" style="opacity: 0.6; font-weight: 600;">
                <i class="bi bi-clock-history me-1"></i> Membre depuis: <br>
                {{ "now"|date("F Y") }}
            </div>
        </div>

        <!-- 2. Right Side Form -->
        <div class="form-main-panel">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'edit-user-form'}}) }}
                
                <div class="section-label-pro"><i class="bi bi-person-check-fill special-accent"></i> Identity Details</div>
                <div class="row">
                    <div class="col-md-6 input-box-pro">
                        <label>Prénom</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-tag"></i>
                            {{ form_widget(form.prenom, {'attr': {'class': 'form-input-pro'}}) }}
                        </div>
                        <span class="error-text">Prénom invalide.</span>
                    </div>
                    <div class="col-md-6 input-box-pro">
                        <label>Nom</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-person"></i>
                            {{ form_widget(form.nom, {'attr': {'class': 'form-input-pro'}}) }}
                        </div>
                        <span class="error-text">Nom invalide.</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 input-box-pro">
                        <label>Âge</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-calendar3"></i>
                            {{ form_widget(form.age, {'attr': {'class': 'form-input-pro', 'type': 'number', 'min': '18', 'max': '40'}}) }}
                        </div>
                        <span class="error-text">Âge invalide.</span>
                    </div>
                    <div class="col-md-6 input-box-pro">
                        <label>Téléphone</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-phone"></i>
                            {{ form_widget(form.telephone, {'attr': {'class': 'form-input-pro'}}) }}
                        </div>
                        <span class="error-text">Téléphone invalide.</span>
                    </div>
                </div>

                <div class="section-label-pro"><i class="bi bi-shield-lock-fill special-accent"></i> Access & Security</div>
                <div class="row">
                    <div class="col-md-6 input-box-pro">
                        <label>Email (Read-only)</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-envelope"></i>
                            {{ form_widget(form.email, {'attr': {'class': 'form-input-pro bg-disabled'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6 input-box-pro">
                        <label>Mot de passe</label>
                        <div class="input-wrapper-pro">
                            <i class="bi bi-key"></i>
                            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-input-pro', 'placeholder': '••••••••'}}) }}
                        </div>
                        <span class="error-text">Mot de passe invalide.</span>
                    </div>
                </div>

                {% if user.role.value == 'COACH' %}
                    <div class="section-label-pro"><i class="bi bi-award-fill special-accent"></i> Professional Profile</div>
                    <div class="row">
                        <div class="col-md-6 input-box-pro">
                            <label>Spécialité</label>
                            {{ form_widget(form.specialite, {'attr': {'class': 'form-input-pro', 'style': 'padding-left: 20px;'}}) }}
                            <span class="error-text"></span>
                        </div>
                        <div class="col-md-6 input-box-pro">
                            <label>Expérience (Années)</label>
                            {{ form_widget(form.experience, {'attr': {'class': 'form-input-pro', 'style': 'padding-left: 20px;'}}) }}
                            <span class="error-text">Expérience invalide.</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 input-box-pro">
                            <label>Disponibilité</label>
                            {{ form_widget(form.disponibilite, {'attr': {'class': 'form-input-pro', 'style': 'padding-left: 20px;'}}) }}
                            <span class="error-text"></span>
                        </div>
                    </div>
                    <div class="col-12 input-box-pro">
                        <label>Biographie</label>
                        {{ form_widget(form.bioCertifs, {'attr': {'class': 'form-input-pro', 'style': 'padding-left: 20px;', 'rows': 4}}) }}
                        <span class="error-text"></span>
                    </div>
                {% endif %}

                <div class="d-none">{{ form_rest(form) }}</div>

                <div class="mt-4">
                    <button type="submit" class="btn-update-pro">
                        <i class="bi bi-check-circle me-2"></i> Sauvegarder les modifications
                    </button>
                    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_user_app_index') : path('app_profile_index') }}" class="btn-cancel-pro">
                        Annuler
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('edit-user-form');
    
    const showError = (input, show, message = null) => {
        const group = input.closest('.input-box-pro');
        if (!group) return;
        const errorSpan = group.querySelector('.error-text');
        if (show) {
            input.classList.add('input-error');
            if (errorSpan) {
                errorSpan.style.display = 'block';
                if (message) errorSpan.innerText = message;
            }
        } else {
            input.classList.remove('input-error');
            if (errorSpan) {
                errorSpan.style.display = 'none';
            }
        }
    };

    const validateField = (input) => {
        const val = input.value.trim();
        const id = input.id || input.name;

        // Skip read-only email
        if (input.classList.contains('bg-disabled')) return true;

        if (input.required && !val) {
            showError(input, true, "Ce champ est obligatoire.");
            return false;
        }

        // Name/Surname: No numbers
        if (id.includes('nom') || id.includes('prenom')) {
            if (/[0-9]/.test(val)) {
                showError(input, true, "Ne doit pas contenir de chiffres.");
                return false;
            }
            if (val.length > 0 && val.length < 2) {
                showError(input, true, "Minimum 2 caractères.");
                return false;
            }
        }

        // Phone: 8 digits (Tunisia: 2,4,5,9)
        if (id.includes('telephone')) {
            if (val && !/^[2459]\d{7}$/.test(val)) {
                showError(input, true, "Numéro invalide (8 chiffres commençant par 2, 4, 5 ou 9).");
                return false;
            }
        }

        // Age: 18-40
        if (id.includes('age')) {
            const ageVal = parseInt(val);
            if (val && (isNaN(ageVal) || ageVal < 18 || ageVal > 40)) {
                showError(input, true, "Entre 18 et 40 ans.");
                return false;
            }
        }

        // Password: min 8 (if not empty)
        if (id.includes('plainPassword')) {
            if (val.length > 0) {
                if (val.length < 8) {
                    showError(input, true, "Minimum 8 caractères.");
                    return false;
                }
                if (!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/.test(val)) {
                    showError(input, true, "Majuscule, minuscule et chiffre requis.");
                    return false;
                }
            }
        }

        // Experience
        if (id.includes('experience')) {
            const expVal = parseInt(val);
            if (val && (isNaN(expVal) || expVal < 0 || expVal > 50)) {
                showError(input, true, "Entre 0 et 50 ans.");
                return false;
            }
        }

        showError(input, false);
        return true;
    };

    form.addEventListener('submit', (e) => {
        let hasError = false;
        const inputs = form.querySelectorAll('input:not([type="hidden"]), select, textarea');
        
        inputs.forEach(input => {
            input.dataset.touched = 'true'; // Mark as touched on submit
            if (!validateField(input)) {
                hasError = true;
            }
        });

        if (hasError) {
            e.preventDefault();
            const firstError = document.querySelector('.input-error');
            if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    form.querySelectorAll('input, select, textarea').forEach(input => {
        input.addEventListener('blur', () => {
            input.dataset.touched = 'true';
            validateField(input);
        });
        input.addEventListener('input', () => {
            if (input.dataset.touched === 'true') {
                validateField(input);
            }
        });
    });
});
</script>
{% endblock %}