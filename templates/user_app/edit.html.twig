{# templates/user_app/edit.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Modifier Profil - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed !important;
            background-size: cover !important;
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 25px; padding: 40px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%; max-width: 650px;
        }
        .form-control, .form-select { border-radius: 12px; margin-bottom: 10px; }
        .btn-update {
            background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            color: white; border-radius: 50px; padding: 12px; font-weight: bold; width: 100%; border: none;
        }
    </style>
</head>
<body>
{# templates/user_app/edit.html.twig #}

<div class="glass-card">
    <h2 class="text-center fw-bold mb-4" style="color: #2c3e50;">Modifier Profil</h2>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }} {# 'novalidate' bech t'khalli Symfony ya3mel el contrôle #}
        
        <div class="row">
            <div class="col-md-6">
                <label class="small fw-bold">Nom</label>
                {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small">{{ form_errors(form.nom) }}</div>
            </div>
            <div class="col-md-6">
                <label class="small fw-bold">Prénom</label>
                {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small">{{ form_errors(form.prenom) }}</div>
            </div>
        </div>

        <label class="small fw-bold mt-2">E-mail</label>
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        <div class="text-danger small">{{ form_errors(form.email) }}</div>

        <div class="col-12 mt-2">
            <label class="small fw-bold">Mot de passe (Laisser vide pour garder l'actuel)</label>
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger small">{{ form_errors(form.plainPassword) }}</div>
        </div>

{% if user.role.value == 'COACH' %}
    <div class="row">
        <div class="col-md-6">
            <label class="small fw-bold">Spécialité</label>
            {{ form_widget(form.specialite, {'attr': {'class': 'form-select'}}) }}
        </div>
        <div class="col-md-6">
            <label class="small fw-bold">Disponibilité</label>
            {{ form_widget(form.disponibilite, {'attr': {'class': 'form-select'}}) }}
        </div>
    </div>

    <label class="small fw-bold mt-2">Bio & Certificats</label>
    {{ form_widget(form.bio_certifs, {'attr': {'class': 'form-control', 'rows': 3}}) }}
{% else %}
    {# Behi: lezem n'khabiw el fields hadhom bech Symfony ma ya3melch error #}
    <div class="d-none">
        {{ form_widget(form.specialite) }}
        {{ form_widget(form.disponibilite) }}
        {{ form_widget(form.bio_certifs) }}
    </div>
{% endif %}

        <div style="display:none;">{{ form_rest(form) }}</div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-update">Mettre à jour</button>
            <a href="{{ path('app_profile_index') }}" class="btn btn-outline-secondary rounded-pill w-50 d-flex align-items-center justify-content-center">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
</body>
</html>