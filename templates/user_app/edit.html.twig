{# templates/user_app/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier Profil - EcoAdventure{% endblock %}

{# templates/user_app/edit.html.twig #}

{% block css %}
<style>
    /* 1. Rigel el wrapper bech i-dha7i el footer louta */
    .edit-profile-wrapper {
        background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed !important;
        background-size: cover !important;
        /* min-height mta3 el viewport m3a e7tiseb el navbar w el footer */
        min-height: 80vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        position: relative;
    }

    /* 2. Na7i el background mel body dakhél el edit bech ma i-ghattich 3al footer */
    body {
        background: #f8f9fa !important; /* background sghir louta l'el footer */
        display: block !important; /* Na7iw el flex mel body kenek 7attitou */
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 650px;
        z-index: 2; /* bech el card dima l'fou9 */
    }
</style>
{% endblock %}

{% block body %}
<div class="edit-profile-wrapper">
    <div class="glass-card">
        <h2 class="text-center fw-bold mb-4" style="color: #2c3e50;">
            <i class="bi bi-person-gear me-2 text-primary"></i>Modifier Profil
        </h2>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="small fw-bold mb-1">Nom</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.nom) }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="small fw-bold mb-1">Prénom</label>
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">{{ form_errors(form.prenom) }}</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="small fw-bold mb-1">E-mail</label>
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                <div class="text-danger small">{{ form_errors(form.email) }}</div>
            </div>

            <div class="mb-3">
                <label class="small fw-bold mb-1">Mot de passe <span class="text-muted fw-normal">(Laisser vide pour garder l'actuel)</span></label>
                {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                <div class="text-danger small">{{ form_errors(form.plainPassword) }}</div>
            </div>

            {% if user.role.value == 'COACH' %}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="small fw-bold mb-1">Spécialité</label>
                        {{ form_widget(form.specialite, {'attr': {'class': 'form-select'}}) }}
                        <div class="text-danger small">{{ form_errors(form.specialite) }}</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="small fw-bold mb-1">Disponibilité</label>
                        {{ form_widget(form.disponibilite, {'attr': {'class': 'form-select'}}) }}
                        <div class="text-danger small">{{ form_errors(form.disponibilite) }}</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small fw-bold mb-1">Bio & Certificats</label>
                    {{ form_widget(form.bio_certifs, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                    <div class="text-danger small">{{ form_errors(form.bio_certifs) }}</div>
                                {% else %}
                {# Hidden fields for simple user #}
                <div class="d-none">
                    {{ form_widget(form.specialite) }}
                    {{ form_widget(form.disponibilite) }}
                    {{ form_widget(form.bioCertifs) }}
                </div>
            {% endif %}

            <div style="display:none;">{{ form_rest(form) }}</div>

            <div class="mt-4 d-flex gap-3">
                <button type="submit" class="btn btn-update">
                    <i class="bi bi-check-lg me-2"></i>Mettre à jour
                </button>
                <a href="{{ path('app_profile_index') }}" class="btn btn-outline-secondary rounded-pill w-50 d-flex align-items-center justify-content-center fw-bold">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}