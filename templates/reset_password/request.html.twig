<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Réinitialiser mon mot de passe - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            font-family: 'Inter', sans-serif;
        }
        .reset-wrapper {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }
        .reset-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .icon-container {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #0369a1;
            font-size: 30px;
            box-shadow: 0 10px 20px rgba(186, 230, 253, 0.5);
        }
        .btn-custom {
            border-radius: 50px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            border: none;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 12px 20px;
            transition: all 0.3s ease;
        }
        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(2, 132, 199, 0.4);
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
        }
        .form-control-custom {
            border-radius: 12px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            background-color: #f8fafc;
            transition: all 0.3s ease;
        }
        .form-control-custom:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1);
            background-color: #fff;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #64748b;
            font-weight: 500;
            transition: color 0.3s ease;
            text-decoration: none;
        }
        .back-link:hover {
            color: #0f172a;
        }
    </style>
</head>
<body>
<div class="reset-wrapper">
    <div class="reset-card">
        <div class="icon-container">
            <i class="fas fa-key"></i>
        </div>
        
        <h2 class="text-center fw-bold mb-2" style="color: #0f172a;">Mot de passe oublié ?</h2>
        <p class="text-muted text-center small mb-4 px-2">
            Pas de panique ! Entrez votre adresse e-mail et nous vous enverrons les instructions pour réinitialiser votre mot de passe.
        </p>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger rounded-3 text-center small shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="fas fa-exclamation-circle"></i>
                <div>{{ flash_error }}</div>
            </div>
        {% endfor %}

        {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-4">
                <label class="small fw-semibold mb-2 text-dark">Adresse e-mail</label>
                {{ form_widget(requestForm.email, {
                    'attr': {
                        'class': 'form-control form-control-custom',
                        'placeholder': 'vous@exemple.com',
                        'autofocus': 'autofocus'
                    }
                }) }}
                <div class="text-danger small mt-1">
                    {{ form_errors(requestForm.email) }}
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-custom w-100 mb-4">
                Envoyer le lien de réinitialisation
            </button>
        {{ form_end(requestForm) }}

        <div class="text-center border-top pt-4 mt-2">
            <a href="{{ path('app_login') }}" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Retour à la connexion
            </a>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>