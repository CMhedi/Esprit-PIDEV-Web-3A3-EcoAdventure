<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Nouveau mot de passe - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            font-family: 'Inter', sans-serif;
        }
        .reset-wrapper {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }
        .reset-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .icon-container {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #f3e8ff 0%, #d8b4fe 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #7e22ce;
            font-size: 30px;
            box-shadow: 0 10px 20px rgba(216, 180, 254, 0.5);
        }
        .btn-custom {
            border-radius: 50px;
            background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
            border: none;
            font-weight: 600;
            letter-spacing: 0.5px;
            padding: 12px 20px;
            transition: all 0.3s ease;
            color: white;
        }
        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(168, 85, 247, 0.4);
            background: linear-gradient(135deg, #9333ea 0%, #6b21a8 100%);
            color: white;
        }
        .form-control-custom {
            border-radius: 12px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            background-color: #f8fafc;
            transition: all 0.3s ease;
        }
        .form-control-custom:focus {
            border-color: #c084fc;
            box-shadow: 0 0 0 4px rgba(192, 132, 252, 0.1);
            background-color: #fff;
        }
        .error-list ul {
            list-style: none;
            padding: 0;
            color: #ef4444;
            font-size: 0.85rem;
            margin-top: 8px;
        }
    </style>
</head>
<body>
<div class="reset-wrapper">
    <div class="reset-card">
        <div class="icon-container">
            <i class="fas fa-lock"></i>
        </div>
        
        <h2 class="text-center fw-bold mb-4" style="color: #0f172a;">Nouveau mot de passe</h2>

        {{ form_start(resetForm, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="mb-4">
                <label class="small fw-semibold mb-2 text-dark">Nouveau mot de passe</label>
                {{ form_widget(resetForm.plainPassword.first, {
                    'attr': {
                        'class': 'form-control form-control-custom', 
                        'placeholder': '••••••••',
                        'autofocus': 'autofocus'
                    }
                }) }}
                <div class="error-list text-danger small">
                    {{ form_errors(resetForm.plainPassword.first) }}
                </div>
            </div>

            <div class="mb-4">
                <label class="small fw-semibold mb-2 text-dark">Confirmez le mot de passe</label>
                {{ form_widget(resetForm.plainPassword.second, {
                    'attr': {
                        'class': 'form-control form-control-custom', 
                        'placeholder': '••••••••'
                    }
                }) }}
            </div>

            <button type="submit" class="btn btn-custom w-100 mt-2">
                Enregistrer le mot de passe
            </button>
        {{ form_end(resetForm) }}
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>