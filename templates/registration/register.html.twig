{# templates/registration/register.html.twig #}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Inscription - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .register-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 500px;
        }
        h2 { 
            color: #333; 
            font-weight: bold; 
            text-align: center; 
            margin-bottom: 30px;
        }
        .btn-info-custom {
            background: #00d2ff;
            color: white;
            border: none;
            border-radius: 50px;
            padding: 12px;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-info-custom:hover {
            background: #0099cc;
            transform: translateY(-2px);
            color: white;
        }
        #coach_section {
            background: rgba(248, 249, 250, 0.6);
            border-radius: 15px;
            border: 1px solid #dee2e6;
            padding: 20px;
            margin-bottom: 20px;
        }
        .invalid-feedback {
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="register-card">
    <h2>Inscription EcoAdventure</h2>

    {# Na7ina novalidate bech el validation dji mrigla #}
    {{ form_start(registrationForm) }}
        
        <div class="mb-3">
            {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control ' ~ (registrationForm.nom.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.nom) }}
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control ' ~ (registrationForm.prenom.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.prenom) }}
        </div>

        {# Champ Téléphone jdid #}
        <div class="mb-3">
            {{ form_label(registrationForm.telephone, 'Téléphone', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control ' ~ (registrationForm.telephone.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.telephone) }}
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control ' ~ (registrationForm.email.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.role, 'Rôle', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.role, {'attr': {'id': 'registration_form_role', 'class': 'form-select'}}) }}
        </div>

        <div id="coach_section" style="display: none;">
            <h5 class="mb-3 text-primary" style="font-size: 1rem; border-bottom: 2px solid #00d2ff; display: inline-block;">Détails Coach</h5>
            
            <div class="mb-3">
                {{ form_label(registrationForm.age, 'Âge') }}
                {{ form_widget(registrationForm.age, {'attr': {'class': 'form-control ' ~ (registrationForm.age.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
                {{ form_errors(registrationForm.age) }}
            </div>

            <div class="mb-3">
                {{ form_label(registrationForm.experience, 'Années d\'expérience') }}
                {{ form_widget(registrationForm.experience, {'attr': {'class': 'form-control ' ~ (registrationForm.experience.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
                {{ form_errors(registrationForm.experience) }}
            </div>

            {# templates/registration/register.html.twig #}

            <div class="mb-3">
                <label class="small fw-bold">Spécialité</label>
                {{ form_widget(registrationForm.specialite, {
                    'attr': {'class': 'form-select ' ~ (registrationForm.specialite.vars.valid ? '' : 'is-invalid')}
                }) }}
                <div class="invalid-feedback">
                    {{ form_errors(registrationForm.specialite) }}
                </div>
            </div>

            <div class="mb-3">
                <label class="small fw-bold">Disponibilité</label>
                {{ form_widget(registrationForm.disponibilite, {
                    'attr': {'class': 'form-select ' ~ (registrationForm.disponibilite.vars.valid ? '' : 'is-invalid')}
                }) }}
                <div class="invalid-feedback">
                    {{ form_errors(registrationForm.disponibilite) }}
                </div>
            </div>
                        
            <div class="mb-3">
                {{ form_label(registrationForm.bio_certifs, 'Bio et Certificats') }}
                {{ form_widget(registrationForm.bio_certifs, {'attr': {'class': 'form-control', 'rows': '3'}}) }}
            </div>
        </div>

        <div class="mb-3">
            {{ form_label(registrationForm.motdepasse, 'Mot de passe', {'label_attr': {'class': 'form-label fw-bold'}}) }}
            {{ form_widget(registrationForm.motdepasse, {'attr': {'class': 'form-control ' ~ (registrationForm.motdepasse.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
            {{ form_errors(registrationForm.motdepasse) }}
        </div>

        <div class="mb-4 form-check">
            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(registrationForm.agreeTerms, 'J\'accepte les termes', {'label_attr': {'class': 'form-check-label'}}) }}
            <div class="text-danger small">{{ form_errors(registrationForm.agreeTerms) }}</div>
        </div>
        
        <button type="submit" class="btn btn-info-custom w-100 shadow-sm">S'inscrire</button>
    {{ form_end(registrationForm) }}
    
    <div class="mt-3 text-center">
        <small class="text-muted">Déjà inscrit ? <a href="{{ path('app_login') }}" class="text-decoration-none" style="color: #0099cc;">Connectez-vous</a></small>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('registration_form_role');
    const coachSection = document.getElementById('coach_section');

    if (roleSelect) {
        function toggleCoachFields() {
            if (roleSelect.value === 'COACH') { 
                coachSection.style.display = 'block';
            } else {
                coachSection.style.display = 'none';
            }
        }
        roleSelect.addEventListener('change', toggleCoachFields);
        toggleCoachFields();
    }
});
</script>

</body>
</html>