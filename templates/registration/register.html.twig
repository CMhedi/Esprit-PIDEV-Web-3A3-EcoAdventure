{# templates/registration/register.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - EcoAdventure</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.4);
            --text-dark: #1e293b;
            --accent-blue: #3a7bd5;
            --success-green: #10b981;
            --warning-orange: #f59e0b;
            --error-red: #ef4444;
        }

        body {
            background: url("{{ asset('image/im.jpg') }}") no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            color: var(--text-dark);
            padding: 40px 20px;
        }

        .register-container {
            width: 100%;
            max-width: 700px;
            animation: fadeInScale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.9) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .register-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 40px;
            border-radius: 32px;
            border: 1px solid var(--glass-border);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .logo-area { text-align: center; margin-bottom: 30px; }
        .logo-icon {
            width: 56px; height: 56px; background: var(--primary-gradient);
            border-radius: 18px; display: flex; align-items: center; justify-content: center;
            color: white; font-size: 28px; margin: 0 auto 12px;
            box-shadow: 0 10px 20px rgba(58, 123, 213, 0.3);
        }

        h2 { font-weight: 700; font-size: 1.8rem; letter-spacing: -0.5px; margin-bottom: 5px; }

        .form-label { font-weight: 600; font-size: 0.85rem; color: #475569; margin-left: 12px; margin-bottom: 6px; }

        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 16px;
            padding: 12px 18px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            background: white; border-color: var(--accent-blue);
            box-shadow: 0 0 0 4px rgba(58, 123, 213, 0.1); transform: translateY(-2px);
        }

        .input-group-custom { position: relative; }
        .password-toggle {
            position: absolute; right: 15px; top: 50%; transform: translateY(-50%);
            cursor: pointer; color: #64748b; z-index: 10; background: none; border: none;
            padding: 5px;
        }

        /* Password Strength Meter */
        .strength-meter {
            height: 6px;
            background: rgba(0,0,0,0.1);
            border-radius: 3px;
            margin-top: 10px;
            margin-left: 12px;
            margin-right: 12px;
            overflow: hidden;
            display: none; /* Will be shown by JS */
        }
        .strength-bar { height: 100%; width: 0; transition: all 0.4s ease; border-radius: 3px; }
        .strength-text { font-size: 0.75rem; font-weight: 800; margin-left: 12px; margin-top: 5px; display: none; text-transform: uppercase; }

        #coach_section {
            background: rgba(58, 123, 213, 0.05); border-radius: 24px; padding: 25px;
            margin-bottom: 25px; border: 1px solid rgba(58, 123, 213, 0.1); display: none;
            animation: slideDown 0.4s ease;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn-submit {
            background: var(--primary-gradient); color: white; border: none;
            border-radius: 16px; padding: 15px; font-weight: 700; width: 100%;
            transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px;
            margin-top: 20px;
        }

        .btn-submit:hover { transform: translateY(-3px); box-shadow: 0 15px 25px -8px rgba(58, 123, 213, 0.5); color: white; }

        .text-danger { font-size: 0.75rem; font-weight: 600; margin-left: 12px; margin-top: 4px; }
        .is-invalid { border-color: var(--error-red) !important; }

        .link-area { text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,0.05); }
        .link-custom { color: var(--accent-blue); text-decoration: none; font-weight: 700; }
    </style>
</head>
<body>

<div class="register-container">
    <div class="register-card">
        <div class="logo-area">
            <div class="logo-icon"><i class="fas fa-mountain-sun"></i></div>
            <h2>Créer un compte</h2>
            <p class="text-muted small">Rejoignez l'aventure EcoAdventure</p>
        </div>

        {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'id': 'register-form'}}) }}
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control ' ~ (registrationForm.nom.vars.errors|length > 0 ? 'is-invalid' : ''), 'placeholder': 'Ex: Ben Ahmed'}}) }}
                    <div class="text-danger">{{ form_errors(registrationForm.nom) }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control ' ~ (registrationForm.prenom.vars.errors|length > 0 ? 'is-invalid' : ''), 'placeholder': 'Ex: Mohamed'}}) }}
                    <div class="text-danger">{{ form_errors(registrationForm.prenom) }}</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.telephone, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control ' ~ (registrationForm.telephone.vars.errors|length > 0 ? 'is-invalid' : '')}}) }}
                    <div class="text-danger">{{ form_errors(registrationForm.telephone) }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control ' ~ (registrationForm.email.vars.errors|length > 0 ? 'is-invalid' : ''), 'placeholder': 'nom@exemple.com'}}) }}
                    <div class="text-danger">{{ form_errors(registrationForm.email) }}</div>
                </div>
            </div>

            <div class="mb-4">
                {{ form_label(registrationForm.role, 'Quel est votre profil ?', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.role, {'attr': {'id': 'registration_form_role', 'class': 'form-select'}}) }}
            </div>

            <div id="coach_section">
                <h6 class="mb-3 fw-bold text-primary"><i class="fas fa-certificate me-2"></i>Informations Coach</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(registrationForm.age, 'Âge', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.age, {'attr': {'class': 'form-control', 'placeholder': 'Min. 18'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(registrationForm.experience, 'Années d\'expérience', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(registrationForm.experience, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 5'}}) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Spécialité</label>
                        {{ form_widget(registrationForm.specialite, {'attr': {'class': 'form-select'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Disponibilité</label>
                        {{ form_widget(registrationForm.disponibilite, {'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>
                <div class="mb-0">
                    {{ form_label(registrationForm.bio_certifs, 'Bio (Optionnel)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.bio_certifs, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Parlez-nous de vous...'}}) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.motdepasse.first, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group-custom">
                        {{ form_widget(registrationForm.motdepasse.first, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        <button type="button" class="password-toggle" onclick="togglePass(this)"><i class="fas fa-eye"></i></button>
                    </div>
                    <div class="strength-meter" id="meter-container">
                        <div class="strength-bar" id="meter-bar"></div>
                    </div>
                    <div class="strength-text" id="meter-text"></div>
                    <div class="text-danger">{{ form_errors(registrationForm.motdepasse.first) }}</div>
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(registrationForm.motdepasse.second, 'Confirmer', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group-custom">
                        {{ form_widget(registrationForm.motdepasse.second, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                        <button type="button" class="password-toggle" onclick="togglePass(this)"><i class="fas fa-eye"></i></button>
                    </div>
                    <div id="match-status" class="small fw-bold mt-2 ms-2" style="display: none;"></div>
                </div>
            </div>

            <div class="mb-4 form-check d-flex align-items-center gap-2" style="margin-left: 10px;">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'form-check-label small'}}) }}
                <div class="text-danger">{{ form_errors(registrationForm.agreeTerms) }}</div>
            </div>
            
            <button type="submit" class="btn btn-submit shadow-sm" id="submitBtn">
                <span class="spinner-border spinner-border-sm d-none" id="loader"></span>
                <span>S'inscrire</span>
            </button>
        {{ form_end(registrationForm) }}
        
        <div class="link-area">
            <span class="text-muted small">Déjà un compte ?</span>
            <a href="{{ path('app_login') }}" class="link-custom ms-1">Se connecter</a>
        </div>
    </div>
</div>

<script>
function togglePass(btn) {
    const input = btn.parentElement.querySelector('input');
    const icon = btn.querySelector('i');
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.classList.toggle('fa-eye'); icon.classList.toggle('fa-eye-slash');
}

document.addEventListener('DOMContentLoaded', function() {
    const roleSelect = document.getElementById('registration_form_role');
    const coachSection = document.getElementById('coach_section');
    const registerForm = document.getElementById('register-form');
    const submitBtn = document.getElementById('submitBtn');
    const loader = document.getElementById('loader');
    
    // Improved Selection for Symfony generated IDs
    const p1 = document.querySelector('input[id*="_motdepasse_first"]');
    const p2 = document.querySelector('input[id*="_motdepasse_second"]');
    
    const meterCont = document.getElementById('meter-container');
    const meterBar = document.getElementById('meter-bar');
    const meterText = document.getElementById('meter-text');
    const matchStatus = document.getElementById('match-status');

    if (roleSelect) {
        function toggleCoachFields() {
            coachSection.style.display = roleSelect.value === 'COACH' ? 'block' : 'none';
        }
        roleSelect.addEventListener('change', toggleCoachFields);
        toggleCoachFields();
    }

    // Password Strength Logic
    if (p1) {
        p1.addEventListener('input', () => {
            const val = p1.value;
            if (val.length === 0) {
                meterCont.style.display = 'none';
                meterText.style.display = 'none';
                return;
            }
            meterCont.style.display = 'block';
            meterText.style.display = 'block';
            
            let strength = 0;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            let color = '#ef4444';
            let text = 'Faible';
            let width = '25%';

            if (strength === 2) { color = '#f59e0b'; text = 'Moyen'; width = '50%'; }
            else if (strength === 3) { color = '#3b82f6'; text = 'Fort'; width = '75%'; }
            else if (strength === 4) { color = '#10b981'; text = 'Très Fort'; width = '100%'; }

            meterBar.style.width = width;
            meterBar.style.backgroundColor = color;
            meterText.innerText = text;
            meterText.style.color = color;
        });
    }

    // Password Match Logic
    if (p2 && p1) {
        p2.addEventListener('input', () => {
            if (p2.value.length === 0) { matchStatus.style.display = 'none'; return; }
            matchStatus.style.display = 'block';
            if (p1.value === p2.value) {
                matchStatus.innerText = '✓ Correspondance parfaite';
                matchStatus.style.color = '#10b981';
            } else {
                matchStatus.innerText = '✗ Ne correspond pas';
                matchStatus.style.color = '#ef4444';
            }
        });
    }

    registerForm.addEventListener('submit', (e) => {
        if (registerForm.checkValidity()) {
            submitBtn.disabled = true;
            loader.classList.remove('d-none');
            submitBtn.querySelector('span:not(.spinner-border)').innerText = "Inscription...";
        }
    });
});
</script>
</body>
</html>