{% extends 'base.html.twig' %}

{% block title %}Reservation Activite{% endblock %}

{% block body %}
{% set fieldErrors = fieldErrors|default({}) %}
{% set formData = formData|default({}) %}

<div class="container my-5">
    <h2 class="mb-4">Reserver une Activite</h2>

    <style>
        .error-label {
            color: #dc3545;
            display: block;
            font-size: 0.9rem;
            margin-top: 0.35rem;
        }

        .activite-image-card {
            border: 1px solid #d9e7dc;
            border-radius: 1rem;
            background: #fff;
            box-shadow: 0 12px 30px rgba(18, 62, 32, 0.08);
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .activite-image-preview {
            width: 100%;
            max-width: 360px;
            max-height: 240px;
            object-fit: cover;
            border-radius: 0.9rem;
            border: 1px solid #dce9df;
            cursor: zoom-in;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .activite-image-preview:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 24px rgba(25, 135, 84, 0.16);
        }

        .activite-image-note {
            color: #617166;
            font-size: 0.92rem;
            margin-top: 0.7rem;
        }

        .activite-lightbox-image {
            width: 100%;
            max-height: 75vh;
            object-fit: contain;
            border-radius: 1rem;
        }
    </style>

    {% if activite.imageUrl %}
        <div class="activite-image-card">
            <label class="form-label">Image de l'activite</label>
            <div>
                <img
                    src="{{ asset(activite.imageUrl) }}"
                    alt="{{ activite.nom }}"
                    class="activite-image-preview"
                    data-activite-image-preview
                    data-image-src="{{ asset(activite.imageUrl) }}"
                >
            </div>
            <div class="activite-image-note">
                Double-clique sur la photo pour l'ouvrir en grand.
            </div>
        </div>
    {% endif %}

    <form action="{{ path('app_reservation_create', {'id': activite.idActivite}) }}" method="POST" novalidate>
        
        <div class="mb-3">
            <label class="form-label">Activite selectionnee</label>
            <input type="text" class="form-control" value="{{ activite.nom }}" readonly>
        </div>

        <div class="mb-3">
            <label for="date_res" class="form-label">Date Reservation</label>
            <input
                type="datetime-local"
                class="form-control"
                id="date_res"
                name="date_res"
                value="{{ formData.date_res|default('') }}"
                min="{{ "now"|date('Y-m-d\\TH:i') }}"
            >
            {% for message in fieldErrors.dateRes|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
            {% for message in fieldErrors.date_res|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        <div class="mb-3">
            <label for="statut_res" class="form-label">Statut Reservation</label>
            <select class="form-select" id="statut_res" name="statut_res">
                <option value="">Choisir le statut</option>
                <option value="EN_ATTENTE" {{ formData.statut_res|default('') == 'EN_ATTENTE' ? 'selected' : '' }}>EN_ATTENTE</option>
                <option value="CONFIRMEE" {{ formData.statut_res|default('') == 'CONFIRMEE' ? 'selected' : '' }}>CONFIRMEE</option>
                <option value="ANNULEE" {{ formData.statut_res|default('') == 'ANNULEE' ? 'selected' : '' }}>ANNULEE</option>
            </select>
            {% for message in fieldErrors.statut_res|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        <div class="mb-3">
            <label for="nb_personnes" class="form-label">Nombre de personnes</label>
            <input
                type="text"
                class="form-control"
                id="nb_personnes"
                name="nb_personnes"
                placeholder="Nombre de personnes"
                value="{{ formData.nb_personnes|default('') }}"
            >
            {% for message in fieldErrors.nb_personnes|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        <div class="mb-3">
            <a href="{{ path('app_reservation_disponibilite', {'id': activite.idActivite}) }}"
               class="btn btn-outline-primary rounded-pill px-4">
                Voir disponibilite
            </a>
        </div>

        <button type="submit" class="btn btn-success rounded-pill px-5">
            Reserver
        </button>

    </form>
</div>

<div class="modal fade" id="activiteImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">Image de l'activite</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2 text-center">
                <img src="" class="activite-lightbox-image" id="activiteImageModalPreview">
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const preview = document.querySelector('[data-activite-image-preview]');
    const modalElement = document.getElementById('activiteImageModal');
    const modalImage = document.getElementById('activiteImageModalPreview');

    if (!preview || !modalElement || !modalImage || typeof bootstrap === 'undefined') {
        return;
    }

    const modal = new bootstrap.Modal(modalElement);

    preview.addEventListener('dblclick', () => {
        modalImage.src = preview.dataset.imageSrc || preview.src;
        modal.show();
    });
});
</script>
{% endblock %}