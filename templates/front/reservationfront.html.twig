{% extends 'base.html.twig' %}

{% block title %}Réservation Activité{% endblock %}

{% block body %}
<div class="container my-5">
    <h2 class="mb-4">Réserver une Activité</h2>

    <form action="{{ path('app_reservation_create', {'id': activite.idActivite}) }}" method="POST">

        <div class="mb-3">
            <label class="form-label">Activité sélectionnée</label>
            <input type="text" class="form-control" value="{{ activite.nom }}" readonly>
        </div>

        <div class="mb-3">
            <label for="date_res" class="form-label">Date Réservation</label>
            <input type="datetime-local"
                   class="form-control"
                   id="date_res"
                   name="date_res"
                   required>
        </div>

        <div class="mb-3">
            <label for="statut_res" class="form-label">Statut Réservation</label>
            <select class="form-select" id="statut_res" name="statut_res" required>
                <option value="">Choisir le statut</option>
                <option value="EN_ATTENTE">EN_ATTENTE</option>
                <option value="CONFIRMEE">CONFIRMEE</option>
                <option value="ANNULEE">ANNULEE</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="nb_personnes" class="form-label">Nombre de personnes</label>
            <input type="number"
                   class="form-control"
                   id="nb_personnes"
                   name="nb_personnes"
                   min="1"
                   required>
        </div>

        <button type="submit" class="btn btn-success rounded-pill px-5">
            Réserver
        </button>
    </form>
</div>
{% endblock %}