{% extends 'base.html.twig' %}

{% block title %}Messagerie - EcoAdventure{% endblock %}

{% block css %}
<style>
   .chat-container {
    height: 85vh;
    background: #f8f9fa;
    border-radius: 15px;
    overflow: hidden;
    display: flex;
}
   .conversation-list {
    background: white;
    border-right: 1px solid #eee;
    display: flex;
    flex-direction: column;
    height: 100%;
    flex: 0 0 32%;
    max-width: 32%;
}
.conversation-scroll-area {
    flex: 1;
    overflow-y: auto;
}
    .conversation-item {
        transition: all 0.2s;
        border: none;
        border-left: 4px solid transparent;
        text-decoration: none;
    }
    .conversation-item:hover {
        background-color: #f1f8f4;
        cursor: pointer;
    }
    .conversation-item.active {
        background-color: #e8f5e9;
        border-left-color: #28a745;
    }
    .conversation-filter-bar {
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }
    .conversation-search-input {
        border-radius: 50px;
        border: 1px solid #dee2e6;
    }
    .conversation-sort-btns {
        gap: 0.35rem;
        flex-wrap: wrap;
    }
    .conversation-sort-btns .btn.active {
        background-color: #28a745;
        color: white;
        border-color: #28a745;
    }
    .conversation-tag {
        font-size: 0.75rem;
        padding: 0.2rem 0.45rem;
        border-radius: 999px;
        background: #e9f7ef;
        color: #1b5e20;
    }
    .chat-window {
    background: white;
    flex: 1 1 68%;
    max-width: 68%;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
}
    @media (max-width: 767.98px) {
        .chat-container {
            display: block;
            height: auto;
        }
        .conversation-list,
        .chat-window {
            max-width: 100%;
            flex: 1 1 100%;
        }
    }
    .messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    scroll-behavior: smooth;
}
    .messages-area::-webkit-scrollbar {
        width: 8px;
    }
    
    .messages-area::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .messages-area::-webkit-scrollbar-thumb {
        background: #28a745;
        border-radius: 4px;
    }
    
    .messages-area::-webkit-scrollbar-thumb:hover {
        background: #218838;
    }
    .message-bubble {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 18px;
        margin-bottom: 10px;
        position: relative;
        font-size: 0.95rem;
        word-break: break-word;
    }
    .message-sent {
        background-color: #28a745;
        color: white;
        border-bottom-right-radius: 2px;
    }
    .message-received {
        background-color: white;
        color: #333;
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .time-stamp {
        font-size: 0.7rem;
        opacity: 0.8;
        display: block;
        margin-top: 4px;
    }
    .bg-eco { background-color: #28a745; }
    .btn-eco { background-color: #28a745; border: none; color: white; }
    .btn-eco:hover { background-color: #218838; color: white; }
    .online-dot {
        height: 10px;
        width: 10px;
        background-color: #28a745;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        border: 2px solid white;
    }
    .online-dot.offline {
        background-color: #9aa0a6;
    }
    .unread-badge {
        min-width: 20px;
        height: 20px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0 6px;
        background: #0d6efd;
        color: #fff;
    }
    .message-item {
        transition: all 0.2s ease;
    }
    .message-item .message-actions-hover {
        position: absolute;
        top: 5px;
        right: 45px;
        opacity: 0;
        transition: opacity 0.2s ease;
        background: rgba(0, 0, 0, 0.7);
        padding: 4px 6px;
        border-radius: 4px;
        display: flex;
        gap: 4px;
    }
    .message-item:hover .message-actions-hover {
        opacity: 1;
    }
    .message-actions-hover .btn {
        padding: 2px 4px !important;
        font-size: 0.85rem;
    }
    .message-actions-hover .btn:hover {
        opacity: 0.8;
    }
    .message-footer {
        position: sticky;
        bottom: 0;
        background: white;
        z-index: 100;
        border-top: 1px solid #ddd;
        box-shadow: 0 -2px 5px rgba(0,0,0,0.05);
    }
    .composer-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }
    .gif-picker-panel {
        position: absolute;
        right: 0;
        bottom: 56px;
        width: 320px;
        background: #fff;
        border: 1px solid #dfe5f0;
        border-radius: 14px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
        padding: 0.55rem;
        z-index: 1500;
    }
    .gif-picker-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.45rem;
    }
    .gif-picker-search {
        border-radius: 999px;
        border: 1px solid #d9deea;
        padding: 0.3rem 0.65rem;
        width: 100%;
        font-size: 0.88rem;
    }
    .gif-picker-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.35rem;
        max-height: 300px;
        overflow-y: auto;
    }
    .gif-picker-item {
        border: 0;
        background: #f4f6fb;
        border-radius: 8px;
        padding: 0;
        overflow: hidden;
    }
    .gif-picker-item img {
        width: 100%;
        height: 108px;
        object-fit: cover;
        display: block;
    }
    .composer-input-wrap {
        display: flex;
        align-items: center;
        flex: 1;
        background: #ffffff;
        border: 1px solid #e3e7ee;
        border-radius: 10px;
        overflow: visible;
        position: relative;
    }
    .composer-emoji-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-right: 1px solid #edf1f6;
        background: #fbf6df;
        color: #d7b24c;
    }
    .composer-emoji-wrap {
        position: relative;
    }
    .emoji-picker-panel {
        position: absolute;
        left: 0;
        bottom: 52px;
        width: 340px;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #e1e6ef;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        padding: 0.4rem;
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 0.2rem;
        z-index: 1400;
    }
    .emoji-picker-panel.d-none {
        display: none;
    }
    .emoji-item-btn {
        border: 0;
        background: transparent;
        font-size: 1.1rem;
        border-radius: 6px;
        line-height: 1;
        padding: 0.25rem;
    }
    .emoji-item-btn:hover {
        background: #f1f4f9;
    }
    .composer-text-input {
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        padding-left: 0.85rem !important;
        padding-right: 0.85rem !important;
    }
    .media-action-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #e9f4ff;
        color: #57a7e6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .media-action-btn:hover {
        background: #d8ecff;
        color: #368ed2;
    }
    .media-action-btn.correcting {
        background: #fff4d6;
        color: #8d6a00;
    }
    .media-action-btn.recording {
        background: #ffebee;
        color: #c62828;
        animation: pulseMic 1s infinite;
    }
    @keyframes pulseMic {
        0% { box-shadow: 0 0 0 0 rgba(198, 40, 40, 0.35); }
        70% { box-shadow: 0 0 0 10px rgba(198, 40, 40, 0); }
        100% { box-shadow: 0 0 0 0 rgba(198, 40, 40, 0); }
    }
    .composer-send-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #1ecf6b;
        color: #fff;
    }
    .composer-send-btn:hover {
        background: #17b95e;
        color: #fff;
    }
    .preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }
    .composer-error {
        border: 1px solid #f5c2c7;
        background: #f8d7da;
        color: #842029;
        border-radius: 8px;
        padding: 0.45rem 0.65rem;
        font-size: 0.85rem;
    }
    .chat-video-inline {
        width: 100%;
        min-width: 260px;
        max-width: 520px;
        max-height: 320px;
        background: #000;
    }
    .video-open-btn {
        margin-top: 0.45rem;
    }
    .message-reactions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.4rem;
        flex-wrap: wrap;
    }
    .reaction-btn {
        border: 1px solid rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.2);
        color: inherit;
        border-radius: 999px;
        padding: 0.05rem 0.45rem;
        font-size: 0.85rem;
        line-height: 1.2;
        cursor: pointer;
    }
    .reaction-btn.active {
        background: #fff;
        color: #222;
    }
    .reaction-btn .reaction-label {
        margin-left: 0.2rem;
        font-size: 0.78rem;
    }
    .voice-message-card {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        background: linear-gradient(135deg, #1f73e0, #2a5ee8);
        color: #fff;
        border-radius: 18px;
        padding: 0.65rem 0.85rem;
        min-width: 280px;
        max-width: 360px;
        user-select: none;
    }
    .voice-message-time {
        font-weight: 700;
        min-width: 42px;
    }
    .voice-wave {
        flex: 1;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
    }
    .voice-wave span {
        display: block;
        width: 4px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.8);
        height: 5px;
    }
    .voice-wave span:nth-child(6) { height: 28px; background: #fff; }
    .voice-wave span:nth-child(5),
    .voice-wave span:nth-child(7) { height: 20px; }
    .voice-wave span:nth-child(4),
    .voice-wave span:nth-child(8) { height: 14px; }
    .voice-wave span:nth-child(3),
    .voice-wave span:nth-child(9) { height: 9px; }
    .voice-play-btn {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .vocal-recording-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        background: #1f73e0;
        color: #fff;
        border-radius: 999px;
        padding: 0.45rem 0.65rem;
    }
    .vocal-recording-timer {
        background: #fff;
        color: #1f73e0;
        border-radius: 999px;
        font-weight: 700;
        padding: 0.15rem 0.55rem;
        min-width: 54px;
        text-align: center;
    }
    .vocal-recording-wave {
        flex: 1;
        height: 10px;
        border-radius: 999px;
        background: linear-gradient(90deg, rgba(255,255,255,0.3), rgba(255,255,255,0.8), rgba(255,255,255,0.3));
        background-size: 200% 100%;
        animation: vocalWave 1.2s linear infinite;
    }
    @keyframes vocalWave {
        from { background-position: 0% 0; }
        to { background-position: 200% 0; }
    }
    .vocal-recording-stop,
    .vocal-recording-cancel {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .vocal-recording-stop {
        background: #fff;
        color: #1f73e0;
    }
    .vocal-recording-cancel {
        background: rgba(255, 255, 255, 0.22);
        color: #fff;
    }
    .message-checkmarks {
        display: inline-flex;
        gap: 1px;
        margin-left: 6px;
        font-size: 1rem;
        vertical-align: middle;
    }
    .checkmark {
        color: rgba(255, 255, 255, 0.6);
        font-weight: bold;
    }
    .checkmark.read {
        color: #1976d2;
        font-weight: bold;
    }
    .read-time {
        font-size: 0.7rem;
        margin-left: 4px;
        opacity: 0.8;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row chat-container g-0 shadow-lg">

        {# --- COLONNE GAUCHE (CONVERSATIONS) --- #}
        <div class="col-md-4 d-flex flex-column conversation-list">
            <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-success"><i class="bi bi-chat-dots-fill me-2"></i>Conversation</h5>
                <button class="btn btn-sm btn-light rounded-circle border shadow-sm" data-bs-toggle="modal" data-bs-target="#newListModal">
                    <i class="bi bi-pencil-square text-success"></i>
                </button>
            </div>
            <div class="p-3 border-bottom bg-white">
                <div class="d-flex flex-column conversation-filter-bar">
                    <div class="input-group input-group-sm conversation-search-input">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input id="conversationSearch" type="text" class="form-control border-start-0" placeholder="Rechercher une conversation..." aria-label="Rechercher une conversation">
                    </div>
                    <div class="d-flex align-items-center conversation-sort-btns">
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="all">Tous</button>
                        <button type="button" class="btn btn-outline-success btn-sm active" data-sort="name">Nom</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-sort="date">Date</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="groupe">Groupes</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="prive">Privés</button>
                    </div>
                </div>
            </div>
            <div class="flex-grow-1 p-2" style="overflow-y:auto">
                {% for conversation in conversations %}
                    {% if conversation is not null %}
                        {% set conversationAvatar = '' %}
                        {% set conversationOtherId = null %}
                        {% set conversationOtherPresence = null %}
                        {% set conversationDisplayTitle = conversation.titre %}
                        {% if not conversation.est_groupe %}
                            {% for participant in conversation.participants %}
                                {% if participant.id_user != mon_id and participant.image_url %}
                                    {% set conversationAvatar = participant.image_url %}
                                {% endif %}
                                {% if participant.id_user != mon_id %}
                                    {% set conversationOtherId = participant.id_user %}
                                    {% set conversationDisplayTitle = participant.nom ~ ' ' ~ participant.prenom %}
                                {% endif %}
                            {% endfor %}
                            {% if conversationOtherId and presence_by_user_id[conversationOtherId] is defined %}
                                {% set conversationOtherPresence = presence_by_user_id[conversationOtherId] %}
                            {% endif %}
                        {% endif %}
                        {% set conversationAvatarUrl = conversationAvatar
                            ? (conversationAvatar starts with 'http'
                                ? conversationAvatar
                                : (conversationAvatar starts with '/'
                                    ? conversationAvatar
                                    : asset(conversationAvatar)))
                            : '' %}
                        <a href="{{ path('app_messagerie_selected', {'id_user': mon_id, 'id_conversation': conversation.id_conversation}) }}"
                           class="card conversation-item mb-1 {% if current_conv is defined and current_conv and current_conv.id_conversation == conversation.id_conversation %}active{% endif %}"
                           data-open-url="{{ path('app_messagerie_selected', {'id_user': mon_id, 'id_conversation': conversation.id_conversation}) }}"
                           data-title="{{ conversationDisplayTitle|lower }}"
                           data-date="{{ conversation.date_creation ? conversation.date_creation|date('YmdHis') : '' }}"
                           data-type="{{ conversation.est_groupe ? 'groupe' : 'prive' }}">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="rounded-circle bg-eco d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 45px; height: 45px;">
                                            {% if conversationAvatarUrl %}
                                                <img src="{{ conversationAvatarUrl }}" alt="avatar" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                                            {% else %}
                                                <i class="bi {{ conversation.est_groupe ? 'bi-people-fill' : 'bi-person-fill' }}"></i>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3 text-dark">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-0 fw-bold text-truncate" style="max-width: 140px;">{{ conversationDisplayTitle }}</h6>
                                            <div class="d-flex align-items-center gap-2">
                                                {% set unreadCount = unread_by_conversation_id[conversation.id_conversation]|default(0) %}
                                                {% if unreadCount > 0 %}
                                                    <span class="unread-badge">{{ unreadCount }}</span>
                                                {% endif %}
                                                <small class="text-muted">{{ conversation.date_creation|date('d/m') }}</small>
                                            </div>
                                        </div>
                                        {% if conversation.est_groupe %}
                                            <small class="text-muted">Groupe</small>
                                        {% else %}
                                            <small class="text-muted">
                                                <span class="online-dot {{ conversationOtherPresence and conversationOtherPresence.online ? '' : 'offline' }}"></span>
                                                {{ conversationOtherPresence and conversationOtherPresence.online ? 'En ligne' : 'Hors ligne' }}
                                            </small>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            </a>
                        {% endif %}
                {% else %}
                        <div class="text-center mt-5 text-muted">
                            <i class="bi bi-chat-square-dots fs-1 opacity-25"></i>
                            <p>Aucune discussion</p>
                        </div>
                {% endfor %}
            </div>
            </div>

        {# --- COLONNE DROITE (CHAT) --- #}
        <div class="col-md-8 d-flex flex-column chat-window">

            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white shadow-sm">
                <div class="d-flex align-items-center">
                    {% set headerAvatar = '' %}
                    {% set headerOtherId = null %}
                    {% set headerPresence = null %}
                    {% set headerDisplayTitle = current_conv ? current_conv.titre : (nom_utilisateur ~ ' ' ~ prenom_utilisateur) %}
                    {% if current_conv and not current_conv.est_groupe %}
                        {% for participant in current_conv.participants %}
                            {% if participant.id_user != mon_id and participant.image_url %}
                                {% set headerAvatar = participant.image_url %}
                            {% endif %}
                            {% if participant.id_user != mon_id %}
                                {% set headerOtherId = participant.id_user %}
                                {% set headerDisplayTitle = participant.nom ~ ' ' ~ participant.prenom %}
                            {% endif %}
                        {% endfor %}
                        {% if headerOtherId and presence_by_user_id[headerOtherId] is defined %}
                            {% set headerPresence = presence_by_user_id[headerOtherId] %}
                        {% endif %}
                    {% endif %}
                    {% set headerAvatarUrl = headerAvatar
                        ? (headerAvatar starts with 'http'
                            ? headerAvatar
                            : (headerAvatar starts with '/'
                                ? headerAvatar
                                : asset(headerAvatar)))
                        : '' %}
                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px;">
                        {% if headerAvatarUrl %}
                            <img src="{{ headerAvatarUrl }}" alt="avatar" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                        {% else %}
                            <i class="bi bi-chat-dots-fill text-success fs-4"></i>
                        {% endif %}
                    </div>
                    <div>
                        <h5 class="m-0 fw-bold text-dark">
                            {{ headerDisplayTitle }}
                            {% if current_conv %}
                                <span class="badge bg-light text-success border ms-2" style="font-size: 0.7rem;">{{ current_conv.est_groupe ? 'Groupe' : 'Privé' }}</span>
                            {% endif %}
                        </h5>
                        {% if current_conv and not current_conv.est_groupe and current_conv.privateBlocked %}
                            <small class="text-danger fw-semibold">
                                <i class="bi bi-slash-circle me-1"></i>Conversation privee bloquee
                            </small>
                        {% elseif current_conv and not current_conv.est_groupe and headerPresence %}
                            <small class="{{ headerPresence.online ? 'text-success' : 'text-muted' }} fw-semibold">
                                <span class="online-dot {{ headerPresence.online ? '' : 'offline' }}"></span>
                                {{ headerPresence.online ? 'En ligne' : 'Hors ligne' }}
                            </small>
                        {% else %}
                            <small class="text-success fw-semibold"><span class="online-dot"></span>{{ current_conv ? 'Discussion active' : 'Aucune discussion sélectionnée' }}</small>
                        {% endif %}
                    </div>
                </div>
                <div class="text-muted fs-5 d-flex align-items-center">
                    <i class="bi bi-robot me-3" id="headerGeminiBtn" data-ai-open-url="{{ path('app_messagerie_ai_open', {'id_user': mon_id}) }}" style="cursor:pointer" title="Assistant IA"></i>
                    <i class="bi bi-telephone-fill me-3" style="cursor:pointer"></i>
                    <i class="bi bi-camera-video-fill me-3" style="cursor:pointer"></i>
                    <i class="bi bi-info-circle-fill text-info" style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#infoModal"></i>
                </div>
            </div>

            <div class="flex-grow-1 p-4 messages-area d-flex flex-column" id="messagesContainer" style="overflow-y:auto"
                 data-my-user-id="{{ mon_id }}"
                 data-current-conversation-id="{{ current_conv ? current_conv.id_conversation : '' }}"
                 data-last-message-id="{{ messages|length > 0 ? messages|last.id_message : 0 }}"
                 data-current-title="{{ current_conv ? current_conv.titre : '' }}">
                {% if current_conv %}
                    {% set is_group_admin = current_conv.est_groupe and current_conv.createur is defined and current_conv.createur.id_user == mon_id %}
                {% endif %}
                {% if current_conv %}
                {% for message in messages %}
                    {% set is_mine = (message.userApp is defined and message.userApp.id_user == mon_id) %}
                    {% set msgType = message.type_message and message.type_message.value is defined ? message.type_message.value : (message.type_message ?? '') %}
                    {% set rawContent = message.contenu ?? '' %}
                    {% set hasUrlInText = rawContent matches '/(https?:\\/\\/|www\\.)\\S+/i' %}
                    {% set isTextStyled = msgType == 'TEXTE' and not hasUrlInText %}
                    <div class="d-flex {{ is_mine ? 'justify-content-end' : 'justify-content-start' }} mb-3 message-item">
                        <div class="message-bubble {{ (is_mine and isTextStyled) ? 'message-sent shadow' : 'message-received shadow-sm' }}" style="position: relative;">
                            <div class="mb-2 fw-bold small text-muted">{{ message.userApp ? (message.userApp.nom ~ ' ' ~ message.userApp.prenom) : 'Utilisateur' }}</div>
                            {% set attachments = message.attachments|default([]) %}
                            {% set contentParts = rawContent ? rawContent|split('|', 2) : [''] %}
                            {% set mediaPath = attachments is empty ? (contentParts[0] ?? '') : '' %}
                            {% set mediaComment = attachments is empty ? (contentParts[1] ?? '') : rawContent %}
                            {% set mediaRelative = mediaPath starts with '/uploads/' ? mediaPath|slice(9) : '' %}
                            {% set mediaRemoteUrl = mediaPath starts with 'http' ? mediaPath : '' %}
                            {% set mediaUrl = mediaRemoteUrl ?: (mediaRelative ? path('app_media_by_path', {'path': mediaPath}) : '') %}
                            {% set mediaDownloadUrl = mediaRemoteUrl ?: (mediaRelative ? path('app_media_by_path', {'path': mediaPath, 'download': 1}) : '') %}
                            {% set mediaFileName = mediaPath ? (mediaPath|split('/')|last) : 'fichier' %}
                            {% set mediaExt = mediaPath ? (mediaPath|split('.')|last|lower) : '' %}
                            {% set mediaParts = mediaPath ? mediaPath|split('/') : [] %}
                            {% set mediaFolder = mediaParts|length > 2 ? mediaParts[2]|lower : '' %}
                            {% set isVideoFile = (mediaFolder == 'video' and mediaFolder != 'vocale') or (mediaExt in ['mp4', 'mov', 'avi', 'mkv', 'webm'] and mediaFolder != 'vocale') %}
                            {% set isAudioFile = mediaFolder in ['audio', 'call', 'vocale'] or mediaExt in ['mp3', 'wav', 'm4a', 'ogg', 'aac', 'webm'] %}
                            {% set isImageFile = mediaFolder == 'images' or mediaExt in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}
                            {% set isPdfFile = (mediaFolder == 'files' and mediaExt == 'pdf') or mediaExt == 'pdf' %}
                            {% set reactions = message.reactions ?? {} %}
                            {% set reactionOptions = ['❤️'] %}
                            {% set userReaction = '' %}
                            {% for reactionEmoji in reactionOptions %}
                                {% if mon_id in (reactions[reactionEmoji]|default([])) %}
                                    {% set userReaction = reactionEmoji %}
                                {% endif %}
                            {% endfor %}

                            {% if attachments is not empty %}
                                {% for attachment in attachments %}
                                    {% set attachmentPath = attachment.path|default('') %}
                                    {% set attachmentRelative = attachmentPath starts with '/uploads/' ? attachmentPath|slice(9) : '' %}
                                    {% set attachmentRemoteUrl = attachmentPath starts with 'http' ? attachmentPath : '' %}
                                    {% set attachmentUrl = attachmentRemoteUrl ?: (attachmentRelative ? path('app_media_by_path', {'path': attachmentPath}) : '') %}
                                    {% set attachmentDownloadUrl = attachmentRemoteUrl ?: (attachmentRelative ? path('app_media_by_path', {'path': attachmentPath, 'download': 1}) : '') %}
                                    {% set attachmentName = attachment.name|default(attachmentPath ? (attachmentPath|split('/')|last) : 'fichier') %}
                                    {% set attachmentMime = attachment.mime|default('') %}
                                    {% set attachmentType = attachment.type|default('') %}
                                    <div class="mb-2">
                                        {% if attachmentType in ['AUDIO', 'VOCALE', 'APPEL_AUDIO'] or attachmentMime starts with 'audio/' %}
                                            <div class="voice-message-card js-open-media" data-media-url="{{ attachmentUrl }}" data-media-kind="audio" title="Double-clic pour ouvrir">
                                                <span class="voice-message-time" data-voice-time>0:00</span>
                                                <div class="voice-wave" aria-hidden="true">
                                                    <span></span><span></span><span></span><span></span><span></span>
                                                    <span></span>
                                                    <span></span><span></span><span></span><span></span><span></span>
                                                </div>
                                                <button type="button" class="voice-play-btn" data-voice-play>
                                                    <i class="bi bi-play-fill"></i>
                                                </button>
                                                <audio class="d-none" preload="metadata">
                                                    <source src="{{ attachmentUrl }}">
                                                </audio>
                                            </div>
                                        {% elseif attachmentType in ['VIDEO', 'APPEL_VIDEO'] or attachmentMime starts with 'video/' %}
                                            <video controls class="rounded chat-video-inline js-open-media" data-media-url="{{ attachmentUrl }}" data-media-kind="video" title="Double-clic pour ouvrir">
                                                <source src="{{ attachmentUrl }}">
                                            </video>
                                        {% elseif attachmentType in ['IMAGE', 'GIF'] or attachmentMime starts with 'image/' %}
                                            <img src="{{ attachmentUrl }}" alt="media" class="img-fluid rounded js-open-media" data-media-url="{{ attachmentUrl }}" data-media-kind="image" style="max-height: 220px; cursor: zoom-in;" title="Double-clic pour ouvrir">
                                        {% elseif attachmentType == 'PDF' or attachmentMime == 'application/pdf' %}
                                            <a href="{{ attachmentDownloadUrl }}" class="btn btn-sm btn-light border" download="{{ attachmentName }}" target="_blank" rel="noopener">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> {{ attachmentName }}
                                            </a>
                                        {% else %}
                                            <a href="{{ attachmentDownloadUrl }}" class="text-decoration-underline" download="{{ attachmentName }}" target="_blank" rel="noopener">{{ attachmentName }}</a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                                {% if mediaComment is not empty %}
                                    <div class="mt-2 js-linkify">{{ mediaComment }}</div>
                                {% endif %}
                            {% elseif mediaUrl %}
                                {% if isAudioFile or msgType in ['AUDIO', 'APPEL_AUDIO', 'VOCALE'] %}
                                    <div class="voice-message-card js-open-media" data-media-url="{{ mediaUrl }}" data-media-kind="audio" title="Double-clic pour ouvrir">
                                        <span class="voice-message-time" data-voice-time>0:00</span>
                                        <div class="voice-wave" aria-hidden="true">
                                            <span></span><span></span><span></span><span></span><span></span>
                                            <span></span>
                                            <span></span><span></span><span></span><span></span><span></span>
                                        </div>
                                        <button type="button" class="voice-play-btn" data-voice-play>
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                        <audio class="d-none" preload="metadata">
                                            <source src="{{ mediaUrl }}">
                                        </audio>
                                    </div>
                                {% elseif isVideoFile or msgType in ['VIDEO', 'APPEL_VIDEO'] %}
                                    <video controls class="rounded chat-video-inline js-open-media" data-media-url="{{ mediaUrl }}" data-media-kind="video" title="Double-clic pour ouvrir">
                                        <source src="{{ mediaUrl }}">
                                    </video>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-light border video-open-btn" data-video-src="{{ mediaUrl }}">
                                            <i class="bi bi-arrows-fullscreen me-1"></i> Ouvrir video
                                        </button>
                                    </div>
                                {% elseif isImageFile or msgType in ['IMAGE', 'GIF'] %}
                                    <img src="{{ mediaUrl }}" alt="media" class="img-fluid rounded js-open-media" data-media-url="{{ mediaUrl }}" data-media-kind="image" style="max-height: 220px; cursor: zoom-in;" title="Double-clic pour ouvrir">
                                {% elseif isPdfFile or msgType == 'PDF' %}
                                    <a href="{{ mediaDownloadUrl }}" class="btn btn-sm btn-light border" download="{{ mediaFileName }}" target="_blank" rel="noopener">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> {{ mediaFileName }}
                                    </a>
                                {% else %}
                                    <a href="{{ mediaDownloadUrl }}" class="text-decoration-underline" download="{{ mediaFileName }}" target="_blank" rel="noopener">{{ mediaFileName }}</a>
                                {% endif %}

                                {% if mediaComment is not empty %}
                                    <div class="mt-2 js-linkify">{{ mediaComment }}</div>
                                {% endif %}
                            {% else %}
                                <div class="js-linkify">{{ rawContent }}</div>
                            {% endif %}
                            <div class="message-reactions" data-message-id="{{ message.id_message }}" data-react-url="{{ path('app_message_react', {'id_message': message.id_message, 'id_user': mon_id}) }}">
                                {% for reactionEmoji in reactionOptions %}
                                    {% set reactionCount = (reactions[reactionEmoji]|default([]))|length %}
                                    <button type="button"
                                            class="reaction-btn {{ userReaction == reactionEmoji ? 'active' : '' }}"
                                            data-emoji="{{ reactionEmoji }}">
                                        {{ reactionEmoji }} <span class="reaction-label">J'adore</span> <span data-count>{{ reactionCount }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                            <div class="mt-2 d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <span class="time-stamp {{ is_mine ? 'text-white-50' : 'text-muted' }}">
                                    <span class="time-stamp {{ (is_mine and isTextStyled) ? 'text-white-50' : 'text-muted' }}">
                                        {{ message.date_envoi ? message.date_envoi|date('H:i') : '' }}
                                        {% if is_mine %}
                                            <span class="message-checkmarks">
                                                {% if message.date_lecture %}
                                                    <span class="checkmark read">✓✓</span>
                                                    <span class="read-time {{ is_mine ? 'text-white-50' : 'text-muted' }}">{{ message.date_lecture|date('H:i') }}</span>
                                                {% else %}
                                                    <span class="checkmark">✓✓</span>
                                                {% endif %}
                                            </span>
                                        {% endif %}
                                    </span>
                                    {% if message.date_modifier %}
                                        <div class="small {{ (is_mine and isTextStyled) ? 'text-white-50' : 'text-muted' }}" style="font-size: 0.75rem; margin-top: 2px;">
                                            <span class="badge {{ (is_mine and isTextStyled) ? 'bg-secondary' : 'bg-light text-dark' }}">Modifié</span>
                                            {{ message.date_modifier|date('H:i') }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% if is_mine or is_group_admin %}
                                <div class="message-actions-hover">
                                    {% if is_mine %}
                                        <button type="button" class="btn btn-link btn-sm p-0 text-success me-2" onclick="toggleEditForm({{ message.id_message }});">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    {% endif %}
                                    <a href="{{ path('app_delete_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation, 'id_message': message.id_message}) }}" class="btn btn-link btn-sm p-0 text-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {% if is_mine %}
                        <form id="edit-form-{{ message.id_message }}" action="{{ path('app_edit_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation, 'id_message': message.id_message}) }}" method="post" class="mb-3 d-none">
                            <div class="input-group">
                                <input type="text" name="edited_message" class="form-control" value="{{ message.contenu }}" required>
                                <button type="submit" class="btn btn-success btn-sm">Enregistrer</button>
                            </div>
                        </form>
                    {% endif %}
                {% else %}
                    <div class="my-auto text-center text-muted">
                        <i class="bi bi-chat-quote fs-1 d-block mb-2 text-success opacity-25"></i>
                        <p>Dites bonjour à Ahmed !</p>
                    </div>
                {% endfor %}
                {% else %}
                    <div class="my-auto text-center text-muted">
                        <i class="bi bi-chat-square-text fs-1 d-block mb-2 text-success opacity-25"></i>
                        <p>Selectionnez une conversation a gauche pour afficher les messages.</p>
                    </div>
                {% endif %}
            </div>

          <div class="p-3 message-footer">
    <form id="messageComposerForm" method="post" enctype="multipart/form-data" action="{{ current_conv ? path('app_send_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) : '#' }}" data-correct-url="{{ current_conv ? path('app_messagerie_correct_text', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) : '' }}" class="d-flex flex-column gap-2">
        
        {# Media preview area #}
        <div id="composerError" class="composer-error d-none"></div>
        {% for flashError in app.flashes('error') %}
            <div class="composer-error">{{ flashError }}</div>
        {% endfor %}
        <div id="vocalRecordingBar" class="d-none">
            <div class="vocal-recording-bar">
                <span id="vocalRecordingTimer" class="vocal-recording-timer">0:00</span>
                <div class="vocal-recording-wave"></div>
                <button type="button" id="vocalStopBtn" class="vocal-recording-stop" title="Stop">
                    <i class="bi bi-stop-fill"></i>
                </button>
                <button type="button" id="vocalCancelBtn" class="vocal-recording-cancel" title="Annuler">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div id="mediaPreview" class="d-none mb-2 p-2 bg-light rounded">
            <div class="preview-header">
                <small class="text-muted mb-0">Fichier selectionne</small>
                <button type="button" id="clearMediaBtn" class="btn btn-sm btn-outline-danger py-0 px-2">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="mediaPreviewContent"></div>
        </div>
        
        {# Input row: file + text + send #}
        <div class="composer-row">
            <div class="composer-input-wrap">
                <div class="composer-emoji-wrap">
                    <button type="button" class="composer-emoji-btn" id="composerEmojiBtn" title="Emoji">
                        <i class="bi bi-emoji-smile"></i>
                    </button>
                    <div id="emojiPickerPanel" class="emoji-picker-panel d-none" aria-label="Emoji list"></div>
                </div>
                <input type="text" name="message" id="textMessage" class="form-control composer-text-input text-dark" placeholder="{{ current_conv and current_conv.privateBlocked ? 'Conversation privee bloquee' : 'Type Message...' }}" autocomplete="off" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
            </div>
            
            <input type="file" id="mediaFile" name="mediaFiles[]" accept="image/*,video/*,audio/*,application/pdf,.gif" class="d-none" multiple>
            <input type="hidden" id="isRecordedVocale" name="is_recorded_vocale" value="0">
            <input type="hidden" id="vocalBlobBase64" name="vocal_blob_base64" value="">
            <input type="hidden" id="vocalBlobMime" name="vocal_blob_mime" value="">
            <input type="hidden" id="vocalBlobName" name="vocal_blob_name" value="">
            <input type="hidden" id="gifUrlInput" name="gif_url" value="">

            <button type="submit" class="composer-send-btn shadow-sm" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }} title="Envoyer">
                <i class="bi bi-send"></i>
            </button>
            <button type="button" class="media-action-btn" id="attachVocaleBtn" title="Message vocale" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
                <i class="bi bi-mic"></i>
            </button>
            <button type="button" class="media-action-btn" id="attachImageBtn" title="Joindre un fichier" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
                <i class="bi bi-paperclip"></i>
            </button>
            <button type="button" class="media-action-btn" id="correctTextBtn" title="Correction orthographique" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
                <i class="bi bi-spellcheck"></i>
            </button>
           
            <button type="button" class="media-action-btn" id="resumeBtn" title="Resumer la conversation" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
                <i class="bi bi-card-text"></i>
            </button>
      
            <button type="button" class="media-action-btn" id="gifQuickBtn" title="Chercher un GIF" {{ current_conv and not current_conv.privateBlocked ? '' : 'disabled' }}>
                <i class="bi bi-filetype-gif"></i>
            </button>
            <div id="gifPickerPanel" class="gif-picker-panel d-none">
                <div class="gif-picker-header">
                    <input type="text" id="gifSearchInput" class="gif-picker-search" placeholder="Rechercher un GIF...">
                </div>
                <div id="gifPickerGrid" class="gif-picker-grid"></div>
            </div>
        </div>
    </form>
</div>
        </div>
    </div>
</div>

<div id="mobileIncomingToast" class="position-fixed bottom-0 start-50 translate-middle-x mb-4 px-3 py-2 rounded-pill shadow d-none"
     style="z-index: 2050; background: #198754; color: #fff; font-weight: 600; max-width: 90vw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
    Nouveau message
</div>
<div id="messageNotifierStack" class="position-fixed top-0 end-0 mt-4 me-3" style="z-index: 2060; width: min(340px, 92vw);"></div>

{# --- MODAL INFO / GESTION --- #}
<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Paramètres</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {% if current_conv is defined and current_conv %}
                    {% set is_group_admin = current_conv.est_groupe and current_conv.createur is defined and current_conv.createur.id_user == mon_id %}
                    {% set private_other_user = null %}
                    {% if not current_conv.est_groupe %}
                        {% for participant in current_conv.participants %}
                            {% if participant.id_user != mon_id %}
                                {% set private_other_user = participant %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    
                    {# --- Rename group (only for groups) --- #}
                    {% if current_conv.est_groupe %}
                        {% if is_group_admin %}
                            <form action="{{ path('app_edit_group', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) }}" method="POST" class="mb-4">
                                <label class="form-label small fw-bold">Nom du groupe</label>
                                <div class="input-group">
                                    <input type="text" name="titre" class="form-control border-success" value="{{ current_conv.titre }}">
                                    <button class="btn btn-success" type="submit">Renommer</button>
                                </div>
                            </form>
                        {% endif %}
                        
                        {# --- Member list with KICK button (only for group admins) --- #}
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">MEMBRES</label>
                            <ul class="list-group list-group-flush border rounded mb-3">
                                {% for participant in current_conv.participants %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            {{ participant.nom }} {{ participant.prenom }}
                                            {% if participant.id_user == current_conv.createur.id_user %}
                                                <span class="badge bg-success ms-2">Admin</span>
                                            {% endif %}
                                        </span>
                                        {% if is_group_admin and participant.id_user != current_conv.createur.id_user %}
                                            <a href="{{ path('app_kick_member', {'id_conversation': current_conv.id_conversation, 'id_user_to_kick': participant.id_user, 'id_user': mon_id}) }}"
                                               class="btn btn-sm btn-outline-danger"
                                               data-confirm-link
                                               data-confirm-title="Retirer un membre"
                                               data-confirm-message="Retirer {{ participant.nom }} {{ participant.prenom }} du groupe ?"
                                               data-confirm-note="Cette action retire ce membre du groupe.">
                                                <i class="bi bi-person-x-fill"></i> Kick
                                            </a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                            
                            {# --- Add member button (admin only) --- #}
                            {% if is_group_admin %}
                                <button class="btn btn-outline-success btn-sm w-100" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                                    <i class="bi bi-person-plus-fill me-1"></i> Ajouter un membre
                                </button>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if not current_conv.est_groupe %}
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">MEMBRES</label>
                            <ul class="list-group list-group-flush border rounded mb-3">
                                {% for participant in current_conv.participants %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>{{ participant.nom }} {{ participant.prenom }}</span>
                                        <span class="badge bg-light text-dark">{{ participant.id_user == mon_id ? 'Vous' : 'Contact' }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        {% if private_other_user %}
                            {% set privateAvatar = private_other_user.image_url
                                ? (private_other_user.image_url starts with 'http'
                                    ? private_other_user.image_url
                                    : (private_other_user.image_url starts with '/'
                                        ? private_other_user.image_url
                                        : asset(private_other_user.image_url)))
                                : '' %}
                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-3" style="width: 52px; height: 52px;">
                                        {% if privateAvatar %}
                                            <img src="{{ privateAvatar }}" alt="avatar" class="rounded-circle w-100 h-100" style="object-fit: cover;">
                                        {% else %}
                                            <i class="bi bi-person-fill text-success fs-4"></i>
                                        {% endif %}
                                    </div>
                                    <div>
                                        <div class="fw-bold">{{ private_other_user.nom }} {{ private_other_user.prenom }}</div>
                                        <small class="text-muted">{{ private_other_user.email ?? 'Email non renseigné' }}</small>
                                    </div>
                                </div>
                                <div class="small text-muted">
                                    <div><strong>Téléphone:</strong> {{ private_other_user.telephone ?? 'Non renseigné' }}</div>
                                    <div><strong>Rôle:</strong> {{ private_other_user.role ? private_other_user.role.value : 'N/A' }}</div>
                                    <div><strong>Création du compte:</strong> {{ private_other_user.date_creation ? private_other_user.date_creation|date('d/m/Y H:i') : 'N/A' }}</div>
                                    <div><strong>Création conversation:</strong> {{ current_conv.date_creation ? current_conv.date_creation|date('d/m/Y H:i') : 'N/A' }}</div>
                                    <div><strong>Dernier contact:</strong> {{ current_conv_last_contact ? current_conv_last_contact|date('d/m/Y H:i') : 'Aucun message' }}</div>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                    
                    <hr>
                    
                    {# --- Delete conversation (only if admin or private chat) --- #}
                    <div class="d-grid shadow-sm">
                        {% if not current_conv.est_groupe or current_conv.createur.id_user == mon_id %}
                            <a href="{{ path('app_delete_conversation', {'id_conversation': current_conv.id_conversation, 'id_user': mon_id}) }}"
                               class="btn btn-danger py-2"
                               data-confirm-link
                               data-confirm-title="Supprimer la conversation"
                               data-confirm-message="Supprimer cette conversation ?"
                               data-confirm-note="Cette action est irreversible.">
                                <i class="bi bi-trash3-fill me-2"></i> Supprimer la conversation
                            </a>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="text-muted">Aucune conversation sélectionnée.</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# --- MODAL NOUVELLE DISCUSSION --- #}
<div class="modal fade" id="newListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Choisir un utilisateur</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    {% for user in tous_les_users %}
                        {% if user.id_user != mon_id %}
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
