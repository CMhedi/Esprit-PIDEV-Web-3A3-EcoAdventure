async function loadGifResults(query) {
    if (!gifPickerGrid) return;
    gifPickerGrid.innerHTML = '<div class="text-muted small p-2">Chargement...</div>';
    try {
        const response = await fetch(`/messagerie/gif/search?q=${encodeURIComponent(query || '')}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) {
            gifPickerGrid.innerHTML = '<div class="text-danger small p-2">Erreur GIF.</div>';
            return;
        }
        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items : [];
        if (!items.length) {
            gifPickerGrid.innerHTML = '<div class="text-muted small p-2">Aucun GIF.</div>';
            return;
        }
        gifPickerGrid.innerHTML = items.map(url => `
            <button type="button" class="gif-picker-item" data-gif-url="${url}">
                <img src="${url}" alt="gif">
            </button>
        `).join('');
    } catch (e) {
        gifPickerGrid.innerHTML = '<div class="text-danger small p-2">Erreur reseau.</div>';
    }
}

