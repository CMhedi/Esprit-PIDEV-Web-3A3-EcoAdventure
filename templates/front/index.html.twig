{% extends 'base.html.twig' %}

{% block title %}Messagerie - EcoAdventure{% endblock %}

{% block css %}
<style>
    .chat-container {
        height: 80vh;
        background: #f8f9fa;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }
    .conversation-list {
        background: white;
        border-right: 1px solid #eee;
    }
    .conversation-item {
        transition: all 0.2s;
        border: none;
        border-left: 4px solid transparent;
        text-decoration: none;
    }
    .conversation-item:hover {
        background-color: #f1f8f4;
        cursor: pointer;
    }
    .conversation-item.active {
        background-color: #e8f5e9;
        border-left-color: #28a745;
    }
    .chat-window {
        background: white;
    }
    .messages-area {
        background-color: #f0f2f5;
    }
    .message-bubble {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 18px;
        margin-bottom: 10px;
        position: relative;
        font-size: 0.95rem;
    }
    .message-sent {
        background-color: #28a745; 
        color: white;
        border-bottom-right-radius: 2px;
    }
    .message-received {
        background-color: white;
        color: #333;
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .time-stamp {
        font-size: 0.7rem;
        opacity: 0.8;
        display: block;
        margin-top: 4px;
    }
    .bg-eco { background-color: #28a745; }
    .btn-eco { background-color: #28a745; border: none; color: white; }
    .btn-eco:hover { background-color: #218838; color: white; }
    
    .online-dot {
        height: 10px;
        width: 10px;
        background-color: #28a745;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        border: 2px solid white;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row chat-container g-0 shadow-lg">

        {# --- COLONNE GAUCHE (CONVERSATIONS) --- #}
        <div class="col-md-4 d-flex flex-column conversation-list">
            <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-success"><i class="bi bi-chat-dots-fill me-2"></i>Conversation</h5>
                <button class="btn btn-sm btn-light rounded-circle border shadow-sm" data-bs-toggle="modal" data-bs-target="#newListModal">
                    <i class="bi bi-pencil-square text-success"></i>
                </button>
            </div>
            
            <div class="flex-grow-1 p-2" style="overflow-y:auto">
                {% for conversation in conversations %}
                    <a href="{{ path('app_messagerie', {'id_user': mon_id}) }}" class="card conversation-item mb-1 {% if loop.first %}active{% endif %}">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-eco d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 45px; height: 45px;">
                                        <i class="bi {{ conversation.est_groupe ? 'bi-people-fill' : 'bi-person-fill' }}"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3 text-dark">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-0 fw-bold text-truncate" style="max-width: 140px;">{{ conversation.titre }}</h6>
                                        <small class="text-muted">{{ conversation.date_creation|date('d/m') }}</small>
                                    </div>
                                    <small class="text-muted">{{ conversation.est_groupe ? 'Groupe' : 'Privé' }}</small>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="text-center mt-5 text-muted">
                        <i class="bi bi-chat-square-dots fs-1 opacity-25"></i>
                        <p>Aucune discussion</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# --- COLONNE DROITE (CHAT) --- #}
        <div class="col-md-8 d-flex flex-column chat-window">
            
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px;">
                        <i class="bi bi-person-badge-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <h5 class="m-0 fw-bold text-dark">
                            {{ nom_utilisateur }} {{ prenom_utilisateur }} 
                            <span class="badge bg-light text-success border ms-2" style="font-size: 0.7rem;">ID #{{ mon_id }}</span>
                        </h5>
                        <small class="text-success fw-semibold"><span class="online-dot"></span>En ligne</small>
                    </div>
                </div>
                <div class="text-muted fs-5">
                    <i class="bi bi-telephone-fill me-3" style="cursor:pointer"></i>
                    <i class="bi bi-camera-video-fill me-3" style="cursor:pointer"></i>
                    {# BOUTON POUR MODAL INFO #}
                    <i class="bi bi-info-circle-fill text-info" style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#infoModal"></i>
                </div>
            </div>

            <div class="flex-grow-1 p-4 messages-area d-flex flex-column" style="overflow-y:auto">
                {% for message in messages %}
                    {% set is_mine = (message.id_user == mon_id) %}
                    <div class="d-flex {{ is_mine ? 'justify-content-end' : 'justify-content-start' }} mb-3">
                        <div class="message-bubble {{ is_mine ? 'message-sent shadow' : 'message-received shadow-sm' }}">
                            {{ message.contenu }}
                            <span class="time-stamp {{ is_mine ? 'text-white-50 text-end' : 'text-muted' }}">
                                {{ message.date_envoi|date('H:i') }}
                            </span>
                        </div>
                    </div>
                {% else %}
                    <div class="my-auto text-center text-muted">
                        <i class="bi bi-chat-quote fs-1 d-block mb-2 text-success opacity-25"></i>
                        <p>Dites bonjour à Ahmed !</p>
                    </div>
                {% endfor %}
            </div>

            <div class="p-3 bg-white border-top">
                <form method="post" class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-light text-muted rounded-circle border-0"><i class="bi bi-plus-circle-fill fs-5"></i></button>
                    <button type="button" class="btn btn-outline-light text-muted rounded-circle border-0"><i class="bi bi-image fs-5"></i></button>
                    <div class="input-group">
                        <input type="text" name="message" class="form-control border-0 bg-light rounded-pill px-4" placeholder="Écrivez votre message..." required>
                        <button type="submit" class="btn btn-eco rounded-circle ms-2 shadow d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{# --- MODAL INFO / GESTION (POUR L'ICÔNE i) --- #}
<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Paramètres</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {% if conversations|length > 0 %}
                    {% set current_conv = conversations[0] %}
                    
                    {% if current_conv.est_groupe %}
                        {% set is_group_admin = current_conv.createur is defined and current_conv.createur.id_user == mon_id %}

                        {# SECTION GROUPE #}
                        {% if is_group_admin %}
                            <form action="{{ path('app_edit_group', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) }}" method="POST" class="mb-4">
                                <label class="form-label small fw-bold">Nom du groupe</label>
                                <div class="input-group">
                                    <input type="text" name="titre" class="form-control border-success" value="{{ current_conv.titre }}">
                                    <button class="btn btn-success" type="submit">Renommer</button>
                                </div>
                            </form>
                        {% endif %}

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">MEMBRES</label>
                            <ul class="list-group list-group-flush border rounded mb-3">
                                {% for participant in current_conv.participants %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>{{ participant.nom }} {{ participant.prenom }}{% if participant.id_user == current_conv.createur.id_user %} (Admin){% endif %}</span>
                                        {% if participant.id_user == current_conv.createur.id_user %}
                                            <span class="badge bg-success">Admin</span>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if is_group_admin %}
                                <button class="btn btn-outline-success btn-sm w-100" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                                    <i class="bi bi-person-plus-fill me-1"></i> Ajouter un membre
                                </button>
                            {% endif %}
                        </div>
                    {% endif %}

                    <hr>
                    <div class="d-grid shadow-sm">
                        {% if not current_conv.est_groupe or current_conv.createur.id_user == mon_id %}
                            <a href="{{ path('app_delete_conversation', {'id_conversation': current_conv.id_conversation, 'id_user': mon_id}) }}" 
                               class="btn btn-danger py-2" 
                               onclick="return confirm('Supprimer cette conversation ?')">
                                <i class="bi bi-trash3-fill me-2"></i> Supprimer la conversation
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# --- MODAL NOUVELLE DISCUSSION / AJOUT MEMBRE --- #}
<div class="modal fade" id="newListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Choisir un utilisateur</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    {% for user in tous_les_users %}
                        {% if user.id_user != mon_id %}
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person text-success"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">{{ user.nom }} {{ user.prenom }}</div>
                                    <small class="text-muted">ID #{{ user.id_user }}</small>
                                </div>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('app_new_conversation', {'id_createur': mon_id, 'id_destinataire': user.id_user, 'type': 'prive'}) }}" class="btn btn-outline-success">Privé</a>
                                <a href="{{ path('app_new_conversation', {'id_createur': mon_id, 'id_destinataire': user.id_user, 'type': 'groupe'}) }}" class="btn btn-success">Groupe</a>
                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Ajouter un membre au groupe</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    {% if conversations|length > 0 and current_conv is defined and current_conv.est_groupe and is_group_admin %}
                        {% for user in tous_les_users %}
                            {% if user.id_user != mon_id and user not in current_conv.participants %}
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-success"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">{{ user.nom }} {{ user.prenom }}</div>
                                            <small class="text-muted">ID #{{ user.id_user }}</small>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_add_group_member', {'id_conversation': current_conv.id_conversation, 'id_user_to_add': user.id_user, 'id_user': mon_id}) }}" class="btn btn-success btn-sm">Ajouter</a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <div class="p-4 text-center text-muted">
                            <p>Aucun groupe sélectionné ou vous n'êtes pas admin.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}