});

fileInput.addEventListener('change', function(e) {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;
    if (vocalBlobBase64Input) vocalBlobBase64Input.value = '';
    if (vocalBlobMimeInput) vocalBlobMimeInput.value = '';
    if (vocalBlobNameInput) vocalBlobNameInput.value = '';
    if (isRecordedVocaleInput) isRecordedVocaleInput.value = '0';
    if (gifUrlInput) gifUrlInput.value = '';

    if (files.length > 3) {
        showComposerError('Vous pouvez joindre au maximum 3 fichiers.');
        clearSelectedMedia();
        return;
    }

    const videoFiles = files.filter(file => file.type.startsWith('video/'));
    if (!videoFiles.length) {
        showPreviewFiles(files);
        return;
    }

    let checkedVideos = 0;
    let hasError = false;
    videoFiles.forEach((file) => {
        const video = document.createElement('video');
        video.preload = 'metadata';
        video.onloadedmetadata = function() {
            if (video.duration > 300 && !hasError) {
                hasError = true;
                showComposerError('Chaque video ne doit pas depasser 5 minutes.');
                clearSelectedMedia();
                return;
            }
            checkedVideos += 1;
            if (checkedVideos === videoFiles.length && !hasError) {
                showPreviewFiles(files);
            }
        };
        video.src = URL.createObjectURL(file);
    });
});

function renderPreviewItem(file) {
    const fileURL = URL.createObjectURL(file);
    if (file.type.startsWith('image/')) {
        return `<div class="mb-2"><img src="${fileURL}" class="img-fluid rounded" style="max-height: 150px;"><div class="small text-muted mt-1">${file.name}</div></div>`;
    } else if (file.type.startsWith('video/')) {
        return `<div class="mb-2"><video controls class="rounded" style="max-height: 150px;"><source src="${fileURL}"></video><div class="small text-muted mt-1">${file.name}</div></div>`;
    } else if (file.type.startsWith('audio/')) {
        return `<div class="mb-2"><div class="small text-success mb-1">Ecouter le fichier audio avant envoi</div><audio controls src="${fileURL}" class="w-100"></audio><div class="small text-muted mt-1">${file.name}</div></div>`;
    } else if (file.type === 'application/pdf') {
        return `<div class="mb-2"><embed src="${fileURL}" type="application/pdf" style="height: 150px; width: 100%;"><div class="small text-muted mt-1">${file.name}</div></div>`;
    }

    return `<div class="alert alert-info mb-2">Fichier: ${file.name}</div>`;
}

function showPreviewFiles(files) {
    const selectedFiles = Array.isArray(files) ? files : [files];
    let html = '';
    selectedFiles.forEach(file => {
        html += renderPreviewItem(file);
    });
    hideComposerError();
    previewContentDiv.innerHTML = html;
    previewDiv.classList.remove('d-none');
    isRecording = false;
    updateVocalButtonState(false);
    textInput.placeholder = selectedFiles.length ? 'Ajouter un commentaire (optionnel)' : 'Ecrivez votre message...';
}

function showPreview(file) {
    const fileURL = URL.createObjectURL(file);
    let html = '';
    if (file.type.startsWith('image/')) {
        html = `<img src="${fileURL}" class="img-fluid rounded" style="max-height: 150px;">`;
    } else if (file.type.startsWith('video/')) {
        html = `<video controls class="rounded" style="max-height: 150px;"><source src="${fileURL}"></video>`;
    } else if (file.type.startsWith('audio/')) {
        html = `<div class="small text-success mb-1">Ecouter la vocale avant envoi</div><audio controls src="${fileURL}" class="w-100"></audio>`;
    } else if (file.type === 'application/pdf') {
        html = `<embed src="${fileURL}" type="application/pdf" style="height: 150px; width: 100%;">`;
    } else {
        html = `<div class="alert alert-info">Fichier: ${file.name}</div>`;
    }
    hideComposerError();
    previewContentDiv.innerHTML = html + `<div class="small text-muted mt-1">${file.name}</div>`;
    previewDiv.classList.remove('d-none');
    isRecording = false;
    updateVocalButtonState(false);
    
    // Optional: disable text input if file is attached (or allow both)
    textInput.placeholder = file ? "Ajouter un commentaire (optionnel)" : "Écrivez votre message...";
}

