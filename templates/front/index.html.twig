// ✅ Compteur participants
function updateParticipantCount() {
    const checkboxes = document.querySelectorAll('.participant-checkbox:checked');
    const count = checkboxes.length;
    const countElement = document.getElementById('selected-count');
    const createBtn = document.getElementById('create-group-btn');
    const groupTypeText = document.getElementById('group-type-text');
    if (countElement) countElement.textContent = count;
    if (createBtn) {
        createBtn.disabled = count === 0;
        if (count <= 1) groupTypeText.textContent = 'la conversation';
        else if (count === 2) groupTypeText.textContent = 'la conversation privée';
        else groupTypeText.textContent = 'le groupe';
    }
}

// ✅ Filter conversations
function filterConversations() {
    const query = document.getElementById('conversationSearch').value.toLowerCase();
    const items = Array.from(document.querySelectorAll('.conversation-item'));
    const currentFilter = document.querySelector('[data-filter].active')?.getAttribute('data-filter') || 'all';
    items.forEach(item => {
        const title = item.dataset.title || '';
        const type = item.dataset.type || '';
        const matchesSearch = title.includes(query);
        const matchesFilter = currentFilter === 'all' || type === currentFilter;
        item.style.display = matchesSearch && matchesFilter ? '' : 'none';
    });
}

function handleSortClick(event) {
    const selectedSort = event.currentTarget.getAttribute('data-sort');
    document.querySelectorAll('[data-sort]').forEach(btn => btn.classList.toggle('active', btn === event.currentTarget));
    sortConversations(selectedSort);
}

function handleFilterClick(event) {
    document.querySelectorAll('[data-filter]').forEach(btn => btn.classList.toggle('active', btn === event.currentTarget));
    filterConversations();
}

function sortConversations(method) {
    const list = document.querySelector('.conversation-list .flex-grow-1');
    if (!list) return;
    const items = Array.from(list.querySelectorAll('.conversation-item'));
    const sorted = items.sort((a, b) => {
        if (method === 'date') return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        return (a.dataset.title || '').trim().localeCompare((b.dataset.title || '').trim(), 'fr', { sensitivity: 'base' });
    });
    sorted.forEach(item => list.appendChild(item));
    filterConversations();
}

document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('messagesContainer');

    // Checkboxes groupe
    document.querySelectorAll('.participant-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', updateParticipantCount);
    });

    document.getElementById('createGroupModal')?.addEventListener('hidden.bs.modal', function () {
        document.querySelectorAll('.participant-checkbox').forEach(cb => cb.checked = false);
        document.getElementById('group_name').value = '';
        updateParticipantCount();
    });

    // Search & sort conversations
    const searchInput = document.getElementById('conversationSearch');
    if (searchInput) searchInput.addEventListener('input', filterConversations);
    document.querySelectorAll('[data-sort]').forEach(btn => btn.addEventListener('click', handleSortClick));
    document.querySelectorAll('[data-filter]').forEach(btn => btn.addEventListener('click', handleFilterClick));

    if (!document.querySelector('[data-sort].active')) {
        document.querySelector('[data-sort="name"]')?.classList.add('active');
    }
    if (!document.querySelector('[data-filter].active')) {
        document.querySelector('[data-filter="all"]')?.classList.add('active');
    }

    document.querySelectorAll('.js-linkify').forEach(linkifyElementContent);
    let currentTotalUnreadCount = {{ total_unread_count|default(0) }};
    if (currentTotalUnreadCount > 0) {
        document.title = `(${currentTotalUnreadCount}) Messagerie - EcoAdventure`;
    }
    if ('Notification' in window && Notification.permission === 'default') {
        Notification.requestPermission().catch(() => {});
    }

    // Confirmation popup personnalisee (remplace confirm natif)
    const confirmModalEl = document.getElementById('actionConfirmModal');
    const confirmTitleEl = document.getElementById('actionConfirmTitle');
    const confirmMessageEl = document.getElementById('actionConfirmMessage');
    const confirmNoteEl = document.getElementById('actionConfirmNote');
    const confirmBtnEl = document.getElementById('actionConfirmBtn');
    const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;
    const videoModalEl = document.getElementById('videoPreviewModal');
    const videoModal = videoModalEl ? new bootstrap.Modal(videoModalEl) : null;
    const videoPlayer = document.getElementById('videoPreviewPlayer');
    const videoSource = document.getElementById('videoPreviewSource');
    const genericMediaModalEl = document.getElementById('genericMediaModal');
    const genericMediaModal = genericMediaModalEl ? new bootstrap.Modal(genericMediaModalEl) : null;
    const genericMediaBody = document.getElementById('genericMediaModalBody');

    document.querySelectorAll('[data-confirm-link]').forEach(link => {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            if (!confirmModal) return;

            const title = this.getAttribute('data-confirm-title') || 'Confirmation';
            const message = this.getAttribute('data-confirm-message') || 'Voulez-vous continuer ?';
            const note = this.getAttribute('data-confirm-note') || 'Verifiez bien avant de confirmer.';
            const targetHref = this.getAttribute('href') || '#';

            confirmTitleEl.textContent = title;
            confirmMessageEl.textContent = message;
            confirmNoteEl.textContent = note;
            confirmBtnEl.setAttribute('href', targetHref);

            confirmModal.show();
        });
    });

    document.querySelectorAll('[data-video-src]').forEach(btn => {
        btn.addEventListener('click', function () {
            if (!videoModal || !videoPlayer || !videoSource) return;
            const src = this.getAttribute('data-video-src');
            if (!src) return;
            videoSource.setAttribute('src', src);
            videoPlayer.load();
            videoModal.show();
        });
    });

    videoModalEl?.addEventListener('hidden.bs.modal', function () {
        if (!videoPlayer || !videoSource) return;
        videoPlayer.pause();
        videoSource.setAttribute('src', '');
        videoPlayer.load();
    });

    document.querySelectorAll('.js-open-media').forEach(el => {
        el.addEventListener('dblclick', function (event) {
            event.preventDefault();
            const src = this.getAttribute('data-media-url');
            const kind = this.getAttribute('data-media-kind');
            if (!src || !genericMediaModal || !genericMediaBody) return;

            if (kind === 'image') {
                genericMediaBody.innerHTML = `<img src="${src}" class="img-fluid rounded mx-auto d-block" style="max-height:70vh;">`;
            } else if (kind === 'video') {
                genericMediaBody.innerHTML = `<video controls autoplay class="w-100 rounded" style="max-height:70vh;"><source src="${src}"></video>`;
            } else if (kind === 'audio') {
                genericMediaBody.innerHTML = `<audio controls autoplay class="w-100"><source src="${src}"></audio>`;
            } else if (kind === 'pdf') {
                genericMediaBody.innerHTML = `<iframe src="${src}" class="w-100 rounded" style="height:70vh; border:0;"></iframe>`;
            } else {
                genericMediaBody.innerHTML = `<a class="btn btn-light" href="${src}" target="_blank">Ouvrir le fichier</a>`;
            }

            genericMediaModal.show();
        });
    });

    genericMediaModalEl?.addEventListener('hidden.bs.modal', function () {
        if (genericMediaBody) {
            genericMediaBody.innerHTML = '';
        }
    });

    document.querySelectorAll('.voice-message-card').forEach(card => {
        const audio = card.querySelector('audio');
        const playBtn = card.querySelector('[data-voice-play]');
        const timeEl = card.querySelector('[data-voice-time]');
        if (!audio || !playBtn || !timeEl) return;

        const setTime = (seconds) => {
            const safe = Number.isFinite(seconds) ? Math.floor(seconds) : 0;
            const m = Math.floor(safe / 60);
            const s = safe % 60;
            timeEl.textContent = `${m}:${String(s).padStart(2, '0')}`;
        };

        audio.addEventListener('loadedmetadata', () => setTime(audio.duration));
        audio.addEventListener('timeupdate', () => setTime(audio.currentTime));
        audio.addEventListener('ended', () => {
            playBtn.innerHTML = '<i class="bi bi-play-fill"></i>';
            setTime(audio.duration);
        });

        playBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            if (audio.paused) {
                audio.play();
                playBtn.innerHTML = '<i class="bi bi-pause-fill"></i>';
            } else {
                audio.pause();
                playBtn.innerHTML = '<i class="bi bi-play-fill"></i>';
            }
        });
    });

    document.querySelectorAll('.message-reactions').forEach(box => {
        const reactUrl = box.getAttribute('data-react-url');
        if (!reactUrl) return;

        box.querySelectorAll('.reaction-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const emoji = this.getAttribute('data-emoji');
                if (!emoji) return;
                const payload = new URLSearchParams({ emoji });

                try {
                    const response = await fetch(reactUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: payload.toString()
                    });
                    const data = await response.json();
                    if (!data.success) return;

                    box.querySelectorAll('.reaction-btn').forEach(button => {
                        const e = button.getAttribute('data-emoji');
                        const countEl = button.querySelector('[data-count]');
                        if (countEl && data.counts && Object.prototype.hasOwnProperty.call(data.counts, e)) {
                            countEl.textContent = data.counts[e];
                        }
                        button.classList.toggle('active', data.selected === e);
                    });
                } catch (error) {
                    // keep UI stable on request failure
                }
            });
        });
    });

    function updateUnreadUI(conversationId, conversationUnread, totalUnread) {
        currentTotalUnreadCount = Math.max(0, Number(totalUnread || 0));
        const activeConversation = document.querySelector(`.conversation-item[data-open-url*='/${conversationId}']`);
        if (activeConversation) {
            let badge = activeConversation.querySelector('.unread-badge');
            if (conversationUnread > 0) {
                if (!badge) {
                    badge = document.createElement('span');
                    badge.className = 'unread-badge';
                    const metaBox = activeConversation.querySelector('.d-flex.align-items-center.gap-2');
                    metaBox?.insertBefore(badge, metaBox.firstChild);
                }
                badge.textContent = String(conversationUnread);
            } else if (badge) {
                badge.remove();
            }
        }

        document.title = currentTotalUnreadCount > 0
            ? `(${currentTotalUnreadCount}) Messagerie - EcoAdventure`
            : 'Messagerie - EcoAdventure';
    }

    document.querySelectorAll('.conversation-item').forEach(item => {
        item.addEventListener('click', () => {
            const openUrl = item.getAttribute('data-open-url');
            if (openUrl) {
                window.location.href = openUrl;
            }
        });
    });

    const messagesContainer = document.getElementById('messagesContainer');
    let pollingActive = true;
    let readSyncInProgress = false;

    function isNearBottom(container) {
        if (!container) return false;
        const threshold = 48;
        return container.scrollHeight - container.scrollTop - container.clientHeight <= threshold;
    }

    async function syncConversationReadState() {
        if (!messagesContainer || readSyncInProgress || !isNearBottom(messagesContainer)) return;

        const userId = messagesContainer.getAttribute('data-my-user-id');
        const conversationId = messagesContainer.getAttribute('data-current-conversation-id');
        if (!userId || !conversationId) return;

        readSyncInProgress = true;
        try {
            const response = await fetch(`/messagerie/read/${userId}/${conversationId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) return;
            const data = await response.json();
            if (data.success) {
                updateUnreadUI(conversationId, Number(data.conversation_unread || 0), Number(data.total_unread || 0));
            }
        } catch (error) {
            // keep silent
        } finally {
            readSyncInProgress = false;
        }
    }

    async function pollIncomingMessages() {
        if (!pollingActive || !messagesContainer) return;
        const userId = messagesContainer.getAttribute('data-my-user-id');
        const conversationId = messagesContainer.getAttribute('data-current-conversation-id');
        let lastSeenId = Number(messagesContainer.getAttribute('data-last-message-id') || '0');
        if (!userId || !conversationId) return;

        try {
            const url = `/messagerie/poll/${userId}/${conversationId}?last_seen_id=${lastSeenId}`;
            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) return;
            const data = await response.json();
            const incomingCount = Number(data.incoming_count || 0);
            const latestId = Number(data.latest_id || lastSeenId);

            if (incomingCount > 0 && latestId > lastSeenId) {
                messagesContainer.setAttribute('data-last-message-id', String(latestId));
                const convTitle = messagesContainer.getAttribute('data-current-title') || 'Messagerie';
                triggerIncomingAttention(convTitle, incomingCount);
                showMessengerStyleNotification(convTitle, incomingCount);

                if ('Notification' in window && Notification.permission === 'granted') {
                    new Notification(`Nouveau message - ${convTitle}`, {
                        body: `Vous avez ${incomingCount} nouveau(x) message(s).`,
                    });
                }

                if (isNearBottom(messagesContainer)) {
                    setTimeout(() => window.location.reload(), 350);
                } else {
                    updateUnreadUI(conversationId, incomingCount, currentTotalUnreadCount + incomingCount);
                }
            } else if (latestId > lastSeenId) {
                messagesContainer.setAttribute('data-last-message-id', String(latestId));
            }
        } catch (error) {
            // keep silent; polling continues
        }
    }

    const pollInterval = setInterval(pollIncomingMessages, 4000);
    messagesContainer?.addEventListener('scroll', syncConversationReadState, { passive: true });
    window.addEventListener('beforeunload', () => {
        pollingActive = false;
        clearInterval(pollInterval);
    });

    filterConversations();
});

// ✅ Scroll quand l'utilisateur revient sur l'onglet
document.addEventListener('visibilitychange', function () {
    if (!document.hidden) {
        const messagesContainer = document.getElementById('messagesContainer');
        const userId = messagesContainer?.getAttribute('data-my-user-id');
        const conversationId = messagesContainer?.getAttribute('data-current-conversation-id');
        if (messagesContainer && userId && conversationId && (messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight <= 48)) {
            fetch(`/messagerie/read/${userId}/${conversationId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).catch(() => {});
        }
    }
});
