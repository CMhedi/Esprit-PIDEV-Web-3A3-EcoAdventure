<script>

const fileInput = document.getElementById('mediaFile');
const textInput = document.getElementById('textMessage');
const previewDiv = document.getElementById('mediaPreview');
const previewContentDiv = document.getElementById('mediaPreviewContent');
const clearMediaBtn = document.getElementById('clearMediaBtn');
const composerEmojiBtn = document.getElementById('composerEmojiBtn');
const emojiPickerPanel = document.getElementById('emojiPickerPanel');
const attachVocaleBtn = document.getElementById('attachVocaleBtn');
const correctTextBtn = document.getElementById('correctTextBtn');
const geminiAskBtn = document.getElementById('geminiAskBtn');
const resumeBtn = document.getElementById('resumeBtn');
const longMsgBtn = document.getElementById('longMsgBtn');
const gifQuickBtn = document.getElementById('gifQuickBtn');
const headerGeminiBtn = document.getElementById('headerGeminiBtn');
const gifPickerPanel = document.getElementById('gifPickerPanel');
const gifSearchInput = document.getElementById('gifSearchInput');
const gifPickerGrid = document.getElementById('gifPickerGrid');
const gifUrlInput = document.getElementById('gifUrlInput');
const vocalBlobBase64Input = document.getElementById('vocalBlobBase64');
const vocalBlobMimeInput = document.getElementById('vocalBlobMime');
const vocalBlobNameInput = document.getElementById('vocalBlobName');
const isRecordedVocaleInput = document.getElementById('isRecordedVocale');
const vocalRecordingBar = document.getElementById('vocalRecordingBar');
const vocalRecordingTimer = document.getElementById('vocalRecordingTimer');
const vocalStopBtn = document.getElementById('vocalStopBtn');
const vocalCancelBtn = document.getElementById('vocalCancelBtn');
const messageComposerForm = document.getElementById('messageComposerForm');
const isCorrectTextBtnInitiallyDisabled = !!correctTextBtn?.disabled;

let mediaRecorder = null;
let recordedChunks = [];
let recordingStream = null;
let isRecording = false;
let recordingInterval = null;
let recordingSeconds = 0;

function formatRecordingTime(totalSeconds) {
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return `${minutes}:${seconds.toString().padStart(2, '0')}`;
}

function startRecordingTimer() {
    recordingSeconds = 0;
    if (vocalRecordingTimer) {
        vocalRecordingTimer.textContent = formatRecordingTime(0);
    }
    clearInterval(recordingInterval);
    recordingInterval = setInterval(() => {
        recordingSeconds += 1;
        if (vocalRecordingTimer) {
            vocalRecordingTimer.textContent = formatRecordingTime(recordingSeconds);
        }
    }, 1000);
}

function stopRecordingTimer() {
    clearInterval(recordingInterval);
    recordingInterval = null;
}

function stopRecordingTracks() {
    if (recordingStream) {
        recordingStream.getTracks().forEach(track => track.stop());
        recordingStream = null;
    }
}

function updateVocalButtonState(recording) {
    if (!attachVocaleBtn) return;
    attachVocaleBtn.classList.toggle('recording', recording);
    attachVocaleBtn.innerHTML = recording ? '<i class="bi bi-stop-fill"></i>' : '<i class="bi bi-mic"></i>';
    attachVocaleBtn.setAttribute('title', recording ? 'Arreter enregistrement' : 'Message vocale');
    if (vocalRecordingBar) {
        vocalRecordingBar.classList.toggle('d-none', !recording);
    }
}

function clearSelectedMedia() {
    if (isRecording && mediaRecorder) {
        mediaRecorder.stop();
    }
    stopRecordingTracks();
    stopRecordingTimer();
    isRecording = false;
    updateVocalButtonState(false);
    fileInput.value = '';
    if (isRecordedVocaleInput) isRecordedVocaleInput.value = '0';
    if (vocalBlobBase64Input) vocalBlobBase64Input.value = '';
    if (vocalBlobMimeInput) vocalBlobMimeInput.value = '';
    if (vocalBlobNameInput) vocalBlobNameInput.value = '';
    if (gifUrlInput) gifUrlInput.value = '';
    if (previewContentDiv) previewContentDiv.innerHTML = '';
    previewDiv.classList.add('d-none');
    textInput.placeholder = 'Type Message...';
}

function getSelectedFiles() {
    return Array.from(fileInput?.files || []);
}

function showComposerError(message) {
    const errorBox = document.getElementById('composerError');
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.style.borderColor = '';
    errorBox.style.background = '';
    errorBox.style.color = '';
    errorBox.classList.remove('d-none');
}

function hideComposerError() {
    const errorBox = document.getElementById('composerError');
    if (!errorBox) return;
    errorBox.classList.add('d-none');
    errorBox.textContent = '';
    errorBox.style.borderColor = '';
    errorBox.style.background = '';
    errorBox.style.color = '';
}

async function correctCurrentMessage() {
    const correctUrl = messageComposerForm?.getAttribute('data-correct-url') || '';
    const currentText = (textInput?.value || '').trim();

    if (!correctUrl) {
        showComposerError('Aucune conversation selectionnee pour la correction.');
        return;
    }
    if (!currentText) {
        showComposerError('Veuillez saisir un texte a corriger.');
        textInput?.focus();
        return;
    }

    hideComposerError();
    correctTextBtn?.classList.add('correcting');
    if (correctTextBtn) correctTextBtn.disabled = true;

    try {
        const payload = new URLSearchParams({ text: currentText });
        const response = await fetch(correctUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: payload.toString()
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
            showComposerError(data.message || 'Correction impossible pour le moment.');
            return;
        }

        if (textInput) {
            textInput.value = data.corrected_text || currentText;
            textInput.focus();
        }

        if (data.changed) {
            showComposerError('Texte corrige avec succes.');
            const errorBox = document.getElementById('composerError');
            errorBox?.classList.remove('d-none');
            if (errorBox) {
                errorBox.style.borderColor = '#badbcc';
                errorBox.style.background = '#d1e7dd';
                errorBox.style.color = '#0f5132';
            }
            setTimeout(() => {
                hideComposerError();
                if (errorBox) {
                    errorBox.style.borderColor = '';
                    errorBox.style.background = '';
                    errorBox.style.color = '';
                }
            }, 2200);
            return;
        }

        showComposerError('Aucune correction necessaire.');
    } catch (error) {
        showComposerError('Erreur reseau pendant la correction.');
    } finally {
        correctTextBtn?.classList.remove('correcting');
        if (correctTextBtn) {
            correctTextBtn.disabled = isCorrectTextBtnInitiallyDisabled;
        }
    }
}

function appendEmojiToMessage(emojiValue) {
    if (!textInput) return;
    const current = textInput.value || '';
    textInput.value = current + emojiValue;
    textInput.focus();
}

function buildLargeEmojiList(limit = 500) {
    const ranges = [
        [0x1F600, 0x1F64F], // emoticons
        [0x1F300, 0x1F5FF], // symbols & pictographs
        [0x1F680, 0x1F6FF], // transport & map
        [0x1F700, 0x1F77F], // alchemical
        [0x1F780, 0x1F7FF], // geometric extended
        [0x1F800, 0x1F8FF], // arrows-c
        [0x1F900, 0x1F9FF], // supplemental symbols
        [0x1FA70, 0x1FAFF], // symbols & pictographs extended-a
        [0x2600, 0x26FF],   // misc symbols
        [0x2700, 0x27BF],   // dingbats
    ];

    const emojis = [];
    const seen = new Set();
    for (const [start, end] of ranges) {
        for (let cp = start; cp <= end && emojis.length < limit; cp++) {
            const char = String.fromCodePoint(cp);
            // Keep only likely emoji pictographs to avoid too many plain symbols
            if (!/\p{Extended_Pictographic}/u.test(char)) continue;
            if (seen.has(char)) continue;
            seen.add(char);
            emojis.push(char);
        }
        if (emojis.length >= limit) break;
    }
    return emojis;
}

function linkifyElementContent(element) {
    if (!element) return;
    const sourceText = element.textContent || '';
    const urlRegex = /((https?:\/\/|www\.)[^\s<]+)/gi;
    const fragment = document.createDocumentFragment();
    let lastIndex = 0;
    let match;

    while ((match = urlRegex.exec(sourceText)) !== null) {
        const urlText = match[0];
        const start = match.index;
        if (start > lastIndex) {
            fragment.appendChild(document.createTextNode(sourceText.slice(lastIndex, start)));
        }

        const href = urlText.startsWith('http://') || urlText.startsWith('https://')
            ? urlText
            : `https://${urlText}`;
        const anchor = document.createElement('a');
        anchor.href = href;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        anchor.className = 'text-decoration-underline';
        anchor.textContent = urlText;
        fragment.appendChild(anchor);
        lastIndex = start + urlText.length;
    }

    if (lastIndex < sourceText.length) {
        fragment.appendChild(document.createTextNode(sourceText.slice(lastIndex)));
    }

    if (sourceText.match(urlRegex)) {
        element.innerHTML = '';
        element.appendChild(fragment);
    }
}

function playIncomingNotificationSound() {
    try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc1 = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();

        osc1.type = 'triangle';
        osc2.type = 'triangle';
        osc1.frequency.setValueAtTime(660, ctx.currentTime);
        osc2.frequency.setValueAtTime(880, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.16, ctx.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.35);

        osc1.connect(gain);
        osc2.connect(gain);
        gain.connect(ctx.destination);
        osc1.start(ctx.currentTime);
        osc2.start(ctx.currentTime + 0.08);
        osc1.stop(ctx.currentTime + 0.25);
        osc2.stop(ctx.currentTime + 0.35);
    } catch (error) {
        // no-op on audio restrictions
    }
}

let lastAttentionAt = 0;
let toastTimerId = null;
let notifierId = 0;
function triggerIncomingAttention(conversationTitle, incomingCount) {
    const now = Date.now();
    if (now - lastAttentionAt < 1800) return;
    lastAttentionAt = now;

    playIncomingNotificationSound();
    setTimeout(() => playIncomingNotificationSound(), 220);

    if (typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function') {
        navigator.vibrate([120, 80, 120]);
    }

    const toast = document.getElementById('mobileIncomingToast');
    if (toast) {
        const safeTitle = conversationTitle || 'Messagerie';
        toast.textContent = `${incomingCount} nouveau(x) message(s) - ${safeTitle}`;
        toast.classList.remove('d-none');
        if (toastTimerId) clearTimeout(toastTimerId);
        toastTimerId = setTimeout(() => toast.classList.add('d-none'), 3200);
    }
}

function showMessengerStyleNotification(conversationTitle, incomingCount) {
    const stack = document.getElementById('messageNotifierStack');
    if (!stack) return;

    const safeTitle = conversationTitle || 'Messagerie';
    const cardId = `msg-notifier-${++notifierId}`;
    const card = document.createElement('div');
    card.id = cardId;
    card.className = 'shadow-lg rounded-4 p-3 mb-2';
    card.style.background = '#ffffff';
    card.style.border = '1px solid #e7ebf3';
    card.style.transform = 'translateY(-12px)';
    card.style.opacity = '0';
    card.style.transition = 'all .22s ease';
    card.innerHTML = `
        <div class="d-flex align-items-start gap-2">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;background:#198754;color:#fff;">
                <i class="bi bi-chat-left-dots-fill"></i>
            </div>
            <div class="flex-grow-1" style="min-width:0;">
                <div class="fw-bold text-dark text-truncate" style="font-size:.95rem;">${safeTitle}</div>
                <div class="text-muted text-truncate" style="font-size:.84rem;">${incomingCount} nouveau(x) message(s)</div>
            </div>
            <button type="button" class="btn btn-sm btn-light border-0 p-1" data-close="${cardId}">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    `;
    stack.appendChild(card);

    requestAnimationFrame(() => {
        card.style.transform = 'translateY(0)';
        card.style.opacity = '1';
    });

    card.addEventListener('click', (event) => {
        const closeBtn = event.target.closest('[data-close]');
        if (closeBtn) return;
        window.focus();
    });
    card.querySelector('[data-close]')?.addEventListener('click', () => card.remove());
    setTimeout(() => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(-8px)';
        setTimeout(() => card.remove(), 220);
    }, 4600);
}

function openFilePicker(acceptValue, placeholderText) {
    if (isRecordedVocaleInput) isRecordedVocaleInput.value = '0';
    fileInput.setAttribute('accept', acceptValue);
    fileInput.value = '';
    fileInput.click();
    if (placeholderText) {
        textInput.placeholder = placeholderText;
    }
}

document.getElementById('attachImageBtn')?.addEventListener('click', () => {
    openFilePicker('image/*,video/*,audio/*,application/pdf,.gif', 'Ajouter un commentaire (optionnel)');
});
attachVocaleBtn?.addEventListener('click', async () => {
    hideComposerError();

    if (!window.MediaRecorder || !navigator.mediaDevices?.getUserMedia) {
        showComposerError('Votre navigateur ne supporte pas lenregistrement vocal.');
        return;
    }

    if (isRecording && mediaRecorder) {
        isRecording = false;
        updateVocalButtonState(false);
        stopRecordingTimer();
        mediaRecorder.stop();
        return;
    }

    try {
        recordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        recordedChunks = [];
        mediaRecorder = new MediaRecorder(recordingStream);
        mediaRecorder.ondataavailable = (event) => {
            if (event.data && event.data.size > 0) {
                recordedChunks.push(event.data);
            }
        };
        mediaRecorder.onstop = () => {
            isRecording = false;
            updateVocalButtonState(false);
            stopRecordingTimer();
            const mimeType = mediaRecorder?.mimeType || 'audio/webm';
            const blob = new Blob(recordedChunks, { type: mimeType });
            if (!blob.size) {
                showComposerError('Aucun son detecte. Reessayez.');
                stopRecordingTracks();
                return;
            }

            const extension = mimeType.includes('ogg') ? 'ogg' : 'webm';
            const fileName = `vocale-${Date.now()}.${extension}`;
            const file = new File([blob], fileName, { type: mimeType });

            let attachedViaInput = false;
            try {
                if (typeof DataTransfer !== 'undefined') {
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    fileInput.files = dt.files;
                    attachedViaInput = fileInput.files && fileInput.files.length > 0;
                }
            } catch (error) {
                attachedViaInput = false;
            }

            if (!attachedViaInput) {
                const reader = new FileReader();
                reader.onload = function() {
                    const result = String(reader.result || '');
                    const base64 = result.includes(',') ? result.split(',')[1] : result;
                    if (vocalBlobBase64Input) vocalBlobBase64Input.value = base64;
                    if (vocalBlobMimeInput) vocalBlobMimeInput.value = mimeType;
                    if (vocalBlobNameInput) vocalBlobNameInput.value = fileName;
                };
                reader.readAsDataURL(blob);
            } else {
                if (vocalBlobBase64Input) vocalBlobBase64Input.value = '';
                if (vocalBlobMimeInput) vocalBlobMimeInput.value = '';
                if (vocalBlobNameInput) vocalBlobNameInput.value = '';
            }

            if (isRecordedVocaleInput) isRecordedVocaleInput.value = '1';
            showPreviewFiles(file);
            stopRecordingTracks();
        };
        mediaRecorder.start();
        isRecording = true;
        updateVocalButtonState(true);
        startRecordingTimer();
        textInput.placeholder = 'Enregistrement en cours... cliquez encore pour stopper';
    } catch (error) {
        showComposerError('Acces micro refuse. Autorisez le microphone.');
        stopRecordingTracks();
        stopRecordingTimer();
        isRecording = false;
        updateVocalButtonState(false);
    }
});
vocalStopBtn?.addEventListener('click', function () {
    if (isRecording && mediaRecorder) {
        isRecording = false;
        updateVocalButtonState(false);
        stopRecordingTimer();
        mediaRecorder.stop();
    }
});
vocalCancelBtn?.addEventListener('click', function () {
