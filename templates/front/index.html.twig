{% extends 'base.html.twig' %}

{% block title %}Messagerie - EcoAdventure{% endblock %}

{% block css %}
<style>
   .chat-container {
    height: 85vh;
    background: #f8f9fa;
    border-radius: 15px;
    overflow: hidden;
    display: flex;
}
   .conversation-list {
    background: white;
    border-right: 1px solid #eee;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.conversation-scroll-area {
    flex: 1;
    overflow-y: auto;
}
    .conversation-item {
        transition: all 0.2s;
        border: none;
        border-left: 4px solid transparent;
        text-decoration: none;
    }
    .conversation-item:hover {
        background-color: #f1f8f4;
        cursor: pointer;
    }
    .conversation-item.active {
        background-color: #e8f5e9;
        border-left-color: #28a745;
    }
    .conversation-filter-bar {
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }
    .conversation-search-input {
        border-radius: 50px;
        border: 1px solid #dee2e6;
    }
    .conversation-sort-btns {
        gap: 0.35rem;
        flex-wrap: wrap;
    }
    .conversation-sort-btns .btn.active {
        background-color: #28a745;
        color: white;
        border-color: #28a745;
    }
    .conversation-tag {
        font-size: 0.75rem;
        padding: 0.2rem 0.45rem;
        border-radius: 999px;
        background: #e9f7ef;
        color: #1b5e20;
    }
    .chat-window {
    background: white;
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
}
    .messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    scroll-behavior: smooth;
}
    .messages-area::-webkit-scrollbar {
        width: 8px;
    }
    
    .messages-area::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .messages-area::-webkit-scrollbar-thumb {
        background: #28a745;
        border-radius: 4px;
    }
    
    .messages-area::-webkit-scrollbar-thumb:hover {
        background: #218838;
    }
    .message-bubble {
        max-width: 70%;
        padding: 10px 15px;
        border-radius: 18px;
        margin-bottom: 10px;
        position: relative;
        font-size: 0.95rem;
        word-break: break-word;
    }
    .message-sent {
        background-color: #28a745;
        color: white;
        border-bottom-right-radius: 2px;
    }
    .message-received {
        background-color: white;
        color: #333;
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .time-stamp {
        font-size: 0.7rem;
        opacity: 0.8;
        display: block;
        margin-top: 4px;
    }
    .bg-eco { background-color: #28a745; }
    .btn-eco { background-color: #28a745; border: none; color: white; }
    .btn-eco:hover { background-color: #218838; color: white; }
    .online-dot {
        height: 10px;
        width: 10px;
        background-color: #28a745;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
        border: 2px solid white;
    }
    .message-item {
        transition: all 0.2s ease;
    }
    .message-item .message-actions-hover {
        position: absolute;
        top: 5px;
        right: 45px;
        opacity: 0;
        transition: opacity 0.2s ease;
        background: rgba(0, 0, 0, 0.7);
        padding: 4px 6px;
        border-radius: 4px;
        display: flex;
        gap: 4px;
    }
    .message-item:hover .message-actions-hover {
        opacity: 1;
    }
    .message-actions-hover .btn {
        padding: 2px 4px !important;
        font-size: 0.85rem;
    }
    .message-actions-hover .btn:hover {
        opacity: 0.8;
    }
    .message-footer {
        position: sticky;
        bottom: 0;
        background: white;
        z-index: 100;
        border-top: 1px solid #ddd;
        box-shadow: 0 -2px 5px rgba(0,0,0,0.05);
    }
    .composer-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }
    .composer-input-wrap {
        display: flex;
        align-items: center;
        flex: 1;
        background: #ffffff;
        border: 1px solid #e3e7ee;
        border-radius: 10px;
        overflow: hidden;
    }
    .composer-emoji-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-right: 1px solid #edf1f6;
        background: #fbf6df;
        color: #d7b24c;
    }
    .composer-text-input {
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
        padding-left: 0.85rem !important;
        padding-right: 0.85rem !important;
    }
    .media-action-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #e9f4ff;
        color: #57a7e6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .media-action-btn:hover {
        background: #d8ecff;
        color: #368ed2;
    }
    .composer-send-btn {
        width: 46px;
        height: 46px;
        border: 0;
        border-radius: 8px;
        background: #1ecf6b;
        color: #fff;
    }
    .composer-send-btn:hover {
        background: #17b95e;
        color: #fff;
    }
    .preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }
    .chat-video-inline {
        width: 100%;
        min-width: 260px;
        max-width: 520px;
        max-height: 320px;
        background: #000;
    }
    .video-open-btn {
        margin-top: 0.45rem;
    }
    .message-checkmarks {
        display: inline-flex;
        gap: 1px;
        margin-left: 6px;
        font-size: 1rem;
        vertical-align: middle;
    }
    .checkmark {
        color: rgba(255, 255, 255, 0.6);
        font-weight: bold;
    }
    .checkmark.read {
        color: #1976d2;
        font-weight: bold;
    }
    .read-time {
        font-size: 0.7rem;
        margin-left: 4px;
        opacity: 0.8;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row chat-container g-0 shadow-lg">

        {# --- COLONNE GAUCHE (CONVERSATIONS) --- #}
        <div class="col-md-4 d-flex flex-column conversation-list">
            <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-success"><i class="bi bi-chat-dots-fill me-2"></i>Conversation</h5>
                <button class="btn btn-sm btn-light rounded-circle border shadow-sm" data-bs-toggle="modal" data-bs-target="#newListModal">
                    <i class="bi bi-pencil-square text-success"></i>
                </button>
            </div>
            <div class="p-3 border-bottom bg-white">
                <div class="d-flex flex-column conversation-filter-bar">
                    <div class="input-group input-group-sm conversation-search-input">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input id="conversationSearch" type="text" class="form-control border-start-0" placeholder="Rechercher une conversation..." aria-label="Rechercher une conversation">
                    </div>
                    <div class="d-flex align-items-center conversation-sort-btns">
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="all">Tous</button>
                        <button type="button" class="btn btn-outline-success btn-sm active" data-sort="name">Nom</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-sort="date">Date</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="groupe">Groupes</button>
                        <button type="button" class="btn btn-outline-success btn-sm" data-filter="prive">Privés</button>
                    </div>
                </div>
            </div>
            <div class="flex-grow-1 p-2" style="overflow-y:auto">
                {% for conversation in conversations %}
                    <a href="{{ path('app_messagerie_selected', {'id_user': mon_id, 'id_conversation': conversation.id_conversation}) }}"
                       class="card conversation-item mb-1 {% if current_conv is defined and current_conv.id_conversation == conversation.id_conversation %}active{% elseif current_conv is not defined and loop.first %}active{% endif %}"
                       data-title="{{ conversation.titre|lower }}"
                       data-date="{{ conversation.date_creation ? conversation.date_creation|date('YmdHis') : '' }}"
                       data-type="{{ conversation.est_groupe ? 'groupe' : 'prive' }}">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-eco d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 45px; height: 45px;">
                                        <i class="bi {{ conversation.est_groupe ? 'bi-people-fill' : 'bi-person-fill' }}"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3 text-dark">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-0 fw-bold text-truncate" style="max-width: 140px;">{{ conversation.titre }}</h6>
                                        <small class="text-muted">{{ conversation.date_creation|date('d/m') }}</small>
                                    </div>
                                    <small class="text-muted">{{ conversation.est_groupe ? 'Groupe' : 'Privé' }}</small>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="text-center mt-5 text-muted">
                        <i class="bi bi-chat-square-dots fs-1 opacity-25"></i>
                        <p>Aucune discussion</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# --- COLONNE DROITE (CHAT) --- #}
        <div class="col-md-8 d-flex flex-column chat-window">

            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-white shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 45px; height: 45px;">
                        <i class="bi bi-chat-dots-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <h5 class="m-0 fw-bold text-dark">
                            {{ current_conv ? current_conv.titre : nom_utilisateur ~ ' ' ~ prenom_utilisateur }}
                            {% if current_conv %}
                                <span class="badge bg-light text-success border ms-2" style="font-size: 0.7rem;">{{ current_conv.est_groupe ? 'Groupe' : 'Privé' }}</span>
                            {% endif %}
                        </h5>
                        <small class="text-success fw-semibold"><span class="online-dot"></span>{{ current_conv ? 'Discussion active' : 'Aucune discussion sélectionnée' }}</small>
                    </div>
                </div>
                <div class="text-muted fs-5">
                    <i class="bi bi-telephone-fill me-3" style="cursor:pointer"></i>
                    <i class="bi bi-camera-video-fill me-3" style="cursor:pointer"></i>
                    <i class="bi bi-info-circle-fill text-info" style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#infoModal"></i>
                </div>
            </div>

            <div class="flex-grow-1 p-4 messages-area d-flex flex-column" id="messagesContainer" style="overflow-y:auto">
                {% if current_conv %}
                    {% set is_group_admin = current_conv.est_groupe and current_conv.createur is defined and current_conv.createur.id_user == mon_id %}
                {% endif %}
                {% for message in messages %}
                    {% set is_mine = (message.userApp is defined and message.userApp.id_user == mon_id) %}
                    <div class="d-flex {{ is_mine ? 'justify-content-end' : 'justify-content-start' }} mb-3 message-item">
                        <div class="message-bubble {{ is_mine ? 'message-sent shadow' : 'message-received shadow-sm' }}" style="position: relative;">
                            <div class="mb-2 fw-bold small text-muted">{{ message.userApp ? (message.userApp.nom ~ ' ' ~ message.userApp.prenom) : 'Utilisateur' }}</div>
                            {% set rawContent = message.contenu ?? '' %}
                            {% set contentParts = rawContent ? rawContent|split('|', 2) : [''] %}
                            {% set mediaPath = contentParts[0] ?? '' %}
                            {% set mediaComment = contentParts[1] ?? '' %}
                            {% set mediaRelative = mediaPath starts with '/uploads/' ? mediaPath|slice(9) : '' %}
                            {% set mediaUrl = mediaRelative ? path('app_media_file', {'file': mediaRelative}) : '' %}
                            {% set msgType = message.type_message and message.type_message.value is defined ? message.type_message.value : (message.type_message ?? '') %}
                            {% set mediaExt = mediaPath ? (mediaPath|split('.')|last|lower) : '' %}
                            {% set mediaParts = mediaPath ? mediaPath|split('/') : [] %}
                            {% set mediaFolder = mediaParts|length > 2 ? mediaParts[2]|lower : '' %}
                            {% set isVideoFile = mediaFolder == 'video' or mediaExt in ['mp4', 'mov', 'avi', 'mkv', 'webm'] %}
                            {% set isAudioFile = mediaFolder in ['audio', 'call'] or mediaExt in ['mp3', 'wav', 'm4a', 'ogg', 'aac'] %}
                            {% set isImageFile = mediaFolder == 'images' or mediaExt in ['jpg', 'jpeg', 'png', 'webp', 'gif'] %}
                            {% set isPdfFile = (mediaFolder == 'files' and mediaExt == 'pdf') or mediaExt == 'pdf' %}

                            {% if mediaUrl %}
                                {% if isVideoFile or msgType in ['VIDEO', 'APPEL_VIDEO'] %}
                                    <video controls class="rounded chat-video-inline">
                                        <source src="{{ mediaUrl }}">
                                    </video>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-light border video-open-btn" data-video-src="{{ mediaUrl }}">
                                            <i class="bi bi-arrows-fullscreen me-1"></i> Ouvrir video
                                        </button>
                                    </div>
                                {% elseif isAudioFile or msgType in ['AUDIO', 'APPEL_AUDIO'] %}
                                    <audio controls class="w-100">
                                        <source src="{{ mediaUrl }}">
                                    </audio>
                                {% elseif isImageFile or msgType in ['IMAGE', 'GIF'] %}
                                    <img src="{{ mediaUrl }}" alt="media" class="img-fluid rounded" style="max-height: 220px;">
                                {% elseif isPdfFile or msgType == 'PDF' %}
                                    <a href="{{ mediaUrl }}" target="_blank" class="btn btn-sm btn-light border">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> Ouvrir le PDF
                                    </a>
                                {% else %}
                                    <a href="{{ mediaUrl }}" target="_blank" class="text-decoration-underline">Ouvrir le fichier</a>
                                {% endif %}

                                {% if mediaComment is not empty %}
                                    <div class="mt-2">{{ mediaComment }}</div>
                                {% endif %}
                            {% else %}
                                {{ rawContent }}
                            {% endif %}
                            <div class="mt-2 d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <span class="time-stamp {{ is_mine ? 'text-white-50' : 'text-muted' }}">
                                        {{ message.date_envoi ? message.date_envoi|date('H:i') : '' }}
                                        {% if is_mine %}
                                            <span class="message-checkmarks">
                                                {% if message.date_lecture %}
                                                    <span class="checkmark read">✓✓</span>
                                                    <span class="read-time {{ is_mine ? 'text-white-50' : 'text-muted' }}">{{ message.date_lecture|date('H:i') }}</span>
                                                {% else %}
                                                    <span class="checkmark">✓✓</span>
                                                {% endif %}
                                            </span>
                                        {% endif %}
                                    </span>
                                    {% if message.date_modifier %}
                                        <div class="small {{ is_mine ? 'text-white-50' : 'text-muted' }}" style="font-size: 0.75rem; margin-top: 2px;">
                                            <span class="badge {{ is_mine ? 'bg-secondary' : 'bg-light text-dark' }}">Modifié</span>
                                            {{ message.date_modifier|date('H:i') }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% if is_mine or is_group_admin %}
                                <div class="message-actions-hover">
                                    {% if is_mine %}
                                        <button type="button" class="btn btn-link btn-sm p-0 text-success me-2" onclick="toggleEditForm({{ message.id_message }});">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    {% endif %}
                                    <a href="{{ path('app_delete_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation, 'id_message': message.id_message}) }}" class="btn btn-link btn-sm p-0 text-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {% if is_mine %}
                        <form id="edit-form-{{ message.id_message }}" action="{{ path('app_edit_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation, 'id_message': message.id_message}) }}" method="post" class="mb-3 d-none">
                            <div class="input-group">
                                <input type="text" name="edited_message" class="form-control" value="{{ message.contenu }}" required>
                                <button type="submit" class="btn btn-success btn-sm">Enregistrer</button>
                            </div>
                        </form>
                    {% endif %}
                {% else %}
                    <div class="my-auto text-center text-muted">
                        <i class="bi bi-chat-quote fs-1 d-block mb-2 text-success opacity-25"></i>
                        <p>Dites bonjour à Ahmed !</p>
                    </div>
                {% endfor %}
            </div>

          <div class="p-3 message-footer">
    <form method="post" enctype="multipart/form-data" action="{{ current_conv ? path('app_send_message', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) : '#' }}" class="d-flex flex-column gap-2">
        
        {# Media preview area #}
        <div id="mediaPreview" class="d-none mb-2 p-2 bg-light rounded">
            <div class="preview-header">
                <small class="text-muted mb-0">Fichier selectionne</small>
                <button type="button" id="clearMediaBtn" class="btn btn-sm btn-outline-danger py-0 px-2">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="mediaPreviewContent"></div>
        </div>
        
        {# Input row: file + text + send #}
        <div class="composer-row">
            <div class="composer-input-wrap">
                <button type="button" class="composer-emoji-btn" title="Emoji">
                    <i class="bi bi-emoji-smile"></i>
                </button>
                <input type="text" name="message" id="textMessage" class="form-control composer-text-input text-dark" placeholder="Type Message..." autocomplete="off" {{ current_conv ? '' : 'disabled' }}>
            </div>
            
            <input type="file" id="mediaFile" name="mediaFile" accept="image/*,video/*,audio/*,application/pdf,.gif" class="d-none">

            <button type="submit" class="composer-send-btn shadow-sm" {{ current_conv ? '' : 'disabled' }} title="Envoyer">
                <i class="bi bi-send"></i>
            </button>
            <button type="button" class="media-action-btn" id="attachVocaleBtn" title="Message vocale">
                <i class="bi bi-mic"></i>
            </button>
            <button type="button" class="media-action-btn" id="attachImageBtn" title="Joindre un fichier">
                <i class="bi bi-paperclip"></i>
            </button>
        </div>
    </form>
</div>
        </div>
    </div>
</div>

{# --- MODAL INFO / GESTION --- #}
<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Paramètres</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {% if conversations|length > 0 %}
                    {% set current_conv = conversations[0] %}
                    {% set is_group_admin = current_conv.est_groupe and current_conv.createur is defined and current_conv.createur.id_user == mon_id %}
                    
                    {# --- Rename group (only for groups) --- #}
                    {% if current_conv.est_groupe %}
                        {% if is_group_admin %}
                            <form action="{{ path('app_edit_group', {'id_user': mon_id, 'id_conversation': current_conv.id_conversation}) }}" method="POST" class="mb-4">
                                <label class="form-label small fw-bold">Nom du groupe</label>
                                <div class="input-group">
                                    <input type="text" name="titre" class="form-control border-success" value="{{ current_conv.titre }}">
                                    <button class="btn btn-success" type="submit">Renommer</button>
                                </div>
                            </form>
                        {% endif %}
                        
                        {# --- Member list with KICK button (only for group admins) --- #}
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">MEMBRES</label>
                            <ul class="list-group list-group-flush border rounded mb-3">
                                {% for participant in current_conv.participants %}
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            {{ participant.nom }} {{ participant.prenom }}
                                            {% if participant.id_user == current_conv.createur.id_user %}
                                                <span class="badge bg-success ms-2">Admin</span>
                                            {% endif %}
                                        </span>
                                        {% if is_group_admin and participant.id_user != current_conv.createur.id_user %}
                                            <a href="{{ path('app_kick_member', {'id_conversation': current_conv.id_conversation, 'id_user_to_kick': participant.id_user, 'id_user': mon_id}) }}"
                                               class="btn btn-sm btn-outline-danger"
                                               data-confirm-link
                                               data-confirm-title="Retirer un membre"
                                               data-confirm-message="Retirer {{ participant.nom }} {{ participant.prenom }} du groupe ?"
                                               data-confirm-note="Cette action retire ce membre du groupe.">
                                                <i class="bi bi-person-x-fill"></i> Kick
                                            </a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                            
                            {# --- Add member button (admin only) --- #}
                            {% if is_group_admin %}
                                <button class="btn btn-outline-success btn-sm w-100" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                                    <i class="bi bi-person-plus-fill me-1"></i> Ajouter un membre
                                </button>
                            {% endif %}
                        </div>
                    {% endif %}
                    
                    <hr>
                    
                    {# --- Delete conversation (only if admin or private chat) --- #}
                    <div class="d-grid shadow-sm">
                        {% if not current_conv.est_groupe or current_conv.createur.id_user == mon_id %}
                            <a href="{{ path('app_delete_conversation', {'id_conversation': current_conv.id_conversation, 'id_user': mon_id}) }}"
                               class="btn btn-danger py-2"
                               data-confirm-link
                               data-confirm-title="Supprimer la conversation"
                               data-confirm-message="Supprimer cette conversation ?"
                               data-confirm-note="Cette action est irreversible.">
                                <i class="bi bi-trash3-fill me-2"></i> Supprimer la conversation
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# --- MODAL NOUVELLE DISCUSSION --- #}
<div class="modal fade" id="newListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Choisir un utilisateur</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    {% for user in tous_les_users %}
                        {% if user.id_user != mon_id %}
                        <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person text-success"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">{{ user.nom }} {{ user.prenom }}</div>
                                    <small class="text-muted">ID #{{ user.id_user }}</small>
                                </div>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('app_new_conversation', {'id_createur': mon_id, 'id_destinataire': user.id_user, 'type': 'prive'}) }}" class="btn btn-outline-success">Privé</a>
                                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createGroupModal" onclick="selectUserForGroup({{ user.id_user }}, '{{ user.nom }} {{ user.prenom }}')">Groupe</button>
                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

{# --- MODAL AJOUT MEMBRE --- #}
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">Ajouter un membre au groupe</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    {% if conversations|length > 0 and current_conv is defined and current_conv.est_groupe and is_group_admin %}
                        {% for user in tous_les_users %}
                            {% if user.id_user != mon_id and user not in current_conv.participants %}
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-success"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">{{ user.nom }} {{ user.prenom }}</div>
                                            <small class="text-muted">ID #{{ user.id_user }}</small>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_add_group_member', {'id_conversation': current_conv.id_conversation, 'id_user_to_add': user.id_user, 'id_user': mon_id}) }}" class="btn btn-success btn-sm">Ajouter</a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <div class="p-4 text-center text-muted">
                            <p>Aucun groupe sélectionné ou vous n'êtes pas admin.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# --- MODAL CONFIRMATION PERSONNALISE --- #}
<div class="modal fade" id="actionConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h6 class="modal-title" id="actionConfirmTitle">Confirmation</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="actionConfirmMessage">Voulez-vous continuer ?</p>
            </div>
            <div class="modal-footer d-block border-0 pt-0">
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <a href="#" id="actionConfirmBtn" class="btn btn-danger">Confirmer</a>
                </div>
                <small class="text-muted d-block mt-2" id="actionConfirmNote">Verifiez bien avant de confirmer.</small>
            </div>
        </div>
    </div>
</div>

{# --- MODAL VIDEO (TAILLE MOYENNE) --- #}
<div class="modal fade" id="videoPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h6 class="modal-title">Lecture video</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2 bg-black">
                <video id="videoPreviewPlayer" controls class="w-100 rounded" style="max-height: 65vh;">
                    <source id="videoPreviewSource" src="">
                </video>
            </div>
        </div>
    </div>
</div>

{# --- MODAL CREATION GROUPE --- #}
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h6 class="modal-title">
                    <i class="bi bi-people-fill me-2"></i>
                    Créer un nouveau groupe
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="{{ path('app_create_group', {'id_createur': mon_id}) }}" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="group_name" class="form-label fw-bold">Nom du groupe (optionnel)</label>
                        <input type="text" class="form-control" id="group_name" name="group_name" placeholder="Laissez vide pour un nom automatique">
                        <small class="text-muted">Si vide, le nom sera généré automatiquement avec les noms des participants</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sélectionner les membres</label>
                        <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                            {% for user in tous_les_users %}
                                {% if user.id_user != mon_id %}
                                <div class="form-check d-flex align-items-center mb-2">
                                    <input class="form-check-input me-3 participant-checkbox" type="checkbox"
                                           value="{{ user.id_user }}" id="user_{{ user.id_user }}" name="participants[]">
                                    <label class="form-check-label d-flex align-items-center flex-grow-1" for="user_{{ user.id_user }}">
                                        <div class="rounded-circle bg-light border me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                            <i class="bi bi-person text-success"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">{{ user.nom }} {{ user.prenom }}</div>
                                            <small class="text-muted">ID #{{ user.id_user }}</small>
                                        </div>
                                    </label>
                                </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Avec 2 personnes sélectionnées, ce sera une conversation privée. Avec 3+ personnes, ce sera un groupe.
                        </small>
                    </div>
                    <div class="selected-count text-muted">
                        <small><span id="selected-count">0</span> membre(s) sélectionné(s)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success" id="create-group-btn" disabled>
                        <i class="bi bi-check-circle me-1"></i>
                        Créer <span id="group-type-text">le groupe</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

const fileInput = document.getElementById('mediaFile');
const textInput = document.getElementById('textMessage');
const previewDiv = document.getElementById('mediaPreview');
const previewContentDiv = document.getElementById('mediaPreviewContent');
const clearMediaBtn = document.getElementById('clearMediaBtn');

function clearSelectedMedia() {
    fileInput.value = '';
    if (previewContentDiv) previewContentDiv.innerHTML = '';
    previewDiv.classList.add('d-none');
    textInput.placeholder = 'Type Message...';
}

function openFilePicker(acceptValue, placeholderText) {
    fileInput.setAttribute('accept', acceptValue);
    fileInput.value = '';
    fileInput.click();
    if (placeholderText) {
        textInput.placeholder = placeholderText;
    }
}

document.getElementById('attachImageBtn')?.addEventListener('click', () => {
    openFilePicker('image/*,video/*,audio/*,application/pdf,.gif', 'Ajouter un commentaire (optionnel)');
});
document.getElementById('attachVocaleBtn')?.addEventListener('click', () => {
    openFilePicker('audio/*', 'Ajouter un message vocale (optionnel)');
});

fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;
    
    // Validation: video max 5 min
    if (file.type.startsWith('video/')) {
        const video = document.createElement('video');
        video.preload = 'metadata';
        video.onloadedmetadata = function() {
            if (video.duration > 300) { // 5 min = 300 sec
                alert('La vidéo ne doit pas dépasser 5 minutes.');
                clearSelectedMedia();
                return;
            }
            showPreview(file);
        };
        video.src = URL.createObjectURL(file);
    } else {
        showPreview(file);
    }
});

function showPreview(file) {
    const fileURL = URL.createObjectURL(file);
    let html = '';
    if (file.type.startsWith('image/')) {
        html = `<img src="${fileURL}" class="img-fluid rounded" style="max-height: 150px;">`;
    } else if (file.type.startsWith('video/')) {
        html = `<video controls class="rounded" style="max-height: 150px;"><source src="${fileURL}"></video>`;
    } else if (file.type.startsWith('audio/')) {
        html = `<audio controls src="${fileURL}"></audio>`;
    } else if (file.type === 'application/pdf') {
        html = `<embed src="${fileURL}" type="application/pdf" style="height: 150px; width: 100%;">`;
    } else {
        html = `<div class="alert alert-info">Fichier: ${file.name}</div>`;
    }
    previewContentDiv.innerHTML = html + `<div class="small text-muted mt-1">${file.name}</div>`;
    previewDiv.classList.remove('d-none');
    
    // Optional: disable text input if file is attached (or allow both)
    textInput.placeholder = file ? "Ajouter un commentaire (optionnel)" : "Écrivez votre message...";
}

clearMediaBtn?.addEventListener('click', clearSelectedMedia);

// On form submit, ensure we send the file
document.querySelector('form').addEventListener('submit', function(e) {
    if (!fileInput.files.length && !textInput.value.trim()) {
        e.preventDefault();
        alert("Veuillez écrire un message ou joindre un fichier.");
    }
});
// ✅ Global: scroll vers le bas du container messages
function scrollToBottom() {
    const container = document.getElementById('messagesContainer');
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
}

// ✅ Scroll avec délai pour s'assurer que le DOM est rendu
function delayedScrollToBottom() {
    setTimeout(() => {
        scrollToBottom();
    }, 100);
}

// ✅ Toggle edit form
function toggleEditForm(id) {
    const form = document.getElementById('edit-form-' + id);
    if (form) form.classList.toggle('d-none');
}

// ✅ Sélectionner un user pour le groupe
function selectUserForGroup(userId, userName) {
    document.querySelectorAll('.participant-checkbox').forEach(cb => cb.checked = false);
    const checkbox = document.getElementById('user_' + userId);
    if (checkbox) checkbox.checked = true;
    updateParticipantCount();
}

// ✅ Compteur participants
function updateParticipantCount() {
    const checkboxes = document.querySelectorAll('.participant-checkbox:checked');
    const count = checkboxes.length;
    const countElement = document.getElementById('selected-count');
    const createBtn = document.getElementById('create-group-btn');
    const groupTypeText = document.getElementById('group-type-text');
    if (countElement) countElement.textContent = count;
    if (createBtn) {
        createBtn.disabled = count === 0;
        if (count <= 1) groupTypeText.textContent = 'la conversation';
        else if (count === 2) groupTypeText.textContent = 'la conversation privée';
        else groupTypeText.textContent = 'le groupe';
    }
}

// ✅ Filter conversations
function filterConversations() {
    const query = document.getElementById('conversationSearch').value.toLowerCase();
    const items = Array.from(document.querySelectorAll('.conversation-item'));
    const currentFilter = document.querySelector('[data-filter].active')?.getAttribute('data-filter') || 'all';
    items.forEach(item => {
        const title = item.dataset.title || '';
        const type = item.dataset.type || '';
        const matchesSearch = title.includes(query);
        const matchesFilter = currentFilter === 'all' || type === currentFilter;
        item.style.display = matchesSearch && matchesFilter ? '' : 'none';
    });
}

function handleSortClick(event) {
    const selectedSort = event.currentTarget.getAttribute('data-sort');
    document.querySelectorAll('[data-sort]').forEach(btn => btn.classList.toggle('active', btn === event.currentTarget));
    sortConversations(selectedSort);
}

function handleFilterClick(event) {
    document.querySelectorAll('[data-filter]').forEach(btn => btn.classList.toggle('active', btn === event.currentTarget));
    filterConversations();
}

function sortConversations(method) {
    const list = document.querySelector('.conversation-list .flex-grow-1');
    if (!list) return;
    const items = Array.from(list.querySelectorAll('.conversation-item'));
    const sorted = items.sort((a, b) => {
        if (method === 'date') return (b.dataset.date || '').localeCompare(a.dataset.date || '');
        return (a.dataset.title || '').trim().localeCompare((b.dataset.title || '').trim(), 'fr', { sensitivity: 'base' });
    });
    sorted.forEach(item => list.appendChild(item));
    filterConversations();
}

document.addEventListener('DOMContentLoaded', function () {

    // ✅ Scroll initial vers le dernier message
    scrollToBottom();

    // ✅ MutationObserver: scroll automatique si nouveau message ajouté au DOM
    const container = document.getElementById('messagesContainer');
    if (container) {
        const observer = new MutationObserver(() => {
            scrollToBottom();
        });
        observer.observe(container, { childList: true, subtree: true });
    }

    // Checkboxes groupe
    document.querySelectorAll('.participant-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', updateParticipantCount);
    });

    document.getElementById('createGroupModal')?.addEventListener('hidden.bs.modal', function () {
        document.querySelectorAll('.participant-checkbox').forEach(cb => cb.checked = false);
        document.getElementById('group_name').value = '';
        updateParticipantCount();
    });

    // Search & sort conversations
    const searchInput = document.getElementById('conversationSearch');
    if (searchInput) searchInput.addEventListener('input', filterConversations);
    document.querySelectorAll('[data-sort]').forEach(btn => btn.addEventListener('click', handleSortClick));
    document.querySelectorAll('[data-filter]').forEach(btn => btn.addEventListener('click', handleFilterClick));

    if (!document.querySelector('[data-sort].active')) {
        document.querySelector('[data-sort="name"]')?.classList.add('active');
    }
    if (!document.querySelector('[data-filter].active')) {
        document.querySelector('[data-filter="all"]')?.classList.add('active');
    }

    // Confirmation popup personnalisee (remplace confirm natif)
    const confirmModalEl = document.getElementById('actionConfirmModal');
    const confirmTitleEl = document.getElementById('actionConfirmTitle');
    const confirmMessageEl = document.getElementById('actionConfirmMessage');
    const confirmNoteEl = document.getElementById('actionConfirmNote');
    const confirmBtnEl = document.getElementById('actionConfirmBtn');
    const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;
    const videoModalEl = document.getElementById('videoPreviewModal');
    const videoModal = videoModalEl ? new bootstrap.Modal(videoModalEl) : null;
    const videoPlayer = document.getElementById('videoPreviewPlayer');
    const videoSource = document.getElementById('videoPreviewSource');

    document.querySelectorAll('[data-confirm-link]').forEach(link => {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            if (!confirmModal) return;

            const title = this.getAttribute('data-confirm-title') || 'Confirmation';
            const message = this.getAttribute('data-confirm-message') || 'Voulez-vous continuer ?';
            const note = this.getAttribute('data-confirm-note') || 'Verifiez bien avant de confirmer.';
            const targetHref = this.getAttribute('href') || '#';

            confirmTitleEl.textContent = title;
            confirmMessageEl.textContent = message;
            confirmNoteEl.textContent = note;
            confirmBtnEl.setAttribute('href', targetHref);

            confirmModal.show();
        });
    });

    document.querySelectorAll('[data-video-src]').forEach(btn => {
        btn.addEventListener('click', function () {
            if (!videoModal || !videoPlayer || !videoSource) return;
            const src = this.getAttribute('data-video-src');
            if (!src) return;
            videoSource.setAttribute('src', src);
            videoPlayer.load();
            videoModal.show();
        });
    });

    videoModalEl?.addEventListener('hidden.bs.modal', function () {
        if (!videoPlayer || !videoSource) return;
        videoPlayer.pause();
        videoSource.setAttribute('src', '');
        videoPlayer.load();
    });

    filterConversations();
});

// ✅ Scroll quand l'utilisateur revient sur l'onglet
document.addEventListener('visibilitychange', function () {
    if (!document.hidden) scrollToBottom();
});
</script>
{% endblock %}