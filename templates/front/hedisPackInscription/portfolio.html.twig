{% extends 'base.html.twig' %}

{% block title %}EcoAdventure - Portfolio Packs{% endblock %}

{% block css %}
    <link rel="stylesheet" href="{{ asset('assets/css/portfolio.css') }}">
    <style>
        header,
        nav,
        .navbar,
        .main-header,
        .site-header,
        .topbar {
            display: none !important;
        }

        body {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
    </style>
{% endblock %}

{% block body %}

<section class="portfolio-hero">
    <div class="container portfolio-container">
        <div class="hero-content reveal">
            <span class="hero-badge">EcoAdventure Premium Packs</span>
            <h1>Découvrez des packs conçus pour offrir une expérience plus forte, plus fluide et plus premium</h1>
            <p>
                Cette page portfolio présente les packs à travers une section visuelle animée,
                puis plusieurs blocs détaillés avec image et description afin de montrer leur valeur,
                leur utilité et leur impact sur l’expérience utilisateur.
            </p>
            <div class="hero-actions">
                <a href="#auto-gallery" class="btn btn-gradient">Voir les visuels</a>
                <a href="#pack-details" class="btn btn-glass">Découvrir les packs</a>
            </div>
        </div>
    </div>
</section>

<section id="auto-gallery" class="auto-scroll-section">
    <div class="container portfolio-container">
        <div class="section-header reveal">
            <span class="mini-title">Visual Showcase</span>
            <h2>Un aperçu animé des packs premium</h2>
            <p>
                Découvrez 4 grands visuels de packs avec un défilement automatique
                fluide et professionnel.
            </p>
        </div>
    </div>

    <div class="big-slider">
        <div class="big-slider-track">
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack1.png') }}" alt="Pack 1">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack2.png') }}" alt="Pack 2">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack3.png') }}" alt="Pack 3">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack4.png') }}" alt="Pack 4">
            </div>

            <div class="big-slide">
                <img src="{{ asset('assets/img/pack1.png') }}" alt="Pack 1">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack2.png') }}" alt="Pack 2">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack3.png') }}" alt="Pack 3">
            </div>
            <div class="big-slide">
                <img src="{{ asset('assets/img/pack4.png') }}" alt="Pack 4">
            </div>
        </div>
    </div>
</section>

<section id="pack-details" class="pack-details-section">
    <div class="container portfolio-container">
        <div class="section-header reveal">
            <span class="mini-title">Pack Details</span>
            <h2>Des blocs image + description pour expliquer la valeur de chaque pack</h2>
            <p>
                Chaque bloc ci-dessous présente un visuel de pack accompagné d’une description claire,
                afin d’aider le visiteur à comprendre immédiatement les avantages et la logique du produit.
            </p>
        </div>

        <div class="details-list">

            <div class="detail-block reveal">
                <div class="detail-image tilt-card">
                    <img src="{{ asset('assets/img/pack1.png') }}" alt="Ultimate Pro Pack">
                </div>
                <div class="detail-content">
                    <span class="detail-tag">Pack Premium</span>
                    <h3>Ultimate Pro Pack</h3>
                    <p>
                        Ce pack représente une formule haut de gamme destinée aux utilisateurs
                        qui recherchent plus d’avantages, plus de confort et un accès renforcé
                        aux services proposés par la plateforme.
                    </p>
                    <ul>
                        <li>Positionnement haut de gamme</li>
                        <li>Image premium et professionnelle</li>
                        <li>Parfait pour les membres à forte valeur</li>
                    </ul>
                    <a href="{{ path('app_packs')}}" class="btn btn-gradient">Voir le pack actuel</a>
                </div>
            </div>

            <div class="detail-block reverse reveal">
                <div class="detail-image tilt-card">
                    <img src="{{ asset('assets/img/pack2.png') }}" alt="VIP Access Pack">
                </div>
                <div class="detail-content">
                    <span class="detail-tag">Pack VIP</span>
                    <h3>Performance & VIP Access</h3>
                    <p>
                        Ce visuel transmet une sensation d’énergie, de priorité et de performance.
                        Il convient parfaitement à une offre centrée sur l’accès rapide, les privilèges
                        spéciaux et les bénéfices liés aux événements.
                    </p>
                    <ul>
                        <li>Accès prioritaire et différenciation claire</li>
                        <li>Valorisation de l’expérience VIP</li>
                        <li>Idéal pour renforcer le sentiment d’exclusivité</li>
                    </ul>
                    <a href="{{ path('app_packs')}}" class="btn btn-gradient">Voir le pack actuel</a>
                </div>
            </div>

            <div class="detail-block reveal">
                <div class="detail-image tilt-card">
                    <img src="{{ asset('assets/img/pack3.png') }}" alt="Smart Value Pack">
                </div>
                <div class="detail-content">
                    <span class="detail-tag">Pack Value</span>
                    <h3>Smart Value Membership</h3>
                    <p>
                        Ce pack met en avant une formule élégante et bien équilibrée entre accessibilité,
                        modernité et clarté. Il est idéal pour convaincre les utilisateurs qui veulent
                        une offre lisible avec une forte valeur perçue.
                    </p>
                    <ul>
                        <li>Très bonne lisibilité visuelle</li>
                        <li>Parfait pour une communication moderne</li>
                        <li>Design rassurant et attractif</li>
                    </ul>
                    <a href="{{ path('app_packs')}}" class="btn btn-gradient">Voir le pack actuel</a>
                </div>
            </div>

            <div class="detail-block reverse reveal">
                <div class="detail-image tilt-card">
                    <img src="{{ asset('assets/img/pack4.png') }}" alt="Explorer Membership">
                </div>
                <div class="detail-content">
                    <span class="detail-tag">Pack Explorer</span>
                    <h3>Explorer Membership</h3>
                    <p>
                        Cette formule convient à une présentation plus sobre, plus stable et plus
                        équilibrée. Elle permet de rassurer l’utilisateur tout en conservant
                        une apparence premium.
                    </p>
                    <ul>
                        <li>Approche visuelle propre et sérieuse</li>
                        <li>Bonne adaptation aux offres longue durée</li>
                        <li>Excellent support pour fidéliser les membres</li>
                    </ul>
                    <a href="{{ path('app_packs')}}" class="btn btn-gradient">Voir le pack actuel</a>
                </div>
            </div>

        </div>
    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/portfolio.js') }}"></script>
{% endblock %}