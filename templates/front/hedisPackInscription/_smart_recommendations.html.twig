{% if topRecommendations is not empty %}
    <div class="mt-4">
        <div class="row g-3">
            {% for recommendation in topRecommendations %}
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="small text-uppercase text-muted mb-1">Selection intelligente</div>
                                    <h3 class="h5 mb-2">{{ recommendation.pack.nom }}</h3>
                                </div>
                                <span class="badge rounded-pill text-bg-dark">
                                    {{ recommendation.recommendationScore > 0 ? recommendation.recommendationScore|number_format(1, '.', ' ') : recommendation.score|number_format(1, '.', ' ') }}/100
                                </span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                {% for badge in recommendation.badges %}
                                    <span class="badge rounded-pill text-bg-light border">{{ badge }}</span>
                                {% endfor %}
                            </div>

                            <p class="text-muted small mb-3">
                                {{ recommendation.reasons|join(', ')|capitalize }}.
                            </p>

                            <div class="small text-muted mb-3">
                                Prix final <strong class="text-dark">{{ recommendation.pack.prixFinal|number_format(2, '.', ' ') }} DT</strong>
                            </div>

                            <a href="{{ path('app_pack_inscription', {'id': recommendation.pack.idPack}) }}" class="btn btn-sm btn-dark rounded-pill">
                                Voir la recommandation
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
