{% extends 'base.html.twig' %}

{% block title %}Ajouter une Activite{% endblock %}

{% block body %}
{% set fieldErrors = fieldErrors|default({}) %}
{% set formData = formData|default({}) %}
{% set packs = packs|default([]) %}
{% set selectedPack = selectedPack|default(null) %}
{% set selectedPackId = formData.id_pack|default('') %}

<div class="container my-5">
    <h2 class="mb-4">Ajouter une Nouvelle Activite</h2>

    <style>
        .btn-eco {
            background: linear-gradient(135deg, #28a745, #218838);
            color: #fff;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-eco:hover {
            background: linear-gradient(135deg, #218838, #28a745);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .error-label {
            color: #dc3545;
            display: block;
            font-size: 0.9rem;
            margin-top: 0.35rem;
        }

        .pack-selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
        }

        .pack-choice-label {
            display: block;
            cursor: pointer;
        }

        .pack-choice-input {
            position: absolute;
            opacity: 0;
        }

        .pack-choice-card {
            border: 1px solid #dbe7dd;
            border-radius: 1rem;
            padding: 1rem;
            background: #fff;
        }
    </style>

    <form action="{{ path('app_activite_create') }}" method="POST" enctype="multipart/form-data" novalidate>

        {# MAP #}
        <div class="mb-4">
            <label class="form-label">Choisir un emplacement</label>
            <div id="map" style="height: 400px; border-radius: 12px;"></div>
            <input type="hidden" name="latitude" id="latitude">
            <input type="hidden" name="longitude" id="longitude">
            <small class="text-muted">Clique sur la carte pour choisir la position</small>
        </div>

        {# NOM #}
        <div class="mb-3">
            <label for="nom" class="form-label">Nom</label>
            <input type="text" class="form-control" id="nom" name="nom"
                   placeholder="Entrer le nom de l'activité"
                   value="{{ formData.nom|default('') }}">
            {% for message in fieldErrors.nom|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# TYPE #}
        <div class="mb-3">
            <label class="form-label">Type d'activité</label>
            <select class="form-select" id="type_activite" name="type_activite">
                <option value="">Choisir le type</option>
                <option value="SPORT" {{ formData.type_activite|default('') == 'SPORT' ? 'selected' : '' }}>SPORT</option>
                <option value="CAMPING" {{ formData.type_activite|default('') == 'CAMPING' ? 'selected' : '' }}>CAMPING</option>
                <option value="INTELECTUEL" {{ formData.type_activite|default('') == 'INTELECTUEL' ? 'selected' : '' }}>INTELECTUEL</option>
                <option value="CULTUREL" {{ formData.type_activite|default('') == 'CULTUREL' ? 'selected' : '' }}>CULTUREL</option>
            </select>
            {% for message in fieldErrors.type_activite|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# CATEGORIE #}
        <div class="mb-3">
            <label class="form-label">Categorie</label>
            <select class="form-select" id="categorie_act" name="categorie_act">
                <option value="">Choisir la categorie</option>
                <option value="FITNESS">FITNESS</option>
                <option value="RUNNING">RUNNING</option>
                <option value="FOOTBALL">FOOTBALL</option>
                <option value="BASKETBALL">BASKETBALL</option>
                <option value="TENNIS">TENNIS</option>
                <option value="NATATION">NATATION</option>
                <option value="RANDONNEE">RANDONNEE</option>
                <option value="CYCLISME">CYCLISME</option>
                <option value="YOGA">YOGA</option>
                <option value="AUTRE">AUTRE</option>
            </select>
            {% for message in fieldErrors.categorie_act|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# NIVEAU #}
        <div class="mb-3">
            <label class="form-label">Niveau</label>
            <select class="form-select" id="niveau_act" name="niveau_act">
                <option value="">Choisir le niveau</option>
                <option value="DEBUTANT">Debutant</option>
                <option value="INTERMEDIAIRE">Intermediaire</option>
                <option value="AVANCE">Avance</option>
            </select>
            {% for message in fieldErrors.niveau_act|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# PRIX (corrigé comme demandé) #}
        <div class="mb-3">
            <label for="prix" class="form-label">Prix</label>
            <input type="text" class="form-control" id="prix" name="prix"
                   placeholder="Donner un prix"
                   value="{{ formData.prix|default('') }}">
            {% for message in fieldErrors.prix|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# STATUT #}
        <div class="mb-3">
            <label class="form-label">Statut</label>
            <select class="form-select" id="statut" name="statut">
                <option value="">Choisir le statut</option>
                <option value="DISPONIBLE">Disponible</option>
                <option value="INDISPONIBLE">Indisponible</option>
            </select>
            {% for message in fieldErrors.statut|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# IMAGE #}
        <div class="mb-3">
            <label class="form-label">Image</label>
            <input type="file" class="form-control" id="image_url" name="image_url">
            {% for message in fieldErrors.image_url|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        {# PACK #}
        <div class="mb-4">
            {% if packs is empty %}
                <div class="alert alert-warning">Aucun pack disponible</div>
            {% else %}
                <div class="pack-selection-grid">
                    {% for pack in packs %}
                        <label class="pack-choice-label">
                            <input type="radio" name="id_pack" value="{{ pack.idPack }}">
                            <div class="pack-choice-card">
                                {{ pack.nom }}
                            </div>
                        </label>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-eco btn-lg rounded-pill px-5">
            Ajouter l'activite
        </button>
    </form>
    <div class="d-flex gap-2 mb-4">

    <a href="{{ path('app_activities_discover') }}"
       class="btn btn-dark">
        🌍 Discover
    </a>

    <a href="{{ path('app_activities_trending') }}"
       class="btn btn-outline-success">
        🔥 Trending
    </a>

    <a href="{{ path('app_activities_insight') }}"
       class="btn btn-outline-primary">
        🧠 AI Insight
    </a>

</div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
const map = L.map('map').setView([36.8065, 10.1815], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

let marker;

map.on('click', function (e) {
    document.getElementById('latitude').value = e.latlng.lat;
    document.getElementById('longitude').value = e.latlng.lng;

    if (marker) map.removeLayer(marker);
    marker = L.marker([e.latlng.lat, e.latlng.lng]).addTo(map);
});
</script>

{% endblock %}