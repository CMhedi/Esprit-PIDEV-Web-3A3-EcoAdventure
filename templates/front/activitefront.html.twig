{% extends 'base.html.twig' %}

{% block title %}Ajouter une Activite{% endblock %}

{% block body %}
{% set fieldErrors = fieldErrors|default({}) %}
{% set formData = formData|default({}) %}
{% set packs = packs|default([]) %}
{% set selectedPack = selectedPack|default(null) %}
{% set selectedPackId = formData.id_pack|default('') %}


<div class="container my-5">
    <h2 class="mb-4">Ajouter une Nouvelle Activite</h2>

    <style>
        .btn-eco {
            background: linear-gradient(135deg, #28a745, #218838);
            color: #fff;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-eco:hover {
            background: linear-gradient(135deg, #218838, #28a745);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .error-label {
            color: #dc3545;
            display: block;
            font-size: 0.9rem;
            margin-top: 0.35rem;
        }

        .pack-selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
        }

        .pack-choice-label {
            display: block;
            cursor: pointer;
        }

        .pack-choice-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .pack-choice-card {
            height: 100%;
            border: 1px solid #dbe7dd;
            border-radius: 1rem;
            padding: 1rem;
            background: #fff;
            box-shadow: 0 10px 24px rgba(15, 67, 34, 0.08);
            transition: all 0.2s ease;
        }

        .pack-choice-label:hover .pack-choice-card {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(15, 67, 34, 0.14);
        }

        .pack-choice-input:checked + .pack-choice-card {
            border-color: #198754;
            background: linear-gradient(180deg, #f6fff8 0%, #ffffff 100%);
            box-shadow: 0 16px 32px rgba(25, 135, 84, 0.18);
        }

        .pack-choice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.75rem;
            margin-bottom: 0.9rem;
        }

        .pack-choice-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #17331f;
            margin-bottom: 0.25rem;
        }

        .pack-choice-type {
            font-size: 0.9rem;
            color: #4d6755;
        }

        .pack-status-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.35rem 0.7rem;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .pack-status-badge.dispo {
            background: #d1f7df;
            color: #157347;
        }

        .pack-status-badge.other {
            background: #f2f4f7;
            color: #495057;
        }

        .pack-mini-info {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .pack-mini-info-item {
            background: #f8faf9;
            border-radius: 0.85rem;
            padding: 0.75rem;
        }

        .pack-mini-info-item span {
            display: block;
            font-size: 0.8rem;
            color: #64706a;
            margin-bottom: 0.2rem;
        }

        .pack-mini-info-item strong {
            color: #1f2d24;
            font-size: 0.98rem;
        }

        .selected-pack-summary {
            border: 1px solid #cae8d3;
            background: linear-gradient(135deg, #f6fff8, #ffffff);
            border-radius: 1rem;
            padding: 1rem 1.2rem;
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        .selected-pack-summary h5 {
            margin-bottom: 0.5rem;
            color: #14532d;
        }

        .selected-pack-summary p {
            margin-bottom: 0;
            color: #425046;
        }
    </style>

    <form action="{{ path('app_activite_create') }}" method="POST" enctype="multipart/form-data" novalidate>

        {# MAP #}
        <div class="mb-4">
            <label class="form-label">Choisir un emplacement</label>

            <div id="map" style="height: 400px; border-radius: 12px;"></div>

            <input type="hidden" name="latitude" id="latitude">
            <input type="hidden" name="longitude" id="longitude">

            <small class="text-muted">Clique sur la carte pour choisir la position</small>
        </div>

        <div class="mb-3">
            <label for="nom" class="form-label">Nom</label>
            <input type="text" class="form-control" id="nom" name="nom"
                   value="{{ formData.nom|default('') }}">
            {% for message in fieldErrors.nom|default([]) %}
                <label class="error-label">{{ message }}</label>
            {% endfor %}
        </div>

        <div class="mb-3">
          {% for message in fieldErrors.type_activite|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <select class="form-select" id="type_activite" name="type_activite">
                <option value="">Choisir le type</option>
                <option value="SPORT" {{ formData.type_activite|default('') == 'SPORT' ? 'selected' : '' }}>SPORT</option>
                <option value="CAMPING" {{ formData.type_activite|default('') == 'CAMPING' ? 'selected' : '' }}>CAMPING</option>
                <option value="INTELECTUEL" {{ formData.type_activite|default('') == 'INTELECTUEL' ? 'selected' : '' }}>INTELECTUEL</option>
                <option value="CULTUREL" {{ formData.type_activite|default('') == 'CULTUREL' ? 'selected' : '' }}>CULTUREL</option>
            </select>
        </div>

        <div class="mb-3">
            {% for message in fieldErrors.categorie_act|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <select class="form-select" id="categorie_act" name="categorie_act">
                <option value="">Choisir la categorie</option>
                <option value="FITNESS" {{ formData.categorie_act|default('') == 'FITNESS' ? 'selected' : '' }}>FITNESS</option>
                <option value="RUNNING" {{ formData.categorie_act|default('') == 'RUNNING' ? 'selected' : '' }}>RUNNING</option>
                <option value="FOOTBALL" {{ formData.categorie_act|default('') == 'FOOTBALL' ? 'selected' : '' }}>FOOTBALL</option>
                <option value="BASKETBALL" {{ formData.categorie_act|default('') == 'BASKETBALL' ? 'selected' : '' }}>BASKETBALL</option>
                <option value="TENNIS" {{ formData.categorie_act|default('') == 'TENNIS' ? 'selected' : '' }}>TENNIS</option>
                <option value="NATATION" {{ formData.categorie_act|default('') == 'NATATION' ? 'selected' : '' }}>NATATION</option>
                <option value="RANDONNEE" {{ formData.categorie_act|default('') == 'RANDONNEE' ? 'selected' : '' }}>RANDONNEE</option>
                <option value="CYCLISME" {{ formData.categorie_act|default('') == 'CYCLISME' ? 'selected' : '' }}>CYCLISME</option>
                <option value="YOGA" {{ formData.categorie_act|default('') == 'YOGA' ? 'selected' : '' }}>YOGA</option>
                <option value="AUTRE" {{ formData.categorie_act|default('') == 'AUTRE' ? 'selected' : '' }}>AUTRE</option>
            </select>
        </div>

        <div class="mb-3">
            {% for message in fieldErrors.niveau_act|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <select class="form-select" id="niveau_act" name="niveau_act">
                <option value="">Choisir le niveau</option>
                <option value="DEBUTANT" {{ formData.niveau_act|default('') == 'DEBUTANT' ? 'selected' : '' }}>Debutant</option>
                <option value="INTERMEDIAIRE" {{ formData.niveau_act|default('') == 'INTERMEDIAIRE' ? 'selected' : '' }}>Intermediaire</option>
                <option value="AVANCE" {{ formData.niveau_act|default('') == 'AVANCE' ? 'selected' : '' }}>Avance</option>
            </select>
        </div>

        <div class="mb-3">
            {% for message in fieldErrors.prix|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <input type="text" class="form-control" id="prix" name="prix"
                   value="{{ formData.prix|default('') }}">
        </div>

        <div class="mb-3">
            {% for message in fieldErrors.statut|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <select class="form-select" id="statut" name="statut">
                <option value="">Choisir le statut</option>
                <option value="DISPONIBLE" {{ formData.statut|default('') == 'DISPONIBLE' ? 'selected' : '' }}>Disponible</option>
                <option value="INDISPONIBLE" {{ formData.statut|default('') == 'INDISPONIBLE' ? 'selected' : '' }}>Indisponible</option>
            </select>
        </div>

        <div class="mb-3">
            {% for message in fieldErrors.image_url|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            <input type="file" class="form-control" id="image_url" name="image_url">
        </div>

        {# PACK SECTION (UNCHANGED) #}
        <div class="mb-4">
            {% for message in fieldErrors.id_pack|default([]) %}
    <label class="error-label">{{ message }}</label>
{% endfor %}
            {% if packs is empty %}
                <div class="alert alert-warning mb-0">
                    Aucun pack n'est disponible pour le moment.
                </div>
            {% else %}
                <div class="pack-selection-grid">
                    {% for pack in packs %}
                        <label class="pack-choice-label">
                            <input class="pack-choice-input" type="radio"
                                   name="id_pack" value="{{ pack.idPack }}"
                                   {{ selectedPackId == pack.idPack ? 'checked' : '' }}>
                            <div class="pack-choice-card">
                                <div class="pack-choice-title">{{ pack.nom }}</div>
                                <div class="pack-choice-type">{{ pack.typePack }}</div>
                            </div>
                        </label>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <button type="submit" class="btn btn-eco btn-lg rounded-pill px-5">
            Ajouter l'activite
        </button>
    </form>
</div>

{# LEAFLET #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    const map = L.map('map').setView([36.8065, 10.1815], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    let marker;

    map.on('click', function (e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        if (marker) map.removeLayer(marker);

        marker = L.marker([lat, lng]).addTo(map);
    });
</script>

{% endblock %}