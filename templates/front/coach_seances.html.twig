{% extends 'base.html.twig' %}

{% block title %}Mes séances - Coach | Plateforme Eco{% endblock %}

{% block body %}

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #ffffff 0%, #f8faf9 100%); min-height: 100vh;">

    <div class="container">

        <!-- ===== HEADER SECTION ===== -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="fw-bold" style="color: #27ae60; margin-bottom: 0.5rem;">
                            <i class="bi bi-calendar-event"></i>
                            Mes séances
                        </h1>
                        <p class="text-muted mb-0" style="font-size: 1rem;">
                            Gestion complète de vos séances et participants
                        </p>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_coach_export_pdf') }}" class="btn btn-outline-success">
                            <i class="bi bi-file-pdf"></i>
                            Export PDF
                        </a>
                        <a href="{{ path('app_coach_seances') }}" class="btn btn-outline-success">
                            <i class="bi bi-arrow-left"></i>
                            Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== MESSAGES FLASH ===== -->
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : 'warning') }} alert-dismissible fade show shadow-sm mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        {% if type == 'success' %}
                            <i class="bi bi-check-circle-fill fs-5 me-2" style="color: #27ae60;"></i>
                        {% elseif type == 'error' %}
                            <i class="bi bi-exclamation-circle-fill fs-5 me-2" style="color: #e74c3c;"></i>
                        {% else %}
                            <i class="bi bi-info-circle-fill fs-5 me-2" style="color: #f39c12;"></i>
                        {% endif %}
                        <span>{{ message }}</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- ===== STATS SECTION ===== -->
        <div class="row mb-5 g-3">
            
            <!-- Total séances -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #27ae60;">
                    <div class="card-body">
                        <h6 class="text-muted mb-2" style="font-size: 0.85rem;">📊 Total séances</h6>
                        <h5 class="fw-bold mb-1" style="color: #27ae60;">{{ stats.total_seances }}</h5>
                        <small class="text-muted">Toutes vos séances</small>
                    </div>
                </div>
            </div>

            <!-- Taux participation -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #27ae60;">
                    <div class="card-body">
                        <h6 class="text-muted mb-2" style="font-size: 0.85rem;">👥 Participation</h6>
                        <h5 class="fw-bold mb-1" style="color: #27ae60;">{{ stats.taux_participation }}%</h5>
                        <small class="text-muted">{{ stats.total_participants }}/{{ stats.total_places }} participants</small>
                    </div>
                </div>
            </div>

<!-- Séance la plus réservée -->
<div class="col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #f39c12;">
        <div class="card-body">

            <h6 class="text-muted mb-2" style="font-size: 0.85rem;">
                🔥 Séance populaire
            </h6>

            {% if stats.seance_populaire %}
                
                <h5 class="fw-bold mb-1" style="color: #e67e22;">
                    {{ stats.seance_populaire.nom }}
                </h5>

                <small class="text-muted">
                    {{ stats.nb_reservations_max }} réservations
                </small>

            {% else %}

                <p class="text-muted mb-0">
                    Aucune donnée
                </p>

            {% endif %}

        </div>
    </div>
</div>

            <!-- Prochaine séance -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100" style="border-top: 4px solid #f39c12;">
                    <div class="card-body">
                        <h6 class="text-muted mb-2" style="font-size: 0.85rem;">📅 Prochaine</h6>
                        {% if stats.prochaine_seance %}
                            <h5 class="fw-bold mb-1" style="color: #27ae60;">{{ stats.prochaine_seance.nom }}</h5>
                            <small class="text-muted">{{ stats.prochaine_seance.dateSeance|date('d/m/Y') }}</small>
                        {% else %}
                            <p class="text-muted mb-0">Aucune séance</p>
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>

        <!-- ===== SEARCH & FILTER SECTION ===== -->
        {% if seances|length > 0 %}
        <div class="row mb-4 g-3">
            
            <!-- Recherche -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-0">
                                <i class="bi bi-search" style="color: #27ae60;"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-0"
                                   placeholder="Rechercher une séance..."
                                   id="searchInput"
                                   autocomplete="off"
                                   style="border-bottom: 2px solid #27ae60 !important;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filtres -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-success filter-btn active" data-filter="tous">
                                <i class="bi bi-funnel"></i>
                                Toutes
                            </button>
                            <button class="btn btn-sm btn-outline-success filter-btn" data-filter="PLANIFIEE">
                                <i class="bi bi-calendar-event"></i>
                                À venir
                            </button>
                            <button class="btn btn-sm btn-outline-success filter-btn" data-filter="TERMINEE">
                                <i class="bi bi-check-circle"></i>
                                Terminées
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        {% endif %}

        <!-- ===== SÉANCES CARDS ===== -->
        <div class="row g-4" id="seanceContainer">

            {% for s in seances %}

                <div class="col-lg-4 col-md-6 seance-card" 
                     data-seance="{{ s.nom|lower }}"
                     data-statut="{{ s.statutSeance.value }}">

                    <div class="card border-0 shadow-sm h-100 overflow-hidden transition-all" 
                         style="cursor: pointer; transition: all 0.3s ease; border-top: 5px solid #27ae60;">

                        <!-- CARD HEADER -->
                        <div class="position-relative" style="background: linear-gradient(135deg, 
                            {% if s.statutSeance.value == 'PLANIFIEE' %}
                                #27ae60 0%, #229954 100%
                            {% elseif s.statutSeance.value == 'TERMINEE' %}
                                #95a5a6 0%, #7f8c8d 100%
                            {% else %}
                                #bdc3c7 0%, #95a5a6 100%
                            {% endif %}
                        ); height: 120px; display: flex; align-items: center; justify-content: center;">
                            
                            <div style="font-size: 3rem; color: rgba(255, 255, 255, 0.3); z-index: 1;">
                                <i class="bi bi-activity"></i>
                            </div>

                            <!-- Badge date -->
                            <div class="position-absolute top-3 start-3">
                                <span class="badge bg-white shadow-sm p-2" style="color: #27ae60; font-weight: 600;">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    {{ s.dateSeance|date('d/m/Y') }}
                                </span>
                            </div>

                            <!-- Badge horaire -->
                            <div class="position-absolute top-3 end-3">
                                <span class="badge bg-white shadow-sm p-2" style="color: #27ae60; font-weight: 600;">
                                    <i class="bi bi-clock me-1"></i>
                                    {{ s.heureDebut|date('H:i') }}
                                </span>
                            </div>

                            <!-- Badge statut -->
                            <div class="position-absolute bottom-3 start-50 translate-middle-x">
                                <span class="badge bg-white shadow-sm p-2" style="color: #27ae60; font-weight: 600;">
                                    <i class="bi bi-dot"></i>
                                    {{ s.statutSeance.value }}
                                </span>
                            </div>
                        </div>

                        <!-- CARD BODY -->
                        <div class="card-body position-relative">

                            <!-- Titre -->
                            <h5 class="fw-bold mb-3" style="color: #27ae60;">
                                <i class="bi bi-lightning-fill" style="color: #f39c12;"></i>
                                {{ s.nom }}
                            </h5>

                            <!-- Infos -->
                            <div class="space-y-2">

                                <!-- Niveau -->
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-bar-chart me-3" style="color: #27ae60; font-size: 1.1rem;"></i>
                                    <div>
                                        <small class="text-muted d-block" style="font-size: 0.85rem;">Niveau</small>
                                        <strong style="color: #2c3e50;">Tous niveaux</strong>
                                    </div>
                                </div>

                                <!-- Participants -->
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-people-fill me-3" style="color: #27ae60; font-size: 1.1rem;"></i>
                                    <div>
                                        <small class="text-muted d-block" style="font-size: 0.85rem;">Participants</small>
                                        <strong style="color: #2c3e50;">{{ s.reservationSeances|length }}/{{ s.capacite }}</strong>
                                    </div>
                                </div>

                                <!-- Barre de progression -->
                                <div class="d-flex align-items-center mt-3">
                                    <i class="bi bi-hourglass-split me-3" style="color: #27ae60; font-size: 1.1rem;"></i>
                                    <div style="width: 100%;">
                                        <small class="text-muted d-block" style="font-size: 0.85rem;">Occupation</small>
                                        <div class="progress mt-1" style="height: 8px;">
                                            {% set pourcentage = (s.reservationSeances|length / s.capacite * 100)|round(0) %}
                                            <div class="progress-bar" 
                                                 style="width: {{ pourcentage }}%; background-color: #27ae60;">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <!-- CARD FOOTER -->
                        <div class="card-footer bg-white border-top-0 p-3">
                            <a href="{{ path('app_coach_seance_detail', {'id': s.idSeance}) }}"
                               class="btn w-100 fw-bold shadow-sm"
                               style="background-color: #27ae60; color: white; border: none;"
                               onmouseover="this.style.backgroundColor='#229954'; this.style.transform='translateY(-2px)';"
                               onmouseout="this.style.backgroundColor='#27ae60'; this.style.transform='translateY(0)';">
                                <i class="bi bi-eye me-2"></i>
                                Voir détails
                            </a>
                        </div>

                    </div>

                </div>

            {% else %}

                <div class="col-12">
                    <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #ffffff 0%, #f8faf9 100%); border-top: 4px solid #27ae60;">
                        <div class="card-body text-center py-5">
                            <div style="font-size: 4rem; margin-bottom: 1rem; color: #bdc3c7;">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <h4 class="fw-bold mb-2" style="color: #27ae60;">Aucune séance</h4>
                            <p class="text-muted mb-0">
                                Vous n'avez pas de séances pour le moment.
                            </p>
                        </div>
                    </div>
                </div>

            {% endfor %}

        </div>

        <!-- Message "aucun résultat" -->
        <div id="noResultsMessage" class="d-none">
            <div class="col-12">
                <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #fff9e6 0%, #ffe6cc 100%); border-top: 4px solid #f39c12;">
                    <div class="card-body text-center py-5">
                        <div style="font-size: 3rem; margin-bottom: 1rem; color: #f39c12;">
                            <i class="bi bi-search"></i>
                        </div>
                        <h4 class="fw-bold mb-2" style="color: #e67e22;">Aucune séance ne correspond</h4>
                        <p class="text-muted mb-0">
                            Essayez une autre recherche ou modifiez vos filtres.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .seance-card:hover .card {
        box-shadow: 0 10px 30px rgba(39, 174, 96, 0.15) !important;
        transform: translateY(-5px);
    }

    .seance-card {
        animation: fadeInUp 0.5s ease forwards;
        opacity: 0;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .seance-card:nth-child(1) { animation-delay: 0.1s; }
    .seance-card:nth-child(2) { animation-delay: 0.2s; }
    .seance-card:nth-child(3) { animation-delay: 0.3s; }
    .seance-card:nth-child(4) { animation-delay: 0.4s; }
    .seance-card:nth-child(5) { animation-delay: 0.5s; }
    .seance-card:nth-child(6) { animation-delay: 0.6s; }

    .filter-btn {
        transition: all 0.3s ease;
    }

    .filter-btn.active {
        background-color: #27ae60 !important;
        color: white !important;
    }
</style>

{% block js %}
<script>
    // ===== SEARCH DYNAMIQUE =====
    document.getElementById('searchInput').addEventListener('keyup', function() {
        filterSeances();
    });

    // ===== FILTRES DYNAMIQUES =====
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            filterSeances();
        });
    });

    // ===== FONCTION DE FILTRAGE =====
    function filterSeances() {
        const searchValue = document.getElementById('searchInput').value.toLowerCase();
        const activeFilter = document.querySelector('.filter-btn.active').getAttribute('data-filter');
        const cards = document.querySelectorAll('.seance-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const seanceName = card.getAttribute('data-seance');
            const statut = card.getAttribute('data-statut');
            
            const matchSearch = seanceName.includes(searchValue) || searchValue === '';
            const matchFilter = activeFilter === 'tous' || statut === activeFilter;
            
            const isVisible = matchSearch && matchFilter;
            card.style.display = isVisible ? 'block' : 'none';
            
            if (isVisible) {
                visibleCount++;
            }
        });

        const noResultsMsg = document.getElementById('noResultsMessage');
        if (visibleCount === 0) {
            noResultsMsg.classList.remove('d-none');
        } else {
            noResultsMsg.classList.add('d-none');
        }
    }
</script>
{% endblock %}

{% endblock %}