{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">

    <style>
        .card-dispo {
            border-radius: 1.5rem;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
            border: none;
            padding: 2rem;
            background: #ffffff;
        }

        .title-dispo {
            font-weight: 700;
            color: #198754;
        }

        .badge-cat {
            background: #e9f7ef;
            color: #198754;
            padding: 0.5rem 1rem;
            border-radius: 999px;
            font-size: 0.9rem;
        }

        .stat-box {
            border-radius: 1rem;
            padding: 1.2rem;
            text-align: center;
            background: #f8f9fa;
            box-shadow: inset 0 0 0 1px #e3e6ea;
        }

        .stat-number {
            font-size: 1.6rem;
            font-weight: bold;
        }

        .seats {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(35px, 1fr));
            gap: 8px;
            margin-top: 1rem;
        }

        .seat {
            width: 35px;
            height: 35px;
            border-radius: 8px;
        }

        .seat.free {
            background-color: #198754;
        }

        .seat.taken {
            background-color: #dc3545;
        }

        .btn-retour {
            border-radius: 999px;
            padding: 0.6rem 1.8rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-retour:hover {
            transform: translateY(-2px);
        }
    </style>

    <div class="card-dispo">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="title-dispo mb-0">Disponibilité</h3>
            <span class="badge-cat">{{ activite.categorieAct.value }}</span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-box">
                    <div>Capacité</div>
                    <div class="stat-number">{{ capaciteTotale }}</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-box">
                    <div>Réservé</div>
                    <div class="stat-number text-danger">{{ nbReserve }}</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-box">
                    <div>Disponible</div>
                    <div class="stat-number {% if disponible > 0 %}text-success{% else %}text-danger{% endif %}">
                        {% if disponible > 0 %}
                            {{ disponible }}
                        {% else %}
                            Complet
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# 🎯 VISUALISATION STYLE "CHAISES" #}
        <div>
            <h6 class="mb-2">Visualisation des places</h6>
            <div class="seats">
                {% for i in 1..capaciteTotale %}
                    {% if i <= nbReserve %}
                        <div class="seat taken"></div>
                    {% else %}
                        <div class="seat free"></div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="{{ path('app_reservation_front', {'id': activite.idActivite}) }}"
               class="btn btn-outline-success btn-retour">
                ← Retour à la réservation
            </a>
        </div>

    </div>

</div>
{% endblock %}