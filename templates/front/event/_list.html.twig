{% for event in events %}
    <div class="col-lg-4 col-md-6">
        <div class="card event-card border-0 shadow-sm h-100">
            {% if event.image_url %}
                <img src="{{ asset(event.image_url) }}" class="card-img-top event-image" alt="{{ event.titre }}" style="height: 200px; object-fit: cover;">
            {% else %}
                <img src="{{ asset('assets/img/default-event.png') }}" class="card-img-top event-image" alt="{{ event.titre }}" style="height: 200px; object-fit: cover;">
            {% endif %}
            
            <div class="card-body">
                <span class="badge bg-light text-dark mb-2">{{ event.categorie_evt.value }}</span>
                <h5 class="fw-bold">{{ event.titre }}</h5>
                <p class="mb-1"><i class="bi bi-geo-alt me-2"></i>{{ event.lieu }}</p>
                <p class="mb-1"><i class="bi bi-calendar-event me-2"></i>{{ event.date_event ? event.date_event|date('d M Y') : '' }}</p>
                <p class="mb-1 text-success fw-bold"><i class="bi bi-tag me-2"></i>{{ event.prix|number_format(2, ',', ' ') }} DT</p>
                <p class="price-text mb-3"><i class="bi bi-people me-2"></i>{{ event.nb_places }} Places</p>

                <div class="d-flex gap-2">
                    <a href="{{ path('app_event_front_show', {'id_evenement': event.id_evenement}) }}" class="btn btn-light border w-100">Détails</a>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12 py-5 text-center">
        <div class="empty-state">
            <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">Aucun événement trouvé</h4>
            <p class="text-muted">Essayez de modifier vos critères de recherche ou de réinitialiser les filtres.</p>
            <a href="{{ path('app_event_front_index') }}" class="btn btn-outline-warning mt-2">Voir tous les événements</a>
        </div>
    </div>
{% endfor %}

{% if total_pages > 1 %}
<div class="col-12 mt-4 d-flex justify-content-center w-100">
    <nav aria-label="Pagination événements">
        <ul class="pagination pagination-success">
            <li class="page-item {% if current_page <= 1 %}disabled{% endif %}">
                <button class="page-link" data-page="{{ current_page - 1 }}" {% if current_page <= 1 %}tabindex="-1" aria-disabled="true"{% endif %}><i class="bi bi-chevron-left"></i> Précédent</button>
            </li>
            
            {% for i in 1..total_pages %}
                <li class="page-item {% if current_page == i %}active{% endif %}">
                    <button class="page-link" data-page="{{ i }}">{{ i }}</button>
                </li>
            {% endfor %}
            
            <li class="page-item {% if current_page >= total_pages %}disabled{% endif %}">
                <button class="page-link" data-page="{{ current_page + 1 }}" {% if current_page >= total_pages %}tabindex="-1" aria-disabled="true"{% endif %}>Suivant <i class="bi bi-chevron-right"></i></button>
            </li>
        </ul>
    </nav>
</div>
{% endif %}
