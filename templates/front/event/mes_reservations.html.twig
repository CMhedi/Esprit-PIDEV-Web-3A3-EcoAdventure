{% extends 'base.html.twig' %}

{% block title %}Mes Réservations | EcoAdventure{% endblock %}

{% block css %}
<style>
    .badge-nouveau {
        animation: pulse-animation 2s infinite;
    }
    @keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0px rgba(13, 110, 253, 0.7); }
        100% { box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-ticket-detailed me-2 text-success"></i>Mes Réservations</h1>
        <div class="d-flex gap-2">
            {% if reservations is not empty %}
                <a href="{{ path('app_reservation_all_tickets') }}" class="btn btn-success shadow-sm">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i>Télécharger tout (PDF)
                </a>
            {% endif %}
            <a href="{{ path('app_event_front_index') }}" class="btn btn-outline-success">Voir d'autres événements</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if reservations is empty %}
        <div class="alert alert-info py-4 text-center">
            <h4 class="mb-3">Vous n'avez pas encore de réservations.</h4>
            <a href="{{ path('app_event_front_index') }}" class="btn btn-success">Explorer les événements</a>
        </div>
    {% else %}
        <div class="row g-4">
            {% for res in reservations %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <div class="position-absolute top-0 end-0 p-2 d-flex flex-column gap-1">
                            {% if res.is_new %}
                                <span class="badge bg-primary badge-nouveau">
                                    <i class="bi bi-star-fill me-1"></i>Nouveau
                                </span>
                            {% endif %}
                            <span class="badge bg-{{ res.statut.value == 'CONFIRMEE' ? 'success' : (res.statut.value == 'ANNULEE' ? 'danger' : 'warning') }}">
                                {{ res.statut.value }}
                            </span>
                        </div>
                        
                        {% if res.evenement.image_url %}
                            <img src="{{ asset(res.evenement.image_url) }}" class="card-img-top" alt="{{ res.evenement.titre }}" style="height: 150px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('assets/img/default-event.png') }}" class="card-img-top" alt="{{ res.evenement.titre }}" style="height: 150px; object-fit: cover;">
                        {% endif %}

                        <div class="card-body">
                            <h5 class="card-title fw-bold">{{ res.evenement.titre }}</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt"></i> {{ res.evenement.lieu }}<br>
                                <i class="bi bi-calendar-event"></i> {{ res.evenement.date_event|date('d/m/Y à H:i') }}
                            </p>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="bi bi-ticket-perforated text-success"></i> Billets Total :</span>
                                <span class="fs-5 fw-bold text-success">{{ res.total_billets }}</span>
                            </div>
                            <div class="text-muted small mt-2">
                                Dernière réservation le {{ res.latest_date|date('d/m/Y H:i') }}
                            </div>
                            <div class="mt-3 d-flex flex-column gap-2">
                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_event_front_show', {'id_evenement': res.evenement.id_evenement}) }}" class="btn btn-sm btn-outline-success flex-grow-1">
                                        <i class="bi bi-plus-circle me-1"></i>Réserver
                                    </a>
                                    <a href="{{ path('app_reservation_event_ticket', {'id_evenement': res.evenement.id_evenement}) }}" class="btn btn-sm btn-success flex-grow-1">
                                        <i class="bi bi-file-earmark-pdf me-1"></i>Ticket PDF
                                    </a>
                                </div>
                                
                                {% set google_cal_url = "https://www.google.com/calendar/render?action=TEMPLATE&text=" ~ res.evenement.titre|url_encode ~ "&details=Réservation EcoAdventure&location=" ~ res.evenement.lieu|url_encode ~ "&dates=" ~ res.evenement.date_event|date('Ymd\\THis') ~ "/" ~ res.evenement.date_event|date_modify("+2 hours")|date('Ymd\\THis') %}
                                <a href="{{ google_cal_url }}" target="_blank" class="btn btn-sm btn-outline-primary w-100">
                                    <i class="bi bi-calendar-plus me-1"></i>Ajouter au Calendrier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
