<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Facture #{{ reference }}</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; line-height: 1.6; }
        .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; }
        .header { display: flex; justify-content: space-between; margin-bottom: 40px; border-bottom: 2px solid #2ecc71; padding-bottom: 20px; }
        .logo { font-size: 28px; font-weight: bold; color: #2ecc71; }
        .invoice-info { text-align: right; }
        .details { margin-bottom: 40px; }
        .details div { margin-bottom: 5px; }
        .table { width: 100%; border-collapse: collapse; margin-bottom: 40px; }
        .table th { background: #f8f9fa; border-bottom: 2px solid #dee2e6; padding: 12px; text-align: left; font-size: 14px; }
        .table td { padding: 12px; border-bottom: 1px solid #eee; font-size: 14px; }
        .total-section { text-align: right; }
        .total-row { margin-bottom: 10px; font-size: 16px; }
        .total-grand { font-size: 22px; font-weight: bold; color: #2ecc71; margin-top: 10px; }
        .footer { margin-top: 50px; text-align: center; font-size: 12px; color: #999; border-top: 1px solid #eee; padding-top: 20px; }
        .status-badge { display: inline-block; padding: 5px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; text-transform: uppercase; background: #e8f5e9; color: #2e7d32; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <table width="100%">
            <tr>
                <td class="logo">EcoAdventure</td>
                <td class="invoice-info">
                    <div style="font-size: 20px; font-weight: bold;">FACTURE</div>
                    <div>Réf: {{ reference }}</div>
                    <div>Date: {{ "now"|date("d/m/Y") }}</div>
                </td>
            </tr>
        </table>

        <hr style="border: 0; border-top: 2px solid #2ecc71; margin: 20px 0;">

        <table width="100%" class="details">
            <tr>
                <td width="50%">
                    <strong>Émetteur:</strong><br>
                    EcoAdventure Agence<br>
                    123 Rue de l'Aventure, Tunis<br>
                    Email: contact@ecoadventure.com<br>
                    Tél: +216 71 000 000
                </td>
                <td width="50%" style="text-align: right;">
                    <strong>Client:</strong><br>
                    {{ user.nom }} {{ user.prenom }}<br>
                    {{ user.email }}<br>
                    {% if user.telephone %}Tél: {{ user.telephone }}{% endif %}
                </td>
            </tr>
        </table>

        <table class="table">
            <thead>
                <tr>
                    <th>Description de l'Événement</th>
                    <th>Prix Unitaire</th>
                    <th style="text-align: center;">Quantité</th>
                    <th style="text-align: right;">Total HT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>{{ evenement.titre }}</strong><br>
                        <small>Date: {{ evenement.dateEvent|date("d/m/Y H:i") }}</small><br>
                        <small>Lieu: {{ evenement.lieu }}</small>
                    </td>
                    <td>{{ evenement.prix|number_format(2, ',', ' ') }} DT</td>
                    <td style="text-align: center;">{{ totalBillets }}</td>
                    <td style="text-align: right;">{{ pricing.sousTotal|number_format(2, ',', ' ') }} DT</td>
                </tr>
            </tbody>
        </table>

        <div class="total-section">
            <div class="total-row">Sous-total HT: <strong>{{ pricing.sousTotal|number_format(2, ',', ' ') }} DT</strong></div>
            {% if pricing.appliquePromo %}
                <div class="total-row" style="color: #e74c3c;">Remise Groupe ({{ pricing.tauxRemise }}%): <strong>-{{ pricing.remise|number_format(2, ',', ' ') }} DT</strong></div>
            {% endif %}
            <div class="total-row">TVA (0%): <strong>0,00 DT</strong></div>
            <div class="total-grand">TOTAL TTC: {{ pricing.totalFinal|number_format(2, ',', ' ') }} DT</div>
        </div>

        <div style="margin-top: 30px;">
            <div class="status-badge">Statut: Confirmée</div>
        </div>

        <div class="footer">
            Merci pour votre confiance !<br>
            EcoAdventure - Vivez l'aventure au naturel.<br>
            Ceci est une facture générée numériquement.
        </div>
    </div>
</body>
</html>
