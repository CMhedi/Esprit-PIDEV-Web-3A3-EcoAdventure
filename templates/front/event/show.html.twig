{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} | EcoAdventure{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-2">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mt-2">{{ message }}</div>
        {% endfor %}

        <div class="row">
            <div class="col-lg-8">
                {% if evenement.image_url %}
                    <img src="{{ asset(evenement.image_url) }}" class="img-fluid rounded shadow-sm mb-4" alt="{{ evenement.titre }}" style="width: 100%; max-height: 400px; object-fit: cover;">
                {% else %}
                    <img src="{{ asset('assets/img/event1.png') }}" class="img-fluid rounded shadow-sm mb-4" alt="{{ evenement.titre }}" style="width: 100%; max-height: 400px; object-fit: cover;">
                {% endif %}
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="fw-bold">{{ evenement.titre }}</h1>
                    <div class="text-warning fs-4">
                        {% set avg = evenement.averageRating %}
                        {% for i in 1..5 %}
                            <i class="bi bi-star{{ avg >= i ? '-fill' : (avg >= i - 0.5 ? '-half' : '') }}"></i>
                        {% endfor %}
                        <span class="ms-1 text-muted fs-6">({{ evenement.ratings|length }})</span>
                    </div>
                </div>
                <p class="lead">{{ evenement.description }}</p>

                {% if weather %}
                    <div class="card border-0 shadow-sm bg-light mb-4">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="fw-bold mb-1"><i class="bi bi-cloud-sun me-2 text-primary"></i>Météo à {{ evenement.lieu }}</h5>
                                <p class="mb-0 text-muted">{{ weather.description }}</p>
                            </div>
                            <div class="d-flex align-items-center">
                                <img src="https://openweathermap.org/img/wn/{{ weather.icon }}@2x.png" alt="Météo" style="width: 50px;">
                                <span class="fs-2 fw-bold ms-2">{{ weather.temp }}°C</span>
                            </div>
                        </div>
                    </div>
                {% endif %}
                
                <h4 class="mt-4">Informations Pratiques</h4>
                <ul class="list-unstyled">
                    <li><i class="bi bi-tag text-warning me-2"></i><strong>Prix:</strong> <span class="fs-5 fw-bold text-success">{{ evenement.prix|number_format(2, ',', ' ') }} DT</span> / billet</li>
                    <li><i class="bi bi-geo-alt text-warning me-2"></i><strong>Lieu:</strong> {{ evenement.lieu }}</li>
                    <li><i class="bi bi-calendar-event text-warning me-2"></i><strong>Date:</strong> {{ evenement.date_event|date('d/m/Y H:i') }}</li>
                    <li><i class="bi bi-people text-warning me-2"></i><strong>Places Restantes:</strong> 
                        {% if places_dispo <= 0 %}
                            <span class="text-danger fw-bold">Complet</span>
                        {% else %}
                            <span class="text-success fw-bold">{{ places_dispo }} / {{ evenement.nb_places }}</span>
                        {% endif %}
                    </li>
                </ul>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 100px;">
                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold">Réserver votre place</h4>
                        <p class="text-muted">Rejoignez-nous pour cette aventure !</p>
                        
                        <hr>
                        
                        <form action="{{ path('app_reservation_event', {'id_evenement': evenement.id_evenement}) }}" method="POST">
                            <div class="mb-3 text-start">
                                <label for="nb_billets" class="form-label">Nombre de billets</label>
                                <input type="number" name="nb_billets" id="nb_billets" class="form-control" value="1" min="1" max="{{ places_dispo > 0 ? places_dispo : 1 }}" {% if places_dispo <= 0 %}disabled{% endif %}>
                            </div>
                            
                            {% if places_dispo <= 0 %}
                                <button type="button" class="btn btn-secondary w-100 fw-bold py-2 disabled">Complet</button>
                            {% else %}
                                <button type="submit" class="btn btn-warning w-100 fw-bold py-2">Valider la Réservation</button>
                            {% endif %}
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold mb-3">Noter cet événement</h5>
                        <form action="{{ path('app_event_rate', {'id_evenement': evenement.id_evenement}) }}" method="POST" id="rating-form">
                            <div class="rating-stars mb-3 fs-3 text-warning">
                                {% for i in 1..5 %}
                                    <i class="bi bi-star rating-star" data-value="{{ i }}" style="cursor: pointer;"></i>
                                {% endfor %}
                            </div>
                            <input type="hidden" name="note" id="note-input" value="5">
                            <button type="submit" class="btn btn-outline-warning btn-sm w-100">Envoyer ma note</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% block js %}
<script>
document.querySelectorAll('.rating-star').forEach(star => {
    star.addEventListener('mouseover', function() {
        const val = this.dataset.value;
        highlightStars(val);
    });
    star.addEventListener('click', function() {
        const val = this.dataset.value;
        document.getElementById('note-input').value = val;
        setSelectedStars(val);
    });
});

document.querySelector('.rating-stars').addEventListener('mouseleave', function() {
    highlightStars(document.getElementById('note-input').value);
});

function highlightStars(val) {
    document.querySelectorAll('.rating-star').forEach(star => {
        if (star.dataset.value <= val) {
            star.classList.replace('bi-star', 'bi-star-fill');
        } else {
            star.classList.replace('bi-star-fill', 'bi-star');
        }
    });
}

function setSelectedStars(val) {
    highlightStars(val);
}
// Initial state
highlightStars(5);
</script>
{% endblock %}
{% endblock %}
