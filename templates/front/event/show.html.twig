{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} | EcoAdventure{% endblock %}

{% block body %}
<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Inter', sans-serif;
    }
    .event-cover-img {
        width: 100%;
        height: 40vh;
        max-height: 380px;
        object-fit: cover;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }
    .sticky-sidebar {
        position: sticky;
        top: 2rem;
        z-index: 10;
    }
    .booking-card {
        border-radius: 24px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        background: #ffffff;
    }
    .badge-category {
        background-color: #e6f4ea;
        color: #1e8e3e;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 8px 16px;
        border-radius: 50px;
    }
    .section-title {
        font-weight: 800;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        color: #1a202c;
    }
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background-color: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #4CAF50;
    }
    .price-text {
        font-size: 2.5rem;
        font-weight: 800;
        color: #2E7D32;
        line-height: 1;
    }
</style>

<div class="container py-5">
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success border-0 shadow-sm rounded-3 fw-bold"><i class="bi bi-check-circle-fill me-2"></i>{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}</div>
    {% endfor %}

    <!-- Entête Titre -->
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <h1 class="display-4 fw-bold text-dark mb-3">{{ evenement.titre }}</h1>
            <div class="d-flex align-items-center gap-3">
                <span class="badge-category text-uppercase"><i class="bi bi-tag-fill me-2"></i>{{ evenement.categorie_evt.value }}</span>
                <div class="d-flex align-items-center text-warning fs-5">
                    {% set avg = evenement.averageRating %}
                    {% for i in 1..5 %}
                        <i class="bi bi-star{{ avg >= i ? '-fill' : (avg >= i - 0.5 ? '-half' : '') }}"></i>
                    {% endfor %}
                    <span class="ms-2 text-muted fs-6 fw-bold">({{ evenement.ratings|length }} avis)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Principale -->
    <div class="mb-5">
        {% if evenement.image_url %}
            <img src="{{ asset(evenement.image_url) }}" class="event-cover-img" alt="{{ evenement.titre }}">
        {% else %}
            <img src="{{ asset('assets/img/default-event.png') }}" class="event-cover-img" alt="{{ evenement.titre }}">
        {% endif %}
    </div>

    <!-- Contenu Split -->
    <div class="row g-5">
        
        <!-- Colonne Gauche : Infos -->
        <div class="col-lg-7 col-xl-8">
            <section class="mb-5 pb-4 border-bottom">
                <h3 class="section-title">À propos de l'aventure</h3>
                <p class="text-muted fs-5 lh-lg">{{ evenement.description }}</p>
            </section>

            <section class="mb-5 pb-4 border-bottom">
                <h3 class="section-title">Informations Importantes</h3>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-3 rounded-4 bg-white border shadow-sm h-100">
                            <div class="icon-box me-3"><i class="bi bi-geo-alt-fill"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Lieu</h6>
                                <span class="text-muted">{{ evenement.lieu }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-3 rounded-4 bg-white border shadow-sm h-100">
                            <div class="icon-box me-3"><i class="bi bi-calendar-event-fill"></i></div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Date & Heure</h6>
                                <span class="text-muted">{{ evenement.date_event|date('d/m/Y à H:i') }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {% if weather %}
            <section class="mb-5">
                <h3 class="section-title">Conditions Météo (<span class="text-primary">{{ evenement.lieu }}</span>)</h3>
                <div class="card border-0 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-4">
                            <div class="bg-white p-3 rounded-circle shadow-sm">
                                <i class="bi bi-cloud-sun-fill text-info fs-1"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1 text-dark text-capitalize">{{ weather.description }}</h4>
                                <span class="text-muted">Préparez-vous bien pour votre aventure sportive !</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <img src="https://openweathermap.org/img/wn/{{ weather.icon }}@2x.png" alt="Météo" style="width: 80px;">
                            <span class="display-3 fw-bold text-dark ms-2">{{ weather.temp }}°</span>
                        </div>
                    </div>
                </div>
                
                {% if weather_ai_alert %}
                <div class="alert alert-{{ weather_ai_alert.type }} border-0 rounded-4 shadow-sm position-relative overflow-hidden mb-5">
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.4) 100%); z-index: 0;"></div>
                    <div class="d-flex align-items-center position-relative" style="z-index: 1;">
                        <div class="bg-{{ weather_ai_alert.type }} text-white rounded-circle d-flex justify-content-center align-items-center me-3 flex-shrink-0" style="width: 50px; height: 50px; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                            <i class="bi bi-robot fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-{{ weather_ai_alert.type }} mb-1">
                                {% if weather_ai_alert.type == 'success' %}
                                    <i class="bi bi-check-circle-fill me-1"></i>Avis Météo Favorable (Agent IA)
                                {% else %}
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Alerte Météo Intelligente (Agent IA)
                                {% endif %}
                            </h6>
                            <p class="mb-0 text-dark fw-bold" style="font-size: 0.95rem;">{{ weather_ai_alert.message }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
            </section>
            {% endif %}

            <section class="mt-5">
                {% set reviews_with_comments = evenement.ratings|filter(r => r.commentaire is not empty) %}
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="section-title mb-0">Avis des Aventuriers</h3>
                    <span class="badge bg-warning text-dark fs-6 rounded-pill"><i class="bi bi-chat-left-text-fill me-1"></i> {{ reviews_with_comments|length }} avis</span>
                </div>

                {% if reviews_with_comments|length > 0 %}
                    <div class="d-flex flex-column gap-3 mb-5">
                        {% for rating in reviews_with_comments %}
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold text-dark"><i class="bi bi-person-circle me-2 text-muted"></i>{{ rating.user.nom }} {{ rating.user.prenom }}</div>
                                        
                                        {% if app.user and rating.user.id_user == app.user.id_user %}
                                            <form action="{{ path('app_event_rate_delete', {'id': rating.id}) }}" method="POST" onsubmit="return confirm('Supprimer ce commentaire ?');" class="m-0 p-0">
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 m-0 border-0" title="Supprimer cet avis">
                                                    <i class="bi bi-trash-fill fs-5"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                    <small class="text-muted d-block mb-2">{{ rating.createdAt|date('d/m/Y') }}</small>
                                    <p class="mb-0 text-dark" style="font-size: 0.95rem;">"{{ rating.commentaire }}"</p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted text-center mb-5">Soyez le premier à donner votre avis après l'événement !</p>
                {% endif %}

                {% if app.user %}
                    <h4 class="section-title fs-5 mt-4">Ajouter un avis</h4>
                    <div class="card border-0 shadow-sm rounded-4 bg-light border border-warning border-opacity-25">
                        <div class="card-body p-4 text-center">
                            <form action="{{ path('app_event_rate', {'id_evenement': evenement.id_evenement}) }}" method="POST" id="rating-form">
                                <div class="rating-stars mb-3 fs-1 text-warning d-flex justify-content-center gap-2">
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star rating-star" data-value="{{ i }}" style="cursor: pointer; transition: transform 0.2s;"></i>
                                    {% endfor %}
                                </div>
                                <input type="hidden" name="note" id="note-input" value="5">
                                
                                <div class="mb-4 text-start">
                                    <label for="commentaire" class="form-label fw-bold small text-muted">Votre commentaire</label>
                                    <textarea name="commentaire" id="commentaire" class="form-control rounded-3" rows="3" placeholder="Qu'avez-vous pensé de cet événement ?" required></textarea>
                                </div>

                                <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow-sm">Soumettre mon avis</button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-warning text-center mt-4 border-0 rounded-4 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Vous devez être connecté pour laisser un avis.
                    </div>
                {% endif %}
            </section>

        </div>

        <!-- Colonne Droite : Ticket / Booking -->
        <div class="col-lg-5 col-xl-4">
            <div class="sticky-sidebar">
                
                <div class="card booking-card p-4">
                    <div class="d-flex align-items-baseline gap-2 mb-4">
                        <span class="price-text">{{ evenement.prix|number_format(2, ',', ' ') }}</span>
                        <span class="text-muted fw-bold fs-5">DT <span class="fw-normal fs-6">/ personne</span></span>
                    </div>

                    <div class="p-3 mb-4 rounded-3 border {% if places_dispo > 0 %}border-success bg-success bg-opacity-10{% else %}border-danger bg-danger bg-opacity-10{% endif %}">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark"><i class="bi bi-ticket-perforated-fill me-2"></i>Disponibilité</span>
                            {% if places_dispo <= 0 %}
                                {% if attente_dispo > 0 %}
                                    <span class="badge bg-warning text-dark fs-6 rounded-pill">Attente ouverte</span>
                                {% else %}
                                    <span class="badge bg-danger fs-6 rounded-pill">Totalement Complet</span>
                                {% endif %}
                            {% else %}
                                <span class="badge bg-success fs-6 rounded-pill">{{ places_dispo }} Places</span>
                            {% endif %}
                        </div>
                    </div>

                    {% if promo_threshold and promo_discount %}
                    <div class="alert alert-info border-0 bg-info bg-opacity-10 rounded-3 d-flex align-items-center mb-4">
                        <i class="bi bi-gift-fill fs-3 text-info me-3"></i>
                        <div>
                            <h6 class="fw-bold text-info mb-0">Remise de Groupe</h6>
                            <span class="small text-muted">-{{ promo_discount * 100 }}% dès {{ promo_threshold }} billets, puis <span class="text-primary fw-bold">+1%</span> tous les 5 billets (max 50), puis <span class="text-primary fw-bold">+1%</span> tous les 10 billets.</span>
                        </div>
                    </div>
                    {% endif %}

                    <form action="{{ path('app_reservation_event', {'id_evenement': evenement.id_evenement}) }}" method="POST" id="booking-form">
                        <div class="mb-4">
                            <label for="nb_billets" class="form-label fw-bold small text-muted text-uppercase">Participants</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white"><i class="bi bi-person-fill text-muted"></i></span>
                                <input type="number" name="nb_billets" id="nb_billets" class="form-control fw-bold border-start-0" value="1" min="1" max="{{ places_dispo > 0 ? places_dispo : (attente_dispo > 0 ? attente_dispo : 1) }}" {% if places_dispo <= 0 and attente_dispo <= 0 %}disabled{% endif %}>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" id="price-container">
                            <span class="fw-bold text-dark">Total</span>
                            <div class="text-end">
                                <h4 class="fw-bold text-success mb-0" id="total-price">{{ evenement.prix|number_format(2, ',', ' ') }} DT</h4>
                                <small class="fw-bold d-none px-2 py-1 rounded-pill bg-primary bg-opacity-10 text-primary" id="promo-info" style="font-size: 0.7rem;"><i class="bi bi-stars me-1"></i>Promo appliquée !</small>
                            </div>
                        </div>

                        {% if places_dispo <= 0 %}
                            {% if attente_dispo > 0 %}
                                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold rounded-4 shadow-sm text-dark py-3"><i class="bi bi-hourglass-split me-2"></i>Liste d'attente</button>
                                <p class="text-center text-muted small mt-3 mb-0">Vous ne serez pas débité.</p>
                            {% else %}
                                <button type="button" class="btn btn-secondary btn-lg w-100 fw-bold rounded-4 py-3 disabled">Événement Indisponible</button>
                            {% endif %}
                        {% else %}
                            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-4 shadow-sm py-3" style="background-color: #2E7D32;"><i class="bi bi-check-circle-fill me-2"></i>Confirmer la réservation</button>
                            <p class="text-center text-muted small mt-3 mb-0">Réservation rapide et sécurisée.</p>
                        {% endif %}
                    </form>
                </div>

                <!-- AI RECOMMENDATION BOX -->
                {% if places_dispo <= 0 and ai_recommendation %}
                <div class="card mt-4 border-0 rounded-4 shadow-sm overflow-hidden" style="background: linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-box bg-info bg-opacity-25 text-info me-3" style="width: 40px; height: 40px;">
                                <i class="bi bi-robot fs-5"></i>
                            </div>
                            <h6 class="fw-bold text-white mb-0">Agent IA EcoAdventure</h6>
                        </div>
                        <p class="text-light opacity-75 small mb-3">Plus de places ? Notre Agent IA a trouvé une aventure alternative similaire juste pour vous :</p>
                        
                        <div class="bg-white bg-opacity-10 rounded-3 p-3 mb-4 d-flex align-items-center">
                            {% if ai_recommendation.image_url %}
                                <img src="{{ asset(ai_recommendation.image_url) }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3">
                            {% else %}
                                <div class="bg-dark text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; border-radius: 8px;"><i class="bi bi-image"></i></div>
                            {% endif %}
                            <div>
                                <h6 class="text-white fw-bold mb-1" style="font-size: 0.9rem;">{{ ai_recommendation.titre }}</h6>
                                <span class="text-info fw-bold small">{{ ai_recommendation.prix }} DT</span>
                            </div>
                        </div>

                        <a href="{{ path('app_event_front_show', {'id_evenement': ai_recommendation.id_evenement}) }}" class="btn btn-info w-100 fw-bold rounded-pill text-dark">Voir l'alternative</a>
                    </div>
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>

{% block js %}
<script>
// Rating Stars Interaction
document.querySelectorAll('.rating-star').forEach(star => {
    star.addEventListener('mouseover', function() {
        highlightStars(this.dataset.value);
        this.style.transform = 'scale(1.2)';
    });
    star.addEventListener('mouseout', function() {
        this.style.transform = 'scale(1)';
    });
    star.addEventListener('click', function() {
        document.getElementById('note-input').value = this.dataset.value;
        setSelectedStars(this.dataset.value);
    });
});

document.querySelector('.rating-stars').addEventListener('mouseleave', function() {
    highlightStars(document.getElementById('note-input').value);
});

function highlightStars(val) {
    document.querySelectorAll('.rating-star').forEach(star => {
        if (star.dataset.value <= val) {
            star.classList.replace('bi-star', 'bi-star-fill');
        } else {
            star.classList.replace('bi-star-fill', 'bi-star');
        }
    });
}

function setSelectedStars(val) {
    highlightStars(val);
}
highlightStars(5);

// Dynamic Price Calculation
const basePrice = {{ evenement.prix }};
const promoThreshold = {{ promo_threshold|default(1000) }};
const promoDiscount = {{ promo_discount|default(0) }};
const inputBillets = document.getElementById('nb_billets');
const totalPriceEl = document.getElementById('total-price');
const promoInfoEl = document.getElementById('promo-info');

if (inputBillets) {
    inputBillets.addEventListener('input', function() {
        let nb = parseInt(this.value) || 1;
        let sousTotal = basePrice * nb;
        let isPromo = false;

        if (nb >= promoThreshold) {
            let disc = promoDiscount;
            if (nb <= 50) {
                disc += Math.floor((nb - promoThreshold) / 5) * 0.01;
            } else {
                disc = 0.18 + Math.floor((nb - 50) / 10) * 0.01;
            }
            
            sousTotal = sousTotal * (1 - disc);
            isPromo = true;
            promoInfoEl.innerHTML = `<i class="bi bi-stars me-1"></i>Promo ${Math.round(disc * 100)}% appliquée !`;
        }

        totalPriceEl.textContent = sousTotal.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' DT';
        
        if (isPromo) {
            promoInfoEl.classList.remove('d-none');
            totalPriceEl.classList.remove('text-success');
            totalPriceEl.classList.add('text-primary');
        } else {
            promoInfoEl.classList.add('d-none');
            totalPriceEl.classList.remove('text-primary');
            totalPriceEl.classList.add('text-success');
        }
    });
}

// Prevent double submission
const bookingForm = document.getElementById('booking-form');
if (bookingForm) {
    bookingForm.addEventListener('submit', function() {
        const btn = this.querySelector('button[type="submit"]');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Traitement...';
        }
    });
}
</script>
{% endblock %}
{% endblock %}

