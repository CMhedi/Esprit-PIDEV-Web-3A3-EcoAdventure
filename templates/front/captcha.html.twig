{# filepath: templates/front/captcha.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
<!-- TEST -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify You're Not a Bot - EcoAdventure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/ecoadventure.css') }}">
    <style>
        :root {
            --forest-green: #2D5A27;
            --energy-orange: #F28C28;
            --river-blue: #3B82F6;
            --rock-gray: #374151;
            --off-white: #F9FAFB;
            --soft-green: #edf5ee;
            --text-dark: #1f2937;
            --border-soft: #e5e7eb;
        }

        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--soft-green) 0%, #f7f8f7 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        /* Subtle animated background pattern */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: 
                radial-gradient(circle at 25% 25%, rgba(45, 90, 39, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 75% 75%, rgba(242, 140, 40, 0.06) 0%, transparent 50%);
            animation: gentleFloat 8s ease-in-out infinite;
        }

        @keyframes gentleFloat {
            0%, 100% { opacity: 0.5; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        .container {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(15px);
            padding: 45px;
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(45, 90, 39, 0.1);
            animation: fadeInUp 0.8s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .robot-icon {
            font-size: 50px;
            margin-bottom: 15px;
            animation: gentleBounce 3s infinite;
        }

        @keyframes gentleBounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-5px); }
            60% { transform: translateY(-3px); }
        }

        h2 {
            color: var(--text-dark);
            margin-bottom: 12px;
            font-size: 26px;
            font-weight: 700;
        }

        h2 .brand-highlight {
            color: var(--energy-orange);
        }

        p {
            color: #666;
            margin-bottom: 25px;
            font-size: 15px;
            line-height: 1.5;
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            background: linear-gradient(135deg, rgba(45, 90, 39, 0.1), rgba(242, 140, 40, 0.08));
            border: 1px solid rgba(45, 90, 39, 0.2);
            border-radius: 20px;
            padding: 8px 15px;
            margin-bottom: 25px;
            font-size: 13px;
            color: var(--forest-green);
            font-weight: 500;
        }

        .security-badge::before {
            content: '🔒';
            margin-right: 8px;
            font-size: 16px;
        }

        .captcha-box {
            background: linear-gradient(135deg, var(--off-white), #f0f2f5);
            padding: 25px;
            border-radius: 16px;
            margin-bottom: 25px;
            border: 2px dashed var(--forest-green);
            position: relative;
            transition: all 0.3s ease;
        }

        .captcha-box:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(45, 90, 39, 0.15);
        }

        .captcha-code {
            font-size: 36px;
            font-weight: bold;
            letter-spacing: 12px;
            color: var(--forest-green);
            user-select: none;
            font-family: 'Courier New', 'Courier', monospace;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
            animation: subtlePulse 4s infinite;
        }

        @keyframes subtlePulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.9; }
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            text-align: left;
            color: var(--text-dark);
            margin-bottom: 10px;
            font-weight: 600;
            font-size: 16px;
        }

        input[type="text"] {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid var(--border-soft);
            border-radius: 12px;
            font-size: 17px;
            font-weight: 500;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        input[type="text"]:focus {
            outline: none;
            border-color: var(--forest-green);
            box-shadow: 0 0 15px rgba(45, 90, 39, 0.2);
            transform: translateY(-1px);
        }

        input[type="text"]::placeholder {
            color: #aab0b6;
            letter-spacing: normal;
            text-transform: none;
        }

        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--forest-green), var(--energy-orange));
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(45, 90, 39, 0.3);
            position: relative;
            overflow: hidden;
        }

        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        button:hover::before {
            left: 100%;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(45, 90, 39, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        .error {
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 12px 15px;
            border-radius: 8px;
            margin-top: 15px;
            font-size: 14px;
            border-left: 4px solid #dc2626;
            animation: shake 0.6s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-2px); }
            20%, 40%, 60%, 80% { transform: translateX(2px); }
        }

        .back-link {
            margin-top: 25px;
            opacity: 0.8;
            transition: opacity 0.3s;
        }

        .back-link:hover {
            opacity: 1;
        }

        .back-link a {
            color: var(--forest-green);
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
        }

        .back-link a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(135deg, var(--forest-green), var(--energy-orange));
            transition: width 0.3s;
        }

        .back-link a:hover::after {
            width: 100%;
        }

        /* Responsive adjustments */
        @media (max-width: 480px) {
            .container {
                padding: 35px 25px;
                margin: 15px;
            }

            h2 {
                font-size: 22px;
            }

            .robot-icon {
                font-size: 45px;
            }

            .captcha-code {
                font-size: 30px;
                letter-spacing: 8px;
            }

            input[type="text"] {
                padding: 12px 15px;
                font-size: 16px;
            }

            button {
                padding: 12px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="robot-icon">🤖</div>
        <h2>Verify You're Not a <span class="brand-highlight">Bot</span></h2>
        <p>Please enter the verification code shown below to continue</p>

        <div class="security-badge">
            Secure verification for EcoAdventure
        </div>

        <div class="captcha-box">
            <div class="captcha-code">{{ captcha }}</div>
        </div>

        <form method="POST" action="{{ path('app_captcha_submit') }}">
            <div class="form-group">
                <label for="captcha_user">Enter the 5 letters above:</label>
                <input 
                    type="text" 
                    id="captcha_user" 
                    name="captcha_user" 
                    placeholder="e.g., ABCDE"
                    required
                    autofocus
                    maxlength="5"
                    pattern="[A-Z]{5}"
                    title="Please enter exactly 5 uppercase letters"
                >
            </div>

            {% if app.flashes('error') %}
                <div class="error">
                    {% for message in app.flashes('error') %}
                        ⚠️ {{ message }}
                    {% endfor %}
                </div>
            {% endif %}

            <button type="submit">✓ Verify & Continue</button>
        </form>

        <div class="back-link">
            <a href="{{ path('app_activitefront') }}">← Back to Activity Form</a>
        </div>
    </div>

    <script>
        // Enhanced UX features
        const input = document.getElementById('captcha_user');
        
        // Auto-uppercase and filter non-letters
        input.addEventListener('input', function() {
            this.value = this.value.toUpperCase().replace(/[^A-Z]/g, '');
            
            // Visual feedback for correct length
            if (this.value.length === 5) {
                this.style.borderColor = '#28a745';
                this.style.boxShadow = '0 0 10px rgba(40, 167, 69, 0.2)';
            } else {
                this.style.borderColor = 'var(--border-soft)';
                this.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.05)';
            }
        });

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            if (input.value.length !== 5) {
                e.preventDefault();
                input.style.borderColor = '#dc2626';
                input.style.boxShadow = '0 0 10px rgba(220, 38, 38, 0.2)';
                setTimeout(() => {
                    input.style.borderColor = 'var(--border-soft)';
                    input.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.05)';
                }, 1500);
            }
        });
    </script>
</body>
</html>