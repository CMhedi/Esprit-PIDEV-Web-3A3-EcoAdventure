{% extends 'base.html.twig' %}

{% block title %}Carte des Activites{% endblock %}

{% block body %}
<!-- TEST -->
<div class="container my-5">
    <h2 class="mb-4">Carte des Activites</h2>

    <div id="map" style="height: 600px; border-radius: 12px;"></div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
    var map = L.map('map').setView([36.8, 10.18], 7);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    {% for activite in activites %}
        {% if activite.latitude and activite.longitude %}
            L.marker([{{ activite.latitude }}, {{ activite.longitude }}])
                .addTo(map)
                .bindPopup(`
                    <b>{{ activite.nom }}</b><br>
                    Prix: {{ activite.prix }} DT
                `);
        {% endif %}
    {% endfor %}
</script>
{% endblock %}