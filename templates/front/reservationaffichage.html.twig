{% extends 'base.html.twig' %}

{% block title %}Réservation Ajoutée{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white py-3">
            <h3 class="mb-0">
                <i class="bi bi-check-circle-fill me-2"></i>
                Réservation effectuée avec succès
            </h3>
        </div>

        <div class="card-body p-4">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Activité</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Nombre de personnes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ reservation.activite.nom }}</td>

                        <td>{{ reservation.dateRes|date('Y-m-d H:i') }}</td>

                        <td>{{ reservation.statutRes.value }}</td>

                        <td>{{ reservation.nbPersonnes }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4">
                <a href="{{ path('app_activitefront') }}" class="btn btn-primary rounded-pill px-4">
                    Retour aux activités
                </a>

                <a href="{{ path('app_reservation_front', {'id': reservation.activite.idActivite}) }}" 
                   class="btn btn-success rounded-pill px-4 ms-2">
                    Nouvelle réservation
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}