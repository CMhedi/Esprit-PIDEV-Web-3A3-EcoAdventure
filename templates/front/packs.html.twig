{% extends 'base.html.twig' %}

{% block title %}Packs | EcoAdventure{% endblock %}

{% block body %}
<section class="page-header py-5">
    <div class="container text-center">
        <h1 class="fw-bold">Nos Packs</h1>
        <p class="text-muted">Choisissez la formule qui correspond à votre style d’aventure.</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="row g-4 justify-content-center">
            {% for pack in packs %}
                <div class="col-lg-4 col-md-6">
                    <div class="card pack-card border-0 shadow-sm h-100">
                        <div class="card-body p-4 text-center">
                            <h3 class="fw-bold">{{ pack.name }}</h3>
                            <div class="pack-price my-3">{{ pack.price }}</div>

                            <ul class="list-unstyled pack-features">
                                {% for feature in pack.features %}
                                    <li><i class="bi bi-check-circle-fill me-2"></i>{{ feature }}</li>
                                {% endfor %}
                            </ul>

                            <a href="#" class="btn btn-eco rounded-pill px-4 mt-3">S’abonner</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}