{% extends 'base.html.twig' %}

{% block title %}Accueil | EcoAdventure{% endblock %}

{% block css %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap');

    :root {
        --eco-green: #346c3b;
        --eco-green-dark: #234c28;
        --eco-orange: #ea792c;
        --eco-orange-dark: #c5621e;
    }

    body {
        font-family: 'Outfit', sans-serif;
        background-color: #f8fafc;
        color: #1e293b;
    }

    .hero-section {
        background: linear-gradient(rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.7)), url('https://images.unsplash.com/photo-1501555088652-021faa106b9b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat fixed;
        min-height: 85vh;
        display: flex;
        align-items: center;
        position: relative;
        padding: 100px 0;
        margin-top: -80px;
    }

    .hero-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 32px;
        padding: 50px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
        animation: slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes slideUpFade {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .hero-card h1 {
        font-size: 3.5rem;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 20px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .hero-card h1 span {
        background: linear-gradient(135deg, var(--eco-green), var(--eco-orange));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: none;
    }

    .hero-card p.lead {
        font-size: 1.25rem;
        font-weight: 300;
        color: rgba(255, 255, 255, 0.9) !important;
        margin-bottom: 40px;
    }

    .search-box {
        background: rgba(255, 255, 255, 0.15);
        padding: 15px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .search-box .form-control, .search-box .form-select {
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 14px;
        height: 54px;
        font-weight: 500;
        color: #334155;
    }

    .search-box .form-control:focus, .search-box .form-select:focus {
        box-shadow: 0 0 0 4px rgba(234, 121, 44, 0.3);
    }

    .search-box .btn-warning {
        background: linear-gradient(135deg, var(--eco-orange), var(--eco-orange-dark));
        border: none;
        border-radius: 14px;
        height: 54px;
        color: white;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
    }

    .search-box .btn-warning:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(234, 121, 44, 0.4);
    }

    .hero-image-wrapper {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0,0,0,0.4);
        transform: perspective(1000px) rotateY(-10deg);
        transition: transform 0.5s ease;
    }
    
    .hero-image-wrapper:hover {
        transform: perspective(1000px) rotateY(0deg);
    }

    .section-title {
        position: relative;
        display: inline-block;
        padding-bottom: 10px;
    }
    
    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, var(--eco-green), var(--eco-orange));
        border-radius: 2px;
    }

    .activity-card, .event-card, .pack-card {
        border-radius: 24px;
        transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        background: white;
    }

    .activity-card:hover, .event-card:hover, .pack-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08) !important;
    }

    .icon-box {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(52, 108, 59, 0.1), rgba(234, 121, 44, 0.1));
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: var(--eco-green);
        margin-bottom: 25px;
    }

    .btn-eco-outline {
        border: 2px solid var(--eco-green);
        color: var(--eco-green);
        font-weight: 600;
        transition: 0.3s;
    }
    
    .btn-eco-outline:hover {
        background: var(--eco-green);
        color: white;
        transform: scale(1.05);
    }

    .event-image {
        height: 220px;
        object-fit: cover;
    }

    .btn-eco {
        background: linear-gradient(135deg, var(--eco-green), var(--eco-green-dark));
        color: white;
        border: none;
        font-weight: 600;
        transition: 0.3s;
    }
    
    .btn-eco:hover {
        background: linear-gradient(135deg, var(--eco-green-dark), #153218);
        color: white;
        transform: translateY(-2px);
    }

    .pack-price {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--eco-green), var(--eco-orange));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .pack-features li {
        margin-bottom: 15px;
        color: #475569;
        font-weight: 500;
    }
    
    .pack-features i {
        color: var(--eco-orange);
    }
</style>
{% endblock %}

{% block body %}
<section class="hero-section">
    <div class="container">
        <div class="hero-card">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="badge rounded-pill bg-white text-dark px-4 py-2 mb-4 fw-bold shadow-sm" style="font-size: 0.9rem;">
                        <i class="bi bi-compass text-primary me-2"></i>Aventure • Nature • Sport
                    </span>
                    <h1 class="text-white">
                        Explorez l'aventure avec<br><span>EcoAdventure</span>
                    </h1>
                    <p class="lead mt-3">
                        Réservez vos activités sportives, découvrez des événements uniques et profitez d'une expérience immersive au cœur de la nature.
                    </p>

                    <form class="search-box mt-5">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <input type="text" class="form-control px-4" placeholder="Rechercher une activité...">
                            </div>
                            <div class="col-md-4">
                                <select class="form-select px-4">
                                    <option>Toutes catégories</option>
                                    <option>Nature</option>
                                    <option>Nautique</option>
                                    <option>Aventure</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-warning w-100 fw-bold">Rechercher</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="col-lg-5 d-none d-lg-block">
                    <div class="hero-image-wrapper">
                        <img src="https://images.unsplash.com/photo-1533240332313-0bc499f50e10?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="img-fluid" alt="Adventure Hero">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            {% for activity in activities %}
                <div class="col-md-4">
                    <div class="card activity-card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="icon-box mb-3">
                                <i class="bi {{ activity.icon }}"></i>
                            </div>
                            <h4 class="fw-bold">{{ activity.title }}</h4>
                            <p class="text-muted">{{ activity.description }}</p>
                            <a href="#" class="btn btn-eco-outline rounded-pill px-4">Découvrir</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold section-title">Événements à venir</h2>
                <p class="text-muted mb-0">Choisissez votre prochaine aventure.</p>
            </div>
            <a href="{{ path('app_event_front_index') }}" class="btn btn-link text-decoration-none fw-semibold">Voir tous</a>
        </div>

        <div class="row g-4">
            {% for event in events %}
                <div class="col-lg-4 col-md-6">
                    <div class="card event-card border-0 shadow-sm h-100">
                        <img src="{{ asset(event.image) }}" class="card-img-top event-image" alt="{{ event.title }}">
                        <div class="card-body">
                            <span class="badge bg-light text-dark mb-2">{{ event.category }}</span>
                            <h5 class="fw-bold">{{ event.title }}</h5>
                            <p class="mb-1"><i class="bi bi-geo-alt me-2"></i>{{ event.location }}</p>
                            <p class="mb-1"><i class="bi bi-calendar-event me-2"></i>{{ event.date }}</p>
                            <p class="price-text mb-3"><i class="bi bi-cash-stack me-2"></i>{{ event.price }}</p>

                            <div class="d-flex gap-2">
                                <a href="#" class="btn btn-eco w-100">S'inscrire</a>
                                <a href="#" class="btn btn-light border w-100">Détails</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="py-5 pack-section">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold section-title">Nos Packs</h2>
            <p class="text-muted">Des formules adaptées à chaque aventurier.</p>
        </div>

        <div class="row g-4">
            {% for pack in packs %}
                <div class="col-lg-4">
                    <div class="card pack-card border-0 shadow-sm h-100">
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold">{{ pack.name }}</h4>
                            <div class="pack-price my-3">{{ pack.price }}</div>

                            <ul class="list-unstyled pack-features">
                                {% for feature in pack.features %}
                                    <li><i class="bi bi-check-circle-fill me-2"></i>{{ feature }}</li>
                                {% endfor %}
                            </ul>

                            <a href="#" class="btn btn-eco rounded-pill px-4 mt-3">Choisir ce pack</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}