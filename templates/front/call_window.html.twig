{% extends 'base.html.twig' %}

{% block title %}Appel - {{ call_target_display_name }}{% endblock %}
{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}
{% block body_class %}call-window-body{% endblock %}

{% block css %}
<style>
    .call-window-body {
        margin: 0;
        min-height: 100vh;
        background:
            radial-gradient(circle at top left, rgba(22, 163, 74, 0.28), transparent 30%),
            radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.22), transparent 35%),
            linear-gradient(135deg, #08111f 0%, #0f172a 48%, #111827 100%);
        color: #f8fafc;
    }

    .call-window-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 28px;
        gap: 24px;
    }

    .call-window-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 18px 22px;
        border-radius: 24px;
        background: rgba(15, 23, 42, 0.72);
        border: 1px solid rgba(148, 163, 184, 0.22);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 48px rgba(8, 15, 32, 0.32);
    }

    .call-window-brand {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #86efac;
    }

    .call-window-title {
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .call-window-status-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }
    .call-window-summary-list {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        margin-top: 12px;
    }
    .call-window-summary-line {
        color: rgba(226, 232, 240, 0.76);
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .call-window-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.92rem;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.78);
        border: 1px solid rgba(148, 163, 184, 0.24);
    }

    .call-window-chip.primary {
        background: rgba(22, 163, 74, 0.18);
        border-color: rgba(74, 222, 128, 0.28);
        color: #dcfce7;
    }

    .call-window-chip.timer {
        font-weight: 700;
        letter-spacing: 0.06em;
    }

    .call-window-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 11px 18px;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.26);
        color: #f8fafc;
        text-decoration: none;
        background: rgba(15, 23, 42, 0.66);
        transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .call-window-link:hover {
        transform: translateY(-1px);
        color: #ffffff;
        border-color: rgba(74, 222, 128, 0.42);
        background: rgba(22, 163, 74, 0.16);
    }

    .call-window-stage {
        flex: 1;
        display: block;
    }

    .call-window-private-stage {
        display: grid;
        gap: 20px;
    }

    .call-window-shell.video-mode .call-window-private-stage {
        grid-template-columns: minmax(0, 1.75fr) minmax(280px, 0.95fr);
    }

    .call-window-shell.audio-mode .call-window-private-stage {
        grid-template-columns: minmax(0, 1fr);
    }

    .call-window-group-stage {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        align-content: start;
    }

    .call-window-group-tile {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        min-height: 260px;
        background:
            linear-gradient(180deg, rgba(15, 23, 42, 0.94) 0%, rgba(15, 23, 42, 0.82) 100%);
        border: 1px solid rgba(148, 163, 184, 0.2);
        box-shadow: 0 24px 52px rgba(3, 7, 18, 0.34);
    }

    .call-window-group-tile.local {
        border-color: rgba(74, 222, 128, 0.36);
    }

    .call-window-group-tile.connected {
        border-color: rgba(96, 165, 250, 0.38);
    }

    .call-window-group-tile.audio-only .call-placeholder-badge {
        color: #86efac;
    }

    .call-window-group-tile.video-enabled .call-placeholder-badge {
        color: #93c5fd;
    }

    .call-participant-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background:
            linear-gradient(180deg, rgba(15, 23, 42, 0.94) 0%, rgba(15, 23, 42, 0.82) 100%);
        border: 1px solid rgba(148, 163, 184, 0.2);
        min-height: 320px;
        box-shadow: 0 24px 52px rgba(3, 7, 18, 0.34);
    }

    .call-participant-card.local {
        min-height: 260px;
    }

    .call-window-shell.audio-mode .call-participant-card.remote {
        min-height: 430px;
    }

    .call-media,
    .call-placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .call-media {
        object-fit: cover;
        background: #020617;
    }

    .call-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 18px;
        padding: 28px;
        text-align: center;
        background:
            radial-gradient(circle at top, rgba(34, 197, 94, 0.22), transparent 35%),
            linear-gradient(180deg, rgba(15, 23, 42, 0.86) 0%, rgba(15, 23, 42, 0.96) 100%);
    }

    .call-placeholder-badge {
        width: 104px;
        height: 104px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.24);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.28);
        font-size: 2.3rem;
        color: #86efac;
    }

    .call-window-shell.video-mode .call-placeholder-badge {
        color: #93c5fd;
    }

    .call-placeholder-title {
        font-size: clamp(1.3rem, 2.2vw, 2rem);
        font-weight: 700;
    }

    .call-placeholder-subtitle {
        max-width: 320px;
        color: rgba(226, 232, 240, 0.76);
    }

    .call-participant-overlay {
        position: absolute;
        left: 18px;
        right: 18px;
        bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(2, 6, 23, 0.66);
        border: 1px solid rgba(148, 163, 184, 0.16);
        backdrop-filter: blur(12px);
    }

    .call-participant-name {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .call-participant-role {
        font-size: 0.9rem;
        color: rgba(226, 232, 240, 0.68);
    }

    .call-window-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 4px 0 16px;
    }

    .call-control-btn {
        min-width: 154px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 18px;
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: rgba(15, 23, 42, 0.76);
        color: #f8fafc;
        font-weight: 600;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }

    .call-control-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        background: rgba(30, 41, 59, 0.9);
        border-color: rgba(74, 222, 128, 0.36);
    }

    .call-control-btn.active {
        background: rgba(37, 99, 235, 0.24);
        border-color: rgba(96, 165, 250, 0.4);
    }

    .call-control-btn.danger {
        background: rgba(190, 24, 93, 0.24);
        border-color: rgba(244, 63, 94, 0.38);
    }

    .call-control-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        transform: none;
    }

    .call-window-shell.call-ended .call-control-btn:not(.leave-open) {
        opacity: 0.45;
        pointer-events: none;
    }

    .call-ended-banner {
        display: none;
        padding: 16px 18px;
        border-radius: 18px;
        background: rgba(190, 24, 93, 0.12);
        border: 1px solid rgba(251, 113, 133, 0.26);
        color: #fecdd3;
        text-align: center;
    }

    .call-window-shell.call-ended .call-ended-banner {
        display: block;
    }

    @media (max-width: 991px) {
        .call-window-shell {
            padding: 18px;
        }

        .call-window-shell.video-mode .call-window-private-stage,
        .call-window-shell.audio-mode .call-window-private-stage {
            grid-template-columns: 1fr;
        }

        .call-participant-card.local {
            min-height: 220px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div
    id="standaloneCallPage"
    class="call-window-shell audio-mode"
    data-current-user-name="{{ current_user_display_name|e('html_attr') }}"
    data-target-user-name="{{ call_target_display_name|e('html_attr') }}"
    data-messenger-url="{{ path('app_messagerie_selected', {'id_user': mon_id, 'id_conversation': conversation.id_conversation}) }}"
    data-call-blocked="{{ call_blocked ? '1' : '0' }}"
>
    <header class="call-window-topbar">
        <div>
            <div class="call-window-brand">EcoAdventure Call</div>
            <div class="call-window-title" id="callWindowTitle">Appel audio</div>
            <div class="call-window-status-row">
                <span class="call-window-chip primary" id="callWindowTypeChip">
                    <i class="bi bi-mic-fill"></i>
                    <span>Audio</span>
                </span>
                <span class="call-window-chip" id="callWindowStatusChip">
                    <i class="bi bi-broadcast-pin"></i>
                    <span id="callWindowStatusText">Connexion en cours...</span>
                </span>
                <span class="call-window-chip timer" id="callWindowTimerText">00:00</span>
            </div>
            <div class="call-window-summary-list">
                <div class="call-window-summary-line" id="callWindowConversationText">Conversation: {{ call_target_display_name }}</div>
                <div class="call-window-summary-line" id="callWindowInitiatorText">Lance par: {{ call_target_display_name }}</div>
                <div class="call-window-summary-line" id="callWindowParticipantsText">Membres: en attente de connexion</div>
            </div>
        </div>
        <a href="{{ path('app_messagerie_selected', {'id_user': mon_id, 'id_conversation': conversation.id_conversation}) }}" class="call-window-link leave-open" id="callWindowMessengerLink">
            <i class="bi bi-chat-left-text"></i>
            <span>Messagerie</span>
        </a>
    </header>

    <div class="call-ended-banner" id="callWindowEndedBanner">
        La fenetre de messagerie n est plus disponible. Revenez a la conversation pour reprendre l appel.
    </div>

    <main class="call-window-stage">
        <div id="callWindowPrivateStage" class="call-window-private-stage">
            <section class="call-participant-card remote">
                <video id="callWindowRemoteVideo" class="call-media d-none" autoplay playsinline muted></video>
                <div id="callWindowRemotePlaceholder" class="call-placeholder">
                    <div class="call-placeholder-badge">
                        <i class="bi bi-mic-fill" id="callWindowRemoteIcon"></i>
                    </div>
                    <div class="call-placeholder-title" id="callWindowRemotePlaceholderTitle">{{ call_target_display_name }}</div>
                    <div class="call-placeholder-subtitle" id="callWindowRemotePlaceholderSubtitle">
                        Audio en attente. Le micro reste actif dans la conversation.
                    </div>
                </div>
                <div class="call-participant-overlay">
                    <div>
                        <div class="call-participant-name" id="callWindowRemoteName">{{ call_target_display_name }}</div>
                        <div class="call-participant-role">Participant distant</div>
                    </div>
                    <span class="call-window-chip" id="callWindowRemoteStateChip">
                        <i class="bi bi-dot"></i>
                        <span>En attente</span>
                    </span>
                </div>
            </section>

            <section class="call-participant-card local">
                <video id="callWindowLocalVideo" class="call-media d-none" autoplay playsinline muted></video>
                <div id="callWindowLocalPlaceholder" class="call-placeholder">
                    <div class="call-placeholder-badge">
                        <i class="bi bi-mic-fill" id="callWindowLocalIcon"></i>
                    </div>
                    <div class="call-placeholder-title" id="callWindowLocalPlaceholderTitle">{{ current_user_display_name }}</div>
                    <div class="call-placeholder-subtitle" id="callWindowLocalPlaceholderSubtitle">
                        Votre apercu apparaitra ici des que le flux local sera pret.
                    </div>
                </div>
                <div class="call-participant-overlay">
                    <div>
                        <div class="call-participant-name" id="callWindowLocalName">{{ current_user_display_name }}</div>
                        <div class="call-participant-role">Vous</div>
                    </div>
                    <span class="call-window-chip" id="callWindowLocalStateChip">
                        <i class="bi bi-mic-fill"></i>
                        <span>Micro actif</span>
                    </span>
                </div>
            </section>
        </div>
        <div id="callWindowGroupStage" class="call-window-group-stage d-none"></div>
    </main>

    <footer class="call-window-controls">
        <button type="button" class="call-control-btn" id="callWindowMuteBtn">
            <i class="bi bi-mic-mute-fill"></i>
            <span>Muet</span>
        </button>
        <button type="button" class="call-control-btn" id="callWindowVideoBtn">
            <i class="bi bi-camera-video"></i>
            <span>Camera</span>
        </button>
        <button type="button" class="call-control-btn leave-open" id="callWindowFocusBtn">
            <i class="bi bi-window-stack"></i>
            <span>Ouvrir messagerie</span>
        </button>
        <button type="button" class="call-control-btn danger" id="callWindowHangupBtn">
            <i class="bi bi-telephone-x-fill"></i>
            <span>Quitter</span>
        </button>
    </footer>
</div>
{% endblock %}

{% block js %}
<script>
(function () {
    const pageRoot = document.getElementById('standaloneCallPage');
    if (!pageRoot) {
        return;
    }

    const messengerUrl = pageRoot.getAttribute('data-messenger-url') || '/messagerie';
    const fallbackCurrentUserName = pageRoot.getAttribute('data-current-user-name') || 'Vous';
    const fallbackTargetUserName = pageRoot.getAttribute('data-target-user-name') || 'Contact';

    const titleEl = document.getElementById('callWindowTitle');
    const typeChip = document.getElementById('callWindowTypeChip');
    const statusTextEl = document.getElementById('callWindowStatusText');
    const timerTextEl = document.getElementById('callWindowTimerText');
    const conversationTextEl = document.getElementById('callWindowConversationText');
    const initiatorTextEl = document.getElementById('callWindowInitiatorText');
    const participantsTextEl = document.getElementById('callWindowParticipantsText');
    const messengerLink = document.getElementById('callWindowMessengerLink');
    const endedBanner = document.getElementById('callWindowEndedBanner');
    const privateStage = document.getElementById('callWindowPrivateStage');
    const groupStage = document.getElementById('callWindowGroupStage');

    const remoteVideo = document.getElementById('callWindowRemoteVideo');
    const localVideo = document.getElementById('callWindowLocalVideo');
    const remotePlaceholder = document.getElementById('callWindowRemotePlaceholder');
    const localPlaceholder = document.getElementById('callWindowLocalPlaceholder');
    const remoteIcon = document.getElementById('callWindowRemoteIcon');
    const localIcon = document.getElementById('callWindowLocalIcon');
    const remotePlaceholderTitle = document.getElementById('callWindowRemotePlaceholderTitle');
    const localPlaceholderTitle = document.getElementById('callWindowLocalPlaceholderTitle');
    const remotePlaceholderSubtitle = document.getElementById('callWindowRemotePlaceholderSubtitle');
    const localPlaceholderSubtitle = document.getElementById('callWindowLocalPlaceholderSubtitle');
    const remoteNameEl = document.getElementById('callWindowRemoteName');
    const localNameEl = document.getElementById('callWindowLocalName');
    const remoteStateChip = document.getElementById('callWindowRemoteStateChip');
    const localStateChip = document.getElementById('callWindowLocalStateChip');

    const muteBtn = document.getElementById('callWindowMuteBtn');
    const videoBtn = document.getElementById('callWindowVideoBtn');
    const focusBtn = document.getElementById('callWindowFocusBtn');
    const hangupBtn = document.getElementById('callWindowHangupBtn');

    let refreshTimer = null;
    let lastGroupRenderKey = '';

    messengerLink?.setAttribute('href', messengerUrl);

    function getBridge() {
        try {
            if (window.opener && !window.opener.closed && window.opener.__ecoAdventureCallBridge) {
                return window.opener.__ecoAdventureCallBridge;
            }
        } catch (error) {
            return null;
        }

        return null;
    }

    function hasLiveVideoTrack(stream) {
        if (!stream || typeof stream.getVideoTracks !== 'function') {
            return false;
        }

        return stream.getVideoTracks().some((track) => track.readyState === 'live' && track.enabled && !track.muted);
    }

    function applyMediaStream(element, stream, shouldShow) {
        if (!element) {
            return;
        }

        if (element.srcObject !== (shouldShow ? stream : null)) {
            element.srcObject = shouldShow ? stream : null;
        }

        element.classList.toggle('d-none', !shouldShow);
        if (shouldShow) {
            element.play?.().catch(() => {});
        }
    }

    function setChipContent(chip, iconClass, label) {
        if (!chip) {
            return;
        }

        chip.innerHTML = `<i class="bi ${iconClass}"></i><span>${label}</span>`;
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function navigateToMessenger() {
        try {
            if (window.opener && !window.opener.closed) {
                window.opener.location.href = messengerUrl;
                window.opener.focus();
                window.close();
                return;
            }
        } catch (error) {
            // fall back to current window navigation
        }

        window.location.href = messengerUrl;
    }

    function buildGroupParticipants(snapshot) {
        const remoteParticipants = Array.isArray(snapshot.groupParticipants) ? snapshot.groupParticipants : [];

        return [
            {
                id: 'local',
                name: snapshot.currentUserDisplayName || fallbackCurrentUserName,
                isLocal: true,
                connected: true,
                stream: snapshot.localStream || null,
            },
            ...remoteParticipants.map((participant) => ({
                id: String(participant.userId || ''),
                name: participant.name || 'Participant',
                isLocal: false,
                connected: !!participant.connected,
                stream: participant.stream || null,
            })),
        ];
    }

    function renderGroupStage(snapshot) {
        if (!groupStage) {
            return;
        }

        const isVideoCall = !!snapshot.isVideoPresentation;
        const participants = buildGroupParticipants(snapshot);
        const renderKey = `${snapshot.callType}|${participants.map((participant) => `${participant.id}:${participant.name}`).join('|')}`;

        if (renderKey !== lastGroupRenderKey) {
            groupStage.innerHTML = participants.map((participant) => `
                <section class="call-window-group-tile ${participant.isLocal ? 'local' : ''} ${participant.connected ? 'connected' : ''} ${isVideoCall ? 'video-enabled' : 'audio-only'}" data-group-tile="${escapeHtml(participant.id)}">
                    <video class="call-media d-none" data-group-media="${escapeHtml(participant.id)}" autoplay playsinline ${participant.isLocal ? 'muted' : ''}></video>
                    <div class="call-placeholder" data-group-placeholder="${escapeHtml(participant.id)}">
                        <div class="call-placeholder-badge">
                            <i class="bi ${isVideoCall ? 'bi-camera-video-fill' : 'bi-mic-fill'}"></i>
                        </div>
                        <div class="call-placeholder-title">${escapeHtml(participant.name)}</div>
                        <div class="call-placeholder-subtitle" data-group-subtitle="${escapeHtml(participant.id)}">
                            ${participant.isLocal ? 'Votre flux sera affiche ici.' : (participant.connected ? 'Participant connecte a l appel.' : 'En attente de connexion a l appel.')}
                        </div>
                    </div>
                    <div class="call-participant-overlay">
                        <div>
                            <div class="call-participant-name">${escapeHtml(participant.name)}</div>
                            <div class="call-participant-role">${participant.isLocal ? 'Vous' : 'Participant'}</div>
                        </div>
                        <span class="call-window-chip" data-group-state="${escapeHtml(participant.id)}">
                            <i class="bi ${participant.isLocal ? 'bi-mic-fill' : (participant.connected ? 'bi-broadcast-pin' : 'bi-hourglass-split')}"></i>
                            <span>${participant.isLocal ? 'Micro actif' : (participant.connected ? 'Connecte' : 'En attente')}</span>
                        </span>
                    </div>
                </section>
            `).join('');
            lastGroupRenderKey = renderKey;
        }

        participants.forEach((participant) => {
            const media = groupStage.querySelector(`[data-group-media="${participant.id}"]`);
            const placeholder = groupStage.querySelector(`[data-group-placeholder="${participant.id}"]`);
            const subtitle = groupStage.querySelector(`[data-group-subtitle="${participant.id}"]`);
            const stateChip = groupStage.querySelector(`[data-group-state="${participant.id}"]`);
            const tile = groupStage.querySelector(`[data-group-tile="${participant.id}"]`);
            const showVideo = isVideoCall
                && hasLiveVideoTrack(participant.stream)
                && (!participant.isLocal || !snapshot.localVideoMuted);

            tile?.classList.toggle('connected', !!participant.connected || participant.isLocal);
            applyMediaStream(media, participant.stream || null, showVideo);
            if (placeholder) {
                placeholder.classList.toggle('d-none', showVideo);
            }

            if (subtitle) {
                subtitle.textContent = participant.isLocal
                    ? (isVideoCall
                        ? (snapshot.localVideoMuted ? 'Votre camera est coupee pour le moment.' : 'Votre video est en cours.')
                        : 'Votre micro reste actif dans cette session audio.')
                    : (participant.connected
                        ? (isVideoCall ? 'Video du participant active.' : 'Audio du participant actif.')
                        : 'En attente de connexion a l appel.');
            }

            if (stateChip) {
                stateChip.innerHTML = participant.isLocal
                    ? `<i class="bi ${snapshot.localAudioMuted ? 'bi-mic-mute-fill' : 'bi-mic-fill'}"></i><span>${snapshot.localAudioMuted ? 'Micro coupe' : 'Micro actif'}</span>`
                    : `<i class="bi ${participant.connected ? 'bi-broadcast-pin' : 'bi-hourglass-split'}"></i><span>${participant.connected ? 'Connecte' : 'En attente'}</span>`;
            }
        });
    }

    function setEndedState(message) {
        pageRoot.classList.add('call-ended');
        endedBanner.textContent = message;
        statusTextEl.textContent = 'Appel termine';
        titleEl.textContent = 'Appel indisponible';
        timerTextEl.textContent = '00:00';
        if (conversationTextEl) conversationTextEl.textContent = `Conversation: ${fallbackTargetUserName}`;
        if (initiatorTextEl) initiatorTextEl.textContent = 'Lance par: indisponible';
        if (participantsTextEl) participantsTextEl.textContent = 'Membres: indisponible';
        privateStage?.classList.remove('d-none');
        if (groupStage) {
            groupStage.classList.add('d-none');
            groupStage.innerHTML = '';
        }
        lastGroupRenderKey = '';
        setChipContent(typeChip, 'bi-telephone-x-fill', 'Termine');
        remotePlaceholderTitle.textContent = fallbackTargetUserName;
        localPlaceholderTitle.textContent = fallbackCurrentUserName;
        remotePlaceholderSubtitle.textContent = 'Revenez a la messagerie pour rouvrir un appel.';
        localPlaceholderSubtitle.textContent = 'La session active n est plus disponible dans la fenetre principale.';
        applyMediaStream(remoteVideo, null, false);
        applyMediaStream(localVideo, null, false);
        remotePlaceholder.classList.remove('d-none');
        localPlaceholder.classList.remove('d-none');
        setChipContent(remoteStateChip, 'bi-telephone-x-fill', 'Hors ligne');
        setChipContent(localStateChip, 'bi-telephone-x-fill', 'Termine');
        muteBtn.disabled = true;
        videoBtn.disabled = true;
        hangupBtn.disabled = true;
    }

    function applySnapshot(snapshot) {
        if (!snapshot || !snapshot.hasActiveCall) {
            setEndedState('La fenetre de messagerie n est plus disponible. Revenez a la conversation pour reprendre l appel.');
            return;
        }

        pageRoot.classList.remove('call-ended');
        endedBanner.textContent = '';

        const isVideoCall = !!snapshot.isVideoPresentation;
        const primaryGroupParticipant = snapshot.isGroupCall
            ? ((snapshot.groupParticipants || []).find((participant) => participant.connected) || (snapshot.groupParticipants || [])[0] || null)
            : null;
        const remoteName = snapshot.isGroupCall
            ? (primaryGroupParticipant?.name || snapshot.targetName || fallbackTargetUserName)
            : (snapshot.targetName || fallbackTargetUserName);
        const localName = snapshot.currentUserDisplayName || fallbackCurrentUserName;
        const conversationName = snapshot.conversationName || snapshot.targetName || fallbackTargetUserName;
        const initiatorName = snapshot.initiatorName || remoteName || fallbackTargetUserName;
        const participantsSummary = snapshot.isGroupCall
            ? (snapshot.groupParticipantsSummary || 'Membres: en attente de connexion')
            : `Correspondant: ${remoteName}`;
        const remoteVideoReady = isVideoCall && hasLiveVideoTrack(snapshot.remoteStream);
        const localVideoReady = isVideoCall && hasLiveVideoTrack(snapshot.localStream) && !snapshot.localVideoMuted;

        pageRoot.classList.toggle('video-mode', isVideoCall);
        pageRoot.classList.toggle('audio-mode', !isVideoCall);

        document.title = `${snapshot.isGroupCall ? (isVideoCall ? 'Appel video de groupe' : 'Appel audio de groupe') : (isVideoCall ? 'Appel video' : 'Appel audio')} - ${conversationName}`;
        titleEl.textContent = snapshot.isGroupCall
            ? (isVideoCall ? 'Appel video de groupe' : 'Appel audio de groupe')
            : (isVideoCall ? 'Appel video' : 'Appel audio');
        statusTextEl.textContent = snapshot.statusText || 'Connexion en cours...';
        timerTextEl.textContent = snapshot.timerText || '00:00';
        if (conversationTextEl) conversationTextEl.textContent = `Conversation: ${conversationName}`;
        if (initiatorTextEl) initiatorTextEl.textContent = `Lance par: ${initiatorName}`;
        if (participantsTextEl) participantsTextEl.textContent = participantsSummary;

        setChipContent(typeChip, isVideoCall ? 'bi-camera-video-fill' : 'bi-mic-fill', isVideoCall ? 'Video' : 'Audio');

        if (snapshot.isGroupCall) {
            privateStage?.classList.add('d-none');
            groupStage?.classList.remove('d-none');
            renderGroupStage(snapshot);
        } else {
            if (groupStage) {
                groupStage.classList.add('d-none');
                groupStage.innerHTML = '';
            }
            lastGroupRenderKey = '';
            privateStage?.classList.remove('d-none');
        }

        remoteNameEl.textContent = remoteName;
        localNameEl.textContent = localName;
        remotePlaceholderTitle.textContent = remoteName;
        localPlaceholderTitle.textContent = localName;

        if (remoteIcon) {
            remoteIcon.className = `bi ${isVideoCall ? 'bi-camera-video-fill' : 'bi-mic-fill'}`;
        }
        if (localIcon) {
            localIcon.className = `bi ${isVideoCall ? 'bi-camera-video-fill' : 'bi-mic-fill'}`;
        }

        remotePlaceholderSubtitle.textContent = isVideoCall
            ? (snapshot.remoteParticipantConnected ? 'Video du correspondant en cours.' : 'En attente de la camera du correspondant.')
            : 'Le micro de votre contact est relie a cet appel audio.';

        localPlaceholderSubtitle.textContent = isVideoCall
            ? (snapshot.localVideoMuted ? 'Votre camera est coupee pour le moment.' : 'Votre apercu video apparait ici.')
            : 'Votre micro reste actif dans cette session audio.';

        applyMediaStream(remoteVideo, snapshot.remoteStream || null, remoteVideoReady);
        applyMediaStream(localVideo, snapshot.localStream || null, localVideoReady);

        remotePlaceholder.classList.toggle('d-none', remoteVideoReady);
        localPlaceholder.classList.toggle('d-none', localVideoReady);

        setChipContent(
            remoteStateChip,
            snapshot.remoteParticipantConnected ? 'bi-broadcast-pin' : 'bi-hourglass-split',
            snapshot.remoteParticipantConnected ? 'Connecte' : 'En attente'
        );
        setChipContent(
            localStateChip,
            snapshot.localAudioMuted ? 'bi-mic-mute-fill' : 'bi-mic-fill',
            snapshot.localAudioMuted ? 'Micro coupe' : 'Micro actif'
        );

        muteBtn.disabled = false;
        muteBtn.classList.toggle('active', snapshot.localAudioMuted);
        muteBtn.innerHTML = snapshot.localAudioMuted
            ? '<i class="bi bi-mic-fill"></i><span>Activer</span>'
            : '<i class="bi bi-mic-mute-fill"></i><span>Muet</span>';

        videoBtn.disabled = false;
        videoBtn.classList.remove('d-none');
        videoBtn.classList.toggle('active', !snapshot.localVideoMuted);
        videoBtn.innerHTML = snapshot.localVideoMuted
            ? '<i class="bi bi-camera-video"></i><span>Video</span>'
            : '<i class="bi bi-camera-video-off"></i><span>Audio</span>';

        hangupBtn.disabled = false;
    }

    async function performBridgeAction(actionName, emptyMessage) {
        const bridge = getBridge();
        if (!bridge || typeof bridge[actionName] !== 'function') {
            setEndedState(emptyMessage);
            return;
        }

        try {
            await bridge[actionName]();
        } catch (error) {
            // The messenger page already manages the visible error state.
        }

        refreshFromBridge();
    }

    function refreshFromBridge() {
        const bridge = getBridge();
        if (!bridge || typeof bridge.getSnapshot !== 'function') {
            setEndedState('La fenetre de messagerie n est plus disponible. Revenez a la conversation pour reprendre l appel.');
            return;
        }

        try {
            applySnapshot(bridge.getSnapshot());
        } catch (error) {
            setEndedState('Impossible de synchroniser cette fenetre avec la messagerie.');
        }
    }

    muteBtn?.addEventListener('click', function () {
        performBridgeAction('toggleAudio', 'Le micro ne peut plus etre gere depuis cette fenetre.');
    });

    videoBtn?.addEventListener('click', function () {
        performBridgeAction('toggleVideo', 'La camera ne peut plus etre geree depuis cette fenetre.');
    });

    focusBtn?.addEventListener('click', function () {
        navigateToMessenger();
    });

    messengerLink?.addEventListener('click', function (event) {
        event.preventDefault();
        navigateToMessenger();
    });

    hangupBtn?.addEventListener('click', async function () {
        const bridge = getBridge();
        if (!bridge || typeof bridge.hangup !== 'function') {
            setEndedState('L appel est deja termine.');
            navigateToMessenger();
            return;
        }

        try {
            await bridge.hangup();
        } catch (error) {
            // The messenger page already manages the visible error state.
        }

        navigateToMessenger();
    });

    refreshFromBridge();
    refreshTimer = window.setInterval(refreshFromBridge, 450);

    window.addEventListener('beforeunload', function () {
        if (refreshTimer) {
            window.clearInterval(refreshTimer);
        }
    });
})();
</script>
{% endblock %}
